<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{asset_name}} · {{lens}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Mono:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --paper: #f4f2ec;
      --surface: #fffefa;
      --surface-soft: #eeece4;
      --ink: #18201d;
      --muted: #6d746f;
      --line: #d8d6ce;
      --line-dark: #b7bab4;
      --teal: #0e8d7b;
      --teal-dark: #096d60;
      --teal-soft: #ddefe9;
      --amber: #c88417;
      --amber-soft: #f6ead1;
      --red: #c34e48;
      --red-soft: #f5dedb;
      --blue: #3d5afe;
      --radius: 18px;
      --shadow: 0 12px 34px rgba(25, 35, 31, .06);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      background:
        radial-gradient(circle at 10% 0%, rgba(14, 141, 123, .07), transparent 26rem),
        var(--paper);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    .report {
      width: min(1180px, calc(100% - 40px));
      margin: 32px auto 56px;
      overflow: hidden;
      background: var(--surface);
      border: 1px solid rgba(24, 32, 29, .12);
      border-radius: 26px;
      box-shadow: var(--shadow);
    }

    .hero {
      padding: 44px 48px 42px;
      color: #f8fffc;
      background:
        linear-gradient(130deg, rgba(255,255,255,.05), transparent 45%),
        #143d36;
    }

    .hero-top {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 36px;
      align-items: start;
    }

    .asset-line {
      margin: 0 0 8px;
      color: rgba(248, 255, 252, .72);
      font-size: 13px;
      font-weight: 750;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .asset-line strong { color: #fff; }

    .period {
      margin: 0;
      color: rgba(248, 255, 252, .63);
      font-size: 14px;
    }

    .eyebrow {
      margin: 31px 0 10px;
      color: #8dd8c9;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .action-title {
      max-width: 870px;
      margin: 0;
      color: #fff;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(34px, 5vw, 60px);
      font-weight: 500;
      letter-spacing: -.035em;
      line-height: 1.04;
    }

    .verdict {
      max-width: 820px;
      margin: 18px 0 0;
      color: rgba(248, 255, 252, .76);
      font-size: clamp(16px, 2vw, 19px);
    }

    .score-ring {
      --score: {{score_badge.score}};
      --score-color: var(--teal);
      position: relative;
      display: grid;
      width: 154px;
      aspect-ratio: 1;
      place-items: center;
      flex: 0 0 auto;
      border-radius: 50%;
      background: conic-gradient(var(--score-color) calc(var(--score) * 1%), rgba(255,255,255,.14) 0);
    }

    .score-ring.amber { --score-color: #efb552; }
    .score-ring.red { --score-color: #ed8078; }

    .score-ring::before {
      position: absolute;
      width: calc(100% - 18px);
      aspect-ratio: 1;
      border-radius: 50%;
      background: #143d36;
      content: "";
    }

    .score-copy { position: relative; text-align: center; }

    .score-value {
      display: block;
      color: #fff;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 44px;
      font-weight: 700;
      letter-spacing: -.06em;
      line-height: 1;
    }

    .score-scale {
      display: block;
      margin-top: 5px;
      color: rgba(248, 255, 252, .58);
      font-size: 11px;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .reasons {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 30px;
    }

    .reason {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 11px;
      color: rgba(248, 255, 252, .83);
      background: rgba(255,255,255,.07);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 999px;
      font-size: 12px;
      font-weight: 650;
    }

    .reason-mark {
      display: inline-grid;
      width: 18px;
      height: 18px;
      place-items: center;
      border-radius: 50%;
      font-size: 12px;
      font-weight: 900;
    }

    .reason-mark.ok { color: #9de1d3; background: rgba(14,141,123,.22); }
    .reason-mark.ok::before { content: "✓"; }
    .reason-mark.no { color: #ffaaa4; background: rgba(195,78,72,.22); }
    .reason-mark.no::before { content: "×"; }

    section { padding: 48px; border-top: 1px solid var(--line); }

    .section-head {
      display: flex;
      justify-content: space-between;
      gap: 24px;
      align-items: end;
      margin-bottom: 24px;
    }

    .section-tag {
      margin: 0 0 6px;
      color: var(--teal-dark);
      font-size: 11px;
      font-weight: 850;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .section-title {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(28px, 4vw, 40px);
      font-weight: 500;
      letter-spacing: -.025em;
      line-height: 1.1;
    }

    .headline-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .headline-card {
      min-width: 0;
      padding: 22px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }

    .metric-label {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 0;
      color: var(--muted);
      font-size: 12px;
      font-weight: 750;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line-dark); }
    .dot.g { background: var(--teal); }
    .dot.a { background: var(--amber); }
    .dot.r { background: var(--red); }

    .metric-value {
      min-height: 62px;
      margin: 17px 0 10px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 30px;
      letter-spacing: -.03em;
      line-height: 1.02;
    }

    .metric-value.mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 26px;
      font-weight: 650;
    }

    .metric-value.g { color: var(--teal-dark); }
    .metric-value.a { color: #9c6714; }
    .metric-value.r { color: var(--red); }
    .value-line { display: block; }
    .metric-sub { margin: 0; color: var(--muted); font-size: 14px; }

    .edge-panel {
      position: relative;
      overflow: hidden;
      padding: 30px;
      color: #f8fffc;
      background: #183f38;
      border-radius: 22px;
    }

    .edge-panel::after {
      position: absolute;
      right: -90px;
      top: -100px;
      width: 300px;
      height: 300px;
      border: 70px solid rgba(127, 218, 200, .07);
      border-radius: 50%;
      content: "";
    }

    .edge-top {
      position: relative;
      z-index: 1;
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
      padding-bottom: 19px;
      border-bottom: 1px solid rgba(255,255,255,.14);
    }

    .edge-badge { color: #97e0d2; font-size: 12px; font-weight: 800; letter-spacing: .03em; }
    .signals { color: rgba(248,255,252,.66); font-family: ui-monospace, monospace; font-size: 12px; }

    .edge-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 30px;
      margin-top: 24px;
    }

    .edge-label {
      margin: 0 0 8px;
      color: rgba(248,255,252,.52);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .edge-copy { margin: 0; color: rgba(248,255,252,.86); font-size: 16px; }

    .focus-row {
      position: relative;
      z-index: 1;
      display: flex;
      gap: 13px;
      align-items: center;
      margin-top: 26px;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,.14);
    }

    .focus-label {
      margin: 0;
      color: rgba(248,255,252,.52);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .focus-content { display: flex; gap: 13px; align-items: center; min-width: 0; }

    .focus-chip {
      flex: 0 0 auto;
      padding: 7px 10px;
      color: #143d36;
      background: #9de1d3;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 850;
    }

    .focus-tail { color: rgba(248,255,252,.7); font-size: 13px; }

    .pattern-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .pattern-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 110px;
      min-height: 150px;
      gap: 24px;
      padding: 22px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }

    .pattern-card.full { grid-column: 1 / -1; }
    .pattern-name { margin: 0 0 9px; font-size: 17px; font-weight: 760; }
    .pattern-meaning { margin: 0; color: var(--muted); font-size: 14px; }

    .spark-wrap { display: flex; flex-direction: column; align-items: end; justify-content: space-between; }
    .trend { font-size: 11px; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
    .trend::before { margin-right: 5px; }
    .trend.steady { color: #747a76; }
    .trend.steady::before { content: "—"; }
    .trend.rising { color: var(--teal); }
    .trend.rising::before { content: "▲"; }
    .trend.new { color: var(--blue); }
    .trend.new::before { content: "●"; }
    .trend.mixed { color: var(--amber); }
    .trend.mixed::before { content: "◆"; }

    .spark { width: 110px; height: 42px; overflow: visible; }


    .timeline {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
      gap: 0;
      margin-top: 35px;
    }

    .timeline-point {
      position: relative;
      min-width: 0;
      padding: 24px 13px 0 0;
      border-top: 1px solid var(--line-dark);
    }

    .timeline-point::before {
      position: absolute;
      top: -6px;
      left: 0;
      width: 11px;
      height: 11px;
      background: var(--teal);
      border: 3px solid var(--surface);
      border-radius: 50%;
      box-shadow: 0 0 0 1px var(--teal);
      content: "";
    }

    .timeline-point.amber::before { background: var(--amber); box-shadow: 0 0 0 1px var(--amber); }
    .timeline-point.red::before { background: var(--red); box-shadow: 0 0 0 1px var(--red); }
    .timeline-label { min-height: 42px; margin: 0 0 7px; font-size: 13px; font-weight: 720; line-height: 1.35; }
    .timeline-period { margin: 0; color: var(--muted); font-family: ui-monospace, monospace; font-size: 11px; }

    .split-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }

    .guidance-card {
      min-width: 0;
      padding: 25px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }

    .guidance-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 20px;
      align-items: start;
    }

    .guidance-title { margin: 0 0 4px; font-size: 18px; }
    .guidance-sub { margin: 0; color: var(--muted); font-size: 12px; }
    .ratio { font-family: ui-monospace, monospace; font-size: 20px; font-weight: 750; white-space: nowrap; }

    progress {
      display: block;
      width: 100%;
      height: 7px;
      margin: 20px 0 22px;
      overflow: hidden;
      appearance: none;
      border: 0;
      border-radius: 99px;
      background: #e7e4dc;
    }

    progress::-webkit-progress-bar { background: #e7e4dc; border-radius: 99px; }
    progress::-webkit-progress-value { background: var(--teal); border-radius: 99px; }
    progress::-moz-progress-bar { background: var(--teal); border-radius: 99px; }
    .guidance-card.amber progress::-webkit-progress-value { background: var(--amber); }
    .guidance-card.amber progress::-moz-progress-bar { background: var(--amber); }

    .guidance-items { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
    .guidance-item {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 14px;
      align-items: start;
      padding: 11px 0;
      border-top: 1px solid #ebe8e1;
      font-size: 13px;
    }

    .item-status {
      padding: 3px 7px;
      border-radius: 99px;
      font-size: 9px;
      font-weight: 850;
      letter-spacing: .06em;
      line-height: 1.4;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .item-status.credible { color: var(--teal-dark); background: var(--teal-soft); }
    .item-status.pending { color: #8d5c0d; background: var(--amber-soft); }
    .item-status.missed { color: #9b3733; background: var(--red-soft); }

    .takeaway {
      margin: 16px 0 0;
      padding: 18px 20px;
      color: #315049;
      background: var(--teal-soft);
      border-left: 4px solid var(--teal);
      border-radius: 0 12px 12px 0;
      font-size: 15px;
      font-weight: 650;
    }

    .watch-heading { margin: 36px 0 15px; font-size: 20px; }
    .watchlist { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .watchpoint { min-width: 0; padding: 19px; background: #f8f6f0; border: 1px solid var(--line); border-radius: 14px; }
    .watch-top { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: start; }
    .watch-name { margin: 0; font-size: 15px; font-weight: 760; }
    .pill { padding: 4px 8px; border-radius: 99px; font-size: 9px; font-weight: 850; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
    .pill.tracking { color: #8d5c0d; background: var(--amber-soft); }
    .pill.resolved { color: var(--teal-dark); background: var(--teal-soft); }
    .pill.breached { color: #9b3733; background: var(--red-soft); }
    .pill.achieved { color: var(--teal-dark); background: var(--teal-soft); }
    .pill.revised, .pill.pending { color: #8d5c0d; background: var(--amber-soft); }
    .pill.missed, .pill.discontinued { color: #9b3733; background: var(--red-soft); }
    .pill.unclear { color: #5e6561; background: #e6e5e0; }
    .watch-desc { margin: 8px 0 17px; color: var(--muted); font-size: 13px; }
    .watch-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 18px; color: var(--muted); font-size: 11px; }
    .watch-meta b { color: var(--ink); }

    .evidence-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .evidence-tile { min-width: 0; padding: 22px; background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--line-dark); border-radius: 14px; }
    .evidence-tile.positive { border-left-color: var(--teal); }
    .evidence-tile.neutral { border-left-color: var(--amber); }
    .evidence-tile.negative { border-left-color: var(--red); }
    .evidence-top { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .evidence-period { color: var(--muted); font-family: ui-monospace, monospace; font-size: 11px; }
    .evidence-name { margin: 14px 0 6px; font-size: 16px; }
    .evidence-phrase { margin: 0; color: var(--muted); font-size: 13px; }
    blockquote { margin: 17px 0 0; padding: 14px 0 0 16px; color: #48504c; border-top: 1px solid var(--line); border-left: 2px solid var(--line-dark); font-family: Georgia, serif; font-size: 13px; }
    blockquote p { margin: 0; }
    blockquote cite { display: block; margin-top: 8px; color: var(--muted); font-family: Inter, sans-serif; font-size: 10px; font-style: normal; }

    .footnote { padding: 24px 48px; color: var(--muted); background: #edebe4; border-top: 1px solid var(--line); font-size: 12px; }
    .footnote strong { color: var(--ink); }

    footer {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: center;
      padding: 22px 48px;
      color: rgba(248,255,252,.63);
      background: #143d36;
      font-size: 11px;
    }

    .source-list { display: flex; flex-wrap: wrap; gap: 8px 18px; justify-content: end; }
    .source-list strong { color: #fff; font-family: ui-monospace, monospace; }

    /* Reference-density alignment: compact spacing and type scale from the
       approved HDFC Bank guidance-credibility scorecard. */
    .report {
      width: min(980px, calc(100% - 48px));
      margin: 28px auto 60px;
    }

    .hero { padding: 30px 32px; }
    .hero-top { gap: 30px; }
    .asset-line { margin-bottom: 4px; font-size: 11px; }
    .period { font-size: 11px; }
    .eyebrow { margin: 18px 0 8px; font-size: 11px; }
    .action-title {
      max-width: 720px;
      font-size: 27px;
      font-weight: 600;
      letter-spacing: -.015em;
      line-height: 1.2;
    }
    .verdict { margin-top: 8px; font-size: 14px; }
    .reasons { margin-top: 16px; }
    .reason { gap: 7px; padding: 7px 12px; font-size: 12.5px; }

    section { padding: 34px 32px 0; }
    .section-head { gap: 10px; margin-bottom: 14px; }
    .section-tag { margin-bottom: 0; font-size: 10.5px; }
    .section-title {
      font-family: Inter, ui-sans-serif, sans-serif;
      font-size: 16px;
      font-weight: 600;
      letter-spacing: 0;
      line-height: 1.3;
    }

    .headline-grid { gap: 12px; }
    .headline-card { padding: 18px 18px 16px; }
    .metric-label { gap: 7px; font-size: 10.5px; }
    .metric-value,
    .metric-value.mono {
      min-height: 0;
      margin: 10px 0 6px;
      font-size: 20px;
      font-weight: 600;
      line-height: 1.15;
    }
    .metric-sub { font-size: 12px; line-height: 1.4; }

    .edge-panel { padding: 22px 24px; border-radius: var(--radius); }
    .edge-top { padding-bottom: 16px; }
    .edge-badge { font-size: 10.5px; }
    .signals { font-size: 11px; }
    .edge-grid { gap: 14px; margin-top: 16px; }
    .edge-label { margin-bottom: 4px; font-size: 10px; }
    .edge-copy { font-size: 13px; line-height: 1.5; }
    .focus-row { gap: 10px; margin-top: 14px; padding-top: 14px; }
    .focus-chip { padding: 6px 12px; font-size: 12.5px; }
    .focus-tail { font-size: 12.5px; }

    .pattern-grid { gap: 10px; }
    .pattern-card {
      min-height: 0;
      grid-template-columns: minmax(0, 1fr) 90px;
      gap: 14px;
      padding: 15px 16px;
      border-radius: 12px;
    }
    .pattern-name { margin-bottom: 4px; font-size: 13.5px; }
    .pattern-meaning { font-size: 12px; line-height: 1.4; }
    .trend { font-size: 9.5px; }
    .spark { width: 90px; height: 32px; }

    .timeline { margin-top: 22px; }
    .timeline-point { padding: 18px 10px 0 0; }
    .timeline-label { min-height: 0; margin-bottom: 3px; font-size: 11px; line-height: 1.3; }
    .timeline-period { font-size: 10px; }

    .split-grid { gap: 14px; }
    .guidance-card { padding: 20px 22px; }
    .guidance-head { gap: 14px; }
    .guidance-title { font-size: 13px; }
    .guidance-sub { font-size: 11.5px; }
    .ratio { font-size: 13px; }
    progress { margin: 12px 0 14px; }
    .guidance-item { gap: 10px; padding: 8px 0; font-size: 11.5px; }
    .takeaway { margin-top: 14px; padding: 14px 0 0; font-size: 12.5px; }

    .watch-heading { margin: 24px 0 12px; font-size: 16px; }
    .watchlist { gap: 10px; }
    .watchpoint { padding: 13px 15px; border-radius: 10px; }
    .watch-name { font-size: 12.5px; }
    .watch-desc { margin: 5px 0 8px; font-size: 11.5px; line-height: 1.4; }
    .watch-meta { font-size: 10.5px; }

    .evidence-grid { gap: 10px; }
    .evidence-tile { padding: 13px 15px; border-radius: 10px; }
    .evidence-period { font-size: 10.5px; }
    .evidence-name { margin: 7px 0 4px; font-size: 13px; }
    .evidence-phrase { font-size: 11.5px; line-height: 1.4; }
    blockquote { margin-top: 10px; padding: 10px 0 0 12px; font-size: 12px; }
    blockquote cite { margin-top: 5px; font-size: 10px; }

    .footnote { padding: 18px 32px; font-size: 11.5px; }
    footer { padding: 18px 32px; font-size: 11px; }

    @media (max-width: 820px) {
      .report { width: min(100% - 20px, 1180px); margin: 10px auto 30px; border-radius: 18px; }
      .hero { padding: 28px 26px; }
      section { padding: 30px 26px 0; }
      .hero-top { grid-template-columns: 1fr; }
      .score-ring { width: 130px; grid-row: 1; justify-self: end; position: absolute; top: 28px; right: 26px; opacity: .33; }
      .score-value { font-size: 36px; }
      .eyebrow { margin-top: 28px; }
      .headline-grid, .split-grid, .evidence-grid { grid-template-columns: 1fr; }
      .edge-grid { grid-template-columns: 1fr; gap: 21px; }
      .pattern-grid { grid-template-columns: 1fr; }
      .pattern-card.full { grid-column: auto; }
      .watchlist { grid-template-columns: 1fr; }
      .footnote { padding: 18px 26px; }
      footer { padding: 18px 26px; align-items: start; flex-direction: column; }
      .source-list { justify-content: start; }
    }

    @media (max-width: 560px) {
      .report { width: 100%; margin: 0; border: 0; border-radius: 0; }
      .hero { padding: 26px 20px; }
      section { padding: 28px 20px 0; }
      .action-title { font-size: 27px; }
      .score-ring { display: none; }
      .section-head { align-items: start; flex-direction: column; }
      .pattern-card { grid-template-columns: 1fr; }
      .spark-wrap { flex-direction: row; align-items: center; }
      .timeline { display: block; margin: 6px 0 0 6px; }
      .timeline-point { min-height: 78px; padding: 0 0 22px 29px; border-top: 0; border-left: 1px solid var(--line-dark); }
      .timeline-point::before { top: 4px; left: -6px; }
      .timeline-label { min-height: auto; }
      .focus-row { align-items: start; flex-direction: column; }
      .edge-top { align-items: start; flex-direction: column; }
      .guidance-head { gap: 12px; }
      .footnote, footer { padding: 18px 20px; }
    }

    @media print {
      @page { size: A4; margin: 12mm; }
      body { background: #fff; }
      .report { width: 100%; margin: 0; border: 0; border-radius: 0; box-shadow: none; }
      section, .headline-card, .pattern-card, .guidance-card, .watchpoint, .evidence-tile { break-inside: avoid; }
    }

    /* Final reference alignment. These rules intentionally mirror the spacing
       hierarchy of the approved static scorecard instead of scaling everything
       down uniformly. */
    @media screen {
      :root {
        --paper: #f5f4ef;
        --surface: #ffffff;
        --surface-soft: #f0efe9;
        --ink: #141a21;
        --muted: #5c6570;
        --line: #e4e0d4;
        --line-dark: #c9c5ba;
        --teal: #0e9c86;
        --teal-dark: #0a6e5c;
        --teal-soft: #e3f4f0;
        --amber: #c07c12;
        --amber-soft: #fbf0dc;
        --red: #c43d34;
        --red-soft: #fbeae8;
        --radius: 14px;
      }

      body {
        background: var(--paper);
        color: var(--ink);
        font: 15px/1.5 'IBM Plex Sans', system-ui, sans-serif;
      }

      .report {
        width: 100%;
        max-width: 980px;
        margin: 0 auto;
        padding: 28px 24px 60px;
        overflow: visible;
        background: transparent;
        border: 0;
        border-radius: 0;
        box-shadow: none;
      }

      .topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--line);
      }
      .topline-brand {
        color: #9aa1a9;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .14em;
        text-transform: uppercase;
      }
      .topline-brand strong { color: var(--ink); }
      .topline-period {
        margin: 0;
        color: #9aa1a9;
        font: 500 11px/1.4 'IBM Plex Mono', monospace;
      }

      .hero {
        display: grid;
        grid-template-columns: 170px minmax(0, 1fr);
        gap: 30px;
        align-items: center;
        padding: 30px 32px;
        overflow: hidden;
        color: #fff;
        background: linear-gradient(145deg, #0d1b2b, #18304a);
        border-radius: 20px;
        position: relative;
      }
      .hero::after {
        position: absolute;
        inset: 0;
        background: radial-gradient(500px 220px at 92% -20%, rgba(14,156,134,.35), transparent 70%);
        content: "";
        pointer-events: none;
      }
      .hero-body, .score-ring { position: relative; z-index: 1; }
      .hero-top { display: contents; }
      .hero-body { min-width: 0; }
      .score-ring { width: 170px; grid-column: 1; grid-row: 1; }
      .score-ring::before { width: calc(100% - 24px); background: #13283d; }
      .score-value {
        color: #8ff0da;
        font-family: 'Fraunces', Georgia, serif;
        font-size: 52px;
        font-weight: 600;
        letter-spacing: 0;
      }
      .score-scale { margin-top: 4px; font-size: 10.5px; }
      .eyebrow {
        margin: 0;
        color: #8ff0da;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .14em;
      }
      .action-title {
        max-width: none;
        margin: 8px 0 2px;
        font-family: 'Fraunces', Georgia, serif;
        font-size: 27px;
        font-weight: 600;
        letter-spacing: 0;
        line-height: 1.2;
      }
      .verdict { max-width: none; margin: 0 0 16px; font-size: 14px; }
      .reasons { gap: 9px; margin-top: 0; }
      .reason { gap: 7px; padding: 7px 12px; font-size: 12.5px; font-weight: 500; }
      .reason-mark { width: auto; height: auto; background: transparent !important; font-size: 13px; }

      section { padding: 0; border: 0; }
      .section-head {
        display: flex;
        align-items: baseline;
        justify-content: flex-start;
        gap: 10px;
        margin: 34px 0 14px;
      }
      .section-head > div { display: flex; align-items: baseline; gap: 10px; }
      .section-tag {
        margin: 0;
        color: #9aa1a9;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .13em;
      }
      .section-title {
        margin: 0;
        font-family: 'IBM Plex Sans', system-ui, sans-serif;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: 0;
        line-height: 1.3;
      }

      .headline-grid { gap: 12px; }
      .headline-card { padding: 18px 18px 16px; border-radius: var(--radius); }
      .metric-label { gap: 7px; font-size: 10.5px; font-weight: 600; letter-spacing: .06em; }
      .metric-value, .metric-value.mono {
        min-height: 0;
        margin: 10px 0 6px;
        font-family: 'Fraunces', Georgia, serif;
        font-size: 20px;
        font-weight: 600;
        letter-spacing: 0;
        line-height: 1.2;
      }
      .metric-value.mono { font-family: 'IBM Plex Mono', monospace; }
      .metric-sub { font-size: 12px; line-height: 1.4; }

      .edge-panel { padding: 22px 24px; background: #0d1b2b; border-radius: var(--radius); }
      .edge-panel::after { display: none; }
      .edge-top { padding-bottom: 0; margin-bottom: 16px; border: 0; }
      .edge-badge { font-size: 10.5px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
      .signals { font-size: 11px; color: rgba(255,255,255,.45); }
      .edge-grid { grid-template-columns: 110px 1fr; gap: 11px 14px; margin-top: 0; }
      .edge-grid > div { display: contents; }
      .edge-label { margin: 0; padding-top: 2px; color: #8ba4fb; font-size: 10px; letter-spacing: .07em; }
      .edge-copy { margin: 0; font-size: 13px; line-height: 1.5; }
      .focus-row { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 14px; align-items: center; margin-top: 11px; padding-top: 0; border: 0; }
      .focus-label { grid-column: 1; padding-top: 1px; color: #8ba4fb; font-size: 10px; letter-spacing: .07em; }
      .focus-content { grid-column: 2; display: flex; flex-wrap: nowrap; gap: 12px; align-items: center; min-width: 0; }
      .focus-chip { flex: 0 1 auto; min-width: 0; margin: 0; padding: 6px 12px; color: #d9c9ff; background: rgba(106,86,216,.25); border: 1px solid rgba(199,169,255,.35); font-size: 12.5px; line-height: 1.35; }
      .focus-tail { flex: 1 1 180px; min-width: 0; font-size: 12px; line-height: 1.45; }

      .pattern-grid { gap: 10px; }
      .pattern-card {
        position: relative;
        grid-template-columns: 90px minmax(0, 1fr);
        min-height: 96px;
        gap: 14px;
        align-items: center;
        padding: 15px 16px;
        border-radius: 12px;
      }
      .pattern-card > div:first-child { grid-column: 2; padding-top: 23px; }
      .spark-wrap { grid-column: 1; grid-row: 1; align-items: center; justify-content: center; }
      .spark { width: 90px; height: 38px; }
      .trend {
        position: absolute;
        top: 15px;
        left: 120px;
        padding: 3px 8px;
        border-radius: 20px;
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: .04em;
      }
      .trend.steady { background: #f0efe9; }
      .trend.rising { background: var(--teal-soft); }
      .trend.new { background: #eef0ff; }
      .trend.mixed { background: var(--amber-soft); }
      .pattern-name { margin: 0 0 4px; font-size: 13.5px; font-weight: 600; }
      .pattern-meaning { font-size: 12px; line-height: 1.4; }

      .timeline-card {
        padding: 18px 18px 14px;
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
      }
      .timeline-scroll {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        overscroll-behavior-inline: contain;
        scrollbar-color: var(--line-dark) transparent;
        scrollbar-width: thin;
        -webkit-overflow-scrolling: touch;
      }
      .timeline-scroll::-webkit-scrollbar { height: 6px; }
      .timeline-scroll::-webkit-scrollbar-thumb { background: var(--line-dark); border-radius: 99px; }
      .timeline-plot {
        display: grid;
        grid-template-columns: 76px minmax(680px, 1fr);
        gap: 12px;
        min-width: 768px;
      }
      .timeline-y-axis {
        display: grid;
        grid-template-rows: repeat(3, 52px);
        gap: 7px;
        color: #8f9691;
        font-size: 10.5px;
      }
      .timeline-y-axis span { display: flex; align-items: center; }
      .timeline-stage { position: relative; height: 240px; }
      .timeline-band {
        position: absolute;
        right: 0;
        left: 0;
        height: 52px;
        border-radius: 8px;
      }
      .timeline-band.high { top: 0; background: #eaf5f1; }
      .timeline-band.developing { top: 59px; background: #fbf1df; }
      .timeline-band.lower { top: 118px; background: #fbeceb; }
      .timeline-baseline { position: absolute; top: 181px; right: 0; left: 0; height: 2px; background: var(--teal); }
      .timeline {
        position: absolute;
        inset: 0;
        display: grid;
        grid-auto-columns: minmax(136px, 1fr);
        grid-auto-flow: column;
        margin: 0;
        padding: 0;
        background: transparent;
        border: 0;
      }
      .timeline-point {
        --point-color: var(--teal);
        --point-y: 26px;
        position: relative;
        min-width: 136px;
        height: 240px;
        padding: 0 7px;
        text-align: center;
        border: 0;
      }
      .timeline-point.amber { --point-color: var(--amber); --point-y: 85px; }
      .timeline-point.red { --point-color: var(--red); --point-y: 144px; }
      .timeline-point::after {
        position: absolute;
        z-index: 1;
        top: calc(var(--point-y) - 1px);
        left: 50%;
        width: 100%;
        height: 2px;
        background: var(--point-color);
        content: "";
      }
      .timeline-point:last-child::after { display: none; }
      .timeline-point::before {
        position: absolute;
        z-index: 2;
        top: calc(var(--point-y) - 8px);
        left: calc(50% - 8px);
        width: 16px;
        height: 16px;
        background: var(--point-color);
        border: 3px solid #fff;
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgba(14, 156, 134, .22);
        content: "";
      }
      .timeline-point.amber::before { box-shadow: 0 0 0 4px rgba(192, 124, 18, .2); }
      .timeline-point.red::before { box-shadow: 0 0 0 4px rgba(196, 61, 52, .18); }
      .timeline-label {
        position: absolute;
        top: 191px;
        right: 5px;
        left: 5px;
        min-height: 0;
        margin: 0;
        font-size: 11px;
        font-weight: 600;
        line-height: 1.25;
      }
      .timeline-period {
        position: absolute;
        top: 221px;
        right: 5px;
        left: 5px;
        margin: 0;
        color: #9aa1a9;
        font-size: 9.5px;
      }
      .timeline-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 20px;
        margin-top: 12px;
        color: #8f9691;
        font-size: 10.5px;
      }
      .legend-item { display: inline-flex; gap: 7px; align-items: center; }
      .legend-dot { width: 8px; height: 8px; background: var(--teal); border-radius: 50%; }
      .legend-dot.amber { background: var(--amber); }
      .legend-dot.red { background: var(--red); }

      .breakdown-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; align-items: stretch; }
      .control-panel, .watch-panel { padding: 20px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
      .panel-head { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; margin-bottom: 18px; }
      .panel-title { margin: 0; font-size: 14px; font-weight: 650; }
      .panel-kicker { margin: 0; color: #9aa1a9; font-size: 9.5px; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }
      .guidance-group + .guidance-group { margin-top: 18px; }
      .guidance-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; margin-bottom: 6px; }
      .guidance-title { margin: 0; font-size: 13px; font-weight: 600; }
      .guidance-sub { display: none; }
      .ratio { font: 600 13px/1.4 'IBM Plex Mono', monospace; color: var(--teal); }
      .guidance-group.amber .ratio { color: var(--amber); }
      progress { height: 6px; margin: 0 0 10px; }
      .guidance-group.amber progress::-webkit-progress-value { background: var(--amber); }
      .guidance-group.amber progress::-moz-progress-bar { background: var(--amber); }
      .guidance-items { display: flex; flex-wrap: wrap; gap: 6px; }
      .guidance-item {
        display: inline-flex;
        grid-template-columns: none;
        gap: 0;
        align-items: center;
        padding: 4px 9px;
        color: var(--teal-dark);
        background: var(--teal-soft);
        border: 1px solid #bfe3d8;
        border-radius: 99px;
        font-size: 11px;
        line-height: 1.4;
      }
      .guidance-item.pending, .guidance-item.missed { color: var(--muted); background: #f0efe9; border-color: var(--line); }
      .item-status { display: none; }
      .takeaway { margin: 16px 0 0; padding: 14px 0 0; color: var(--muted); background: transparent; border: 0; border-top: 1px solid var(--line); border-radius: 0; font-size: 12.5px; font-weight: 400; line-height: 1.5; }

      .watch-heading { display: none; }
      .watchlist { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
      .watchpoint { padding: 10px 13px; background: var(--amber-soft); border: 0; border-left: 3px solid var(--amber); border-radius: 8px; }
      .watch-top { display: flex; align-items: start; justify-content: space-between; gap: 8px; }
      .watch-name { font-size: 12.5px; font-weight: 600; }
      .watch-desc { margin: 3px 0 6px; font-size: 11.5px; line-height: 1.4; }
      .watch-meta { justify-content: flex-start; gap: 10px; color: #9aa1a9; font-size: 10.5px; }
      .watch-meta b { color: var(--muted); }

      .evidence-grid { gap: 10px; }
      .evidence-tile { padding: 13px 15px; border-left-width: 3px; border-radius: 10px; }
      .evidence-top { justify-content: space-between; margin-bottom: 5px; }
      .evidence-period { color: #9aa1a9; font-size: 10.5px; font-weight: 700; }
      .evidence-name { margin: 0 0 4px; font-size: 13px; font-weight: 600; }
      .evidence-phrase { font-size: 11.5px; line-height: 1.4; }
      .pill { display: inline-flex; padding: 3px 8px; font-size: 9.5px; font-weight: 700; letter-spacing: .04em; }
      blockquote { margin: 10px 0 0; padding: 9px 0 0 12px; color: #48504c; border-top: 1px solid var(--line); border-left: 2px solid var(--line-dark); font-size: 11.5px; line-height: 1.45; }
      blockquote cite { margin-top: 5px; font-size: 9.5px; }

      .footnote { margin-top: 36px; padding: 16px 0 0; color: #9aa1a9; background: transparent; border: 0; border-top: 1px solid var(--line); font-size: 11.5px; line-height: 1.5; }
      .footnote strong { color: var(--muted); }
      footer { margin-top: 16px; padding: 0; color: #9aa1a9; background: transparent; font-size: 10.5px; }
      .source-list strong { color: var(--muted); }
    }

    @media screen and (max-width: 760px) {
      .report { padding: 20px 16px 40px; }
      .topline { align-items: flex-start; flex-direction: column; gap: 4px; }
      .hero { grid-template-columns: 1fr; padding: 26px 20px; text-align: center; }
      .hero-top { display: contents; }
      .score-ring { display: grid; width: 150px; margin: 0 auto; grid-column: 1; grid-row: auto; order: -1; }
      .reasons { justify-content: center; }
      .section-head, .section-head > div { align-items: flex-start; flex-direction: column; gap: 3px; }
      .headline-grid, .pattern-grid, .breakdown-grid, .evidence-grid { grid-template-columns: 1fr; }
      .pattern-card.full { grid-column: auto; }
      .edge-grid { grid-template-columns: 88px 1fr; }
      .edge-top { flex-direction: row; align-items: center; }
      .focus-row { grid-template-columns: 88px 1fr; }
      .watchlist { grid-template-columns: 1fr; }
    }

    @media screen and (max-width: 480px) {
      .report { padding-inline: 12px; }
      .action-title { font-size: 24px; }
      .headline-grid { grid-template-columns: 1fr; }
      .pattern-card { grid-template-columns: 72px 1fr; }
      .spark { width: 72px; }
      .trend { left: 102px; }
      .control-panel, .watch-panel { padding: 16px; }
    }
  </style>
</head>
<body>
  <main class="report">
    <div class="topline">
      <div class="topline-brand">Guidance Credibility · <strong>{{asset_name}}</strong></div>
      <p class="topline-period">{{period_start}} → {{period_end}}</p>
    </div>
    <header class="hero">
      <div class="hero-top">
        <div class="hero-body">
          <p class="eyebrow">{{hero.eyebrow}}</p>
          <h1 class="action-title">{{hero.action_title}}</h1>
          <p class="verdict">{{hero.verdict}}</p>
          {{#if hero.reasons}}
          <div class="reasons">
            {{#each hero.reasons}}
            <div class="reason"><span class="reason-mark {{mark}}" aria-hidden="true"></span><span>{{text}}</span></div>
            {{/each}}
          </div>
          {{/if}}
        </div>
        <div class="score-ring {{score_badge.status_color}}" role="img" aria-label="Score {{score_badge.score}} out of {{score_badge.scale}}">
          <div class="score-copy">
            <span class="score-value">{{score_badge.score}}</span>
            <span class="score-scale">out of {{score_badge.scale}}</span>
          </div>
        </div>
      </div>
    </header>

    {{#if headline.cards}}
    <section class="headline-section">
      <div class="section-head">
        <div>
          <p class="section-tag">{{headline.section_tag}}</p>
          <h2 class="section-title">{{headline.section_title}}</h2>
        </div>
      </div>
      <div class="headline-grid">
        {{#each headline.cards}}
        <article class="headline-card">
          <p class="metric-label"><span class="dot {{dot}}"></span>{{label}}</p>
          <div class="metric-value {{value_color}}{{#if value_mono}} mono{{/if}}">
            {{#each value_lines}}<span class="value-line">{{this}}</span>{{/each}}
          </div>
          <p class="metric-sub">{{sub}}</p>
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if edge}}
    <section class="edge-section">
      <div class="section-head">
        <div>
          <p class="section-tag">{{edge.section_tag}}</p>
          <h2 class="section-title">{{edge.section_title}}</h2>
        </div>
      </div>
      <div class="edge-panel">
        <div class="edge-top"><span class="edge-badge">{{edge.badge}}</span><span class="signals">{{edge.signals_parsed}} signals parsed</span></div>
        <div class="edge-grid">
          <div><p class="edge-label">Behaviour</p><p class="edge-copy">{{edge.behaviour}}</p></div>
          <div><p class="edge-label">Implication</p><p class="edge-copy">{{edge.implication}}</p></div>
        </div>
        {{#if edge.investor_focus}}
        <div class="focus-row">
          <p class="focus-label">Investor focus</p>
          <div class="focus-content"><span class="focus-chip">{{edge.investor_focus.chip}}</span><span class="focus-tail">{{edge.investor_focus.tail}}</span></div>
        </div>
        {{/if}}
      </div>
    </section>
    {{/if}}

    {{#if patterns.cards}}
    <section class="patterns-section">
      <div class="section-head">
        <div>
          <p class="section-tag">{{patterns.section_tag}}</p>
          <h2 class="section-title">{{patterns.section_title}}</h2>
        </div>
      </div>
      <div class="pattern-grid">
        {{#each patterns.cards}}
        <article class="pattern-card{{#if full_width}} full{{/if}}">
          <div><h3 class="pattern-name">{{name}}</h3><p class="pattern-meaning">{{meaning}}</p></div>
          <div class="spark-wrap">
            <span class="trend {{trend}}">{{trend}}</span>
            <svg class="spark" viewBox="0 0 110 46" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <polyline points="{{trendSparkPoints trend}}" fill="none" stroke="{{trendHex trend}}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
              <circle cx="104" cy="{{trendSparkEndY trend}}" r="3.5" fill="{{trendHex trend}}"/>
            </svg>
          </div>
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if credibility_timeline.points}}
    <section class="timeline-section">
      <div class="section-head">
        <div>
          <p class="section-tag">{{credibility_timeline.section_tag}}</p>
          <h2 class="section-title">{{credibility_timeline.section_title}}</h2>
        </div>
      </div>
      <div class="timeline-card">
        <div class="timeline-scroll" tabindex="0" role="region" aria-label="Horizontally scrollable guidance credibility timeline">
          <div class="timeline-plot">
            <div class="timeline-y-axis" aria-hidden="true"><span>High</span><span>Developing</span><span>Lower</span></div>
            <div class="timeline-stage">
              <div class="timeline-band high"></div>
              <div class="timeline-band developing"></div>
              <div class="timeline-band lower"></div>
              <div class="timeline-baseline"></div>
              <div class="timeline">
                {{#each credibility_timeline.points}}
                <article class="timeline-point {{tone}}"><p class="timeline-label">{{label}}</p><p class="timeline-period">{{period}}</p></article>
                {{/each}}
              </div>
            </div>
          </div>
        </div>
        <div class="timeline-legend" aria-label="Credibility level legend">
          <span class="legend-item"><span class="legend-dot"></span>High credibility</span>
          <span class="legend-item"><span class="legend-dot amber"></span>Developing</span>
          <span class="legend-item"><span class="legend-dot red"></span>Lower</span>
        </div>
      </div>
    </section>
    {{/if}}

    {{#if split}}
    <section class="breakdown-section">
      <div class="section-head">
        <div>
          <p class="section-tag">{{split.section_tag}}</p>
          <h2 class="section-title">{{split.section_title}}</h2>
        </div>
      </div>
      <div class="breakdown-grid">
        <article class="control-panel">
          <div class="panel-head"><h3 class="panel-title">Controllability breakdown</h3><p class="panel-kicker">Detailed field</p></div>
          {{#if split.controllable}}
          <div class="guidance-group {{split.controllable.color}}">
          <div class="guidance-head"><div><h3 class="guidance-title">{{split.controllable.title}}</h3><p class="guidance-sub">{{split.controllable.sub}}</p></div><div class="ratio">{{split.controllable.credible}} / {{split.controllable.total}}</div></div>
          <progress value="{{split.controllable.credible}}" max="{{split.controllable.total}}" aria-label="{{split.controllable.credible}} of {{split.controllable.total}} credible"></progress>
          <ul class="guidance-items">
            {{#each split.controllable.items}}<li class="guidance-item {{status}}"><span>{{text}}</span><span class="item-status {{status}}">{{status}}</span></li>{{/each}}
          </ul>
          </div>
          {{/if}}
          {{#if split.demand_led}}
          <div class="guidance-group {{split.demand_led.color}}">
          <div class="guidance-head"><div><h3 class="guidance-title">{{split.demand_led.title}}</h3><p class="guidance-sub">{{split.demand_led.sub}}</p></div><div class="ratio">{{split.demand_led.credible}} / {{split.demand_led.total}}</div></div>
          <progress value="{{split.demand_led.credible}}" max="{{split.demand_led.total}}" aria-label="{{split.demand_led.credible}} of {{split.demand_led.total}} credible"></progress>
          <ul class="guidance-items">
            {{#each split.demand_led.items}}<li class="guidance-item {{status}}"><span>{{text}}</span><span class="item-status {{status}}">{{status}}</span></li>{{/each}}
          </ul>
          </div>
          {{/if}}
          {{#if split.takeaway}}<p class="takeaway">{{split.takeaway}}</p>{{/if}}
        </article>

        {{#if watchpoints}}
        <aside class="watch-panel">
          <div class="panel-head"><h3 class="panel-title">Open promises · watch next</h3><p class="panel-kicker">{{watchpoints.length}} live commitments</p></div>
          <div class="watchlist">
            {{#each watchpoints}}
            <article class="watchpoint">
              <div class="watch-top"><h4 class="watch-name">{{name}}</h4><span class="pill {{status}}">{{status}}</span></div>
              <p class="watch-desc">{{desc}}</p>
              <div class="watch-meta"><span><b>Resolves</b> {{resolves}}</span><span><b>Type</b> {{type}}</span></div>
            </article>
            {{/each}}
          </div>
        </aside>
        {{/if}}
      </div>
    </section>
    {{/if}}

    {{#if evidence.tiles}}
    <section class="evidence-section">
      <div class="section-head">
        <div>
          <p class="section-tag">{{evidence.section_tag}}</p>
          <h2 class="section-title">{{evidence.section_title}}</h2>
        </div>
      </div>
      <div class="evidence-grid">
        {{#each evidence.tiles}}
        <article class="evidence-tile {{effect}}">
          <div class="evidence-top"><span class="evidence-period">{{period}}</span><span class="pill {{status}}">{{status}}</span></div>
          <h3 class="evidence-name">{{name}}</h3>
          <p class="evidence-phrase">{{phrase}}</p>
          {{#if source.quote}}<blockquote><p>“{{source.quote}}”</p>{{#if source.meta}}<cite>{{source.meta}}</cite>{{/if}}</blockquote>{{/if}}
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if footnote}}
    <div class="footnote"><strong>{{footnote.lead}}</strong> {{footnote.text}}</div>
    {{/if}}

    {{#if footer}}
    <footer>
      <span>Computed {{footer.computed_date}} · {{footer.n_periods}} periods</span>
      {{#if footer.sources}}<div class="source-list">{{#each footer.sources}}<span><strong>{{count}}</strong> {{label}}</span>{{/each}}</div>{{/if}}
    </footer>
    {{/if}}
  </main>
</body>
</html>
