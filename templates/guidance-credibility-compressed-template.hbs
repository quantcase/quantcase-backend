<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guidance Credibility — {{asset_name}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink:#1c1c1a;
      --muted:#6c6c68;
      --faint:#9a9a96;
      --line:#e8e7e3;
      --line2:#f0efeb;
      --card:#fafaf8;
      --bg:#fff;
      --green:#1c7a4d;
      --green-d:#155f3c;
      --green-bg:#eef5f0;
      --green-bd:#cfe5d8;
      --red:#bb3a32;
      --red-bg:#fbeeed;
      --amber:#b1750f;
      --amber-d:#8f5d0a;
      --amber-bg:#fbf3e3;
      --amber-bd:#ecd9b5;
      --blue:#4f6ef7;
      --blue-bg:#eef0ff;
      --blue-bd:#d0d8fd;
      --navy:#1a1f3a;
      --navy2:#2a3060;
      --radius:10px;
    }

    * { box-sizing:border-box; }
    body {
      margin:0;
      background:var(--bg);
      color:var(--ink);
      font:15px/1.55 Inter,system-ui,sans-serif;
      -webkit-font-smoothing:antialiased;
    }
    .serif,.score-num,.metric-value,.watch-name,.qci-title { font-family:Lora,Georgia,serif; }
    .wrap { max-width:1180px; margin:auto; padding:34px 40px 64px; }

    .top { display:flex; justify-content:space-between; border-bottom:1px solid var(--line); padding-bottom:20px; }
    .lens-row { display:flex; align-items:center; flex-wrap:wrap; gap:10px; }
    .eyebrow,.section-kicker {
      color:var(--faint);
      font-size:11.5px;
      font-weight:600;
      letter-spacing:.13em;
      text-transform:uppercase;
    }
    .title { margin:18px 0 0; font:600 36px/1.2 Lora,Georgia,serif; }
    .view-pill { padding:4px 10px; color:#3652d9; background:var(--blue-bg); border:1px solid var(--blue-bd); border-radius:6px; font-size:10px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; }
    .pill { display:inline-flex; align-items:center; padding:4px 11px; border:1px solid; border-radius:6px; font-size:11px; font-weight:700; letter-spacing:.06em; line-height:1.35; text-transform:uppercase; white-space:nowrap; }
    .pill.strong,.pill.achieved { color:var(--green-d); background:var(--green-bg); border-color:var(--green-bd); }
    .pill.green,.pill.teal { color:var(--green-d); background:var(--green-bg); border-color:var(--green-bd); }
    .pill.amber { color:var(--amber-d); background:var(--amber-bg); border-color:var(--amber-bd); }
    .pill.red { color:var(--red); background:var(--red-bg); border-color:#f0d4d1; }
    .pill.tracking { color:var(--amber-d); background:var(--amber-bg); border-color:var(--amber-bd); }
    .xbtn { width:38px; height:38px; border:1px solid var(--line); border-radius:9px; background:#fff; color:var(--faint); font-size:20px; }

    .score-summary { display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:18px; align-items:center; margin-top:22px; }
    .score-ring { position:relative; width:72px; height:72px; }
    .score-ring svg { display:block; }
    .score-num { position:absolute; inset:0; display:grid; place-items:center; font-size:22px; font-weight:600; }
    .score-ring.green,.score-ring.teal { color:var(--green); }
    .score-ring.amber { color:var(--amber); }
    .score-ring.red { color:var(--red); }
    .score-progress { stroke:currentColor; }
    .score-ring.green .score-num,.score-ring.teal .score-num { color:var(--green-d); }
    .score-ring.amber .score-num { color:var(--amber-d); }
    .score-ring.red .score-num { color:var(--red); }
    .score-copy strong { display:block; color:var(--green-d); font-size:12px; letter-spacing:.1em; text-transform:uppercase; }
    .score-copy p { max-width:760px; margin:5px 0 0; color:var(--muted); font-size:13.5px; }
    .reason-row { display:flex; flex-wrap:wrap; gap:6px; margin-top:9px; }
    .reason-chip { padding:3px 8px; border-radius:99px; font-size:9.5px; font-weight:600; }
    .reason-chip.ok { color:var(--green-d); background:var(--green-bg); }
    .reason-chip.no { color:var(--red); background:var(--red-bg); }
    .reason-chip.ok::before { content:"✓\00a0"; }
    .reason-chip.no::before { content:"×\00a0"; }
    .score-facts { display:flex; gap:7px; }
    .fact { min-width:86px; padding:10px 12px; background:var(--card); border:1px solid var(--line); border-radius:8px; text-align:center; }
    .fact b { display:block; color:var(--green-d); font:600 18px Lora,Georgia,serif; }
    .fact span { color:var(--faint); font-size:9.5px; letter-spacing:.07em; text-transform:uppercase; }

    .section { margin-top:42px; }
    .section-head { display:flex; justify-content:space-between; align-items:end; gap:24px; margin-bottom:16px; }
    .section-title { margin:5px 0 0; font-size:20px; line-height:1.25; }
    .section-note { max-width:540px; color:var(--faint); font-size:12.5px; text-align:right; }

    .headline-grid { display:grid; grid-template-columns:repeat(var(--count,3),1fr); overflow:hidden; background:var(--card); border:1px solid var(--line); border-radius:var(--radius); }
    .metric-card { padding:20px 22px; border-right:1px solid var(--line); }
    .metric-card:last-child { border:0; }
    .metric-label { display:flex; align-items:center; gap:8px; color:var(--muted); font-size:11px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; }
    .dot { width:8px; height:8px; border-radius:50%; }
    .dot.green,.dot.teal,.dot.g { background:var(--green); }
    .dot.amber,.dot.a { background:var(--amber); }
    .dot.red,.dot.r { background:var(--red); }
    .metric-value { margin:10px 0 5px; font-size:24px; font-weight:600; }
    .metric-value.g,.metric-value.green,.metric-value.teal { color:var(--green-d); }
    .metric-value.a,.metric-value.amber { color:var(--amber-d); }
    .metric-value.r,.metric-value.red { color:var(--red); }
    .mono { font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; }
    .metric-card p { margin:0; color:var(--muted); font-size:12px; }

    .qci { overflow:hidden; margin-top:44px; background:#fcfcff; border:1px solid var(--blue-bd); border-radius:14px; }
    .qci-header { position:relative; overflow:hidden; padding:24px 28px 22px; color:#fff; background:linear-gradient(135deg,var(--navy),var(--navy2)); }
    .qci-header::before { position:absolute; width:200px; height:200px; right:-45px; top:-70px; background:rgba(139,164,251,.08); border-radius:50%; content:""; }
    .qci-top { position:relative; display:flex; justify-content:space-between; align-items:center; gap:20px; }
    .qci-badge { display:inline-flex; align-items:center; gap:8px; padding:5px 12px; color:#a9bafa; background:rgba(79,110,247,.12); border:1px solid rgba(139,164,251,.35); border-radius:99px; font-size:10.5px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
    .qci-badge i { width:6px; height:6px; background:#8ba4fb; border-radius:50%; }
    .qci-count { color:#8ba4fb; font-size:11px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; }
    .qci-title { position:relative; margin:17px 0 4px; font-size:25px; font-weight:500; }
    .qci-sub { position:relative; max-width:760px; margin:0; color:rgba(255,255,255,.6); font-size:12.5px; }
    .qci-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); }
    .pattern { display:grid; grid-template-columns:105px 1fr; gap:13px; align-items:center; min-width:0; padding:17px 18px; background:#fff; }
    .pattern svg { width:105px; height:48px; }
    .pattern svg.steady { color:#9a9a96; }
    .pattern svg.rising { color:var(--green); }
    .pattern svg.new { color:var(--blue); }
    .pattern svg.mixed { color:var(--amber); }
    .pattern-status { display:inline-flex; padding:3px 8px; border-radius:20px; font-size:9.5px; font-weight:700; text-transform:uppercase; }
    .pattern-status.steady { color:var(--muted); background:var(--line2); }
    .pattern-status.rising { color:var(--green-d); background:var(--green-bg); }
    .pattern-status.new { color:var(--blue); background:var(--blue-bg); }
    .pattern-status.mixed { color:var(--amber-d); background:var(--amber-bg); }
    .pattern-status.steady::before { content:"—\00a0"; }
    .pattern-status.rising::before { content:"▲\00a0"; }
    .pattern-status.new::before { content:"●\00a0"; }
    .pattern-status.mixed::before { content:"◆\00a0"; }
    .pattern:nth-child(n+4) { display:none; }
    .pattern h3 { margin:5px 0 2px; font-size:12.5px; line-height:1.3; }
    .pattern p { margin:0; color:var(--faint); font-size:10.5px; line-height:1.4; }
    .pattern p { display:-webkit-box; overflow:hidden; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
    .qci-edge { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:rgba(255,255,255,.1); color:rgba(255,255,255,.82); }
    .edge-item { padding:15px 18px; background:linear-gradient(120deg,#1a1f3a,#202660); font-size:11.5px; }
    .edge-item b { display:block; margin-bottom:4px; color:#8ba4fb; font-size:9.5px; letter-spacing:.09em; text-transform:uppercase; }

    .timeline-card { padding:18px 20px 16px; background:var(--card); border:1px solid var(--line); border-radius:var(--radius); }
    .timeline-scroll { overflow-x:auto; }
    .timeline-visual { min-width:820px; }
    .timeline-plot { display:grid; grid-template-columns:74px minmax(0,1fr); gap:20px; }
    .timeline-axis { display:grid; grid-template-rows:repeat(3,38px); gap:4px; color:var(--faint); font-size:10px; }
    .timeline-axis span { display:flex; align-items:center; }
    .timeline-bands { position:relative; height:122px; }
    .timeline-band { position:absolute; left:0; right:0; height:38px; border-radius:6px; }
    .timeline-band.high { top:0; background:var(--green-bg); }
    .timeline-band.developing { top:42px; background:var(--amber-bg); }
    .timeline-band.lower { top:84px; background:var(--red-bg); }
    .timeline-track { position:absolute; left:0; right:0; top:18px; height:2px; background:var(--green); opacity:.85; }
    .timeline-points { position:absolute; inset:0; display:grid; grid-auto-flow:column; grid-auto-columns:1fr; }
    .timeline-point { --point-y:19px; --point-color:var(--green); position:relative; min-width:0; }
    .timeline-point.teal,.timeline-point.green { --point-y:19px; --point-color:var(--green); }
    .timeline-point.amber,.timeline-point.developing { --point-y:61px; --point-color:var(--amber); }
    .timeline-point.red,.timeline-point.lower { --point-y:103px; --point-color:var(--red); }
    .timeline-dot { position:absolute; top:var(--point-y); left:50%; width:18px; height:18px; background:var(--point-color); border:3px solid #fff; border-radius:50%; box-shadow:0 0 0 5px rgba(28,122,77,.16); transform:translate(-50%,-50%); }
    .timeline-point.amber .timeline-dot,.timeline-point.developing .timeline-dot { box-shadow:0 0 0 5px rgba(177,117,15,.16); }
    .timeline-point.red .timeline-dot,.timeline-point.lower .timeline-dot { box-shadow:0 0 0 5px rgba(187,58,50,.16); }
    .timeline-point:nth-child(n+2) .timeline-dot { width:19px; height:19px; }
    .timeline-point:nth-child(n+3) .timeline-dot { width:20px; height:20px; }
    .timeline-point:nth-child(n+5) .timeline-dot { width:22px; height:22px; }
    .timeline-events { display:grid; grid-auto-flow:column; grid-auto-columns:1fr; min-width:820px; margin-top:3px; padding-left:94px; }
    .timeline-event { padding:9px 10px 0; border-top:2px solid var(--green); text-align:center; }
    .timeline-event.amber,.timeline-event.developing { border-color:var(--amber); }
    .timeline-event.red,.timeline-event.lower { border-color:var(--red); }
    .timeline-bands:has(.timeline-point.amber,.timeline-point.red,.timeline-point.developing,.timeline-point.lower) .timeline-track { display:none; }
    .timeline-event b { display:block; font-size:10.5px; line-height:1.3; }
    .timeline-event span { color:var(--faint); font-size:9.5px; }
    .timeline-legend { display:flex; flex-wrap:wrap; align-items:center; gap:10px 20px; margin-top:14px; color:var(--faint); font-size:10.5px; }
    .legend-dot { display:inline-block; width:8px; height:8px; margin-right:5px; border-radius:50%; }
    .confidence-key { margin-left:auto; }

    .balance-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:stretch; }
    .balance-panel { display:flex; flex-direction:column; min-width:0; padding:22px 24px; background:var(--card); border:1px solid var(--line); border-radius:var(--radius); }
    .panel-title { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; }
    .panel-title h3 { margin:0; font-size:14px; }
    .panel-title span { color:var(--faint); font-size:10px; letter-spacing:.08em; text-transform:uppercase; }
    .control-group + .control-group { margin-top:18px; }
    .control-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:7px; }
    .control-top b { font-size:12.5px; }
    .ratio { font:700 12.5px Inter; }
    .ratio.green { color:var(--green); }
    .ratio.amber { color:var(--amber); }
    .bar { height:7px; margin-bottom:10px; overflow:hidden; background:#eeeeea; border-radius:99px; }
    .bar > i { display:block; height:100%; border-radius:inherit; }
    .chip-row { display:flex; flex-wrap:wrap; gap:6px; }
    .chip { padding:4px 9px; color:var(--green-d); background:var(--green-bg); border:1px solid var(--green-bd); border-radius:99px; font-size:10.5px; }
    .chip.pending { color:var(--muted); background:#f0efeb; border-color:#deddd8; }
    .takeaway { margin-top:auto; padding-top:16px; border-top:1px solid var(--line); color:var(--muted); font-size:12px; }
    .watch-grid { display:grid; grid-template-columns:1fr 1fr; gap:9px; flex:1; }
    .watch-card { display:flex; flex-direction:column; min-width:0; padding:11px 12px; background:var(--amber-bg); border-left:3px solid var(--amber); border-radius:7px; }
    .watch-top { display:flex; justify-content:space-between; gap:8px; }
    .watch-name { font-size:11.5px; font-weight:600; line-height:1.3; }
    .watch-status { color:var(--amber-d); font-size:8.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; }
    .watch-card p { margin:4px 0 7px; color:var(--muted); font-size:9.5px; line-height:1.35; }
    .watch-meta { margin-top:auto; color:var(--faint); font-size:8.5px; }

    .evidence-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:10px; }
    .evidence { position:relative; min-width:0; padding:14px 15px 13px; background:var(--card); border:1px solid var(--line); border-radius:8px; }
    .evidence::before { position:absolute; left:-1px; top:10px; bottom:10px; width:3px; background:var(--green); border-radius:3px; content:""; }
    .evidence.amber::before,.evidence.neutral::before { background:var(--amber); }
    .evidence.red::before,.evidence.negative::before { background:var(--red); }
    .evidence-top { display:flex; justify-content:space-between; align-items:center; gap:8px; }
    .evidence-period { color:var(--faint); font-size:9.5px; font-weight:600; }
    .mini-status { padding:3px 7px; color:var(--green-d); background:var(--green-bg); border-radius:20px; font-size:8px; font-weight:700; text-transform:uppercase; }
    .mini-status.tracking,.mini-status.pending,.mini-status.revised { color:var(--amber-d); background:var(--amber-bg); }
    .mini-status.missed,.mini-status.breached,.mini-status.discontinued { color:var(--red); background:var(--red-bg); }
    .evidence h3 { margin:9px 0 3px; font-size:12px; }
    .evidence p { margin:0; color:var(--muted); font-size:10.5px; line-height:1.4; }

    .foot { margin-top:40px; padding-top:16px; color:var(--faint); border-top:1px solid var(--line); font-size:11px; }
    .foot b { color:var(--muted); }

    @media (max-width:900px) {
      .wrap { padding:24px 20px 48px; }
      .score-summary { grid-template-columns:auto 1fr; }
      .score-facts { grid-column:1/-1; }
      .headline-grid,.qci-grid,.qci-edge,.evidence-grid { grid-template-columns:1fr; }
      .metric-card { border-right:0; border-bottom:1px solid var(--line); }
      .balance-grid { grid-template-columns:1fr; }
      .section-head { align-items:start; flex-direction:column; gap:5px; }
      .section-note { text-align:left; }
    }
    @media (max-width:560px) {
      .title { font-size:29px; }
      .score-summary { grid-template-columns:1fr; }
      .score-ring { margin:0 auto; }
      .score-copy { text-align:center; }
      .score-facts { justify-content:center; }
      .pattern { grid-template-columns:88px 1fr; }
      .pattern svg { width:88px; }
      .watch-grid { grid-template-columns:1fr; }
    }
  </style>
</head>
<body>
<main class="wrap">
  <header class="top">
    <div>
      <div class="lens-row">
        <span class="eyebrow">{{lens}}</span>
        <span class="pill {{score_badge.status_color}}">{{score_badge.rating}} credibility</span>
        <span class="view-pill">Summary view</span>
      </div>
      <h1 class="title">Guidance Credibility</h1>
    </div>
    <button class="xbtn" aria-label="Close">×</button>
  </header>

  <section class="score-summary" data-asset="{{asset_name}}" data-period-start="{{period_start}}" data-period-end="{{period_end}}" data-action="{{hero.action_title}}">
    <div class="score-ring {{score_badge.status_color}}" style="--score:{{score_badge.score}}" aria-label="Credibility score {{score_badge.score}} out of {{score_badge.scale}}">
      <svg width="72" height="72" aria-hidden="true">
        <circle cx="36" cy="36" r="30" fill="none" stroke="#f0efeb" stroke-width="7"/>
        <circle class="score-progress" cx="36" cy="36" r="30" pathLength="100" fill="none" stroke-width="7" stroke-linecap="round" stroke-dasharray="100" style="stroke-dashoffset:calc(100 - var(--score))" transform="rotate(-90 36 36)"/>
      </svg>
      <span class="score-num">{{score_badge.score}}</span>
    </div>
    <div class="score-copy">
      <strong>{{hero.eyebrow}}</strong>
      <p>{{hero.verdict}}</p>
      {{#if hero.reasons}}<div class="reason-row">{{#each hero.reasons}}<span class="reason-chip {{mark}}">{{text}}</span>{{/each}}</div>{{/if}}
    </div>
    <div class="score-facts">
      <div class="fact"><b>{{split.controllable.credible}}/{{split.controllable.total}}</b><span>Controllable</span></div>
      <div class="fact"><b>{{split.demand_led.credible}}/{{split.demand_led.total}}</b><span>Demand-led</span></div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div><span class="section-kicker">{{headline.section_tag}}</span><h2 class="section-title">What moves the score</h2></div>
      <div class="section-note">Three metrics carry the decision; detail remains available in the full view.</div>
    </div>
    <div class="headline-grid" style="--count:{{headline.cards.length}}">
      {{#each headline.cards}}
      <article class="metric-card"><div class="metric-label"><span class="dot {{dot}}"></span>{{label}}</div><div class="metric-value {{value_color}}{{#if value_mono}} mono{{/if}}">{{#each value_lines}}{{this}}{{#unless @last}}<br>{{/unless}}{{/each}}</div><p>{{sub}}</p></article>
      {{/each}}
    </div>
  </section>

  <section class="qci" data-pattern-tag="{{patterns.section_tag}}" data-pattern-section="{{patterns.section_title}}" data-edge-tag="{{edge.section_tag}}" data-edge-title="{{edge.section_title}}">
    <div class="qci-header">
      <div class="qci-top"><span class="qci-badge">{{edge.badge}}</span><span class="qci-count">{{patterns.cards.length}} patterns · {{footer.n_periods}} periods</span></div>
      <h2 class="qci-title">How management communicates future commitments.</h2>
      <p class="qci-sub">Recurring commitment and disclosure behaviour across {{period_start}} → {{period_end}}, compressed to the patterns that change the investor read.</p>
    </div>
    <div class="qci-grid">
      {{#each patterns.cards}}
      <article class="pattern" data-full-width="{{full_width}}">
        <svg class="{{trend}}" viewBox="4 0 24 8" preserveAspectRatio="none" aria-hidden="true"><g transform="translate(0 8) scale(1 -1)"><polyline points="{{spark}}" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/></g></svg>
        <div><span class="pattern-status {{trend}}">{{trend}}</span><h3>{{name}}</h3><p>{{meaning}}</p></div>
      </article>
      {{/each}}
    </div>
    <div class="qci-edge">
      <div class="edge-item"><b>Behaviour</b>{{edge.behaviour}}</div>
      <div class="edge-item"><b>Implication</b>{{edge.implication}}</div>
      <div class="edge-item"><b>Investor focus</b>{{edge.investor_focus.chip}} · {{edge.investor_focus.tail}}</div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div><span class="section-kicker">{{credibility_timeline.section_tag}}</span><h2 class="section-title">Guidance Credibility Over Time</h2></div>
      <div class="section-note">Vertical position shows credibility level; marker size shows confidence in the assessment.</div>
    </div>
    <div class="timeline-card">
      <div class="timeline-scroll">
        <div class="timeline-visual" role="img" aria-label="{{credibility_timeline.section_title}} from {{period_start}} through {{period_end}}">
          <div class="timeline-plot">
            <div class="timeline-axis"><span>High</span><span>Developing</span><span>Lower</span></div>
            <div class="timeline-bands">
              <div class="timeline-band high"></div><div class="timeline-band developing"></div><div class="timeline-band lower"></div><div class="timeline-track"></div>
              <div class="timeline-points">{{#each credibility_timeline.points}}<div class="timeline-point {{tone}}"><span class="timeline-dot" title="{{label}} · {{period}}"></span></div>{{/each}}</div>
            </div>
          </div>
          <div class="timeline-events">
            {{#each credibility_timeline.points}}<div class="timeline-event {{tone}}"><b>{{label}}</b><span>{{period}}</span></div>{{/each}}
          </div>
        </div>
      </div>
      <div class="timeline-legend"><span><i class="legend-dot" style="background:var(--green)"></i>High credibility</span><span><i class="legend-dot" style="background:var(--amber)"></i>Developing</span><span><i class="legend-dot" style="background:var(--red)"></i>Lower</span><span class="confidence-key">Larger marker = stronger evidence confidence</span></div>
    </div>
  </section>

  <section class="section" data-source-title="{{split.section_title}}">
    <div class="section-head">
      <div><span class="section-kicker">{{split.section_tag}}</span><h2 class="section-title">Guidance Credibility by Controllability</h2></div>
      <div class="section-note">The left panel maps execution reliability; the right panel keeps live promises visible.</div>
    </div>
    <div class="balance-grid">
      <article class="balance-panel">
        <div class="panel-title"><h3>Controllability breakdown</h3><span>Detailed field</span></div>
        {{#if split.controllable}}
        <div class="control-group" data-description="{{split.controllable.sub}}">
          <div class="control-top"><b>{{split.controllable.title}}</b><span class="ratio green">{{split.controllable.credible}} / {{split.controllable.total}}</span></div>
          <div class="bar"><i style="width:calc({{split.controllable.credible}} * 100% / {{split.controllable.total}});background:var(--green)"></i></div>
          <div class="chip-row">{{#each split.controllable.items}}<span class="chip {{status}}">{{text}}</span>{{/each}}</div>
        </div>
        {{/if}}
        {{#if split.demand_led}}
        <div class="control-group" data-description="{{split.demand_led.sub}}">
          <div class="control-top"><b>{{split.demand_led.title}}</b><span class="ratio amber">{{split.demand_led.credible}} / {{split.demand_led.total}}</span></div>
          <div class="bar"><i style="width:calc({{split.demand_led.credible}} * 100% / {{split.demand_led.total}});background:var(--amber)"></i></div>
          <div class="chip-row">{{#each split.demand_led.items}}<span class="chip {{status}}">{{text}}</span>{{/each}}</div>
        </div>
        {{/if}}
        <div class="takeaway"><strong>Read:</strong> {{split.takeaway}}</div>
      </article>

      <article class="balance-panel">
        <div class="panel-title"><h3>Open promises · watch next</h3><span>{{watchpoints.length}} live commitments</span></div>
        <div class="watch-grid">
          {{#each watchpoints}}
          <div class="watch-card {{status}}"><div class="watch-top"><span class="watch-name">{{name}}</span><span class="watch-status">{{status}}</span></div><p>{{desc}}</p><span class="watch-meta">{{resolves}} · {{type}}</span></div>
          {{/each}}
        </div>
      </article>
    </div>
  </section>

  <section class="section" data-source-title="{{evidence.section_title}}">
    <div class="section-head">
      <div><span class="section-kicker">{{evidence.section_tag}}</span><h2 class="section-title">Guidance Evidence Timeline</h2></div>
      <div class="section-note">Four latest evidence snapshots; quotes and the full chronology remain in the detailed view.</div>
    </div>
    <div class="evidence-grid" style="--evidence-count:{{evidence.tiles.length}}">
      {{#each evidence.tiles}}
      <article class="evidence {{effect}}" data-source-meta="{{source.meta}}" data-source-quote="{{source.quote}}"><div class="evidence-top"><span class="evidence-period">{{period}}</span><span class="mini-status {{status}}">{{status}}</span></div><h3>{{name}}</h3><p>{{phrase}}</p></article>
      {{/each}}
    </div>
  </section>

  <div class="foot"><b>How this score is built —</b> forward statements paired with resolved outcomes, weighted by magnitude, recency, controllability and evidence confidence.
    {{#if footer.sources}}<span class="source-summary">{{#each footer.sources}} · {{count}} {{label}}{{/each}}</span>{{/if}}
    {{#if footer.computed_date}}<span> · Computed {{footer.computed_date}}</span>{{/if}}
  </div>
  <template id="render-metadata">
    <span data-allow-null="{{render_rules.allow_null}}" data-confidence-only="{{render_rules.confidence_only}}" data-omit-if-unsupported="{{render_rules.omit_if_unsupported}}" data-same-metric-validation="{{render_rules.same_metric_validation}}"></span>
    <span data-timeline-rule="{{_derived_by_renderer.tl_dot}}" data-bar-rule="{{_derived_by_renderer.bar_fill_pct}}" data-spark-rule="{{_derived_by_renderer.spark_stroke}}" data-gauge-rule="{{_derived_by_renderer.gauge_dashoffset}}" data-evidence-rule="{{_derived_by_renderer.etile_border_left}}"></span>
  </template>
</main>
</body>
</html>
