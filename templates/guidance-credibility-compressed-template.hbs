<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{asset_name}} · Disclosure Honesty</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Mono:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --paper: #f5f4ef;
      --surface: #ffffff;
      --surface-soft: #f0efe9;
      --ink: #141a21;
      --muted: #5c6570;
      --faint: #9aa1a9;
      --line: #e4e0d4;
      --line-dark: #c9c5ba;
      --teal: #0e9c86;
      --teal-dark: #0a6e5c;
      --teal-soft: #e3f4f0;
      --amber: #c07c12;
      --amber-soft: #fbf0dc;
      --red: #c43d34;
      --red-soft: #fbeae8;
      --blue: #3d5afe;
      --navy: #0d1b2b;
      --navy-2: #18304a;
      --radius: 14px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font: 15px/1.5 'IBM Plex Sans', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .report {
      width: 100%;
      max-width: 980px;
      margin: 0 auto;
      padding: 28px 24px 60px;
    }

    .topline {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--line);
    }
    .topline-brand {
      color: var(--faint);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    .topline-brand strong { color: var(--ink); }
    .topline-period {
      margin: 0;
      color: var(--faint);
      font: 500 11px/1.4 'IBM Plex Mono', monospace;
      text-align: right;
    }

    .hero {
      position: relative;
      display: grid;
      grid-template-columns: 170px minmax(0, 1fr);
      gap: 30px;
      align-items: center;
      padding: 30px 32px;
      overflow: hidden;
      color: #fff;
      background: linear-gradient(145deg, var(--navy), var(--navy-2));
      border-radius: 20px;
    }
    .hero::after {
      position: absolute;
      inset: 0;
      background: radial-gradient(500px 220px at 92% -20%, rgba(14,156,134,.35), transparent 70%);
      content: "";
      pointer-events: none;
    }
    .hero-body, .score-ring { position: relative; z-index: 1; }
    .hero-body { min-width: 0; }
    .score-ring {
      --score: {{score_badge.score}};
      --score-color: var(--teal);
      position: relative;
      display: grid;
      width: 170px;
      aspect-ratio: 1;
      place-items: center;
      border-radius: 50%;
      background: conic-gradient(var(--score-color) calc(var(--score) * 1%), rgba(255,255,255,.14) 0);
    }
    .score-ring.amber { --score-color: #efb552; }
    .score-ring.red { --score-color: #ed8078; }
    .score-ring::before {
      position: absolute;
      width: calc(100% - 24px);
      aspect-ratio: 1;
      background: #13283d;
      border-radius: 50%;
      content: "";
    }
    .score-copy { position: relative; text-align: center; }
    .score-value {
      display: block;
      color: #8ff0da;
      font-family: 'Fraunces', Georgia, serif;
      font-size: 52px;
      font-weight: 600;
      line-height: 1;
    }
    .score-ring.amber .score-value { color: #ffd58c; }
    .score-ring.red .score-value { color: #ffaaa4; }
    .score-scale {
      display: block;
      margin-top: 4px;
      color: rgba(255,255,255,.5);
      font: 600 10.5px/1.4 'IBM Plex Mono', monospace;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .eyebrow {
      margin: 0;
      color: #8ff0da;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    .action-title {
      max-width: none;
      margin: 8px 0 2px;
      color: #fff;
      font-family: 'Fraunces', Georgia, serif;
      font-size: 27px;
      font-weight: 600;
      line-height: 1.2;
    }
    .verdict { max-width: 670px; margin: 0 0 16px; color: rgba(255,255,255,.74); font-size: 14px; }
    .reasons { display: flex; flex-wrap: wrap; gap: 9px; }
    .reason {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 12px;
      color: rgba(255,255,255,.85);
      background: rgba(255,255,255,.07);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 500;
    }
    .reason-mark { color: #9de1d3; font-size: 13px; font-weight: 700; }
    .reason-mark.g::before { content: "✓"; }
    .reason-mark.a { color: #ffd58c; }.reason-mark.a::before { content: "!"; }
    .reason-mark.r { color: #ffaaa4; }.reason-mark.r::before { content: "×"; }

    section { padding: 0; border: 0; }
    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: flex-start;
      gap: 10px;
      margin: 34px 0 14px;
    }
    .section-head > div { display: flex; align-items: baseline; gap: 10px; }
    .section-tag {
      margin: 0;
      color: var(--faint);
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
    .section-title { margin: 0; font-size: 16px; font-weight: 600; line-height: 1.3; }
    .section-note { margin: 0 0 0 auto; color: var(--faint); font-size: 11px; }

    .communication-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .communication-card {
      padding: 18px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-top: 3px solid var(--teal);
      border-radius: var(--radius);
    }
    .communication-card.a { border-top-color: var(--amber); }
    .communication-card.r { border-top-color: var(--red); }
    .communication-title-row { display: flex; align-items: center; gap: 8px; }
    .communication-icon { font-size: 15px; }
    .communication-title { margin: 0; font-size: 13.5px; font-weight: 600; }
    .communication-subtitle { margin: 3px 0 12px; color: var(--faint); font-size: 11px; }
    .communication-items { margin: 0; padding: 0; list-style: none; counter-reset: communication; }
    .communication-item {
      display: grid;
      grid-template-columns: 22px 1fr;
      gap: 7px;
      padding: 9px 0;
      border-top: 1px solid var(--line);
      counter-increment: communication;
    }
    .communication-item::before {
      color: var(--faint);
      font: 600 9.5px/1.5 'IBM Plex Mono', monospace;
      content: counter(communication, decimal-leading-zero);
    }
    .communication-item strong { display: block; font-size: 12px; font-weight: 600; }
    .communication-item span { display: block; margin-top: 2px; color: var(--muted); font-size: 11.5px; line-height: 1.4; }

    /* QC Intuition mirrors the Guidance Credibility edge panel. */
    .edge-panel {
      position: relative;
      padding: 22px 24px;
      overflow: hidden;
      color: rgba(255,255,255,.85);
      background: var(--navy);
      border-radius: var(--radius);
    }
    .edge-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
    .edge-badge {
      color: #a9bafa;
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: .09em;
      text-transform: uppercase;
    }
    .signals { color: rgba(255,255,255,.45); font: 500 11px/1.4 'IBM Plex Mono', monospace; }
    .edge-grid { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 11px 14px; }
    .edge-grid > div { display: contents; }
    .edge-label { margin: 0; padding-top: 2px; color: #8ba4fb; font-size: 10px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
    .edge-copy { margin: 0; color: rgba(255,255,255,.85); font-size: 13px; line-height: 1.5; }
    .edge-copy.accent { color: #d9c9ff; }

    .pattern-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .pattern-card {
      position: relative;
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 14px;
      align-items: center;
      min-height: 96px;
      padding: 15px 16px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
    }
    .pattern-visual { display: grid; gap: 8px; place-items: center; }
    .pattern-icon { font-size: 21px; }
    .pattern-bar { position: relative; width: 64px; height: 5px; overflow: hidden; background: var(--surface-soft); border-radius: 99px; }
    .pattern-bar i { position: absolute; inset-block: 0; left: 0; width: 70%; background: var(--teal); border-radius: inherit; }
    .pattern-bar i.a { background: var(--amber); }.pattern-bar i.r { background: var(--red); }
    .pattern-bar i.very-high { width: 92%; }.pattern-bar i.high { width: 80%; }.pattern-bar i.medium { width: 68%; }.pattern-bar i.mixed { width: 52%; }.pattern-bar i.low { width: 38%; }
    .pattern-name { margin: 20px 0 4px; font-size: 13.5px; font-weight: 600; }
    .pattern-meaning { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.4; }
    .trend {
      position: absolute;
      top: 15px;
      left: 102px;
      padding: 3px 8px;
      border-radius: 20px;
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: .04em;
      text-transform: uppercase;
    }
    .trend.g { color: var(--teal-dark); background: var(--teal-soft); }
    .trend.a { color: #875408; background: var(--amber-soft); }
    .trend.r { color: #9a3029; background: var(--red-soft); }
    .trend.rising::before { content: "▲ "; }.trend.steady::before { content: "— "; }.trend.mixed::before { content: "~ "; }.trend.weakening::before { content: "▼ "; }.trend.new::before { content: "◆ "; }

    .watch-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; counter-reset: watch; }
    .watchpoint {
      padding: 13px 15px;
      background: var(--amber-soft);
      border-left: 3px solid var(--amber);
      border-radius: 8px;
      counter-increment: watch;
    }
    .watch-number { color: var(--amber); font: 700 9.5px/1.4 'IBM Plex Mono', monospace; }
    .watch-number::before { content: counter(watch, decimal-leading-zero); }
    .watch-name { margin: 4px 0 3px; font-size: 12.5px; font-weight: 600; }
    .watch-desc { margin: 0; color: var(--muted); font-size: 11.5px; line-height: 1.4; }

    .bottom-line { display: grid; gap: 10px; }
    .bottom-row {
      display: grid;
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 14px;
      align-items: start;
      padding: 13px 15px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-left: 3px solid var(--teal);
      border-radius: 10px;
    }
    .bottom-row.a { border-left-color: var(--amber); }.bottom-row.r { border-left-color: var(--red); }
    .bottom-tag { color: var(--teal-dark); font: 700 10px/1.5 'IBM Plex Mono', monospace; letter-spacing: .06em; text-transform: uppercase; }
    .bottom-row.a .bottom-tag { color: #875408; }.bottom-row.r .bottom-tag { color: #9a3029; }
    .bottom-copy { color: var(--muted); font-size: 12.5px; line-height: 1.5; }

    .footnote { margin-top: 36px; padding: 16px 0 0; color: var(--faint); border-top: 1px solid var(--line); font-size: 11.5px; line-height: 1.5; }
    .footnote strong { color: var(--muted); }
    footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 16px; color: var(--faint); font-size: 10.5px; }

    @media (max-width: 760px) {
      .report { padding: 20px 16px 40px; }
      .topline { align-items: flex-start; flex-direction: column; gap: 4px; }
      .topline-period { text-align: left; }
      .hero { grid-template-columns: 1fr; padding: 26px 20px; text-align: center; }
      .score-ring { width: 150px; margin: 0 auto; }
      .reasons { justify-content: center; }
      .section-head, .section-head > div { align-items: flex-start; flex-direction: column; gap: 3px; }
      .section-note { margin-left: 0; }
      .communication-grid, .pattern-grid, .watch-grid { grid-template-columns: 1fr; }
      .edge-grid { grid-template-columns: 88px minmax(0, 1fr); }
      .edge-top { align-items: flex-start; flex-direction: column; gap: 5px; }
    }

    @media (max-width: 480px) {
      .report { padding-inline: 12px; }
      .action-title { font-size: 24px; }
      .hero { padding-inline: 16px; }
      .communication-card, .edge-panel { padding: 17px; }
      .edge-grid { grid-template-columns: 1fr; gap: 3px; }
      .edge-grid > div { display: grid; gap: 3px; }
      .edge-copy + .edge-label { margin-top: 9px; }
      .bottom-row { grid-template-columns: 1fr; gap: 4px; }
    }

    @media print {
      body { background: #fff; }
      .report { max-width: none; padding: 0; }
      .communication-card, .edge-panel, .pattern-card, .watchpoint, .bottom-row { break-inside: avoid; }
    }
  </style>
</head>
<body>
  <main class="report">
    <div class="topline">
      <div class="topline-brand">Disclosure Honesty · <strong>{{asset_name}}</strong></div>
      <p class="topline-period">{{#if period_start}}{{period_start}} → {{period_end}}{{/if}}{{#if computed_date}} · Computed {{computed_date}}{{/if}}</p>
    </div>

    <header class="hero">
      <div class="score-ring {{score_badge.status_color}}" role="img" aria-label="Score {{score_badge.score}} out of {{score_badge.scale}}">
        <div class="score-copy"><span class="score-value">{{score_badge.score}}</span><span class="score-scale">out of {{score_badge.scale}}</span></div>
      </div>
      <div class="hero-body">
        <p class="eyebrow">{{score_badge.rating}} · {{lens}}</p>
        <h1 class="action-title">{{hero_verdict}}</h1>
        <p class="verdict">{{score_badge.description}}</p>
        {{#if hero_reasons.length}}
        <div class="reasons">
          {{#each hero_reasons}}<div class="reason"><span class="reason-mark {{tone}}" aria-hidden="true"></span><span>{{label}}</span></div>{{/each}}
        </div>
        {{/if}}
      </div>
    </header>

    {{#if communication_analysis.columns.length}}
    <section>
      <div class="section-head">
        <div><p class="section-tag">Headline insights</p><h2 class="section-title">Communication behaviour</h2></div>
        <p class="section-note">{{communication_analysis.source_note}}</p>
      </div>
      <div class="communication-grid">
        {{#each communication_analysis.columns}}
        <article class="communication-card {{tone}}">
          <div class="communication-title-row"><span class="communication-icon">{{icon}}</span><h3 class="communication-title">{{title}}</h3></div>
          <p class="communication-subtitle">{{subtitle}}</p>
          <ol class="communication-items">
            {{#each items}}<li class="communication-item"><div><strong>{{label}}</strong><span>{{note}}</span></div></li>{{/each}}
          </ol>
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if pattern_radar.intuition}}
    <section class="edge-section">
      <div class="section-head"><div><p class="section-tag">Synthesis</p><h2 class="section-title">The Edge</h2></div></div>
      <div class="edge-panel">
        <div class="edge-top"><span class="edge-badge">◆ QC Intuition · Pattern Recognition</span>{{#if pattern_radar.signals_parsed}}<span class="signals">{{pattern_radar.signals_parsed}} signals parsed</span>{{/if}}</div>
        <div class="edge-grid">
          <div><p class="edge-label">Behaviour</p><p class="edge-copy">{{pattern_radar.intuition.lead}}</p></div>
          <div><p class="edge-label">Implication</p><p class="edge-copy accent">{{pattern_radar.intuition.detail}}</p></div>
        </div>
      </div>
    </section>
    {{/if}}

    {{#if pattern_radar.patterns.length}}
    <section>
      <div class="section-head">
        <div><p class="section-tag">Pattern recognition</p><h2 class="section-title">Key patterns</h2></div>
        <p class="section-note">{{#if pattern_radar.period_start}}{{pattern_radar.period_start}} → {{pattern_radar.period_end}}{{/if}}</p>
      </div>
      <div class="pattern-grid">
        {{#each pattern_radar.patterns}}
        <article class="pattern-card">
          <div class="pattern-visual"><span class="pattern-icon">{{icon}}</span><span class="pattern-bar"><i class="{{tone}} {{strength}}"></i></span></div>
          <div><h3 class="pattern-name">{{name}}</h3><p class="pattern-meaning">{{meaning}}</p></div>
          <span class="trend {{tone}} {{trend}}">{{trend}}</span>
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if watchpoints.length}}
    <section>
      <div class="section-head"><div><p class="section-tag">Forward look</p><h2 class="section-title">Watch next four quarters</h2></div></div>
      <div class="watch-grid">
        {{#each watchpoints}}<article class="watchpoint"><span class="watch-number"></span><h3 class="watch-name">{{title}}</h3><p class="watch-desc">{{desc}}</p></article>{{/each}}
      </div>
    </section>
    {{/if}}

    {{#if bottom_line.length}}
    <section>
      <div class="section-head"><div><p class="section-tag">Investor takeaway</p><h2 class="section-title">Bottom line</h2></div></div>
      <div class="bottom-line">
        {{#each bottom_line}}<div class="bottom-row {{tone}}"><span class="bottom-tag">{{tag}}</span><span class="bottom-copy">{{text}}</span></div>{{/each}}
      </div>
    </section>
    {{/if}}

    {{#if footer.methodology}}<div class="footnote"><strong>How this score is built.</strong> — {{footer.methodology}}</div>{{/if}}
    <footer><span>Disclosure Honesty · {{asset_name}}</span>{{#if footer.sources}}<span>{{footer.sources}}</span>{{/if}}</footer>
  </main>
</body>
</html>
