<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{asset_name}} · Guidance Credibility</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Mono:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --paper: #f5f4ef;
      --surface: #ffffff;
      --surface-soft: #f0efe9;
      --ink: #141a21;
      --muted: #5c6570;
      --faint: #9aa1a9;
      --line: #e4e0d4;
      --line-dark: #c9c5ba;
      --teal: #0e9c86;
      --teal-dark: #0a6e5c;
      --teal-soft: #e3f4f0;
      --amber: #c07c12;
      --amber-soft: #fbf0dc;
      --red: #c43d34;
      --red-soft: #fbeae8;
      --blue: #3d5afe;
      --navy: #0d1b2b;
      --navy-2: #18304a;
      --radius: 14px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font: 15px/1.5 'IBM Plex Sans', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .report {
      width: 100%;
      max-width: 980px;
      margin: 0 auto;
      padding: 28px 24px 60px;
    }

    .topline {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--line);
    }
    .topline-brand {
      color: var(--faint);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    .topline-brand strong { color: var(--ink); }
    .topline-period {
      margin: 0;
      color: var(--faint);
      font: 500 11px/1.4 'IBM Plex Mono', monospace;
      text-align: right;
    }

    .hero {
      position: relative;
      display: grid;
      grid-template-columns: 180px minmax(0, 1fr);
      gap: 38px;
      align-items: center;
      min-height: 286px;
      padding: 42px 40px;
      overflow: hidden;
      color: #fff;
      background: #1c254b;
      border: 1px solid #40528f;
      border-radius: 20px;
    }
    .hero::after {
      position: absolute;
      inset: 0;
      background: radial-gradient(500px 240px at 92% -20%, rgba(115,139,230,.16), transparent 70%);
      content: "";
      pointer-events: none;
    }
    .hero-body, .score-ring { position: relative; z-index: 1; }
    .hero-body { min-width: 0; }
    .score-ring {
      --score: {{score_badge.score}};
      --score-color: var(--teal);
      position: relative;
      display: grid;
      width: 180px;
      aspect-ratio: 1;
      place-items: center;
      border-radius: 50%;
      background: conic-gradient(var(--score-color) calc(var(--score) * 1%), rgba(255,255,255,.14) 0);
    }
    .score-ring.amber { --score-color: #efb552; }
    .score-ring.red { --score-color: #ed8078; }
    .score-ring::before {
      position: absolute;
      width: calc(100% - 24px);
      aspect-ratio: 1;
      background: #13283d;
      border-radius: 50%;
      content: "";
    }
    .score-copy { position: relative; text-align: center; }
    .score-value {
      display: block;
      color: #8ff0da;
      font-family: 'Fraunces', Georgia, serif;
      font-size: 52px;
      font-weight: 600;
      line-height: 1;
    }
    .score-ring.amber .score-value { color: #ffd58c; }
    .score-ring.red .score-value { color: #ffaaa4; }
    .score-scale {
      display: block;
      margin-top: 4px;
      color: rgba(255,255,255,.5);
      font: 600 10.5px/1.4 'IBM Plex Mono', monospace;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .eyebrow {
      margin: 0;
      color: #8ff0da;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    .action-title {
      max-width: none;
      margin: 8px 0 2px;
      color: #fff;
      font-family: 'Fraunces', Georgia, serif;
      font-size: 34px;
      font-weight: 600;
      line-height: 1.2;
    }
    .verdict { max-width: 670px; margin: 6px 0 20px; color: rgba(255,255,255,.74); font-size: 15px; }
    .reasons { display: flex; flex-wrap: wrap; gap: 9px; }
    .reason {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 12px;
      color: rgba(255,255,255,.85);
      background: rgba(255,255,255,.07);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 500;
    }
    .reason-mark { color: #9de1d3; font-size: 13px; font-weight: 700; }
    .reason-mark.g::before { content: "✓"; }
    .reason-mark.a { color: #ffd58c; }.reason-mark.a::before { content: "!"; }
    .reason-mark.r { color: #ffaaa4; }.reason-mark.r::before { content: "×"; }
    .reason-mark.ok { color: #9de1d3; }.reason-mark.ok::before { content: "✓"; }
    .reason-mark.no { color: #ffaaa4; }.reason-mark.no::before { content: "×"; }

    section { padding: 0; border: 0; }
    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: flex-start;
      gap: 10px;
      margin: 34px 0 14px;
    }
    .section-head > div { display: flex; align-items: baseline; gap: 10px; }
    .section-tag {
      margin: 0;
      color: var(--faint);
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: .13em;
      text-transform: uppercase;
    }
    .section-title { margin: 0; font-size: 16px; font-weight: 600; line-height: 1.3; }
    .section-note { margin: 0 0 0 auto; color: var(--faint); font-size: 11px; }

    .communication-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .communication-card {
      padding: 18px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-top: 3px solid var(--teal);
      border-radius: var(--radius);
    }
    .communication-card.a { border-top-color: var(--amber); }
    .communication-card.r { border-top-color: var(--red); }
    .communication-title-row { display: flex; align-items: center; gap: 8px; }
    .communication-icon { font-size: 15px; }
    .communication-title { margin: 0; font-size: 13.5px; font-weight: 600; }
    .communication-subtitle { margin: 3px 0 12px; color: var(--faint); font-size: 11px; }
    .communication-items { margin: 0; padding: 0; list-style: none; counter-reset: communication; }
    .communication-item {
      display: grid;
      grid-template-columns: 22px 1fr;
      gap: 7px;
      padding: 9px 0;
      border-top: 1px solid var(--line);
      counter-increment: communication;
    }
    .communication-item::before {
      color: var(--faint);
      font: 600 9.5px/1.5 'IBM Plex Mono', monospace;
      content: counter(communication, decimal-leading-zero);
    }
    .communication-item strong { display: block; font-size: 12px; font-weight: 600; }
    .communication-item span { display: block; margin-top: 2px; color: var(--muted); font-size: 11.5px; line-height: 1.4; }

    .headline-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .headline-card { padding: 18px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
    .headline-label { display: flex; align-items: center; gap: 8px; margin: 0 0 12px; color: var(--muted); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; }
    .headline-dot { width: 8px; height: 8px; flex: 0 0 auto; background: var(--teal); border-radius: 50%; }
    .headline-dot.a { background: var(--amber); }.headline-dot.r { background: var(--red); }
    .headline-value { margin: 0; color: var(--teal-dark); font: 600 22px/1.15 'Fraunces', Georgia, serif; }
    .headline-value.mono { font-family: 'IBM Plex Mono', monospace; font-size: 18px; }
    .headline-value.a { color: #875408; }.headline-value.r { color: #9a3029; }
    .headline-sub { margin: 9px 0 0; color: var(--muted); font-size: 12px; line-height: 1.45; }

    /* QC Intuition summary immediately below the three headline scores. */
    .intuition-panel {
      position: relative;
      min-height: 220px;
      margin-top: 14px;
      padding: 28px 30px;
      overflow: hidden;
      color: #fff;
      background: #1c254b;
      border: 1px solid #40528f;
      border-radius: var(--radius);
    }
    .intuition-panel::before, .intuition-panel::after { position: absolute; border-radius: 50%; background: rgba(115,139,230,.10); content: ""; pointer-events: none; }
    .intuition-panel::before { width: 230px; height: 230px; top: -105px; right: -55px; }
    .intuition-panel::after { width: 230px; height: 230px; bottom: -190px; left: -95px; }
    .intuition-content { position: relative; z-index: 1; max-width: 790px; }
    .intuition-badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; color: #a9bafa; border: 1px solid #5266aa; border-radius: 999px; font-size: 10.5px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
    .intuition-badge::before { width: 7px; height: 7px; background: #7895ff; border-radius: 50%; box-shadow: 0 0 0 6px rgba(120,149,255,.12); content: ""; }
    .intuition-heading { margin: 38px 0 10px; font-family: 'Fraunces', Georgia, serif; font-size: clamp(25px, 4vw, 38px); font-weight: 500; line-height: 1.15; }
    .intuition-line { display: -webkit-box; max-width: 820px; margin: 0; overflow: hidden; color: rgba(255,255,255,.62); font-size: 15px; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

    /* Detailed behaviour, implication and investor focus now follow Key patterns. */
    .edge-panel {
      position: relative;
      padding: 22px 24px;
      overflow: hidden;
      color: rgba(255,255,255,.85);
      background: var(--navy);
      border-radius: var(--radius);
    }
    .edge-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
    .edge-badge {
      color: #a9bafa;
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: .09em;
      text-transform: uppercase;
    }
    .signals { color: rgba(255,255,255,.45); font: 500 11px/1.4 'IBM Plex Mono', monospace; }
    .edge-grid { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 11px 14px; }
    .edge-grid > div { display: contents; }
    .edge-label { margin: 0; padding-top: 2px; color: #8ba4fb; font-size: 10px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
    .edge-copy { margin: 0; color: rgba(255,255,255,.85); font-size: 13px; line-height: 1.5; }
    .edge-copy.accent { color: #d9c9ff; }

    .pattern-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .pattern-card {
      position: relative;
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 14px;
      align-items: center;
      min-height: 96px;
      padding: 15px 16px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
    }
    .pattern-visual { display: grid; gap: 8px; place-items: center; }
    .sparkline { display: flex; width: 68px; height: 38px; align-items: end; justify-content: center; gap: 3px; padding-bottom: 3px; border-bottom: 1px solid var(--line-dark); }
    .sparkline i { width: 6px; height: 45%; background: #9a9a96; border-radius: 3px 3px 0 0; }
    .sparkline i.v1 { height: 20%; }.sparkline i.v2 { height: 36%; }.sparkline i.v3 { height: 52%; }.sparkline i.v4 { height: 72%; }.sparkline i.v5 { height: 92%; }
    .pattern-card:has(.trend.rising) .sparkline i { background: var(--teal); }
    .pattern-card:has(.trend.new) .sparkline i { background: var(--blue); }
    .pattern-icon { font-size: 21px; }
    .pattern-bar { position: relative; width: 64px; height: 5px; overflow: hidden; background: var(--surface-soft); border-radius: 99px; }
    .pattern-bar i { position: absolute; inset-block: 0; left: 0; width: 70%; background: var(--teal); border-radius: inherit; }
    .pattern-bar i.a { background: var(--amber); }.pattern-bar i.r { background: var(--red); }
    .pattern-bar i.very-high { width: 92%; }.pattern-bar i.high { width: 80%; }.pattern-bar i.medium { width: 68%; }.pattern-bar i.mixed { width: 52%; }.pattern-bar i.low { width: 38%; }
    .pattern-name { margin: 20px 0 4px; font-size: 13.5px; font-weight: 600; }
    .pattern-meaning { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.4; }
    .trend {
      position: absolute;
      top: 15px;
      left: 102px;
      padding: 3px 8px;
      border-radius: 20px;
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: .04em;
      text-transform: uppercase;
    }
    .trend.g { color: var(--teal-dark); background: var(--teal-soft); }
    .trend.a { color: #875408; background: var(--amber-soft); }
    .trend.r { color: #9a3029; background: var(--red-soft); }
    .trend.rising { color: var(--teal-dark); background: var(--teal-soft); }
    .trend.steady, .trend.mixed { color: #875408; background: var(--amber-soft); }
    .trend.new { color: #2444ba; background: #e8edff; }
    .trend.weakening { color: #9a3029; background: var(--red-soft); }
    .trend.rising::before { content: "▲ "; }.trend.steady::before { content: "— "; }.trend.mixed::before { content: "~ "; }.trend.weakening::before { content: "▼ "; }.trend.new::before { content: "◆ "; }

    .timeline-card { padding: 24px 22px 18px; overflow: hidden; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
    .timeline-scroll { overflow-x: auto; padding-bottom: 8px; scrollbar-width: thin; scrollbar-color: var(--line-dark) transparent; }
    .timeline-canvas { min-width: 800px; }
    .cred-chart { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 14px; }
    .cred-axis { display: grid; grid-template-rows: repeat(3, 68px); gap: 7px; color: var(--faint); font-size: 11px; }
    .cred-axis span { display: flex; align-items: center; }
    .cred-plot { position: relative; height: 294px; }
    .cred-bands { position: absolute; inset: 0 0 auto; display: grid; width: 100%; height: 218px; grid-template-rows: repeat(3, 68px); gap: 7px; }
    .cred-band { border-radius: 8px; }
    .cred-band.high { background: #e9f4ef; }.cred-band.developing { background: #fbf2df; }.cred-band.lower { background: #fbeceb; }
    .cred-points { position: absolute; inset: 0; display: grid; grid-auto-columns: minmax(130px, 1fr); grid-auto-flow: column; }
    .cred-point { position: relative; min-width: 0; text-align: center; }
    .cred-marker { position: absolute; z-index: 2; left: 50%; width: 24px; height: 24px; background: var(--teal); border: 4px solid var(--surface); border-radius: 50%; box-shadow: 0 0 0 5px rgba(14,156,134,.17); transform: translate(-50%, -50%); }
    .cred-point.teal .cred-marker { top: 34px; background: var(--teal); box-shadow: 0 0 0 5px rgba(14,156,134,.17); }
    .cred-point.amber .cred-marker { top: 109px; background: var(--amber); box-shadow: 0 0 0 5px rgba(192,124,18,.17); }
    .cred-point.red .cred-marker { top: 184px; background: var(--red); box-shadow: 0 0 0 5px rgba(196,61,52,.17); }
    .cred-marker.high { width: 30px; height: 30px; }.cred-marker.medium { width: 24px; height: 24px; }.cred-marker.low { width: 18px; height: 18px; }
    /* 1. Define current vertical positions and line colors */
.cred-point.teal { --curr-y: 34px; --line-color: var(--teal); }
.cred-point.amber { --curr-y: 109px; --line-color: var(--amber); }
.cred-point.red { --curr-y: 184px; --line-color: var(--red); }

/* 2. Pass the vertical position forward to the next sibling */
.cred-point.teal + .cred-point { --prev-y: 34px; }
.cred-point.amber + .cred-point { --prev-y: 109px; }
.cred-point.red + .cred-point { --prev-y: 184px; }

/* 3. Use clip-path to draw a diagonal polygon connecting the two Y coordinates */
.cred-segment { 
  position: absolute; 
  z-index: 1; 
  left: -50%; 
  top: 0; 
  width: 100%; 
  height: 100%; 
  background: var(--line-color); 
  clip-path: polygon(
    0 calc(var(--prev-y) - 1.5px),
    100% calc(var(--curr-y) - 1.5px),
    100% calc(var(--curr-y) + 1.5px),
    0 calc(var(--prev-y) + 1.5px)
  );
}
    .cred-labels { position: absolute; top: 232px; left: 0; width: 100%; padding-top: 12px; border-top: 2px solid var(--teal); }
    .cred-label { display: block; padding-inline: 7px; color: var(--ink); font-size: 11px; font-weight: 700; line-height: 1.3; }
    .cred-period { display: block; margin-top: 7px; color: var(--faint); font: 500 10px/1.3 'IBM Plex Mono', monospace; }
    .timeline-footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 10px; color: var(--faint); font-size: 10.5px; }
    .timeline-legend { display: flex; flex-wrap: wrap; gap: 16px; }
    .legend-key { display: inline-flex; align-items: center; gap: 6px; }
    .legend-key i { width: 8px; height: 8px; background: var(--teal); border-radius: 50%; }
    .legend-key i.amber { background: var(--amber); }.legend-key i.red { background: var(--red); }
    .confidence-note { text-align: right; }

    .split-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .split-card { padding: 20px; background: var(--surface); border: 1px solid var(--line); border-top: 3px solid var(--teal); border-radius: var(--radius); }
    .split-card.amber { border-top-color: var(--amber); }
    .split-head { display: flex; align-items: start; justify-content: space-between; gap: 14px; }
    .split-title { margin: 0; font-size: 14px; font-weight: 700; }
    .split-sub { margin: 4px 0 0; color: var(--faint); font-size: 11px; line-height: 1.4; }
    .split-count { flex: 0 0 auto; color: var(--teal-dark); font: 700 18px/1 'IBM Plex Mono', monospace; }
    .split-card.amber .split-count { color: #875408; }
    .split-count small { display: block; margin-top: 5px; color: var(--faint); font: 500 8.5px/1.2 'IBM Plex Sans', sans-serif; letter-spacing: .08em; text-align: right; text-transform: uppercase; }
    .split-progress { width: 100%; height: 6px; margin: 16px 0 8px; overflow: hidden; border: 0; border-radius: 99px; appearance: none; }
    .split-progress::-webkit-progress-bar { background: var(--surface-soft); }
    .split-progress::-webkit-progress-value { background: var(--teal); border-radius: 99px; }
    .split-progress::-moz-progress-bar { background: var(--teal); border-radius: 99px; }
    .split-card.amber .split-progress::-webkit-progress-value { background: var(--amber); }
    .split-card.amber .split-progress::-moz-progress-bar { background: var(--amber); }
    .split-items { margin: 0; padding: 0; list-style: none; }
    .split-item { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 9px; padding: 9px 0; color: var(--muted); border-top: 1px solid var(--line); font-size: 11.5px; line-height: 1.4; }
    .split-status { width: 9px; height: 9px; margin-top: 4px; background: var(--amber); border-radius: 50%; }
    .split-status.credible { background: var(--teal); }.split-status.missed { background: var(--red); }
    .split-takeaway { margin: 12px 0 0; padding: 13px 15px; color: var(--muted); background: var(--surface-soft); border-radius: 9px; font-size: 12px; line-height: 1.5; }

    .evidence-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .evidence-card { padding: 17px 18px; background: var(--surface); border: 1px solid var(--line); border-left: 3px solid var(--amber); border-radius: 11px; }
    .evidence-card.positive { border-left-color: var(--teal); }.evidence-card.negative { border-left-color: var(--red); }
    .evidence-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .evidence-period { color: var(--faint); font: 600 10px/1.3 'IBM Plex Mono', monospace; }
    .evidence-status { padding: 3px 8px; color: #875408; background: var(--amber-soft); border-radius: 999px; font-size: 9px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
    .evidence-card.positive .evidence-status { color: var(--teal-dark); background: var(--teal-soft); }.evidence-card.negative .evidence-status { color: #9a3029; background: var(--red-soft); }
    .evidence-name { margin: 13px 0 5px; font-size: 13.5px; font-weight: 700; }
    .evidence-phrase { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.45; }
    .evidence-source { margin: 12px 0 0; padding-top: 11px; color: var(--faint); border-top: 1px solid var(--line); font-size: 10.5px; line-height: 1.45; }
    .evidence-quote { display: block; margin-bottom: 4px; color: var(--muted); font-style: italic; }

    .watch-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; counter-reset: watch; }
    .watchpoint {
      padding: 13px 15px;
      background: var(--amber-soft);
      border-left: 3px solid var(--amber);
      border-radius: 8px;
      counter-increment: watch;
    }
    .watch-number { color: var(--amber); font: 700 9.5px/1.4 'IBM Plex Mono', monospace; }
    .watch-number::before { content: counter(watch, decimal-leading-zero); }
    .watch-name { margin: 4px 0 3px; font-size: 12.5px; font-weight: 600; }
    .watch-desc { margin: 0; color: var(--muted); font-size: 11.5px; line-height: 1.4; }

    .bottom-line { display: grid; gap: 10px; }
    .bottom-row {
      display: grid;
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 14px;
      align-items: start;
      padding: 13px 15px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-left: 3px solid var(--teal);
      border-radius: 10px;
    }
    .bottom-row.a { border-left-color: var(--amber); }.bottom-row.r { border-left-color: var(--red); }
    .bottom-tag { color: var(--teal-dark); font: 700 10px/1.5 'IBM Plex Mono', monospace; letter-spacing: .06em; text-transform: uppercase; }
    .bottom-row.a .bottom-tag { color: #875408; }.bottom-row.r .bottom-tag { color: #9a3029; }
    .bottom-copy { color: var(--muted); font-size: 12.5px; line-height: 1.5; }

    .insight-stack { margin-top: 34px; }
    .insight-stack .intuition-panel { margin-top: 0; border-radius: var(--radius) var(--radius) 0 0; }
    .insight-patterns { padding: 18px; background: var(--paper); border-right: 1px solid var(--line-dark); border-left: 1px solid var(--line-dark); }
    .insight-stack .edge-panel { border-radius: 0 0 var(--radius) var(--radius); }

    .footnote { margin-top: 36px; padding: 16px 0 0; color: var(--faint); border-top: 1px solid var(--line); font-size: 11.5px; line-height: 1.5; }
    .footnote strong { color: var(--muted); }
    footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 16px; color: var(--faint); font-size: 10.5px; }

    @media (max-width: 760px) {
      .report { padding: 20px 16px 40px; }
      .topline { align-items: flex-start; flex-direction: column; gap: 4px; }
      .topline-period { text-align: left; }
      .hero { grid-template-columns: 1fr; padding: 26px 20px; text-align: center; }
      .score-ring { width: 150px; margin: 0 auto; }
      .reasons { justify-content: center; }
      .section-head, .section-head > div { align-items: flex-start; flex-direction: column; gap: 3px; }
      .section-note { margin-left: 0; }
      .communication-grid, .headline-grid, .pattern-grid, .split-grid, .watch-grid, .evidence-grid { grid-template-columns: 1fr; }
      .edge-grid { grid-template-columns: 88px minmax(0, 1fr); }
      .edge-top { align-items: flex-start; flex-direction: column; gap: 5px; }
    }

    @media (max-width: 480px) {
      .report { padding-inline: 12px; }
      .action-title { font-size: 24px; }
      .hero { padding-inline: 16px; }
      .communication-card, .edge-panel { padding: 17px; }
      .intuition-panel { min-height: 0; padding: 22px 18px; }
      .intuition-heading { margin-top: 28px; }
      .hero { min-height: 0; padding-block: 34px; }
      .timeline-card { padding: 18px 14px 14px; }
      .timeline-scroll { margin-right: -14px; padding-right: 14px; }
      .timeline-footer { align-items: flex-start; flex-direction: column; }
      .confidence-note { text-align: left; }
      .edge-grid { grid-template-columns: 1fr; gap: 3px; }
      .edge-grid > div { display: grid; gap: 3px; }
      .edge-copy + .edge-label { margin-top: 9px; }
      .bottom-row { grid-template-columns: 1fr; gap: 4px; }
    }

    @media print {
      body { background: #fff; }
      .report { max-width: none; padding: 0; }
      .communication-card, .edge-panel, .pattern-card, .split-card, .watchpoint, .evidence-card, .bottom-row { break-inside: avoid; }
    }
  </style>
</head>
<body>
  <main class="report">
    <div class="topline">
      <div class="topline-brand">Guidance Credibility · <strong>{{asset_name}}</strong></div>
      <p class="topline-period">{{#if period_start}}{{period_start}} → {{period_end}}{{/if}}{{#if footer.computed_date}} · Computed {{footer.computed_date}}{{/if}}</p>
    </div>

    <header class="hero">
      <div class="score-ring {{score_badge.status_color}}" role="img" aria-label="Score {{score_badge.score}} out of {{score_badge.scale}}">
        <div class="score-copy"><span class="score-value">{{score_badge.score}}</span><span class="score-scale">out of {{score_badge.scale}}</span></div>
      </div>
      <div class="hero-body">
        <p class="eyebrow">{{hero.eyebrow}}</p>
        <h1 class="action-title">{{hero.action_title}}</h1>
        <p class="verdict">{{hero.verdict}}</p>
        {{#if hero.reasons.length}}
        <div class="reasons">
          {{#each hero.reasons}}<div class="reason"><span class="reason-mark {{mark}}" aria-hidden="true"></span><span>{{text}}</span></div>{{/each}}
        </div>
        {{/if}}
      </div>
    </header>

    {{#if headline.cards.length}}
    <section>
      <div class="section-head">
        <div><p class="section-tag">{{headline.section_tag}}</p><h2 class="section-title">Communication behaviour</h2></div>
      </div>
      <div class="headline-grid">
        {{#each headline.cards}}
        <article class="headline-card">
          <p class="headline-label"><span class="headline-dot {{dot}}"></span>{{label}}</p>
          <p class="headline-value {{value_color}} {{#if value_mono}}mono{{/if}}">{{#each value_lines}}{{this}}{{#unless @last}}<br>{{/unless}}{{/each}}</p>
          <p class="headline-sub">{{sub}}</p>
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <section class="insight-stack">
    {{#if edge}}
      <div class="intuition-panel">
        <div class="intuition-content">
          <span class="intuition-badge">◆ QC Intuition · Pattern Recognition</span>
          <h2 class="intuition-heading">How management communicates future commitments.</h2>
          <p class="intuition-line">{{#if qc_intuition.summary}}{{qc_intuition.summary}}{{else}}{{edge.behaviour}}{{/if}}</p>
        </div>
      </div>
    {{/if}}

    {{#if patterns.cards.length}}
    <div class="insight-patterns">
      <div class="pattern-grid">
        {{#each patterns.cards}}
        <article class="pattern-card">
          <div class="pattern-visual">
            {{#if strength}}
            <span class="pattern-icon">{{icon}}</span><span class="pattern-bar"><i class="{{tone}} {{strength}}"></i></span>
            {{else}}
            <span class="sparkline">{{#each spark}}<i class="v{{lookup this 1}}"></i>{{/each}}</span>
            {{/if}}
          </div>
          <div><h3 class="pattern-name">{{name}}</h3><p class="pattern-meaning">{{meaning}}</p></div>
          <span class="trend {{trend}}">{{trend}}</span>
        </article>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if edge}}
      <div class="edge-panel">
        <div class="edge-top"><span class="edge-badge">{{edge.badge}}</span></div>
        <div class="edge-grid">
          <div><p class="edge-label">Behaviour</p><p class="edge-copy">{{edge.behaviour}}</p></div>
          <div><p class="edge-label">Implication</p><p class="edge-copy accent">{{edge.implication}}</p></div>
          {{#if edge.investor_focus}}
          <div><p class="edge-label">Investor focus</p><p class="edge-copy"><strong>{{edge.investor_focus.chip}}</strong>{{#if edge.investor_focus.tail}} — {{edge.investor_focus.tail}}{{/if}}</p></div>
          {{/if}}
        </div>
      </div>
    {{/if}}
    </section>

    {{#if credibility_timeline.points.length}}
    <section>
      <div class="section-head">
        <div><p class="section-tag">{{credibility_timeline.section_tag}}</p><h2 class="section-title">{{credibility_timeline.section_title}}</h2></div>
        <p class="section-note">Vertical position shows credibility level; marker size shows confidence in the assessment.</p>
      </div>
      <div class="timeline-card">
        <div class="timeline-scroll" role="region" aria-label="Guidance credibility over time" tabindex="0">
          <div class="timeline-canvas">
            <div class="cred-chart">
              <div class="cred-axis"><span>High</span><span>Developing</span><span>Lower</span></div>
              <div class="cred-plot">
                <div class="cred-bands" aria-hidden="true"><span class="cred-band high"></span><span class="cred-band developing"></span><span class="cred-band lower"></span></div>
                <div class="cred-points">
                  {{#each credibility_timeline.points}}
                  <div class="cred-point {{tone}}">
                    {{#unless @first}}<span class="cred-segment" aria-hidden="true"></span>{{/unless}}
                    <span class="cred-marker {{confidence}}" aria-hidden="true"></span>
                    <div class="cred-labels"><span class="cred-label">{{label}}</span><span class="cred-period">{{period}}</span></div>
                  </div>
                  {{/each}}
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="timeline-footer">
          <div class="timeline-legend" aria-label="Credibility level color key">
            <span class="legend-key"><i></i>High credibility</span>
            <span class="legend-key"><i class="amber"></i>Developing</span>
            <span class="legend-key"><i class="red"></i>Lower</span>
          </div>
          <span class="confidence-note">Larger marker = stronger evidence confidence</span>
        </div>
      </div>
    </section>
    {{/if}}

    {{#if split}}
    <section>
      <div class="section-head">
        <div><p class="section-tag">{{split.section_tag}}</p><h2 class="section-title">{{split.section_title}}</h2></div>
      </div>
      <div class="split-grid">
        <article class="split-card {{split.controllable.color}}">
          <div class="split-head">
            <div><h3 class="split-title">{{split.controllable.title}}</h3><p class="split-sub">{{split.controllable.sub}}</p></div>
            <div class="split-count">{{split.controllable.credible}}/{{split.controllable.total}}<small>credible</small></div>
          </div>
          <progress class="split-progress" value="{{split.controllable.credible}}" max="{{split.controllable.total}}">{{split.controllable.credible}} of {{split.controllable.total}}</progress>
          <ul class="split-items">
            {{#each split.controllable.items}}<li class="split-item"><span class="split-status {{status}}"></span><span>{{text}}</span></li>{{/each}}
          </ul>
        </article>
        <article class="split-card {{split.demand_led.color}}">
          <div class="split-head">
            <div><h3 class="split-title">{{split.demand_led.title}}</h3><p class="split-sub">{{split.demand_led.sub}}</p></div>
            <div class="split-count">{{split.demand_led.credible}}/{{split.demand_led.total}}<small>credible</small></div>
          </div>
          <progress class="split-progress" value="{{split.demand_led.credible}}" max="{{split.demand_led.total}}">{{split.demand_led.credible}} of {{split.demand_led.total}}</progress>
          <ul class="split-items">
            {{#each split.demand_led.items}}<li class="split-item"><span class="split-status {{status}}"></span><span>{{text}}</span></li>{{/each}}
          </ul>
        </article>
      </div>
      {{#if split.takeaway}}<p class="split-takeaway"><strong>Takeaway:</strong> {{split.takeaway}}</p>{{/if}}
    </section>
    {{/if}}

    {{#if watchpoints.length}}
    <section>
      <div class="section-head"><div><p class="section-tag">Forward look</p><h2 class="section-title">Watch next four quarters</h2></div></div>
      <div class="watch-grid">
        {{#each watchpoints}}<article class="watchpoint"><span class="watch-number"></span><h3 class="watch-name">{{name}}</h3><p class="watch-desc">{{desc}}{{#if resolves}} <strong>Resolves: {{resolves}}.</strong>{{/if}}</p></article>{{/each}}
      </div>
    </section>
    {{/if}}

    {{#if evidence.tiles.length}}
    <section>
      <div class="section-head"><div><p class="section-tag">{{evidence.section_tag}}</p><h2 class="section-title">{{evidence.section_title}}</h2></div></div>
      <div class="evidence-grid">
        {{#each evidence.tiles}}
        <article class="evidence-card {{effect}}">
          <div class="evidence-top"><span class="evidence-period">{{period}}</span><span class="evidence-status">{{status}}</span></div>
          <h3 class="evidence-name">{{name}}</h3>
          <p class="evidence-phrase">{{phrase}}</p>
          {{#if source}}<p class="evidence-source">{{#if source.quote}}<span class="evidence-quote">“{{source.quote}}”</span>{{/if}}{{source.meta}}</p>{{/if}}
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if bottom_line.length}}
    <section>
      <div class="section-head"><div><p class="section-tag">Investor takeaway</p><h2 class="section-title">{{investor_takeaway_text}}</h2></div></div>
      <div class="bottom-line">
        {{#each bottom_line}}<div class="bottom-row {{tone}}"><span class="bottom-tag">{{tag}}</span><span class="bottom-copy">{{text}}</span></div>{{/each}}
      </div>
    </section>
    {{/if}}

    <footer><span>Guidance Credibility · {{asset_name}}</span>{{#if footer.sources}}<span>{{#each footer.sources}}{{count}} {{label}}{{#unless @last}} · {{/unless}}{{/each}}</span>{{/if}}</footer>
  </main>
</body>
</html>
