:root{--ink:#1c1c1a;--muted:#6c6c68;--faint:#9a9a96;--line:#e8e7e3;--line2:#f0efeb;--card:#fafaf8;--bg:#fff;--green:#1c7a4d;--green-d:#155f3c;--green-bg:#eef5f0;--green-bd:#cfe5d8;--red:#bb3a32;--red-d:#9a2d27;--red-bg:#fbeeed;--red-bd:#f0d4d1;--amber:#b1750f;--amber-d:#8f5d0a;--amber-bg:#fbf3e3;--amber-bd:#ecd9b5;--blue:#4f6ef7;--blue-bg:#eef0ff;--radius:10px;--qci-accent:#4f6ef7;--qci-accent-bg:#f0f2ff;--qci-accent-bd:#d0d8fd;--qci-accent-dark:#3652d9;--qci-glow:rgba(79,110,247,.12)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased}.serif,.title,.big,.score-num,.qci-title,.lead{font-family:Lora,Georgia,serif}.wrap{max-width:1180px;margin:auto;padding:34px 40px 64px}.top{display:flex;justify-content:space-between;gap:24px;border-bottom:1px solid var(--line);padding-bottom:20px}.lens-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.eyebrow,.sec-title{font-size:11.5px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--faint)}.title{font-size:36px;line-height:1.2;margin:18px 0 0}.xbtn{width:38px;height:38px;border:1px solid var(--line);border-radius:9px;background:#fff;color:var(--faint);font-size:20px}.pill{display:inline-flex;align-items:center;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:4px 11px;border:1px solid;border-radius:6px;white-space:nowrap}.strong,.high,.transparent,.aligned,.positive,.g,.rising,.clean{color:var(--green-d);background:var(--green-bg);border-color:var(--green-bd)}.moderate,.track,.watch,.mixed,.developing,.a,.steady,.unresolved{color:var(--amber-d);background:var(--amber-bg);border-color:var(--amber-bd)}.weak,.low,.risk,.miss,.concerning,.negative,.r,.gap{color:var(--red-d);background:var(--red-bg);border-color:var(--red-bd)}.new,.revised{color:#3652d9;background:#eef0ff;border-color:#d0d8fd}.score-badge{display:flex;align-items:center;gap:16px;margin-top:22px}.score-ring{--score:0;--tone:var(--amber);position:relative;width:72px;height:72px;flex:0 0 auto;border-radius:50%;background:conic-gradient(var(--tone) calc(var(--score)*1%),#f0efeb 0);display:grid;place-items:center}.score-ring:after{content:"";position:absolute;width:58px;height:58px;border-radius:50%;background:#fff}.score-num{position:relative;z-index:1;font-size:21px;font-weight:600}.score-label{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.score-desc{max-width:800px;margin-top:5px;color:var(--muted);font-size:13.5px}.sec{margin-top:42px}.sec-head{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:16px}.sec-note{font-size:13px;color:var(--faint);text-align:right}.grid{display:grid;gap:16px}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}.card,.stat,.watch-card,.keymsg,.chart-card{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);padding:22px 24px}.stat{min-width:0}.lab{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.dot{width:8px;height:8px;border-radius:50%;background:currentColor}.big{font-size:26px;line-height:1.2;font-weight:600;margin:12px 0 9px}.desc,.sub,.meta{color:var(--muted);font-size:13px}.meta{color:var(--faint)}.metric-row{display:grid;grid-template-columns:minmax(160px,1fr) minmax(220px,2fr);gap:18px;padding:15px 0;border-bottom:1px solid var(--line)}.metric-row:last-child{border:0}.metric-name{font-weight:650}.bar{height:8px;background:#ecebe7;border-radius:99px;overflow:hidden;margin-top:10px}.fill{height:100%;background:var(--green);border-radius:inherit}.tag-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.tag{padding:4px 9px;border:1px solid var(--line);border-radius:99px;background:#fff;color:var(--muted);font-size:11px}.qci{margin-top:48px;border:1px solid var(--qci-accent-bd);border-radius:14px;background:#fcfcff;overflow:hidden}.qci-head{position:relative;padding:28px 32px 24px;background:linear-gradient(135deg,#1a1f3a,#2a3060);color:#fff}.qci-badge{display:inline-flex;padding:5px 12px;border:1px solid rgba(139,164,251,.35);border-radius:99px;color:#a9bafa;background:rgba(79,110,247,.12);font-size:10.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.qci-count{position:absolute;right:32px;top:23px;color:#8ba4fb;font:600 30px Lora}.qci-title{margin-top:18px;font-size:26px}.qci-sub{max-width:760px;margin-top:6px;color:rgba(255,255,255,.62);font-size:13.5px}.qci-edge{display:grid;grid-template-columns:120px 1fr;gap:20px;padding:22px 28px;background:linear-gradient(120deg,#1a1f3a,#202660);color:rgba(255,255,255,.86)}.qci-edge-label{color:#8ba4fb;font-weight:700;text-transform:uppercase;letter-spacing:.1em}.qci-edge p{margin:0 0 8px}.qci-edge p:last-child{margin:0}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:var(--radius)}table{width:100%;border-collapse:collapse;min-width:760px;background:#fff}th,td{text-align:left;vertical-align:top;border-bottom:1px solid var(--line);padding:15px 18px}th{background:#f7f7fb;color:var(--faint);font-size:10.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase}td{font-size:13px}tbody tr:last-child td{border-bottom:0}.quote{margin-top:14px;padding:14px 18px;border-left:3px solid var(--amber);background:#fff;font:italic 14px/1.55 Lora,Georgia,serif}.list{list-style:none;padding:0;margin:12px 0 0}.list li{padding:9px 0;border-bottom:1px solid var(--line)}.list li:last-child{border:0}.watch-card{border-left:3px solid var(--amber)}.watch-card h3,.card h3{margin:0 0 8px;font-size:16px}.keymsg{border-left:3px solid var(--green)}.lead{font-size:21px;line-height:1.4;margin:8px 0 12px}.raw{margin-top:14px;border-top:1px solid var(--line);padding-top:10px}.raw summary{cursor:pointer;color:var(--faint);font-size:11px;text-transform:uppercase;letter-spacing:.08em}.raw pre{white-space:pre-wrap;word-break:break-word;color:var(--muted);font:11px/1.45 ui-monospace,monospace}.foot{margin-top:46px;padding-top:18px;border-top:1px solid var(--line);color:var(--faint);font-size:12.5px}.foot strong{color:var(--muted)}
@media(max-width:820px){.wrap{padding:24px 20px 48px}.title{font-size:28px}.grid.two,.grid.three,.grid.four{grid-template-columns:1fr}.sec-head{display:block}.sec-note{text-align:left;margin-top:4px}.qci-count{position:static;margin-top:14px}.qci-edge{grid-template-columns:1fr}.metric-row{grid-template-columns:1fr}.score-desc{font-size:12.5px}}
</style></head>
<body><main class="wrap" data-template-category="earnings-forecast" data-score-status="{{score_badge.status_color}}" data-score-ring="{{score.ring_color}}" data-score-color="{{score.color}}" data-lens-label="{{lens_label}}" data-confidence-only="{{render_rules.confidence_only}}" data-allow-null="{{render_rules.allow_null}}" data-omit-if-unsupported="{{render_rules.omit_if_unsupported}}" data-same-metric-validation="{{render_rules.same_metric_validation}}">
<header class="top"><div><div class="lens-row"><span class="eyebrow">Deal Lens</span>{{#if primary_scenario}}<span class="pill {{primary_scenario.case}}">{{primary_scenario.pill_label}}</span>{{/if}}</div><h1 class="title">Earnings Forecast</h1></div><button class="xbtn" aria-label="Close">&times;</button></header>

{{#if primary_scenario}}<section class="score-badge"><div class="score-ring" style="--score:{{score_badge.score}}"><span class="score-num">{{score_badge.score}}{{score_badge.base_cagr}}</span></div><div><div class="score-label">{{primary_scenario.pill_label}} · {{score_badge.rating}} {{score_badge.label}}</div><div class="score-desc">{{score_badge.desc}}</div><div class="meta">Case: {{primary_scenario.case}} · CAGR: {{primary_scenario.cagr}} · Horizon: {{score_badge.horizon}} · Fill: {{score_badge.fill_fraction}}</div></div></section>{{/if}}
{{#if scenarios}}<section class="sec"><div class="sec-head"><div class="sec-title">Bull · base · bear scenarios</div></div><div class="grid three">{{#each scenarios}}<article class="card {{case}}"><span class="pill {{case}}">{{case}}</span><div class="big">{{cagr}}</div><ul class="list">{{#each drivers}}<li><strong>{{label}}</strong><div class="sub">{{detail}}</div></li>{{/each}}</ul></article>{{/each}}</div></section>{{/if}}
{{#if earnings_chart}}<section class="sec"><div class="sec-head"><div class="sec-title">Earnings forecast path</div><div class="sec-note">Scale maximum · {{earnings_chart.y_max}}</div></div><div class="card"><div class="tag-row">{{#each earnings_chart.labels}}<span class="tag">{{this}}</span>{{/each}}</div><div class="grid three" style="margin-top:16px"><div><strong>Bull</strong><pre>{{json earnings_chart.datasets.bull}}</pre></div><div><strong>Base</strong><pre>{{json earnings_chart.datasets.base}}</pre></div><div><strong>Bear</strong><pre>{{json earnings_chart.datasets.bear}}</pre></div></div></div><details class="raw"><summary>Complete section data</summary><pre>{{json earnings_chart}}</pre></details></section>{{/if}}
{{#if margin_chart}}<section class="sec"><div class="sec-head"><div class="sec-title">{{margin_chart.metric_label}}</div><div class="sec-note">{{margin_chart.metric_note}} · {{margin_chart.unit}}</div></div><div class="card"><div class="tag-row">{{#each margin_chart.labels}}<span class="tag">{{this}}</span>{{/each}}</div><div class="grid three" style="margin-top:16px"><div><strong>Bull</strong><pre>{{json margin_chart.datasets.bull}}</pre></div><div><strong>Base</strong><pre>{{json margin_chart.datasets.base}}</pre></div><div><strong>Bear</strong><pre>{{json margin_chart.datasets.bear}}</pre></div></div></div><details class="raw"><summary>Complete section data</summary><pre>{{json margin_chart}}</pre></details></section>{{/if}}
{{#if patterns}}<section class="qci"><div class="qci-head"><div class="qci-count">{{patterns.n_patterns}}</div><div class="qci-badge">QC Intuition · Forecast Patterns</div><div class="qci-title">What drives the forecast range</div><div class="qci-sub">{{patterns.source_types}}</div></div><div class="table-wrap"><table><thead><tr><th>Pattern</th><th>Evidence</th><th>Read</th><th>Interpretation</th></tr></thead><tbody>{{#each patterns.items}}<tr><td><strong>{{title}}{{label}}{{name}}</strong><div class="sub">{{metric}}</div></td><td>{{value}} {{pct_qualifier}}</td><td>{{read_label}} {{read}}</td><td>{{{interp_short}}} {{{interp_long}}} {{{interp}}}</td></tr>{{/each}}</tbody></table></div><div class="tag-row" style="padding:14px 20px">{{#each patterns.sources}}<span class="tag">{{short}} {{long}}</span>{{/each}}</div>{{#if patterns.edge}}<div class="qci-edge"><div class="qci-edge-label">The Edge</div><div><p>{{patterns.edge.hl_theme}}</p><p>{{patterns.edge.hl2_theme}}</p><p>{{patterns.edge.mechanical_floor}} {{patterns.edge.floor_reason}}</p><p>{{patterns.edge.swing_variable}}</p></div></div>{{/if}}<details class="raw"><summary>Complete section data</summary><pre>{{json patterns}}</pre></details></section>{{/if}}
{{#if assumption_table}}<section class="sec"><div class="sec-head"><div class="sec-title">Assumption table</div><div class="sec-note">Unit · {{assumption_table.unit}}</div></div><div class="table-wrap"><table><thead><tr><th>Metric</th><th>Bull</th><th>Base</th><th>Bear</th><th>Investor read</th></tr></thead><tbody>{{#each assumption_table.rows}}<tr><td>{{metric}}{{label}}</td><td>{{bull}}</td><td>{{base}}</td><td>{{bear}}</td><td>{{read}}{{read_label}}</td></tr>{{/each}}</tbody></table></div><details class="raw"><summary>Complete section data</summary><pre>{{json assumption_table}}</pre></details></section>{{/if}}
{{#if key_message}}<section class="sec keymsg"><div class="sec-title">{{key_message.kicker}}</div><div class="lead">{{key_message.lead}}</div>{{#each key_message.paras}}<p>{{{this}}}</p>{{/each}}<div class="grid two"><div><strong>Bull trigger</strong><p>{{key_message.bull_trigger}}</p></div><div><strong>Bear trigger</strong><p>{{key_message.bear_trigger}}</p></div></div><details class="raw"><summary>Complete section data</summary><pre>{{json key_message}}</pre></details></section>{{/if}}
<footer class="foot"><strong>Forecast sources.</strong> {{footer_sources}}</footer>

<script type="application/json" id="dashboard-data">{{{json this}}}</script>
</main></body></html>
