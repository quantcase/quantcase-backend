<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guidance Credibility — {{{asset_name}}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #1c1c1a;
      --muted: #6c6c68;
      --faint: #9a9a96;
      --line: #e8e7e3;
      --line2: #f0efeb;
      --card: #fafaf8;
      --bg: #fff;
      --green: #1c7a4d;
      --green-d: #155f3c;
      --green-bg: #eef5f0;
      --green-bd: #cfe5d8;
      --red: #bb3a32;
      --red-d: #9a2d27;
      --red-bg: #fbeeed;
      --red-bd: #f0d4d1;
      --amber: #b1750f;
      --amber-d: #8f5d0a;
      --amber-bg: #fbf3e3;
      --amber-bd: #ecd9b5;
      --blue: #4f6ef7;
      --blue-bg: #eef0ff;
      --radius: 10px;
      --qci-accent: #4f6ef7;
      --qci-accent-bg: #f0f2ff;
      --qci-accent-bd: #d0d8fd;
      --qci-accent-dark: #3652d9;
      --qci-glow: rgba(79, 110, 247, .12);
      --qci-rising: #1c7a4d;
      --qci-rising-bg: #eef5f0;
      --qci-new: #4f6ef7;
      --qci-new-bg: #eef0ff;
      --qci-steady: #6c6c68;
      --qci-steady-bg: #f0efeb;
      --qci-watch: #a86e0e;
      --qci-watch-bg: #fbf2e2
    }

    * {
      box-sizing: border-box
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font: 15px/1.55 Inter, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased
    }

    .serif,
    .big,
    .score-num,
    .qci-header-title,
    .qci-signal-count,
    .wname {
      font-family: Lora, Georgia, serif
    }

    .wrap {
      max-width: 1180px;
      margin: auto;
      padding: 34px 40px 64px
    }

    .top {
      display: flex;
      justify-content: space-between;
      border-bottom: 1px solid var(--line);
      padding-bottom: 20px
    }

    .lens-row {
      display: flex;
      align-items: center;
      gap: 12px
    }

    .eyebrow,
    .sec-title {
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: .13em;
      text-transform: uppercase;
      color: var(--faint)
    }

    .title {
      font-size: 36px;
      line-height: 1.2;
      margin: 18px 0 0
    }
    .top-right { display: flex; align-items: flex-start; gap: 20px; }
        .top-meta { border-collapse: separate; border-spacing: 0; width: auto; min-width: 0; background: transparent; border: 1px solid var(--line); border-radius: 6px; margin-left: auto; margin-right: 0; align-self: flex-end; }
        .top-meta th, .top-meta td { padding: 2px 12px; font-size: 10.5px; color: var(--faint); white-space: nowrap; border-bottom: none; font-family: 'Manrope', sans-serif; }
        .top-meta tr:last-child td { padding-bottom: 8px; }
        .top-meta .meta-label { padding-right: 8px; text-align: right; text-transform: uppercase; letter-spacing: .04em; color: #b4b3ae; font-weight: 600; font-size: 9.5px; font-family: 'Manrope', sans-serif; }

    .xbtn {
      width: 38px;
      height: 38px;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: #fff;
      color: var(--faint);
      font-size: 20px
    }

    .pill {
      display: inline-flex;
      align-items: center;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      padding: 4px 11px;
      border: 1px solid;
      border-radius: 6px;
      white-space: nowrap
    }

    .strong,
    .inline,
    .achieved,
    .reaffirmed {
      color: var(--green-d);
      background: var(--green-bg);
      border-color: var(--green-bd)
    }

    .moderate,
    .track,
    .tracking,
    .unresolved {
      color: var(--amber-d);
      background: var(--amber-bg);
      border-color: var(--amber-bd)
    }

    .low,
    .miss,
    .missed {
      color: var(--red-d);
      background: var(--red-bg);
      border-color: var(--red-bd)
    }

    .revised {
      color: #3652d9;
      background: #eef0ff;
      border-color: #d0d8fd
    }

    .discontinued,
    .unclear {
      color: #666;
      background: #f0efeb;
      border-color: #deddd8
    }

    .score-badge {
      display: flex;
      gap: 16px;
      align-items: center;
      margin-top: 22px
    }

    .score-ring {
      position: relative;
      width: 72px;
      height: 72px;
      flex: 0 0 auto
    }

    .score-ring svg {
      display: block
    }

    .score-num {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font-size: 22px;
      font-weight: 600
    }

    .score-label {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase
    }

    .score-desc {
      max-width: 780px;
      margin-top: 5px;
      color: var(--muted);
      font-size: 13.5px;
      line-height: 1.5
    }

    .c-green {
      color: var(--green-d)
    }

    .c-red {
      color: var(--red-d)
    }

    .c-amber {
      color: var(--amber-d)
    }

    .sec {
      margin-top: 42px
    }

    .sec-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 20px;
      margin-bottom: 16px
    }

    .sec-note {
      font-size: 13px;
      color: var(--faint);
      text-align: right
    }

    .trio {
      display: grid;
      grid-template-columns: repeat(var(--count), 1fr);
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--card);
      overflow: hidden
    }

    .stat {
      padding: 24px 26px;
      border-right: 1px solid var(--line)
    }

    .stat:last-child {
      border: 0
    }

    .lab {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--muted)
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%
    }

    .g {
      color: var(--green-d)
    }

    .dot.g {
      background: var(--green)
    }

    .r {
      color: var(--red-d)
    }

    .dot.r {
      background: var(--red)
    }

    .a {
      color: var(--amber-d)
    }

    .dot.a {
      background: var(--amber)
    }

    .big {
      font-size: 27px;
      line-height: 1.18;
      font-weight: 600;
      margin: 15px 0 10px
    }

    .desc {
      font-size: 13.5px;
      color: var(--muted)
    }

    .qci-section {
      margin-top: 48px;
      border: 1px solid var(--qci-accent-bd);
      border-radius: 14px;
      background: #fcfcff;
      overflow: hidden
    }

    .qci-header {
      position: relative;
      overflow: hidden;
      padding: 28px 32px 24px;
      background: linear-gradient(135deg, #1a1f3a, #2a3060)
    }

    .qci-header:before,
    .qci-header:after {
      content: "";
      position: absolute;
      border-radius: 50%;
      background: rgba(139, 164, 251, .07)
    }

    .qci-header:before {
      width: 200px;
      height: 200px;
      right: -40px;
      top: -65px
    }

    .qci-header:after {
      width: 300px;
      height: 150px;
      left: -100px;
      bottom: -100px
    }

    .qci-signal-count {
      position: absolute;
      right: 32px;
      top: 23px;
      color: #8ba4fb;
      font-size: 32px;
      text-align: right
    }

    .qci-signal-count small {
      display: block;
      font: 600 10px Inter;
      letter-spacing: .09em
    }

    .qci-badge {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 5px 12px;
      border: 1px solid rgba(139, 164, 251, .35);
      border-radius: 99px;
      color: #a9bafa;
      background: rgba(79, 110, 247, .12);
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase
    }

    .qci-badge-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #8ba4fb;
      animation: qcipulse 2s infinite
    }

    @keyframes qcipulse {
      50% {
        box-shadow: 0 0 0 6px rgba(139, 164, 251, .12)
      }
    }

    .qci-header-title {
      position: relative;
      margin-top: 20px;
      color: #fff;
      font-size: 26px
    }

    .qci-header-sub {
      position: relative;
      max-width: 720px;
      margin-top: 6px;
      color: rgba(255, 255, 255, .58);
      font-size: 13.5px
    }

    .qci-header-sub strong {
      color: rgba(255, 255, 255, .8)
    }

    .qci-table,
    .tbl {
      width: 100%;
      border-collapse: collapse
    }

    .qci-table th,
    .qci-table td,
    .tbl th,
    .tbl td {
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid var(--line);
      padding: 18px 20px
    }

    .qci-table th,
    .tbl th {
      padding-top: 12px;
      padding-bottom: 12px;
      background: #f7f7fb;
      color: var(--faint);
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase
    }

    .qci-table tbody tr:hover {
      background: #f8f8ff
    }

    .theme-name,
    .m-name {
      font-weight: 600
    }

    .theme-sub,
    .m-desc {
      font-size: 12.5px;
      color: var(--faint);
      margin-top: 3px
    }

    .qci-table th:nth-child(2),
    .qci-table td:nth-child(2) {
      width: 170px;
      min-width: 170px
    }

    .spark {
      display: block;
      width: 130px;
      height: 54px;
      overflow: visible
    }

    .qci-status-pill {
      display: inline-flex;
      border-radius: 20px;
      padding: 5px 11px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase
    }

    .qci-status-pill.new {
      color: var(--qci-new);
      background: var(--qci-new-bg)
    }

    .qci-status-pill.rising {
      color: var(--qci-rising);
      background: var(--qci-rising-bg)
    }

    .qci-status-pill.steady {
      color: var(--qci-steady);
      background: var(--qci-steady-bg)
    }

    .qci-status-pill.mixed {
      color: var(--qci-watch);
      background: var(--qci-watch-bg)
    }

    .qci-sources {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      padding: 14px 20px;
      background: #f7f7fb;
      border-top: 1px solid var(--line);
      font-size: 11px;
      color: var(--faint);
      text-transform: uppercase;
      letter-spacing: .08em
    }

    .qci-src-pill {
      padding: 4px 9px;
      border: 1px solid var(--line);
      border-radius: 99px;
      background: #fff;
      color: var(--muted)
    }

    .qci-edge {
      display: grid;
      grid-template-columns: 120px 1fr;
      gap: 20px;
      padding: 22px 28px;
      background: linear-gradient(120deg, #1a1f3a, #202660);
      color: rgba(255, 255, 255, .85)
    }

    .qci-edge-label {
      color: #8ba4fb;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .1em
    }

    .qci-edge-text {
      font-size: 14.5px
    }

    .qci-edge-text p {
      margin: 0 0 8px
    }

    .qci-edge-text p:last-child {
      margin: 0
    }

    .hl {
      color: #9fb1ff
    }

    .hl2 {
      color: #82dfc4
    }

    .hl3 {
      color: #c7a9ff
    }

    .pct {
      color: #f0c66c
    }

    .scatter,
    .tbl-card,
    .split {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--card);
      overflow: hidden
    }

    .scatter {
      padding: 18px 22px
    }

    .chart {
      width: 100%;
      height: auto;
      min-width: 680px
    }

    .chart-scroll {
      overflow-x: auto
    }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 22px;
      padding: 12px 2px 0;
      color: var(--faint);
      font-size: 11px
    }

    .legend b {
      font-size: 14px
    }

    .tbl-card {
      overflow-x: auto
    }

    .tbl {
      min-width: 900px
    }

    .tbl td {
      font-size: 13px
    }

    .metric {
      position: relative
    }

    .metric:before {
      content: "";
      position: absolute;
      left: 0;
      top: 14px;
      bottom: 14px;
      width: 3px;
      border-radius: 3px
    }

    .metric.positive:before {
      background: var(--green)
    }

    .metric.negative:before {
      background: var(--red)
    }

    .metric.neutral:before {
      background: var(--amber)
    }

    .metric.unknown:before {
      background: var(--faint)
    }

    .src-btn {
      margin-top: 7px;
      border: 0;
      background: none;
      padding: 0;
      color: var(--amber-d);
      cursor: pointer;
      font: 600 11.5px Inter
    }

    .src-row td {
      padding: 0 !important
    }

    .src-inner {
      max-height: 0;
      overflow: hidden;
      transition: max-height .28s
    }

    .src-row.open .src-inner {
      max-height: 200px;
      padding: 15px 22px
    }

    .quote {
      font-family: Georgia, serif;
      font-style: italic;
      border-left: 2px solid var(--amber);
      padding-left: 14px
    }

    .src-meta {
      margin-top: 6px;
      color: var(--faint);
      font-size: 11.5px
    }

    .split {
      padding: 24px 26px
    }

    .split-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
      align-items: stretch
    }

    .control-column {
      display: flex;
      flex-direction: column;
      min-width: 0
    }

    .control-column__header {
      min-height: 66px;
      margin-bottom: 12px
    }

    .control-column__header h3 {
      margin: 0 0 6px;
      font-size: 14px;
      line-height: 1.25
    }

    .control-column__header p {
      margin: 0;
      color: #777772;
      font-size: 11px;
      line-height: 1.45
    }

    .control-column__metric {
      width: 100%;
      margin-bottom: 18px
    }

    .control-column__metric-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 7px;
      color: #969691;
      font-size: 10px;
      line-height: 1.2
    }

    .control-column__metric-label span:last-child {
      flex-shrink: 0
    }

    .control-column__bar {
      width: 100%;
      height: 7px;
      overflow: hidden;
      background: #eeeeea;
      border-radius: 999px
    }

    .control-column__bar-fill {
      height: 100%;
      background: #258355;
      border-radius: inherit
    }

    .signal-list {
      list-style: none;
      padding: 0;
      margin: 0
    }

    .signal-list li {
      position: relative;
      padding: 6px 0 6px 17px;
      font-size: 13px
    }

    .signal-list li:before {
      content: "";
      position: absolute;
      left: 0;
      top: 13px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--faint)
    }

    .signal-list li.achieved:before,
    .signal-list li.reaffirmed:before {
      background: var(--green)
    }

    .signal-list li.tracking:before,
    .signal-list li.unresolved:before {
      background: var(--amber)
    }

    .signal-list li.missed:before {
      background: var(--red)
    }

    .signal-list li.revised:before {
      background: var(--blue)
    }

    .takeaway {
      margin-top: 22px;
      padding-top: 18px;
      border-top: 1px solid var(--line);
      color: var(--muted)
    }

    .watch {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px
    }

    .wcard {
      border: 1px solid var(--line);
      border-left: 3px solid var(--amber);
      border-radius: 8px;
      padding: 19px 20px;
      background: var(--card)
    }

    .wtop {
      display: flex;
      justify-content: space-between;
      gap: 14px
    }

    .wname {
      font-size: 17px;
      font-weight: 600
    }

    .wdesc {
      margin: 9px 0;
      color: var(--muted);
      font-size: 13px
    }

    .wfoot {
      display: flex;
      gap: 18px;
      color: var(--faint);
      font-size: 11.5px
    }

    .foot {
      margin-top: 46px;
      padding-top: 18px;
      border-top: 1px solid var(--line);
      color: var(--faint);
      font-size: 12.5px
    }

    .foot strong {
      color: var(--muted)
    }

    .timeline-leader {
      stroke: #d8d6d0;
      stroke-width: 1;
      stroke-dasharray: 2 3
    }

    .timeline-label-box {
      overflow: visible
    }

    .timeline-label-card {
      width: 104px;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      font-family: Inter, system-ui, sans-serif
    }

    .timeline-label-card.above {
      justify-content: flex-end;
      padding-bottom: 2px
    }

    .timeline-label-card.below {
      justify-content: flex-start;
      padding-top: 2px
    }

    .timeline-label-text {
      max-width: 104px;
      color: #4f4f4b;
      font-size: 10px;
      font-weight: 600;
      line-height: 1.18;
      overflow-wrap: anywhere;
      word-break: normal;
      hyphens: auto
    }

    .timeline-label-period {
      margin-top: 3px;
      color: #9a9a96;
      font-size: 9.5px;
      line-height: 1.15;
      white-space: nowrap
    }

    .timeline-points>.timeline-point:nth-child(odd) .label-below {
      display: none
    }

    .timeline-points>.timeline-point:nth-child(even) .label-above {
      display: none
    }

    .signal-list li.signal-achieved:before,
    .signal-list li.signal-reaffirmed:before {
      background: var(--green)
    }

    .signal-list li.signal-tracking:before,
    .signal-list li.signal-unresolved:before {
      background: var(--amber)
    }

    .signal-list li.signal-missed:before {
      background: var(--red)
    }

    .signal-list li.signal-revised:before {
      background: var(--blue)
    }

    @media(max-width:820px) {
      .wrap {
        padding: 24px 20px 48px
      }

      .title {
        font-size: 28px
      }

      .trio,
      .split-grid,
      .watch {
        grid-template-columns: 1fr
      }

      .stat {
        border-right: 0;
        border-bottom: 1px solid var(--line)
      }

      .sec-head {
        display: block
      }

      .sec-note {
        text-align: left;
        margin-top: 4px
      }

      .qci-signal-count {
        position: relative;
        right: auto;
        top: auto;
        text-align: left;
        margin: 14px 0
      }

      .qci-table {
        min-width: 760px
      }

      .qci-body {
        overflow-x: auto
      }

      .qci-edge {
        grid-template-columns: 1fr
      }

      .wfoot {
        display: block
      }

      .score-desc {
        font-size: 12.5px
      }
    }

    /* Shared visual-consistency update */
    .score-badge:not(.no-score)>div:last-child {
      flex: 1;
      min-width: 0;
      padding: 15px 18px;
      border: 1px solid var(--line);
      border-left: 3px solid var(--amber);
      border-radius: var(--radius);
      background: var(--card);
      box-shadow: 0 1px 0 rgba(18, 24, 39, .02)
    }

    .score-badge:not(.no-score) .score-desc {
      max-width: none
    }

    .qci-edge {
      align-items: start;
      background: #172445 !important
    }

    .qci-edge .edge-copy {
      margin: 0;
      font-size: 14.5px;
      line-height: 1.68;
      color: rgba(255, 255, 255, .84)
    }

    .qci-edge .edge-copy strong {
      color: #fff
    }

    .edge-accent,
    .edge-positive,
    .edge-watch,
    .edge-risk,
    .edge-segment {
      font-weight: 700
    }

    .edge-accent,
    .edge-segment-0 {
      color: #9fb1ff
    }

    .edge-positive,
    .edge-segment-1 {
      color: #77dec0
    }

    .edge-watch,
    .edge-segment-2 {
      color: #f0c66c
    }

    .edge-risk,
    .edge-segment-3 {
      color: #ff9b8f
    }

    .edge-segment+.edge-segment:before {
      content: " ";
      white-space: pre
    }

    .synthesis-card {
      padding: 24px 26px !important
    }

    .synthesis-card>.sec-title {
      margin-bottom: 14px
    }

    .synthesis-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(205px, 1fr));
      border-top: 1px solid var(--line)
    }

    .synthesis-panel {
      min-width: 0;
      padding: 17px 18px 2px;
      border-left: 1px solid var(--line)
    }

    .synthesis-panel:first-child {
      padding-left: 0;
      border-left: 0
    }

    .synthesis-panel .lead {
      margin: 0;
      font-size: 18px;
      line-height: 1.45
    }

    .synthesis-panel p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.58
    }

    .synthesis-label {
      display: block;
      margin-bottom: 7px;
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: .09em;
      text-transform: uppercase;
      background: none !important;
      border: 0 !important
    }

    .synthesis-label.neutral {
      color: #5267c8
    }

    .synthesis-label.positive {
      color: var(--green-d)
    }

    .synthesis-label.watch {
      color: var(--amber-d)
    }

    .synthesis-label.risk {
      color: var(--red-d)
    }

    @media(max-width:820px) {
      .synthesis-grid {
        grid-template-columns: 1fr
      }

      .synthesis-panel,
      .synthesis-panel:first-child {
        padding: 15px 0;
        border-left: 0;
        border-top: 1px solid var(--line)
      }

      .synthesis-panel:first-child {
        border-top: 0
      }

      .qci-edge .edge-copy {
        font-size: 13.5px
      }
    }

    /* Unified typography: one sans-serif family across every UI element. */
    :root {
      --font-sans: 'Manrope', Inter, Arial, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
    }

    html,
    body,
    button,
    input,
    select,
    textarea {
      font-family: var(--font-sans) !important
    }

    body *,
    body *::before,
    body *::after {
      font-family: var(--font-sans) !important
    }
          /* QC Intuition Table PC Layout Fix */
        .qci table, .qci-table { table-layout: fixed; }
        .qci table th:nth-child(1), .qci-table th:nth-child(1) { width: 32% !important; }
        .qci table th:nth-child(2), .qci-table th:nth-child(2) { width: 14% !important; }
        .qci table th:nth-child(3), .qci-table th:nth-child(3) { width: 14% !important; }
        .qci table th:nth-child(4), .qci-table th:nth-child(4) { width: 40% !important; }
</style>
</head>

<body>
  <main class="wrap">
    <header class="top">
      <div>
        <div class="lens-row"><span class="eyebrow">Management lens</span><span
            class="pill {{{ratingClass overall_rating.pill}}}">{{{overall_rating.label}}}</span></div>
        <h1 class="title serif">Guidance Credibility</h1>
        <div class="asset-kicker">{{{asset_name}}}</div>
      </div>
      <div class="top-right">
      {{#if source_meta}}
      <table class="top-meta">
                <tr><th colspan="2" style="padding: 8px 12px 4px; text-align: center; color: #b4b3ae; font-size: 9.5px; font-weight: 400; font-style: italic; white-space: nowrap; border-bottom: none;">Latest analysed</th></tr>
          {{#if source_meta.transcript}}<tr><td class="meta-label">Transcript</td><td>{{{source_meta.transcript}}}</td></tr>{{/if}}
          {{#if source_meta.ppt}}<tr><td class="meta-label">Investor Presentation</td><td>{{{source_meta.ppt}}}</td></tr>{{/if}}
          {{#if source_meta.annual_report}}<tr><td class="meta-label">Annual Report</td><td>{{{source_meta.annual_report}}}</td></tr>{{/if}}
      </table>
      {{/if}}
      </div>
    </header>
    {{#if score_badge}}
      <section class="score-badge">
        <div class="score-ring"><svg width="72" height="72" aria-hidden="true">
            <circle cx="36" cy="36" r="30" fill="none" stroke="#f0efeb" stroke-width="7" />
            <circle cx="36" cy="36" r="30" fill="none" stroke="{{{statusHex score_badge.status_color}}}" stroke-width="7"
              stroke-linecap="round" stroke-dasharray="188.5" stroke-dashoffset="{{{scoreOffset score_badge.score}}}"
              transform="rotate(-90 36 36)" />
          </svg><span class="score-num c-{{{lower score_badge.status_color}}}">{{{score_badge.score}}}</span></div>
        <div>
          <div class="score-label c-{{{lower score_badge.status_color}}}">{{{score_badge.label}}}</div>
          <div class="score-desc">{{{score_badge.desc}}}</div>
        </div>
      </section>
    {{/if}}
    {{#if headline.length}}
      <section class="sec">
        <div class="sec-head">
          <div class="sec-title">Headline insights</div>
          <div class="sec-note">How consistently management delivers - and on which kinds of promises.</div>
        </div>
        <div class="trio" style="--count:{{{headline.length}}}">{{#each headline}}
            <article class="stat">
              <div class="lab"><span class="dot {{{dot}}}"></span>{{{label}}}</div>
              <div class="big {{{value_color}}}">{{{value}}}</div>
              <div class="desc">{{{desc}}}</div>
            </article>
          {{/each}}</div>
      </section>
    {{/if}}
    {{#if narrative.themes.length}}
      <section class="qci-section">
        <div class="qci-header">
          <div class="qci-badge"><i class="qci-badge-dot"></i>QC Intuition · Pattern Recognition</div>
          <div class="qci-header-title">What management is really saying.</div>
          {{!-- <div class="qci-header-sub">Recurring <strong>future commitments, execution updates and disclosure
              patterns</strong> extracted from Annual Reports and Management Presentations across
            <strong>{{{narrative.period_start}}} &rarr; {{{narrative.period_end}}}</strong>, highlighting how management
            communicates, updates and follows through on long-term commitments.</div> --}}
        </div>
        <div class="qci-body">
          <table class="qci-table">
            <thead>
              <tr>
                <th style="width:220px">THEME</th>
                <th>SIGNAL TREND {{{narrative.period_start}}} &rarr; {{{narrative.period_end}}}</th>
                <th>Status</th>
                <th>What it means</th>
              </tr>
            </thead>
            <tbody>{{#each narrative.themes}}
                <tr>
                  <td>
                    <div class="theme-name">{{{name}}}</div>
                    <div class="theme-sub">{{{sub}}}</div>
                  </td>
                  <td><svg class="spark" viewBox="0 0 110 46" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                      <polyline points="{{{trendSparkPoints trend}}}" fill="none" stroke="{{{trendHex trend}}}"
                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                        vector-effect="non-scaling-stroke" />
                      <circle cx="104" cy="{{{trendSparkEndY trend}}}" r="3.5" fill="{{{trendHex trend}}}" />
                    </svg></td>
                  <td><span class="qci-status-pill {{{lower trend}}}">{{{trendGlyph trend}}} {{{trend}}}</span></td>
                  <td>{{{bold interp}}}</td>
                </tr>
              {{/each}}</tbody>
          </table>
        </div>

        {{#if narrative.edge}}
          <div class="qci-edge">
            <div class="qci-edge-label">THE EDGE</div>
            <div class="qci-edge-text">
              <p class="edge-copy">{{#if narrative.edge.core_pattern}}<span
                    class="edge-accent">{{{narrative.edge.core_pattern}}}</span>
                {{/if}}{{#if narrative.edge.core_behaviour}}<span
                    class="edge-accent">{{{narrative.edge.core_behaviour}}}</span>
                {{/if}}{{#if narrative.edge.credibility_implication}}<strong>Credibility implication:</strong> <span
                    class="edge-positive">{{{narrative.edge.credibility_implication}}}</span>
                {{/if}}{{#if narrative.edge.key_watch_item}}<strong>Key watch item:</strong> <span
                    class="edge-watch">{{{narrative.edge.key_watch_item}}}</span>
                {{/if}}{{#if narrative.edge.investor_focus}}<span
                    class="edge-watch">{{{narrative.edge.investor_focus.theme}}}</span>{{#if narrative.edge.investor_focus.reason}}
                    — {{{narrative.edge.investor_focus.reason}}}{{/if}}
                {{/if}}{{#if narrative.edge.supporting_metric}}<strong>Supporting metric:</strong> <span
                    class="edge-risk">{{{narrative.edge.supporting_metric}}}</span>
                {{/if}}{{#if narrative.edge.closing_line}}<span>{{{narrative.edge.closing_line}}}</span>{{/if}}</p>
            </div>
          </div>
        {{/if}}
      </section>
    {{/if}}
    {{#if credibility_timeline.length}}
      <section class="sec">
        <div class="sec-head">
          <div class="sec-title">Management Credibility Over Time</div>
          <div class="sec-note">Has management's guidance behaviour become more or less credible over time? Recent commnication carries greater weight</div>
        </div>
        <div class="scatter">
          <div class="chart-scroll"><svg class="chart" viewBox="0 0 1080 270" role="img"
              aria-label="Guidance credibility timeline {{{narrative.period_start}}} → {{{narrative.period_end}}}">
              <line x1="145" y1="170" x2="1040" y2="170" stroke="#e2e1dd" />
              <line x1="145" y1="70" x2="1040" y2="70" stroke="#f0efeb" stroke-dasharray="3 4" />
              <line x1="145" y1="115" x2="1040" y2="115" stroke="#f0efeb" stroke-dasharray="3 4" />
              <g fill="#9a9a96" font-family="Inter" font-size="11"><text x="10" y="60">High Credibility</text><text
                  x="10" y="112">Developing</text><text x="10" y="172">Lower Credibility</text></g>
              <polyline points="{{{timelinePoints credibility_timeline}}}" fill="none" stroke="#cbc9c2" stroke-width="2"
                stroke-linejoin="round" />
              <g class="timeline-points">{{#each credibility_timeline}}
                  <g class="timeline-point"
                    transform="translate({{{timelineX @index ../credibility_timeline.length}}} 0)">
                    <title>{{{label}}} · {{{period}}}</title>
                    <line class="timeline-leader label-above" x1="0" y1="{{{markerY credibility}}}" x2="0" y2="64" />
                    <line class="timeline-leader label-below" x1="0" y1="{{{markerY credibility}}}" x2="0" y2="178" />
                    {{#if (eq credibility "insufficient")}}
                      <circle cx="0" cy="{{{markerY credibility}}}" r="{{{markerRadius confidence}}}" fill="none"
                        stroke="#9a9a96" stroke-width="2" />
                    {{else}}
                      <circle cx="0" cy="{{{markerY credibility}}}" r="{{{markerRadius confidence}}}"
                        fill="{{{credibilityHex credibility}}}" />
                    {{/if}}
                    <foreignObject class="timeline-label-box label-above" x="-52" y="7" width="104" height="55">
                      <div xmlns="http://www.w3.org/1999/xhtml" class="timeline-label-card above">
                        <div class="timeline-label-text">{{{label}}}</div>
                        <div class="timeline-label-period">{{{period}}}</div>
                      </div>
                    </foreignObject>
                    <foreignObject class="timeline-label-box label-below" x="-52" y="181" width="104" height="62">
                      <div xmlns="http://www.w3.org/1999/xhtml" class="timeline-label-card below">
                        <div class="timeline-label-text">{{{label}}}</div>
                        <div class="timeline-label-period">{{{period}}}</div>
                      </div>
                    </foreignObject>
                  </g>
                {{/each}}</g>
            </svg></div>
          <div class="legend"><span><b style="color:var(--green)">●</b> High Credibility</span><span><b
                style="color:var(--amber)">●</b> Mixed / Developing Credibility</span><span><b
                style="color:var(--red)">●</b> Lower Credibility</span><span><b>○</b> Insufficient
              Evidence</span><span>Marker size represents confidence in the assessment, not company performance.</span>
          </div>
        </div>
      </section>
    {{/if}}
    {{#with (timelineRows this)}}{{#if length}}
        <section class="sec">
          <div class="sec-head">
            <div class="sec-title">Guidance Behaviour Timeline</div>
            <div class="sec-note">How management's commitments evolved over time - guidance, execution updates, revisions and outcomes.</div>
          </div>
          <div class="tbl-card">
            <table class="tbl">
              <thead>
                <tr>
                  <th style="width:80px">Period</th>
                  <th>Guidance Signal</th>
                  <th>Management Update</th>
                  <th>Outcome</th>
                  <th>Behaviour</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>{{#each this}}
                  <tr>
                    <td>{{{period}}}</td>
                    <td class="metric {{{effectClass this}}}">
                      <div class="m-name">{{{topic}}}</div>
                      <div class="m-desc">{{{description}}}</div>{{#if source}}<button class="src-btn"
                          onclick="toggleSrc(this,{{{@index}}})">&#9656; Source quote</button>{{/if}}
                    </td>
                    <td>{{{evidenceText this}}}</td>
                    <td>{{{outcome}}}</td>
                    <td>{{{evidenceType this}}}</td>
                    <td><span class="pill {{{statusClass status}}}">{{{status}}}</span></td>
                  </tr>{{#if source}}
                    <tr class="src-row" id="src-{{{@index}}}">
                      <td colspan="6">
                        <div class="src-inner">{{#if source.quote}}
                            <div class="quote">&ldquo;{{{source.quote}}}&rdquo;</div>
                          {{/if}}{{#if source.meta}}
                            <div class="src-meta">{{{source.meta}}}</div>
                          {{/if}}</div>
                      </td>
                    </tr>
                  {{/if}}
                {{/each}}</tbody>
            </table>
          </div>
        </section>
      {{/if}}{{/with}}
    {{#if split}}
      <section class="sec">
        <div class="sec-head">
          <div class="sec-title">Guidance Credibility by Controllability</div>
          <div class="sec-note">Where does management's guidance prove most reliable? Separate execution-driven
            commitments from those that depend on market demand.</div>
        </div>
        <div class="split">
          <div class="split-grid">{{#eachBucket split}}
              <div class="control-column">
                <div class="control-column__header">
                  <h3>{{{title}}}</h3>
                  <p>{{{sub}}}</p>
                </div>
                <div class="control-column__metric">
                  <div class="control-column__metric-label"><span>Credible guidance ratio</span><span>{{{credible}}} /
                      {{{total}}}</span></div>
                  <div class="control-column__bar">
                    <div class="control-column__bar-fill" style="width:{{{ratioPercent credible total}}}%;"></div>
                  </div>
                </div>
                <ul class="signal-list">{{#each items}}
                    <li class="signal-{{{statusClass status}}}">{{{text}}}</li>
                  {{/each}}</ul>
              </div>
            {{/eachBucket}}</div>{{#if split.takeaway}}
            <div class="takeaway">{{{bold split.takeaway}}}</div>
          {{/if}}
        </div>
      </section>
    {{/if}}
    {{#if watchpoints.length}}
      <section class="sec">
        <div class="sec-head">
          <div class="sec-title">Open promises · watch next</div>
          <div class="sec-note">Live commitments that resolve in upcoming results — the reason to come back.</div>
        </div>
        <div class="watch">{{#each watchpoints}}
            <article class="wcard">
              <div class="wtop">
                <div class="wname">{{{name}}}</div><span class="pill track">Tracking</span>
              </div>
              <div class="wdesc">{{{desc}}}</div>
              <div class="wfoot"><span>Resolves: <strong>{{{resolves}}}</strong></span><span>Type:
                  <strong>{{{typeLabel type}}}</strong></span></div>
            </article>
          {{/each}}</div>
      </section>
    {{/if}}
    {{#if narrative.edge}}
      <section class="sec keymsg synthesis-card">
        <div class="sec-title">Synthesis</div>
        <div class="synthesis-grid">{{#if narrative.edge.closing_line}}
            <div class="synthesis-panel"><span class="synthesis-label neutral">Bottom line</span>
              <div class="lead">{{{narrative.edge.closing_line}}}</div>
            </div>
          {{/if}}{{#if narrative.edge.core_behaviour}}
            <div class="synthesis-panel"><span class="synthesis-label positive">Core behaviour</span>
              <p>{{{narrative.edge.core_behaviour}}}</p>
            </div>
          {{/if}}{{#if narrative.edge.investor_focus}}
            <div class="synthesis-panel"><span class="synthesis-label watch">Investor focus</span>
              <p>{{{narrative.edge.investor_focus.theme}}}{{#if narrative.edge.investor_focus.reason}} —
                  {{{narrative.edge.investor_focus.reason}}}{{/if}}</p>
            </div>
          {{/if}}{{#if narrative.edge.supporting_metric}}
            <div class="synthesis-panel"><span class="synthesis-label risk">Supporting metric</span>
              <p>{{{narrative.edge.supporting_metric}}}</p>
            </div>
          {{/if}}</div>
      </section>
    {{/if}}
    </main>
  <script>function toggleSrc(btn, id) { var row = document.getElementById('src-' + id); var open = row.classList.toggle('open'); btn.innerHTML = (open ? '▾ Source quote' : '▸ Source quote') }</script>
</body>

</html>