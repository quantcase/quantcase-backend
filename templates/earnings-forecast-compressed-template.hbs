<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Earnings Forecast — {{{asset_name}}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Source+Serif+4:wght@500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #20201e;
      --muted: #686864;
      --faint: #969691;
      --line: #e5e4df;
      --line-dark: #cfcec8;
      --surface: #f3f3f0;
      --surface-soft: #f6f6f3;
      --page: #ffffff;
      --teal: #0e9c86;
      --teal-dark: #087967;
      --teal-soft: #e8f5f2;
      --amber: #c07c12;
      --amber-soft: #fbf1df;
      --red: #c43d34;
      --red-soft: #f9e9e7;
      --blue: #3d5afe;
      --blue-soft: #e9edff;
      --navy: #181e39;
      --radius: 13px
    }

    * {
      box-sizing: border-box
    }

    html {
      scroll-behavior: smooth
    }

    body {
      margin: 0;
      background: var(--page);
      color: var(--ink);
      font: 14px/1.55 'Manrope', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased
    }

    .report {
      width: min(1040px, 100%);
      margin: auto;
      padding: 28px 28px 52px
    }

                .hero {
      display: grid;
      grid-template-columns: 176px minmax(0, 1fr);
      gap: 30px;
      align-items: center;
      min-height: 300px;
      margin-top: 20px;
      padding: 34px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 18px
    }

    .score-ring {
      --score: 0;
      --ring: var(--amber);
      position: relative;
      width: 164px;
      aspect-ratio: 1;
      border-radius: 50%;
      background: conic-gradient(var(--ring) calc(var(--score)*1%), #ecebe7 0);
      display: grid;
      place-items: center
    }

    .score-ring:after {
      content: "";
      position: absolute;
      width: 132px;
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--surface)
    }

    .score-ring.green {
      --ring: var(--teal)
    }

    .score-ring.red {
      --ring: var(--red)
    }

    .score-copy {
      position: relative;
      z-index: 1;
      text-align: center
    }

    .score-value {
      display: block;
      font: 600 42px/1 'Source Serif 4', Georgia, serif
    }

    .score-scale {
      display: block;
      margin-top: 7px;
      color: var(--faint);
      font: 600 9px/1.2 'Manrope', system-ui, sans-serif;
      text-transform: uppercase
    }

    .eyebrow,
    .section-tag {
      margin: 0;
      color: var(--teal-dark);
      font: 700 10px/1.3 'Manrope', system-ui, sans-serif;
      letter-spacing: .09em;
      text-transform: uppercase
    }

    .action-title {
      max-width: 720px;
      margin: 12px 0 10px;
      font: 600 clamp(26px, 4vw, 39px)/1.12 'Source Serif 4', Georgia, serif;
      letter-spacing: -.025em
    }

    .verdict {
      max-width: 760px;
      margin: 0;
      color: var(--muted);
      font-size: 14px
    }

    .rating-line {
      margin-top: 12px
    }

    .rating-badge {
      display: inline-flex;
      padding: 4px 9px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase
    }

    .rating-badge.green,
    .rating-badge.g,
    .tone-g {
      color: var(--teal-dark);
      background: var(--teal-soft)
    }

    .rating-badge.amber,
    .rating-badge.a,
    .tone-a {
      color: #875408;
      background: var(--amber-soft)
    }

    .rating-badge.blue,
    .rating-badge.b,
    .tone-b {
      color: #2944bd;
      background: var(--blue-soft)
    }

    .rating-badge.red,
    .rating-badge.r,
    .tone-r {
      color: #9a3029;
      background: var(--red-soft)
    }

    .reasons {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 18px
    }

    .reason {
      padding: 6px 9px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--surface-soft);
      font-size: 11px;
      font-weight: 600
    }

    .reason.g {
      border-color: #b9dfd7
    }

    .reason.a {
      border-color: #ead3a8
    }

    .reason.b {
      border-color: #c3d0ff
    }

    .reason.r {
      border-color: #ecc4c0
    }

    section {
      margin-top: 36px
    }

    .section-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 13px
    }

    .section-title {
      margin: 4px 0 0;
      font: 600 22px/1.2 'Source Serif 4', Georgia, serif
    }

    .section-note {
      max-width: 520px;
      margin: 0;
      color: var(--faint);
      font-size: 11px;
      text-align: right
    }

    .headline-grid,
    .pattern-grid,
    .watch-grid,
    .three-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px
    }

    .two-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px
    }

    .headline-card,
    .pattern-card,
    .watch-card,
    .panel,
    .metric-card,
    .evidence-card {
      position: relative;
      min-width: 0;
      padding: 18px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius)
    }

    .headline-card {
      border-top: 4px solid var(--teal)
    }

    .headline-card.a {
      border-top-color: var(--amber)
    }

    .headline-card.b {
      border-top-color: var(--blue)
    }

    .headline-card.r {
      border-top-color: var(--red)
    }

    .headline-label {
      margin: 0;
      color: var(--faint);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .07em;
      text-transform: uppercase
    }

    .headline-value {
      margin: 12px 0 7px;
      font: 600 22px/1.15 'Source Serif 4', Georgia, serif
    }

    .headline-value.g {
      color: var(--teal-dark)
    }

    .headline-value.a {
      color: #875408
    }

    .headline-value.b {
      color: #2944bd
    }

    .headline-value.r {
      color: #9a3029
    }

    .headline-sub,
    .card-copy {
      margin: 0;
      color: var(--muted);
      font-size: 11.5px;
      line-height: 1.48
    }

    .intuition-panel {
      min-height: 210px;
      padding: 28px;
      background: var(--navy);
      color: #fff;
      border-radius: 16px
    }

    .intuition-badge,
    .edge-badge {
      display: inline-flex;
      padding: 5px 10px;
      border: 1px solid rgba(139, 164, 251, .35);
      border-radius: 999px;
      color: #a9bafa;
      background: rgba(79, 110, 247, .1);
      font: 700 9.5px/1.3 'Manrope', system-ui, sans-serif;
      letter-spacing: .08em;
      text-transform: uppercase
    }

    .intuition-heading {
      max-width: 760px;
      margin: 42px 0 8px;
      font: 600 27px/1.2 'Source Serif 4', Georgia, serif
    }

    .intuition-line {
      max-width: 820px;
      margin: 0;
      color: rgba(255, 255, 255, .68);
      font-size: 13px
    }

    .pattern-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr))
    }

    .pattern-card {
      min-height: 177px
    }

    .pattern-card.full {
      grid-column: span 2
    }

    .pattern-visual {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 10px;
      min-height: 42px
    }

    .sparkline {
      display: flex;
      align-items: flex-end;
      gap: 4px;
      width: 92px;
      height: 38px;
      padding-bottom: 3px;
      border-bottom: 1px solid var(--line)
    }

    .sparkline i {
      display: block;
      flex: 1;
      min-width: 5px;
      background: var(--teal);
      border-radius: 3px 3px 0 0
    }

    .sparkline i.v1 {
      height: 18%
    }

    .sparkline i.v2 {
      height: 35%
    }

    .sparkline i.v3 {
      height: 54%
    }

    .sparkline i.v4 {
      height: 75%
    }

    .sparkline i.v5 {
      height: 96%
    }

    .pattern-card.a .sparkline i {
      background: var(--amber)
    }

    .pattern-card.b .sparkline i {
      background: var(--blue)
    }

    .pattern-card.r .sparkline i {
      background: var(--red)
    }

    .trend {
      padding: 3px 7px;
      border-radius: 999px;
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase
    }

    .trend.rising {
      color: var(--teal-dark);
      background: var(--teal-soft)
    }

    .trend.steady,
    .trend.mixed {
      color: #875408;
      background: var(--amber-soft)
    }

    .trend.weakening {
      color: #9a3029;
      background: var(--red-soft)
    }

    .trend.new {
      color: #2944bd;
      background: var(--blue-soft)
    }

    .pattern-name {
      margin: 18px 0 5px;
      font-size: 13px
    }

    .pattern-meaning {
      margin: 0;
      color: var(--muted);
      font-size: 11.5px
    }

    .edge-panel {
      padding: 22px;
      background: var(--navy);
      color: #fff;
      border-radius: 15px
    }

    .edge-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
      margin-top: 20px
    }

    .edge-label {
      margin: 0 0 5px;
      color: #8ba4fb;
      font: 700 9px/1.3 'Manrope', system-ui, sans-serif;
      letter-spacing: .08em;
      text-transform: uppercase
    }

    .edge-copy {
      margin: 0;
      color: rgba(255, 255, 255, .75);
      font-size: 12.5px
    }

    .edge-copy.accent {
      color: #91dfd1
    }

    .focus-chip {
      display: inline-block;
      margin-right: 7px;
      padding: 3px 7px;
      color: #f0c070;
      background: rgba(240, 192, 112, .1);
      border-radius: 5px;
      font-weight: 700
    }

    .card-title {
      margin: 0 0 5px;
      font-size: 13px
    }

    .card-meta {
      margin: 0 0 9px;
      color: var(--faint);
      font: 600 9.5px/1.35 'Manrope', system-ui, sans-serif;
      text-transform: uppercase
    }

    .list {
      margin: 10px 0 0;
      padding: 0;
      list-style: none
    }

    .list li {
      padding: 8px 0;
      color: var(--muted);
      border-top: 1px solid var(--line);
      font-size: 11.5px
    }

    .status-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      margin-right: 7px;
      border-radius: 50%;
      background: var(--amber)
    }

    .status-dot.g {
      background: var(--teal)
    }

    .status-dot.r {
      background: var(--red)
    }

    .bar-row {
      display: grid;
      grid-template-columns: minmax(135px, 1fr) minmax(180px, 2.4fr) 48px;
      gap: 12px;
      align-items: center;
      padding: 10px 0;
      border-top: 1px solid var(--line)
    }

    .bar-row:first-child {
      border-top: 0
    }

    .bar-row>.quote {
      grid-column: 1/-1
    }

    .bar-name {
      font-size: 11.5px;
      font-weight: 600
    }

    .bar-track {
      height: 7px;
      overflow: hidden;
      background: var(--surface-soft);
      border-radius: 99px
    }

    .bar-fill {
      height: 100%;
      background: var(--teal);
      border-radius: inherit
    }

    .bar-fill.a {
      background: var(--amber)
    }

    .bar-fill.b {
      background: var(--blue)
    }

    .bar-fill.r {
      background: var(--red)
    }

    .bar-value {
      text-align: right;
      font: 700 11px/1.2 'Manrope', system-ui, sans-serif
    }

    .table-scroll,
    .chart-scroll,
    .timeline-scroll {
      overflow-x: auto;
      padding-bottom: 7px;
      scrollbar-width: thin;
      scrollbar-color: var(--line-dark) transparent
    }

    .data-table {
      width: 100%;
      min-width: 720px;
      border-collapse: collapse;
      background: var(--surface);
      border: 1px solid var(--line)
    }

    .data-table th,
    .data-table td {
      padding: 12px 14px;
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid var(--line)
    }

    .data-table th {
      color: var(--faint);
      background: var(--surface-soft);
      font-size: 9.5px;
      letter-spacing: .07em;
      text-transform: uppercase
    }

    .data-table td {
      color: var(--muted);
      font-size: 11.5px
    }

    .data-table tr:last-child td {
      border-bottom: 0
    }

    .quote {
      display: block;
      margin-top: 7px;
      padding-left: 9px;
      color: var(--faint);
      border-left: 2px solid var(--amber);
      font-style: italic
    }

    .timeline-canvas {
      min-width: 760px;
      padding: 18px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius)
     width: max-content; }

    .timeline-track {
      position: relative;
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(130px, 1fr);
      min-height: 150px;
      padding-top: 36px
    }

    .timeline-track:before {
      content: "";
      position: absolute;
      top: 50px;
      left: 6%;
      right: 6%;
      height: 2px;
      background: var(--line-dark)
    }

    .timeline-point {
      position: relative;
      z-index: 1;
      text-align: center
    }

    .timeline-marker {
      display: block;
      width: 18px;
      height: 18px;
      margin: 5px auto 18px;
      background: var(--teal);
      border: 4px solid var(--surface);
      border-radius: 50%;
      box-shadow: 0 0 0 4px rgba(14, 156, 134, .15)
    }

    .timeline-point.a .timeline-marker {
      background: var(--amber);
      box-shadow: 0 0 0 4px rgba(192, 124, 18, .15)
    }

    .timeline-point.b .timeline-marker {
      background: var(--blue);
      box-shadow: 0 0 0 4px rgba(61, 90, 254, .15)
    }

    .timeline-point.r .timeline-marker {
      background: var(--red);
      box-shadow: 0 0 0 4px rgba(196, 61, 52, .15)
    }

    .timeline-label {
      display: block;
      padding: 0 6px;
      font-size: 11px;
      font-weight: 700
    }

    .timeline-period {
      display: block;
      margin-top: 5px;
      color: var(--faint);
      font: 500 9.5px/1.3 'Manrope', system-ui, sans-serif
    }

    .watch-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr))
    }

    .watch-card {
      border-left: 3px solid var(--amber)
    }

    .watch-card.g {
      border-left-color: var(--teal)
    }

    .watch-card.r {
      border-left-color: var(--red)
    }

    .watch-card.b {
      border-left-color: var(--blue)
    }

    .watch-title {
      margin: 0 0 5px;
      font-size: 12.5px
    }

    .watch-desc {
      margin: 0;
      color: var(--muted);
      font-size: 11.5px
    }

    .watch-meta {
      margin-top: 8px;
      color: var(--faint);
      font: 500 9.5px/1.35 'Manrope', system-ui, sans-serif
    }

    .bottom-line {
      display: grid;
      gap: 9px
    }

    .bottom-row {
      display: grid;
      grid-template-columns: 90px minmax(0, 1fr);
      gap: 13px;
      padding: 13px 15px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-left: 3px solid var(--teal);
      border-radius: 10px
    }

    .bottom-row.a {
      border-left-color: var(--amber)
    }

    .bottom-row.b {
      border-left-color: var(--blue)
    }

    .bottom-row.r {
      border-left-color: var(--red)
    }

    .bottom-tag {
      color: var(--teal-dark);
      font: 700 9.5px/1.5 'Manrope', system-ui, sans-serif;
      letter-spacing: .05em;
      text-transform: uppercase
    }

    .bottom-row.a .bottom-tag {
      color: #875408
    }

    .bottom-row.b .bottom-tag {
      color: #2944bd
    }

    .bottom-row.r .bottom-tag {
      color: #9a3029
    }

    .bottom-copy {
      color: var(--muted);
      font-size: 12px
    }

    .foot {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      margin-top: 34px;
      padding-top: 15px;
      color: var(--faint);
      border-top: 1px solid var(--line);
      font-size: 10.5px
    }

    .foot span:last-child {
      text-align: right
    }

    /* Shared compressed-report hero: intentionally matches Guidance Credibility. */
                .hero {
      position: relative;
      grid-template-columns: 180px minmax(0, 1fr);
      gap: 38px;
      min-height: 286px;
      margin-top: 0;
      padding: 42px 40px;
      overflow: hidden;
      color: #fff;
      background: #1c254b;
      border: 1px solid #40528f;
      border-radius: 20px
    }

    .hero:after {
      position: absolute;
      inset: 0;
      width: auto;
      aspect-ratio: auto;
      background: radial-gradient(500px 240px at 92% -20%, rgba(115, 139, 230, .16), transparent 70%);
      border-radius: 0;
      content: "";
      pointer-events: none
    }

    .hero-body,
    .hero .score-ring {
      position: relative;
      z-index: 1
    }

    .hero-body {
      min-width: 0
    }

    .hero .score-ring {
      --ring: var(--teal);
      width: 180px;
      background: conic-gradient(var(--ring) calc(var(--score)*1%), rgba(255, 255, 255, .14) 0)
    }

    .hero .score-ring.amber {
      --ring: #efb552
    }

    .hero .score-ring.red {
      --ring: #ed8078
    }

    .hero .score-ring:after {
      width: calc(100% - 24px);
      background: #13283d
    }

    .hero .score-value {
      color: #8ff0da;
      font-family: 'Source Serif 4', Georgia, serif;
      font-size: 52px
    }

    .hero .score-ring.amber .score-value {
      color: #ffd58c
    }

    .hero .score-ring.red .score-value {
      color: #ffaaa4
    }

    .hero .score-scale {
      margin-top: 4px;
      color: rgba(255, 255, 255, .5);
      font-size: 10.5px;
      letter-spacing: .08em
    }

    .hero .eyebrow {
      color: #8ff0da;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .14em
    }

    .hero .action-title {
      max-width: none;
      margin: 8px 0 2px;
      color: #fff;
      font-family: 'Source Serif 4', Georgia, serif;
      font-size: 34px;
      line-height: 1.2
    }

    .hero .verdict {
      max-width: 670px;
      margin: 6px 0 20px;
      color: rgba(255, 255, 255, .74);
      font-size: 15px
    }

    .hero .reasons {
      gap: 9px;
      margin-top: 0
    }

    .hero .reason {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 12px;
      color: rgba(255, 255, 255, .85);
      background: rgba(255, 255, 255, .07);
      border: 1px solid rgba(255, 255, 255, .1);
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 500
    }

    .hero .reason.g,
    .hero .reason.a,
    .hero .reason.r,
    .hero .reason.b {
      border-color: rgba(255, 255, 255, .1)
    }

    .hero .reason:before {
      font-weight: 700
    }

    .hero .reason.g:before {
      color: #9de1d3;
      content: "✓"
    }

    .hero .reason.a:before {
      color: #ffd58c;
      content: "!"
    }

    .hero .reason.b:before {
      color: #a0baff;
      content: "•"
    }

    .hero .reason.r:before {
      color: #ffaaa4;
      content: "×"
    }

    @media(max-width:760px) {
      .report {
        padding: 20px 16px 40px
      }

                  .hero {
        grid-template-columns: 1fr;
        min-height: 0;
        padding: 34px 20px;
        text-align: center
      }

      .hero .score-ring {
        width: 150px;
        margin: auto
      }

      .hero .action-title {
        font-size: 30px
       font-family: 'Source Serif 4', Georgia, serif; }

      .reasons {
        justify-content: center
      }

      .section-head {
        align-items: flex-start;
        flex-direction: column;
        gap: 4px
      }

      .section-note {
        text-align: left
      }

      .headline-grid,
      .pattern-grid,
      .three-grid,
      .two-grid,
      .watch-grid,
      .edge-grid {
        grid-template-columns: 1fr;
        max-height: 450px;
        overflow-y: auto;
        padding-right: 8px;
        scrollbar-width: thin;
        scrollbar-color: var(--line-dark) transparent
      }

      .pattern-card.full {
        grid-column: auto
      }

      .bar-row {
        grid-template-columns: 1fr
      }

      .bar-value {
        text-align: left
      }

      .foot {
        flex-direction: column
      }

      .foot span:last-child {
        text-align: left
      }
    }

    @media(max-width:480px) {
      .report {
        padding-inline: 12px
      }

      .hero {
        padding-inline: 16px
      }

      .action-title {
        font-size: 25px
       font-family: 'Source Serif 4', Georgia, serif; }

      .intuition-panel {
        padding: 23px 18px
      }

      .intuition-heading {
        margin-top: 32px;
        font-size: 22px
      }

      .edge-panel {
        padding: 18px
      }

      .bottom-row {
        grid-template-columns: 1fr;
        gap: 4px
      }
    }

    @media print {
      body {
        background: #fff
      }

      .report {
        max-width: none;
        padding: 0
      }

      .hero,
      .headline-card,
      .pattern-card,
      .edge-panel,
      .panel,
      .metric-card,
      .watch-card,
      .bottom-row {
        break-inside: avoid
      }
    }

    .insight-stack {
      margin-top: 36px
    }

    .insight-stack .intuition-panel {
      border-radius: 16px 16px 0 0
    }

    .insight-patterns {
      padding: 18px;
      background: var(--page);
      border-right: 1px solid var(--line-dark);
      border-left: 1px solid var(--line-dark)
    }

    .insight-stack .edge-panel {
      border-radius: 0 0 15px 15px
    }
  
    /* Global scrollbars for grids */
    .pattern-grid, .headline-grid, .three-grid, .two-grid, .watch-grid, .edge-grid, .communication-grid, .split-grid, .evidence-grid {
      max-height: 450px;
      overflow-y: auto;
      padding-right: 8px;
      scrollbar-width: thin;
      scrollbar-color: var(--line-dark) transparent;
    }

    /* Fix for .card-meta highlight block */
    p.card-meta.tone-g, p.card-meta.tone-a, p.card-meta.tone-b, p.card-meta.tone-r, p.card-meta.tone-amber, p.card-meta.tone-red, p.card-meta.tone-green, p.card-meta.tone-blue {
      background: transparent !important;
      font-weight: 700;
    }

    /* Make bar-row panels scrollable */
    .panel:has(.bar-row) {
      max-height: 450px;
      overflow-y: auto;
      padding-right: 8px;
      scrollbar-width: thin;
      scrollbar-color: var(--line-dark) transparent;
    }

    .top-meta { border-collapse: separate; border-spacing: 0; width: auto; min-width: 0; background: transparent; border: 1px solid var(--line); border-radius: 6px; margin-left: auto; margin-right: 0; align-self: flex-end; overflow: hidden; }
        .top-meta th, .top-meta td { padding: 2px 12px; font-size: 10.5px; color: var(--faint); white-space: nowrap; border-bottom: none; font-family: 'Manrope', sans-serif; }
    .top-meta th { background: #f7f7fb; text-transform: uppercase; letter-spacing: .11em; font-style: normal; }
        .top-meta tr:last-child td { padding-bottom: 8px; }
        .top-meta .meta-label { padding-right: 8px; text-align: right; text-transform: uppercase; letter-spacing: .04em; color: #b4b3ae; font-weight: 600; font-size: 9.5px; font-family: 'Manrope', sans-serif; }

    .top { display: flex; justify-content: space-between; gap: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--line); margin-bottom: 24px; }
    .top-right { display: flex; align-items: flex-start; gap: 20px; flex-shrink: 0; }
    .lens-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
    .lens-row .eyebrow { font-size: 11.5px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; color: var(--faint); margin: 0; }
    .title { font-size: 36px; line-height: 1.2; margin: 0; font-weight: 600; }
    .serif { font-family: 'Source Serif 4', Georgia, serif; }
    .asset-kicker { margin-top: 5px; color: var(--muted); font-size: 13px; }
    @media (max-width: 768px) {
        .title { font-size: 28px; }
    }


    /* Unified typography: one sans-serif family across every UI element to match full-t1 */
    :root {
        --font-sans: 'Manrope', Inter, Arial, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
    }

    html,
    body,
    button,
    input,
    select,
    textarea {
        font-family: var(--font-sans) !important
    }

    body *,
    body *::before,
    body *::after {
        font-family: var(--font-sans) !important
    }

</style>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
</head>

<body>
  <main class="report" data-template-category="earnings-forecast-compressed">
    <header class="top">
      <div>
        <div class="lens-row">
            <span class="eyebrow">{{{lens}}}</span>
        </div>
        <h1 class="title serif">Earnings Forecast</h1>
        <div class="asset-kicker">{{{asset_name}}}</div>
      </div>
      <div class="top-right">
        {{#if source_meta}}
      <table class="top-meta">
          <tr><th colspan="2" style="padding: 8px 12px 4px; text-align: center; color: #b4b3ae; font-size: 9.5px; font-weight: 400; white-space: nowrap; border-bottom: none;">Latest analysed</th></tr>
          {{#if source_meta.transcript}}<tr><td class="meta-label">Transcript</td><td>{{{source_meta.transcript}}}</td></tr>{{/if}}
          {{#if source_meta.ppt}}<tr><td class="meta-label">Investor Presentation</td><td>{{{source_meta.ppt}}}</td></tr>{{/if}}
          {{#if source_meta.annual_report}}<tr><td class="meta-label">Annual Report</td><td>{{{source_meta.annual_report}}}</td></tr>{{/if}}
      </table>
      {{/if}}
      </div>
    </header>

    <header class="hero">
      <div class="score-ring {{{score_badge.status_color}}}" style="--score:{{{score_badge.score}}}" role="img"
        aria-label="Earnings forecast score {{{score_badge.score}}} out of {{{score_badge.scale}}}">
        <div class="score-copy"><span class="score-value">{{{score_badge.score}}}</span><span class="score-scale">out of
            {{{score_badge.scale}}}</span></div>
      </div>
      <div class="hero-body">
                <h1 class="action-title">{{{hero.action_title}}}</h1>
        <p class="verdict">{{{hero.verdict}}}</p>
        {{#if hero.reasons.length}}
          <div class="reasons">{{#each hero.reasons}}<span class="reason {{{tone}}}">{{{text}}}</span>{{/each}}</div>
        {{/if}}
      </div>
    </header>
    {{#if scenarios.cards.length}}
      <section>
        <div class="section-head">
          <div>
            <p class="section-tag">{{{scenarios.section_tag}}}</p>
            <h2 class="section-title">{{{scenarios.section_title}}}</h2>
          </div>
        </div>
        <div class="three-grid">{{#each scenarios.cards}}
            <article class="headline-card {{{tone}}}">
              <p class="headline-label">{{{case}}} case</p>
              <p class="headline-value {{{tone}}}">{{{cagr}}}</p>
              <p class="card-meta">Earnings CAGR</p>
              <ul class="list">{{#each drivers}}
                  <li><strong>{{{label}}}:</strong> {{{detail}}}</li>
                {{/each}}</ul>
            </article>
          {{/each}}</div>
      </section>
    {{/if}}

    {{!-- {{#if earnings_chart.labels.length}}
      <section>
        <div class="section-head">
          <div>
            <p class="section-tag">{{{earnings_chart.section_tag}}}</p>
            <h2 class="section-title">{{{earnings_chart.section_title}}}</h2>
          </div>
          <p class="section-note">{{{earnings_chart.note}}}</p>
        </div>
        <div class="chart-scroll">
          <div class="panel" style="min-width:760px;height:330px"><canvas id="earningsForecastChart"
              aria-label="Earnings growth forecast chart"></canvas></div>
        </div>
      </section>
    {{/if}}

    {{#if margin_chart.labels.length}}
      <section>
        <div class="section-head">
          <div>
            <p class="section-tag">{{{margin_chart.section_tag}}}</p>
            <h2 class="section-title">{{{margin_chart.section_title}}}</h2>
          </div>
          <p class="section-note">{{{margin_chart.note}}} · {{{margin_chart.unit}}}</p>
        </div>
        <div class="chart-scroll">
          <div class="panel" style="min-width:760px;height:330px"><canvas id="marginForecastChart"
              aria-label="Secondary forecast metric chart"></canvas></div>
        </div>
      </section>
    {{/if}} --}}
    {{#if assumptions.rows.length}}
      <section>
        <div class="section-head">
          <div>
            <p class="section-tag">{{{assumptions.section_tag}}}</p>
            <h2 class="section-title">{{{assumptions.section_title}}}</h2>
          </div>
          <p class="section-note">{{{assumptions.unit}}}</p>
        </div>
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Metric</th>
                <th>Bull</th>
                <th>Base</th>
                <th>Bear</th>
              </tr>
            </thead>
            <tbody>{{#each assumptions.rows}}
                <tr>
                  <td><strong>{{{metric}}}</strong></td>
                  <td>{{{bull}}}</td>
                  <td>{{{base}}}</td>
                  <td>{{{bear}}}</td>
                </tr>
              {{/each}}</tbody>
          </table>
        </div>
      </section>
    {{/if}}


    <section class="insight-stack">
      {{#if qc_intuition.summary}}
        <div class="intuition-panel"><span class="intuition-badge">QC Intuition · Pattern Recognition</span>
          <h2 class="intuition-heading">What is driving earnings path</h2>
          <p class="intuition-line">{{{qc_intuition.summary}}}</p>
        </div>
      {{/if}}
      {{#if patterns.cards.length}}
        <div class="insight-patterns">
          <div class="pattern-grid">{{#each patterns.cards}}
              <article class="pattern-card {{{tone}}} {{#if full_width}}full{{/if}}">
                <div class="pattern-visual"><span class="sparkline"
                    aria-label="Relative pattern evolution">{{#each spark}}<i
                        class="v{{{this}}}"></i>{{/each}}</span><span class="trend tone-{{{tone}}}">{{{trend}}}</span></div>
                <h3 class="pattern-name">{{{name}}}</h3>
                <p class="pattern-meaning">{{{meaning}}}</p>
              </article>
            {{/each}}</div>
        </div>
      {{/if}}
      {{#if edge}}
        <div class="edge-panel"><span class="edge-badge">{{{edge.badge}}}</span>
          <div class="edge-grid">
            <div>
              <p class="edge-label">Theme</p>
              <p class="edge-copy">{{{edge.behaviour}}}</p>
            </div>
            <div>
              <p class="edge-label">Floor reason</p>
              <p class="edge-copy accent">{{{edge.implication}}}</p>
            </div>{{#if edge.investor_focus.chip}}
              <div>
                <p class="edge-label">Swing variable</p>
                <p class="edge-copy"><span
                    class="focus-chip">{{{edge.investor_focus.chip}}}</span>{{{edge.investor_focus.tail}}}</p>
              </div>
            {{/if}}
          </div>
        </div>
      {{/if}}
    </section>
    

    {{#if triggers.bull.desc}}
      <section>
        <div class="section-head">
          <div>
            <p class="section-tag">Scenario switches</p>
            <h2 class="section-title">What moves the forecast</h2>
          </div>
        </div>
        <div class="two-grid">
          <article class="watch-card g">
            <h3 class="watch-title">{{{triggers.bull.title}}}</h3>
            <p class="watch-desc">{{{triggers.bull.desc}}}</p>
          </article>
          <article class="watch-card r">
            <h3 class="watch-title">{{{triggers.bear.title}}}</h3>
            <p class="watch-desc">{{{triggers.bear.desc}}}</p>
          </article>
        </div>
      </section>
    {{/if}}
    {{#if bottom_line.length}}
      <section>
        <div class="section-head">
          <div>
            <p class="section-tag">Investor takeaway</p>
            <h2 class="section-title">{{{investor_takeaway_text}}}</h2>
          </div>
        </div>
        <div class="bottom-line">{{#each bottom_line}}
            <div class="bottom-row {{{tone}}}"><span class="bottom-tag">{{{tag}}}</span><span
                class="bottom-copy">{{{text}}}</span></div>
          {{/each}}</div>
      </section>
    {{/if}}
    <script>
      (() => {
        if (typeof Chart === 'undefined') return;
        const colors = { bull: '#0e9c86', base: '#3d5afe', bear: '#c43d34' };
        const common = { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false }, plugins: { legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 8, font: { family: 'Inter', size: 11 } } } }, scales: { x: { grid: { display: false }, ticks: { font: { family: 'Inter', size: 10 } } }, y: { beginAtZero: true, grid: { color: '#eeedea' }, ticks: { font: { family: 'Inter', size: 10 } } } } };
        const line = document.getElementById('earningsForecastChart');
        if (line) {
          const bullData = {{{ json earnings_chart.datasets.bull }}};
          const baseData = {{{ json earnings_chart.datasets.base }}};
          const bearData = {{{ json earnings_chart.datasets.bear }}};
          const dynamicMax = Math.max(...bullData, ...baseData, ...bearData);
          const finalMax = Math.max(dynamicMax, {{{ json earnings_chart.y_max }}} || 0) + 2;
          new Chart(line, { type: 'line', data: { labels: {{{ json earnings_chart.labels }}}, datasets: [{ label: 'Bull', data: bullData, borderColor: colors.bull, backgroundColor: 'rgba(14,156,134,.08)', fill: true, tension: .35}, { label: 'Base', data: baseData, borderColor: colors.base, backgroundColor: 'rgba(61,90,254,.06)', fill: true, tension: .35}, { label: 'Bear', data: bearData, borderColor: colors.bear, backgroundColor: 'rgba(196,61,52,.06)', fill: true, tension: .35}]}, options: {...common, scales: {...common.scales, y: {...common.scales.y, max: finalMax, ticks: {...common.scales.y.ticks, callback: v => v + '%' } } } }});
        }
      const bar = document.getElementById('marginForecastChart');
      const marginUnit = {{{ json margin_chart.unit }}};
      if (bar) new Chart(bar, { type: 'bar', data: { labels: {{{ json margin_chart.labels }}}, datasets: [{ label: 'Bull', data: {{{ json margin_chart.datasets.bull }}}, backgroundColor: colors.bull, borderRadius: 4}, { label: 'Base', data: {{{ json margin_chart.datasets.base }}}, backgroundColor: colors.base, borderRadius: 4}, { label: 'Bear', data: {{{ json margin_chart.datasets.bear }}}, backgroundColor: colors.bear, borderRadius: 4}]}, options: { ...common, scales: { ...common.scales, y: { ...common.scales.y, ticks: { ...common.scales.y.ticks, callback: v => v + marginUnit } } } }});
  }) ();
    </script>
    <footer class="foot"><span>Earnings Forecast ·
        {{{asset_name}}}</span><span>{{{footer.sources}}}{{#if footer.methodology}} · {{{footer.methodology}}}{{/if}}</span>
    </footer>
  </main>
</body>

</html>
