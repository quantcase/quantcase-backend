<body><main class="wrap" data-template-category="competition">
<header class="top"><div><div class="lens-row"><span class="eyebrow">Opportunity Lens</span>{{#if overall_rating}}<span class="pill {{score_badge.status_color}}">{{overall_rating.label}}</span>{{/if}}</div><h1 class="title">Competition</h1><div class="asset-kicker">{{asset_name}}</div></div><button class="xbtn" aria-label="Close">&times;</button></header>
{{#if score_badge}}<section class="score-badge"><div class="score-ring {{score_badge.status_color}}" style="--score:{{score_badge.score}}"><span class="score-num">{{score_badge.score}}</span></div><div><div class="score-label">{{score_badge.rating}} · {{score_badge.label}}</div><div class="score-desc">{{score_badge.desc}}</div></div></section>{{/if}}
{{#if headline.length}}<section class="sec"><div class="sec-head"><div class="sec-title">Headline insights</div></div><div class="grid three">{{#each headline}}<article class="stat"><div class="lab {{dot}}"><span class="dot"></span>{{label}}</div><div class="big {{value_color}}">{{value}}</div><div class="desc">{{desc}}</div></article>{{/each}}</div></section>{{/if}}
{{#if narrative.patterns.length}}<section class="qci"><div class="qci-head"><div class="qci-count">{{narrative.signals_parsed}}</div><div class="qci-badge">QC Intuition · Competitive Patterns</div><div class="qci-title">How competitive behaviour is changing</div><div class="qci-sub">{{narrative.source_summary}}</div></div><div class="table-wrap"><table><thead><tr><th>Pattern</th><th>Evolution</th><th>Status</th><th>Interpretation</th></tr></thead><tbody>{{#each narrative.patterns}}<tr><td><strong>{{name}}</strong><div class="sub">{{sub}}</div></td><td>{{{trendSparkline this}}}</td><td><span class="pill {{trend}}">{{status_label}}</span></td><td>{{interp}}</td></tr>{{/each}}</tbody></table></div>{{#if narrative.edge}}<div class="qci-edge"><div class="qci-edge-label">The Edge</div><div><p><strong>Structural advantage:</strong> {{narrative.edge.structural_advantage}}</p><p><strong>Competitive pressure:</strong> {{narrative.edge.competitive_pressure}}</p><p><strong>Management response:</strong> {{narrative.edge.management_response}}</p><p>{{narrative.edge.closing_line}}</p></div></div>{{/if}}<div class="tag-row" style="padding:14px 20px">{{#each narrative.sources}}<span class="tag">{{count}} {{label}}</span>{{/each}}</div></section>{{/if}}
{{#if competitive_landscape}}<section class="sec"><div class="sec-head"><div class="sec-title">Competitive landscape</div></div><div class="keymsg"><div class="lead">{{competitive_landscape.verdict}}</div></div><div class="grid three" style="margin-top:16px"><article class="card"><h3>Advantages</h3>{{#each competitive_landscape.advantages}}<div class="metric-row"><strong>{{title}}</strong><span>{{evidence}}<br><em>{{why_it_matters}}</em></span></div>{{/each}}</article><article class="card"><h3>Pressures</h3>{{#each competitive_landscape.pressures}}<div class="metric-row"><strong>{{title}}</strong><span>{{evidence}}<br><em>{{why_it_matters}}</em></span></div>{{/each}}</article><article class="card"><h3>Responses</h3>{{#each competitive_landscape.responses}}<div class="metric-row"><strong>{{title}}</strong><span>{{evidence}}<br><em>{{why_it_matters}}</em></span></div>{{/each}}</article></div></section>{{/if}}
{{#if watch.length}}<section class="sec"><div class="sec-head"><div class="sec-title">Competitive watchpoints</div></div><div class="grid two">{{#each watch}}<article class="watch-card"><h3>{{title}}</h3><p class="desc">{{desc}}</p></article>{{/each}}</div></section>{{/if}}
{{#if key_message}}<section class="sec keymsg"><div class="sec-title">Synthesis</div><div class="lead">{{key_message.lead}}</div><p><strong class="g">Positive:</strong> {{key_message.positive}}</p><p><strong class="a">Watch:</strong> {{key_message.watch}}</p><p><strong class="r">Risk:</strong> {{key_message.risk}}</p></section>{{/if}}
<footer class="foot"><strong>Competitive view.</strong> {{footer.computed_date}} · {{footer.sources}}</footer>
</main></body></html>