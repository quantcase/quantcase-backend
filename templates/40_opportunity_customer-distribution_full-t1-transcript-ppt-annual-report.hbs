        }

        .synthesis-label.neutral {
            color: #5267c8
        }

        .synthesis-label.positive {
            color: var(--green-d)
        }

        .synthesis-label.watch {
            color: var(--amber-d)
        }

        .synthesis-label.risk {
            color: var(--red-d)
        }

        @media(max-width:820px) {
            .synthesis-grid {
                grid-template-columns: 1fr
            }

            .synthesis-panel,
            .synthesis-panel:first-child {
                padding: 15px 0;
                border-left: 0;
                border-top: 1px solid var(--line)
            }

            .synthesis-panel:first-child {
                border-top: 0
            }

            .qci-edge .edge-copy {
                font-size: 13.5px
            }
        }

        /* Customer traction: reference-aligned composite block */
        .ct-outer {
            overflow: hidden;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            background: var(--card)
        }

        .ct-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            padding: 14px 20px;
            border-bottom: 1px solid var(--line);
            background: #f7f7f5
        }

        .ct-header-left,
        .ct-verdict {
            display: flex;
            align-items: center;
            gap: 12px
        }

        .ct-header-label {
            color: var(--faint);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .13em;
            text-transform: uppercase
        }

        .ct-date-pill {
            padding: 4px 11px;
            border: 1px solid var(--line);
            border-radius: 99px;
            background: #fff;
            color: var(--muted);
            font-size: 11px;
            font-weight: 700
        }

        .ct-verdict {
            gap: 7px;
            color: var(--green-d);
            font-size: 12px;
            font-weight: 700
        }

        .ct-verdict-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--green)
        }

        .ct-verdict-dot.amber,
        .ct-verdict-dot.a,
        .ct-verdict-dot.moderate {
            background: var(--amber)
        }

        .ct-verdict-dot.red,
        .ct-verdict-dot.r,
        .ct-verdict-dot.weak {
            background: var(--red)
        }

        .ct-summary {
            margin: 0;
            padding: 17px 20px;
            border-bottom: 1px solid var(--line);
            color: var(--muted);
            font-size: 13.5px
        }

        .ct-stat-row {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            border-bottom: 1px solid var(--line)
        }

        .ct-stat {
            min-width: 0;
            padding: 20px;
            border-right: 1px solid var(--line);
            background: #fff
        }

        .ct-stat:last-child {
            border-right: 0
        }

        .ct-stat.hl {
            background: var(--amber-bg)
        }

        .ct-stat-label {
            color: var(--green-d);
            font-size: 10.5px;
            font-weight: 800;
            letter-spacing: .09em;
            text-transform: uppercase
        }

        .ct-stat-label.amber,
        .ct-stat-label.a {
            color: var(--amber-d)
        }

        .ct-stat-label.red,
        .ct-stat-label.r {
            color: var(--red-d)
        }

        .ct-stat-value {
            margin: 4px 0 3px;
            color: var(--green-d);
            font: 600 28px/1.1 'Source Serif 4', Georgia, serif
        }

        .ct-stat.amber .ct-stat-value,
        .ct-stat.a .ct-stat-value {
            color: var(--amber-d)
        }

        .ct-stat.red .ct-stat-value,
        .ct-stat.r .ct-stat-value {
            color: var(--red-d)
        }

        .ct-stat-desc {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.45
        }

        .ct-quote {
            margin: 0;
            padding: 18px 22px 17px 25px;
            border: 0;
            border-bottom: 1px solid var(--line);
            border-left: 3px solid var(--green);
            background: #fff;
            font: italic 14px/1.55 'Source Serif 4', Georgia, serif
        }

        .ct-quote-source {
            display: block;
            margin-top: 8px;
            color: var(--faint);
            font: 11px/1.4 'Manrope', system-ui, sans-serif
        }

        .ct-signals {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            background: #fff
        }

        .ct-signal {
            position: relative;
            min-height: 124px;
            padding: 19px 22px 18px 43px;
            border-top: 1px solid var(--line);
            border-right: 1px solid var(--line)
        }

        .ct-signal:nth-child(2n) {
            border-right: 0
        }

        .ct-signal.pos {
            box-shadow: inset 3px 0 var(--green)
        }

        .ct-signal.warn {
            box-shadow: inset 3px 0 var(--amber)
        }

        .ct-signal-icon {
            position: absolute;
            left: 20px;
            top: 20px;
            color: var(--green);
            font-weight: 800
        }

        .ct-signal.warn .ct-signal-icon {
            color: var(--amber)
        }

        .ct-signal-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px
        }

        .ct-signal h3 {
            margin: 0;
            font-size: 14px
        }

        .ct-signal p {
            margin: 8px 0 0;
            color: var(--muted);
            font-size: 12.5px;
            line-height: 1.52
        }

        /* Customer synthesis: the reference dark, data-led closing panel */
        .customer-ai {
            display: flex;
            gap: 20px;
            align-items: flex-start;
            padding: 24px 28px;
            border: 1px solid #2d427d;
            border-radius: var(--radius);
            background: linear-gradient(135deg, #111d3b, #1d2f62);
            color: rgba(255, 255, 255, .86)
        }

        .customer-ai-icon {
            display: grid;
            place-items: center;
            width: 44px;
            height: 44px;
            flex: 0 0 auto;
            border: 1px solid rgba(126, 151, 255, .45);
            border-radius: 10px;
            background: rgba(79, 110, 247, .18);
            color: #9fb1ff;
            font-size: 17px;
            font-weight: 800
        }

        .customer-ai-body {
            min-width: 0;
            flex: 1
        }

        .customer-ai-label {
            color: #90a7ff;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase
        }

        .customer-ai-copy {
            margin-top: 8px;
            font-size: 15px;
            line-height: 1.65
        }

        .customer-ai-copy .pos {
            color: #70d7b6
        }

        .customer-ai-copy .neg {
            color: #f0bd58
        }

        .customer-ai-copy .hl {
            color: #8fa7ff
        }

        .customer-ai-kpis {
            display: flex;
            flex-wrap: wrap;
            gap: 34px;
            margin-top: 18px;
            padding-top: 15px;
            border-top: 1px solid rgba(255, 255, 255, .13)
        }

        .customer-ai-kpi {
            min-width: 120px
        }

        .customer-ai-kpi-label {
            color: rgba(255, 255, 255, .48);
            font-size: 9.5px;
            font-weight: 800;
            letter-spacing: .1em;
            text-transform: uppercase
        }

        .customer-ai-kpi-value {
            margin-top: 5px;
            color: #8fa7ff;
            font: 600 24px/1.1 'Source Serif 4', Georgia, serif
        }

        .customer-ai-kpi-sub {
            margin-top: 4px;
            color: rgba(255, 255, 255, .46);
            font-size: 11px
        }

        @media(max-width:820px) {
            .ct-header {
                align-items: flex-start;
                flex-direction: column
            }

            .ct-stat-row,
            .ct-signals {
                grid-template-columns: 1fr
            }

            .ct-stat {
                border-right: 0;
                border-bottom: 1px solid var(--line)
            }

            .ct-stat:last-child {
                border-bottom: 0
            }

            .ct-signal {
                border-right: 0
            }

            .customer-ai {
                padding: 22px 20px
            }

            .customer-ai-icon {
                display: none
            }

            .customer-ai-kpis {
                gap: 20px
            }
        }

        /* Unified typography: one sans-serif family across every UI element. */
        :root {
            --font-sans: 'Manrope', Inter, Arial, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
        }

        html,
        body,
        button,
        input,
        select,
        textarea {
            font-family: var(--font-sans) !important
        }

        body *,
        body *::before,
        body *::after {
            font-family: var(--font-sans) !important
        }
            /* QC Intuition Table PC Layout Fix */
        .qci table, .qci-table { table-layout: fixed; }
        .qci table th:nth-child(1), .qci-table th:nth-child(1) { width: 32% !important; }
        .qci table th:nth-child(2), .qci-table th:nth-child(2) { width: 14% !important; }
        .qci table th:nth-child(3), .qci-table th:nth-child(3) { width: 14% !important; }
        .qci table th:nth-child(4), .qci-table th:nth-child(4) { width: 40% !important; }

        .ct-signal.pos .pill { color: var(--green-d); background: var(--green-bg) !important; border-color: var(--green-bd); }
        .ct-signal.neg .pill { color: var(--red-d); background: var(--red-bg) !important; border-color: var(--red-bd); }
        .ct-signal.neu .pill { color: var(--amber-d); background: var(--amber-bg) !important; border-color: var(--amber-bd); }
</style>
</head>

<body>
    <main class="wrap" data-template-category="customer-distribution">
        <header class="top">
            <div>
                <div class="lens-row"><span class="eyebrow">Opportunity Lens</span>{{#if overall_rating}}<span
                            class="pill {{{score_badge.status_color}}}">{{{overall_rating.label}}}</span>{{/if}}</div>
                <h1 class="title">Customer &amp; Distribution</h1>
                <div class="asset-kicker">{{{asset_name}}}</div>
            </div>
            <div class="top-right">
            {{#if source_meta}}
            <table class="top-meta">
                <tr><td style="padding: 0 8px 2px 0; text-align: center; color: #b4b3ae; font-size: 9.5px; font-weight: 600;  white-space: nowrap; border-bottom: none;">LATEST ANALYSED :</td><td></td></tr>
                {{#if source_meta.transcript}}<tr><td class="meta-label">Transcript</td><td>{{{source_meta.transcript}}}</td></tr>{{/if}}
                {{#if source_meta.ppt}}<tr><td class="meta-label">Presentation</td><td>{{{source_meta.ppt}}}</td></tr>{{/if}}
                {{#if source_meta.annual_report}}<tr><td class="meta-label">Annual Report</td><td>{{{source_meta.annual_report}}}</td></tr>{{/if}}
            </table>
            {{/if}}
            </div>
        </header>

        {{#if score_badge}}
            <section class="score-badge">
                <div class="score-ring {{{score_badge.status_color}}}" style="--score:{{{score_badge.score}}}"><span
                        class="score-num">{{{score_badge.score}}}</span></div>
                <div>
                    <div class="score-label">{{{score_badge.rating}}} · {{{score_badge.label}}}</div>
                    <div class="score-desc">{{{score_badge.desc}}}</div>
                </div>
            </section>
        {{/if}}
        {{#if customer_traction}}
            <section class="sec">
                <div class="ct-outer">
                    <div class="ct-header">
                        <div class="ct-header-left"><span class="ct-header-label">Customer
                                traction</span>{{#if period}}<span class="ct-date-pill">{{{period}}}</span>{{/if}}</div>
                        {{#if customer_traction.verdict_label}}
                            <div class="ct-verdict"><span
                                    class="ct-verdict-dot {{{score_badge.status_color}}}"></span>{{{customer_traction.verdict_label}}}
                            </div>
                        {{/if}}
                    </div>{{#if customer_traction.block_summary}}
                        <p class="ct-summary">{{{customer_traction.block_summary}}}</p>
                    {{/if}}{{#if customer_traction.stats.length}}
                        <div class="ct-stat-row">{{#each customer_traction.stats}}
                                <article class="ct-stat {{{color}}} {{#if highlight}}hl{{/if}}">
                                    <div class="ct-stat-label {{{color}}}">{{{label}}}</div>
                                    <div class="ct-stat-value">{{{value}}}</div>
                                    <div class="ct-stat-desc">{{{desc}}}</div>
                                </article>
                            {{/each}}</div>
                    {{/if}}{{#if customer_traction.quote.text}}
                        <blockquote class="ct-quote">“{{{customer_traction.quote.text}}}”{{#if
                            customer_traction.quote.source}}<span
                                class="ct-quote-source">{{{customer_traction.quote.source}}}</span>
                    {{/if}}</blockquote>
        {{/if}}{{#if customer_traction.signals.length}}
            <div class="ct-signals">{{#each customer_traction.signals}}
                    <article class="ct-signal {{{sentiment}}}"><span class="ct-signal-icon"
                            aria-hidden="true">{{#if (eq sentiment "pos")}}✓{{else}}!{{/if}}</span>
                        <div class="ct-signal-head">
                            <h3>{{{title}}}</h3>{{#if badge_label}}<span
                                    class="pill {{{badge_color}}}">{{{badge_label}}}</span>{{/if}}
                        </div>
                        <p>{{{desc}}}</p>
                    </article>
                {{/each}}</div>
        {{/if}}</div>
        </section>{{/if}}
        {{#if qci.themes.length}}
            <section class="qci">
                <div class="qci-head">
                    <div class="qci-badge"> QC Intuition · Pattern Recognition</div>
                    <div class="qci-title">What the distribution signals reveal.</div>
                    {{!-- <div class="qci-sub">Customer and distribution evidence{{#if qci.period_start}} ·
                        {{{qci.period_start}}} → {{{qci.period_end}}}
        {{/if}} --}}
        </div>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Theme</th>
                        <th>Evolution</th>
                        <th>Status</th>
                        <th>Interpretation</th>
                    </tr>
                </thead>
                <tbody>{{#each qci.themes}}
                        <tr>
                            <td><strong>{{{name}}}</strong>
                                <div class="sub">{{{sub}}}</div>
                            </td>
                            <td>{{{trendSparkline this}}}</td>
                            <td><span class="pill {{{trend}}}">{{{trend}}}</span></td>
                            <td>{{{interp}}}</td>
                        </tr>
                    {{/each}}</tbody>
            </table>
        </div>{{#if qci.edge}}
            <div class="qci-edge">
                <div class="qci-edge-label">THE EDGE</div>
                <div>
                    <p class="edge-copy"><strong>Strength:</strong> <span
                            class="edge-positive">{{{qci.edge.strength}}}</span> <strong>Risk:</strong> <span
                            class="edge-watch">{{{qci.edge.risk}}}</span> <span>{{{qci.edge.conclusion}}}</span></p>
                </div>
            </div>
        {{/if}}</section>{{/if}}
        {{#if ai_summary}}
            <section class="sec">
                <div class="customer-ai">
                    <div class="customer-ai-icon" aria-hidden="true">QC</div>
                    <div class="customer-ai-body">
                        <div class="customer-ai-label">Customer &amp; Distribution</div>
                        {{#if ai_summary.text_segments.length}}
                            <div class="customer-ai-copy">{{#each ai_summary.text_segments}}<span
                                        class="{{{class}}}">{{{text}}}</span>{{/each}}</div>
                        {{/if}}{{#if ai_summary.kpis.length}}
                            <div class="customer-ai-kpis">{{#each ai_summary.kpis}}
                                    <div class="customer-ai-kpi">
                                        <div class="customer-ai-kpi-label">{{{label}}}</div>
                                        <div class="customer-ai-kpi-value">{{{value}}}</div>
                                        <div class="customer-ai-kpi-sub">{{{sub}}}</div>
                                    </div>
                                {{/each}}</div>
                        {{/if}}
                    </div>
                </div>
            </section>
        {{/if}}
    </main>
</body>

</html>