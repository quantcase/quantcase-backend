        .timeline-card,
        .analysis-card,
        .challenge-card,
        .traction-stat,
        .signal-card {
            background: var(--card) !important
        }

        .card.g,
        .card.a,
        .card.r,
        .card.positive,
        .card.negative,
        .stat.g,
        .stat.a,
        .stat.r,
        .watch-card.g,
        .watch-card.a,
        .watch-card.r,
        .timeline-card.g,
        .timeline-card.a,
        .timeline-card.r,
        .analysis-card.g,
        .analysis-card.a,
        .analysis-card.r,
        .challenge-card.g,
        .challenge-card.a,
        .challenge-card.r,
        .traction-stat.g,
        .traction-stat.a,
        .traction-stat.r,
        .signal-card.g,
        .signal-card.a,
        .signal-card.r,
        .signal-card.positive,
        .signal-card.negative {
            background: var(--card) !important
        }

        .fill.g,
        .fill.green {
            background: var(--green) !important
        }

        .fill.a,
        .fill.amber {
            background: var(--amber) !important
        }

        .fill.r,
        .fill.red {
            background: var(--red) !important
        }

        .watch-card.green {
            border-left-color: var(--green)
        }

        .watch-card.amber {
            border-left-color: var(--amber)
        }

        .watch-card.red {
            border-left-color: var(--red)
        }

        .keymsg {
            border-left: 3px solid var(--green);
            border-radius: 0 var(--radius) var(--radius) 0;
            padding: 24px 28px;
            background: var(--card)
        }

        .keymsg .sec-title {
            margin-bottom: 10px
        }

        .keymsg .lead {
            font-size: 22px;
            line-height: 1.32;
            margin: 0 0 14px
        }

        .keymsg p {
            margin: 10px 0
        }

        .keymsg .g,
        .keymsg .a,
        .keymsg .r {
            font-weight: 700
        }

        .keymsg .up {
            color: var(--green);
            font-weight: 700
        }

        .keymsg .dn {
            color: var(--red);
            font-weight: 700
        }

        .balance {
            border: 1px solid var(--line);
            border-radius: var(--radius);
            background: var(--card);
            overflow: hidden
        }

        .balance-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr))
        }

        .balance-block {
            padding: 24px 26px;
            border-right: 1px solid var(--line)
        }

        .balance-block:last-child {
            border-right: 0
        }

        .balance-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 14px
        }

        .balance-count {
            font: 600 20px/1.1 'Source Serif 4', Georgia, serif;
            white-space: nowrap
        }

        .balance-track {
            height: 10px;
            border-radius: 99px;
            background: #e8e7e3;
            overflow: hidden;
            margin: 14px 0
        }

        .balance-fill {
            height: 100%;
            max-width: 100%;
            border-radius: inherit
        }

        .balance-fill.g {
            background: var(--green) !important
        }

        .balance-fill.a {
            background: var(--amber) !important
        }

        .balance-fill.r {
            background: var(--red) !important
        }

        .balance-takeaway {
            border-top: 1px solid var(--line);
            padding: 18px 26px;
            line-height: 1.6
        }

        @media(max-width:820px) {
            .balance-grid {
                grid-template-columns: 1fr
            }

            .balance-block {
                border-right: 0;
                border-bottom: 1px solid var(--line)
            }

            .balance-block:last-child {
                border-bottom: 0
            }

            .keymsg {
                padding: 22px 20px
            }
        }

        body {
            font-family: 'Manrope', system-ui, sans-serif
        }

        .serif,
        .title,
        .big,
        .score-num,
        .qci-title,
        .lead {
            font-family: 'Source Serif 4', Georgia, serif
        }

        /* Shared visual-consistency update */
        .score-badge:not(.no-score)>div:last-child {
            flex: 1;
            min-width: 0;
            padding: 15px 18px;
            border: 1px solid var(--line);
            border-left: 3px solid var(--amber);
            border-radius: var(--radius);
            background: var(--card);
            box-shadow: 0 1px 0 rgba(18, 24, 39, .02)
        }

        .score-badge:not(.no-score) .score-desc {
            max-width: none
        }

        .qci-edge {
            align-items: start;
            background: #172445 !important
        }

        .qci-edge .edge-copy {
            margin: 0;
            font-size: 14.5px;
            line-height: 1.68;
            color: rgba(255, 255, 255, .84)
        }

        .qci-edge .edge-copy strong {
            color: #fff
        }

        .edge-accent,
        .edge-positive,
        .edge-watch,
        .edge-risk,
        .edge-segment {
            font-weight: 700
        }

        .edge-accent,
        .edge-segment-0 {
            color: #9fb1ff
        }

        .edge-positive,
        .edge-segment-1 {
            color: #77dec0
        }

        .edge-watch,
        .edge-segment-2 {
            color: #f0c66c
        }

        .edge-risk,
        .edge-segment-3 {
            color: #ff9b8f
        }

        .edge-segment+.edge-segment:before {
            content: " ";
            white-space: pre
        }

        .synthesis-card {
            padding: 24px 26px !important
        }

        .synthesis-card>.sec-title {
            margin-bottom: 14px
        }

        .synthesis-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            border-top: 1px solid var(--line)
        }

        .synthesis-panel {
            min-width: 0;
            padding: 17px 18px 2px;
            border-left: 1px solid var(--line)
        }

        .synthesis-panel:first-child {
            padding-left: 0;
            border-left: 0
        }

        .synthesis-panel .lead {
            margin: 0;
            font-size: 18px;
            line-height: 1.45
        }

        .synthesis-panel p {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.58
        }

        .synthesis-label {
            display: block;
            margin-bottom: 7px;
            font-size: 10.5px;
            font-weight: 800;
            letter-spacing: .09em;
            text-transform: uppercase;
            background: none !important;
            border: 0 !important
        }

        .synthesis-label.neutral {
            color: #5267c8
        }

        .synthesis-label.positive {
            color: var(--green-d)
        }

        .synthesis-label.watch {
            color: var(--amber-d)
        }

        .synthesis-label.risk {
            color: var(--red-d)
        }

        @media (max-width: 1050px) {
            .synthesis-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .synthesis-panel:first-child {
                grid-column: 1 / -1;
                border-bottom: 1px solid var(--line);
                padding-bottom: 20px;
                margin-bottom: 5px;
            }
            .synthesis-panel:nth-child(2) {
                border-left: none;
                padding-left: 0;
            }
        }

        @media(max-width:820px) {
            .synthesis-grid {
                grid-template-columns: 1fr
            }

            .synthesis-panel,
            .synthesis-panel:first-child,
            .synthesis-panel:nth-child(2) {
                padding: 15px 0;
                border-left: 0;
                border-top: 1px solid var(--line);
                border-bottom: 0;
                margin-bottom: 0;
            }

            .synthesis-panel:first-child {
                border-top: 0
            }

            .qci-edge .edge-copy {
                font-size: 13.5px
            }
        }

        /* Reference-aligned score composition */
        .score-composition {
            overflow: hidden;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            background: #fff;
            padding: 6px 26px 20px
        }

        .composition-row {
            display: grid;
            grid-template-columns: minmax(210px, 280px) minmax(260px, 1fr) 56px;
            align-items: center;
            gap: 20px;
            padding: 19px 0;
            border-bottom: 1px solid var(--line)
        }

        .composition-name {
            font-size: 14px;
            font-weight: 700
        }

        .composition-bar {
            height: 10px;
            overflow: hidden;
            border-radius: 99px;
            background: #ecebe8
        }

        .composition-fill {
            height: 100%;
            border-radius: inherit
        }

        .composition-fill.g {
            background: var(--green) !important
        }

        .composition-fill.a {
            background: var(--amber) !important
        }

        .composition-fill.r {
            background: var(--red) !important
        }

        .composition-value {
            text-align: right;
            font: 600 17px/1 'Source Serif 4', Georgia, serif
        }

        .composition-value.g {
            color: var(--green-d)
        }

        .composition-value.a {
            color: var(--amber-d)
        }

        .composition-value.r {
            color: var(--red-d)
        }

        .composition-insight {
            margin: 0;
            padding: 20px 0 0;
            font-size: 14px;
            line-height: 1.6
        }

        /* Sentiment trajectory */
        .sentiment-shell {
            overflow: hidden;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            background: #fff
        }

        .sentiment-scroll {
            overflow-x: auto;
            padding: 18px 20px 0
        }

        .sentiment-chart {
            display: block;
            width: 100%;
            min-width: 760px;
            height: auto
        }

        .sentiment-gridline {
            stroke: #ecebe7;
            stroke-width: 1;
            stroke-dasharray: 4 5
        }

        .sentiment-baseline {
            stroke: #d9d8d3;
            stroke-width: 1.25
        }

        .sentiment-axis {
            fill: var(--faint);
            font: 12px 'Manrope', system-ui, sans-serif
        }

        .sentiment-period {
            fill: var(--muted);
            font: 11px 'Manrope', system-ui, sans-serif
        }

        .sentiment-dot {
            stroke: #fff;
            stroke-width: 2
        }

        .sentiment-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 18px;
            padding: 0 22px 18px;
            color: var(--muted);
            font-size: 12px
        }

        .sentiment-legend span {
            display: inline-flex;
            align-items: center;
            gap: 7px
        }

        .sentiment-legend i {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--amber)
        }

        .sentiment-legend .optimistic i {
            background: var(--green)
        }

        .sentiment-legend .defensive i {
            background: var(--red)
        }

        /* Collapsible source evidence */
        .source-toggle {
            display: inline-flex;
            align-items: center;
            margin-top: 8px;
            padding: 0;
            border: none;
            background: transparent;
            color: var(--amber-d);
            font: 600 13px var(--font-sans);
            cursor: pointer;
            text-transform: none;
            letter-spacing: normal;
        }

        .source-toggle:hover,
        .source-toggle:focus-visible {
            color: var(--amber);
            outline: none
        }

        .source-toggle::before {
            content: "▼";
            margin-right: 5px;
            font-size: 9px;
        }

        .source-toggle[aria-expanded="true"]::before {
            content: "▲";
        }

        .source-detail td {
            padding: 0 !important;
            background: #fbfaf7
        }

        .source-detail[hidden] {
            display: none
        }

        .source-detail-inner {
            padding: 15px 20px 17px;
            border-left: 3px solid var(--amber);
            color: var(--muted);
            font: italic 13px/1.58 'Source Serif 4', Georgia, serif
        }

        .source-detail-meta {
            display: block;
            margin-top: 7px;
            color: var(--faint);
            font: 11px/1.4 'Manrope', system-ui, sans-serif;
            font-style: normal
        }

        /* Outlook cards inherit the signal tone */
        .outlook-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px
        }

        .outlook-card {
            --outlook-color: var(--amber);
            min-width: 0;
            padding: 21px 23px;
            border: 1px solid var(--line);
            border-left: 3px solid var(--outlook-color);
            border-radius: var(--radius);
            background: #fff;
        }

        .outlook-card.tailwind,
        .outlook-card.optimistic {
            --outlook-color: var(--green);
        }

        .outlook-card.headwind,
        .outlook-card.defensive {
            --outlook-color: var(--red);
        }

        .outlook-card h3 {
            margin: 0;
            font-size: 16px
        }

        .outlook-card .desc {
            margin: 12px 0
        }

        .outlook-card .meta strong {
            color: var(--ink)
        }

        @media(max-width:820px) {
            .composition-row {
                grid-template-columns: 1fr 46px;
                gap: 10px
            }

            .composition-name {
                grid-column: 1/-1
            }

            .outlook-grid {
                grid-template-columns: 1fr
            }

            .score-composition {
                padding-left: 20px;
                padding-right: 20px
            }
        }

        /* Unified typography: one sans-serif family across every UI element. */
        :root {
            --font-sans: 'Manrope', Inter, Arial, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
        }

        html,
        body,
        button,
        input,
        select,
        textarea {
            font-family: var(--font-sans) !important
        }

        body *,
        body *::before,
        body *::after {
            font-family: var(--font-sans) !important
        }
            /* QC Intuition Table PC Layout Fix */
        .qci table, .qci-table { table-layout: fixed; }
        .qci table th:nth-child(1), .qci-table th:nth-child(1) { width: 32% !important; }
        .qci table th:nth-child(2), .qci-table th:nth-child(2) { width: 14% !important; }
        .qci table th:nth-child(3), .qci-table th:nth-child(3) { width: 14% !important; }
        .qci table th:nth-child(4), .qci-table th:nth-child(4) { width: 40% !important; }
</style>
</head>

<body>
    <main class="wrap" data-template-category="industry-analysis">
        <header class="top">
            <div>
                <div class="lens-row"><span class="eyebrow">Opportunity Lens</span>{{#if overall_sentiment}}<span
                            class="pill {{{overall_sentiment.pill_class}}}">{{{overall_sentiment.label}}}</span>{{/if}}
                </div>
                <h1 class="title">Management Views on Industry</h1>
                <div class="asset-kicker">{{{asset_name}}}</div>
            </div>
            <div class="top-right">
            {{#if source_meta}}
            <table class="top-meta">
                <tr><th colspan="2" style="padding: 8px 12px 4px; text-align: center; color: #b4b3ae; font-size: 9.5px; font-weight: 400;  white-space: nowrap; border-bottom: none;">Latest analysed</th></tr>
                {{#if source_meta.transcript}}<tr><td class="meta-label">Transcript</td><td>{{{source_meta.transcript}}}</td></tr>{{/if}}
                {{#if source_meta.ppt}}<tr><td class="meta-label">Investor Presentation</td><td>{{{source_meta.ppt}}}</td></tr>{{/if}}
                {{#if source_meta.annual_report}}<tr><td class="meta-label">Annual Report</td><td>{{{source_meta.annual_report}}}</td></tr>{{/if}}
            </table>
            {{/if}}
            </div>
        </header>
        {{#if score}}
            <section class="score-badge">
                <div class="score-ring {{{score.sentiment_class}}}" style="--score:{{{score.value}}}"><span
                        class="score-num">{{{score.value}}}</span></div>
                <div>
                    <div class="score-label">{{{score.label}}}</div>
                    <div class="score-desc">{{{score.desc}}}</div>
                </div>
            </section>
        {{/if}}
        {{#if headline.length}}
            <section class="sec">
                <div class="sec-head">
                    <div class="sec-title">Headline insights</div>
                </div>
                <div class="grid three">{{#each headline}}
                        <article class="stat">
                            <div class="lab {{{dot}}}"><span class="dot"></span>{{{label}}}</div>
                            <div class="big {{{value_color}}}">{{{value}}}</div>
                            <div class="desc">{{{desc}}}</div>
                        </article>
                    {{/each}}</div>
            </section>
        {{/if}}
        {{#if dimensions.length}}
            <section class="sec">
                <div class="sec-head">
                    <div class="sec-title">{{#if score.value}}How the {{{score.value}}}/100 is built{{else}}How the
                            industry score is built{{/if}}</div>
                    <div class="sec-note">Weighted across {{{dimensions.length}}} perception dimensions</div>
                </div>
                <div class="score-composition">{{#each dimensions}}
                        <div class="composition-row">
                            <div class="composition-name">{{{name}}}</div>
                            <div class="composition-bar">
                                <div class="composition-fill {{{color}}}" style="width:{{{score}}}%"></div>
                            </div>
                            <div class="composition-value {{{color}}}">{{{score}}}</div>
                        </div>
                    {{/each}}{{#if score.desc}}
                        <p class="composition-insight"><strong>Key insight:</strong> {{{score.desc}}}</p>
                    {{/if}}</div>
            </section>
        {{/if}}
        {{#if narrative.Patterns.length}}
            <section class="qci">
                <div class="qci-head">
                    <div class="qci-badge">QC Intuition · Pattern Recognition</div>
                    <div class="qci-title">What management sees in the industry</div>
                    {{!-- <div class="qci-sub">{{{narrative.source_types}}}{{#if narrative.period_start}} ·
                            {{{narrative.period_start}}} → {{{narrative.period_end}}}{{/if}}</div> --}}
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Theme</th>
                                <th>Evolution</th>
                                <th>Status</th>
                                <th>What it means</th>
                            </tr>
                        </thead>
                        <tbody>{{#each narrative.Patterns}}
                                <tr>
                                    <td><strong>{{{name}}}</strong>
                                        <div class="sub">{{{sub}}}</div>
                                    </td>
                                    <td>
                                      <div style="width: 110px;">
                                        <svg class="spark" viewBox="0 0 110 46" preserveAspectRatio="xMidYMid meet" aria-hidden="true"
                                          style="display:block;">
                                          <polyline points="{{{trendSparkPoints trend}}}" fill="none" stroke="{{{trendHex trend}}}"
                                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                                            vector-effect="non-scaling-stroke" />
                                          <circle cx="104" cy="{{{trendSparkEndY trend}}}" r="3.5" fill="{{{trendHex trend}}}" />
                                        </svg>
                                        <div
                                          style="display: flex; justify-content: space-between; font-size: 10.5px; color: var(--faint); margin-top: 4px; font-weight: 600; letter-spacing: 0.02em;">
                                          <span>{{{shortPeriod date}}}</span>
                                          <span>{{{shortPeriod (lookup this 'end date')}}}</span>
                                        </div>
                                      </div>
                                    </td>
                                    <td><span
                                            class="pill {{{trend}}}">{{#if status_label}}{{{status_label}}}{{else}}{{{trend}}}{{/if}}</span>
                                    </td>
                                    <td>{{{interp}}}</td>
                                </tr>
                            {{/each}}</tbody>
                    </table>
                </div>
                {{#if narrative.edge}}
                <div class="qci-edge">
                    <div class="qci-edge-label">THE EDGE</div>
                    <div>
                        <p class="edge-copy">
                            {{#if narrative.edge.hl}}
                                <span class="edge-positive">{{{narrative.edge.hl}}}</span>
                            {{else if narrative.edge.content}}
                                <span data-inline-markdown>{{{narrative.edge.content}}}</span>
                            {{else}}
                                <span data-inline-markdown>{{{narrative.edge}}}</span>
                            {{/if}}

                            {{#if narrative.edge.pct}}
                                <span class="edge-watch">{{{narrative.edge.pct}}}</span>
                            {{/if}}
                        </p>
                    </div>
                </div>
            {{/if}}
            </section>
        {{/if}}
        {{#if timeline.length}}
            <section class="sec">
                <div class="sec-head">
                    <div class="sec-title">Sentiment trajectory</div>
                    <div class="sec-note">Recent periods carry greater weight</div>
                </div>
                <div class="sentiment-shell">
                    <div class="sentiment-scroll"><svg class="sentiment-chart" viewBox="0 0 1180 245" role="img"
                            aria-label="Industry sentiment trajectory over time">
                            <line class="sentiment-gridline" x1="145" y1="72" x2="1045" y2="72"></line>
                            <line class="sentiment-gridline" x1="145" y1="120" x2="1045" y2="120"></line>
                            <line class="sentiment-baseline" x1="145" y1="168" x2="1045" y2="168"></line><text
                                class="sentiment-axis" x="22" y="76">Optimistic</text><text class="sentiment-axis"
                                x="22" y="124">Cautious</text><text class="sentiment-axis" x="22"
                                y="172">Defensive</text>{{#each timeline}}
                                <g>
                                    <title>{{{x_period}}} · {{{label}}} · {{{posture}}} · intensity {{{severity}}}/5</title>
                                    <circle class="sentiment-dot" cx="{{{timelineX @index ../timeline.length}}}"
                                        cy="{{#if (eq posture " optimistic")}}72{{else}}{{#if (eq posture "defensive"
                                        )}}168{{else}}120{{/if}}{{/if}}"
                                        r="{{#if (eq severity 4)}}11{{else}}{{#if (eq severity 3)}}9{{else}}7.5{{/if}}{{/if}}"
                                        fill="{{#if (eq posture " optimistic")}}#1c7a4d{{else}}{{#if (eq
                                        posture "defensive" )}}#bb3a32{{else}}#b1750f{{/if}}{{/if}}"></circle><text
                                        class="sentiment-period" x="{{{timelineX @index ../timeline.length}}}" y="204"
                                        text-anchor="middle">{{{x_period}}}</text>
                                </g>
                            {{/each}}
                        </svg></div>
                    <div class="sentiment-legend"><span class="optimistic"><i></i>Optimistic /
                            Tailwind</span><span><i></i>Cautious / Mixed</span><span class="defensive"><i></i>Defensive
                            / Headwind</span><span>Marker size reflects intensity</span></div>
                </div>
            </section>
        {{/if}}
        {{#if dynamics.length}}
            <section class="sec">
                <div class="sec-head">
                    <div class="sec-title">Demand, margin & structure dynamics</div>
                    <div class="sec-note">what management perceives .  tap a row to see the source quote</div>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th>Dynamic</th>
                                <th>Direction</th>
                                <th>Signal</th>
                            </tr>
                        </thead>
                        <tbody>{{#each dynamics}}
                                <tr>
                                    <td><strong>{{{period}}}</strong>
                                        <div class="meta">{{{date_label}}}</div>
                                    </td>
                                    <td><strong>{{{name}}}</strong>
                                        <div class="sub">{{{desc}}}</div>{{#if source.quote}}<button class="source-toggle"
                                                type="button" aria-expanded="false"
                                                aria-controls="industry-source-{{{@index}}}"
                                                onclick="toggleIndustrySource(this,'industry-source-{{{@index}}}')">Source quote</button>{{/if}}
                                    </td>
                                    <td>{{{direction_word}}}</td>
                                    <td><span class="pill {{{signal}}}">{{{signal}}}</span></td>
                                </tr>{{#if source.quote}}
                                    <tr class="source-detail" id="industry-source-{{{@index}}}" hidden>
                                        <td colspan="4">
                                            <div class="source-detail-inner">“{{{source.quote}}}”{{#if source.meta}}<span
                                                    class="source-detail-meta">{{{source.meta}}}</span>
                                {{/if}}
                </div>
                </td>
                </tr>
        {{/if}}{{/each}}</tbody>
        </table>
        </div>
        </section>{{/if}}
        {{#if positioning}}
            <section class="sec">
                <div class="sec-head">
                    <div class="sec-title">Competitive positioning & resilience</div>
                    <div class="sec-note">Structural strengths versus exposed vulnerabilities</div>
                </div>
                <div class="balance">
                    <div class="balance-grid">
                        <article class="balance-block">
                            <div class="balance-head">
                                <div>
                                    <h3>{{{positioning.strengths.title}}}</h3>
                                    <div class="sub">{{{positioning.strengths.sub}}}</div>
                                </div><span class="balance-count g">{{{positioning.strengths.count}}} items</span>
                            </div>
                            <div class="balance-track">
                                <div class="balance-fill g" style="width:{{{positioning.strengths.count}}}0%"></div>
                            </div>{{#each positioning.strengths.items}}
                                <div class="factor-item"><span class="factor-mark g">✓</span><span>{{{this}}}</span></div>
                            {{/each}}
                        </article>
                        <article class="balance-block">
                            <div class="balance-head">
                                <div>
                                    <h3>{{{positioning.vulnerabilities.title}}}</h3>
                                    <div class="sub">{{{positioning.vulnerabilities.sub}}}</div>
                                </div><span class="balance-count r">{{{positioning.vulnerabilities.count}}} items</span>
                            </div>
                            <div class="balance-track">
                                <div class="balance-fill r" style="width:{{{positioning.vulnerabilities.count}}}0%"></div>
                            </div>{{#each positioning.vulnerabilities.items}}
                                <div class="factor-item"><span class="factor-mark r">×</span><span>{{{this}}}</span></div>
                            {{/each}}
                        </article>
                    </div>{{#if positioning.takeaway}}
                        <div class="balance-takeaway"><strong>Synthesis:</strong> {{{positioning.takeaway}}}</div>
                    {{/if}}
                </div>
            </section>
        {{/if}}
        {{#if outlook.length}}
            <section class="sec">
                <div class="sec-head">
                    <div class="sec-title">Medium-term outlook · 2–3 years</div>
                    <div class="sec-note">Card color follows the underlying signal.</div>
                </div>
                <div class="outlook-grid">{{#each outlook}}
                        <article class="outlook-card {{{direction}}}">
                            <div class="factor-head">
                                <h3>{{{name}}}</h3><span class="pill {{{direction}}}">{{{direction}}}</span>
                            </div>
                            <p class="desc">{{{desc}}}</p>
                            <div class="meta">Driver: <strong>{{{driver}}}</strong> · Type: <strong>{{{type}}}</strong>
                            </div>
                        </article>
                    {{/each}}</div>
            </section>
        {{/if}}
        {{#if synthesis}}
            <section class="sec keymsg synthesis-card">
                <div class="sec-title">Synthesis</div>
                <div class="synthesis-grid">
                    <div class="synthesis-panel"><span class="synthesis-label neutral">Bottom line</span>
                        <div class="lead">{{{synthesis.lead}}}</div>
                    </div>
                    <div class="synthesis-panel"><span class="synthesis-label positive">Industry structure</span>
                        <p>{{{synthesis.structure_para}}}</p>
                    </div>
                    <div class="synthesis-panel"><span class="synthesis-label watch">Operating dynamics</span>
                        <p>{{{synthesis.dynamics_para}}}</p>
                    </div>
                    <div class="synthesis-panel"><span class="synthesis-label risk">Strategic read</span>
                        <p>{{{synthesis.framework_para}}}</p>
                    </div>
                </div>
            </section>
        {{/if}}
        <script>
            function toggleIndustrySource(button, id) { 
                const row = document.getElementById(id); 
                if (!row) return; 
                const opening = row.hasAttribute('hidden'); 
                if (opening) row.removeAttribute('hidden'); 
                else row.setAttribute('hidden', ''); 
                button.setAttribute('aria-expanded', String(opening)); 
                // Removed the text swap logic so the CSS ::before triangle works perfectly
            } 
            document.querySelectorAll('[data-inline-markdown]').forEach(el => { 
                const parts = el.textContent.split('**'); 
                el.textContent = ''; 
                parts.forEach((part, i) => { 
                    const node = i % 2 ? document.createElement('strong') : document.createTextNode(part); 
                    if (i % 2) node.textContent = part; el.appendChild(node) 
                }) 
            });
        </script>
    </main>
</body>

</html>
