            height: 72px;
            flex: 0 0 auto;
            border-radius: 50%;
            background: conic-gradient(var(--tone) calc(var(--score)*1%), #f0efeb 0);
            display: grid;
            place-items: center
        }

        .score-ring:after {
            content: "";
            position: absolute;
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: #fff
