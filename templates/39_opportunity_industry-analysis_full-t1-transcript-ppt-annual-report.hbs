            --green-bd: #cfe5d8;
            --red: #bb3a32;
            --red-d: #9a2d27;
            --red-bg: #fbeeed;
            --red-bd: #f0d4d1;
            --amber: #b1750f;
            --amber-d: #8f5d0a;
            --amber-bg: #fbf3e3;
