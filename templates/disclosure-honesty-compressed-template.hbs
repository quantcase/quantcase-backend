<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Disclosure Honesty — {{asset_name}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#faf9f6;--ink:#14151a;--sub:#6b6d76;--line:#e7e5df;
      --navy1:#0b1226;--navy2:#1a2a5e;--navy3:#28407e;
      --g:#127a4f;--g-bg:#e8f4ee;--g-ln:#c3e1d3;
      --a:#a5680b;--a-bg:#fbf1de;--a-ln:#ecd8ab;
      --r:#bf3a30;--r-bg:#fceeec;--r-ln:#f2cec9;
      --blue:#3f5edb;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Manrope',sans-serif;background:var(--bg);color:var(--ink);font-size:14.5px;line-height:1.4;-webkit-font-smoothing:antialiased}
    .wrap{max-width:980px;margin:0 auto;padding:0 0 40px}
    .mono{font-family:'IBM Plex Mono',monospace}
    b,strong{font-weight:700}

    .hero{background:radial-gradient(120% 160% at 8% 0%,var(--navy3) 0%,var(--navy2) 45%,var(--navy1) 100%);color:#fff;padding:28px 30px 26px;position:relative;overflow:hidden;border-radius:0 0 18px 18px}
    .hero::after{content:'';position:absolute;top:-60px;right:-60px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.08),transparent 70%)}
    .hero-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;position:relative;z-index:1}
    .eyebrow{font-family:'IBM Plex Mono',monospace;font-size:10.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5)}
    h1.title{font-family:'Source Serif 4',Georgia,serif;font-size:25px;font-weight:600;letter-spacing:-.01em;margin-top:3px;color:#fff}
    .datestamp{font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:rgba(255,255,255,.4);text-align:right;white-space:nowrap}
    .hero-main{display:flex;align-items:center;gap:22px;margin-top:20px;flex-wrap:wrap;position:relative;z-index:1}
    .gauge{width:104px;height:104px;position:relative;flex-shrink:0;color:#5be599}
    .gauge.amber{color:#f3c877}.gauge.red{color:#ff8f86}
    .gauge svg{width:100%;height:100%;transform:rotate(-90deg)}
    .gauge-value{stroke:currentColor}
    .gauge-num{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
    .gauge-num .n{font-family:'Source Serif 4',Georgia,serif;font-size:32px;font-weight:700;color:#fff;line-height:1}
    .gauge-num .of{font-family:'IBM Plex Mono',monospace;font-size:9px;color:rgba(255,255,255,.4);margin-top:1px}
    .hero-verdict{flex:1;min-width:230px}
    .vbadge{display:inline-flex;align-items:center;gap:6px;background:rgba(125,211,160,.15);border:1px solid rgba(125,211,160,.35);color:#8ee8b8;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:4px 12px;border-radius:20px;margin-bottom:9px}
    .vbadge.amber{background:rgba(243,200,119,.14);border-color:rgba(243,200,119,.35);color:#f3c877}
    .vbadge.red{background:rgba(255,143,134,.14);border-color:rgba(255,143,134,.35);color:#ff9d95}
    .vbadge .d{width:6px;height:6px;border-radius:50%;background:currentColor}
    .vlead{font-family:'Source Serif 4',Georgia,serif;font-size:18px;font-weight:600;line-height:1.32;max-width:560px}
    .score-desc{margin-top:7px;max-width:600px;color:rgba(255,255,255,.56);font-size:11.5px;line-height:1.4}
    .hero-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:22px;position:relative;z-index:1}
    .hs-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:12px 14px;backdrop-filter:blur(2px)}
    .hs-icon{font-size:16px;margin-bottom:6px;display:block}
    .hs-label{font-size:12px;font-weight:700;color:#fff;line-height:1.25;margin-bottom:3px}
    .hs-tag{font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:.05em;text-transform:uppercase;padding:2px 7px;border-radius:4px;display:inline-block}
    .hs-tag.g{color:#8ee8b8;background:rgba(125,211,160,.14)}
    .hs-tag.a{color:#f3c877;background:rgba(243,200,119,.14)}
    .hs-tag.r{color:#ff9d95;background:rgba(255,143,134,.14)}

    .sec{padding:0 30px;margin-top:26px}
    .sec-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:12px;gap:10px;flex-wrap:wrap}
    .sec-title{font-family:'IBM Plex Mono',monospace;font-size:10.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--sub)}
    .sec-title::before{content:'';display:inline-block;width:14px;height:1px;background:var(--sub);vertical-align:middle;margin-right:8px}
    .sec-note{font-size:11.5px;color:var(--sub)}

    .sig-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
    .sig-col{border-radius:12px;padding:14px 15px 6px;border:1px solid;counter-reset:signal}
    .sig-col.g{background:var(--g-bg);border-color:var(--g-ln)}
    .sig-col.a{background:var(--a-bg);border-color:var(--a-ln)}
    .sig-col.r{background:var(--r-bg);border-color:var(--r-ln)}
    .sig-head{display:flex;align-items:center;gap:7px;margin-bottom:2px}
    .sig-icon{font-size:14px}.sig-title{font-size:12.5px;font-weight:800;letter-spacing:.01em}
    .sig-col.g .sig-title{color:var(--g)}.sig-col.a .sig-title{color:var(--a)}.sig-col.r .sig-title{color:var(--r)}
    .sig-sub{font-size:10.5px;color:var(--sub);margin-bottom:10px}
    .sig-item{display:flex;gap:7px;padding:8px 0;border-top:1px solid rgba(0,0,0,.06);counter-increment:signal}
    .sig-item .num{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--sub);flex-shrink:0;padding-top:1px}
    .sig-item .num::before{content:counter(signal,decimal-leading-zero)}
    .sig-item .txt{font-size:12.5px;line-height:1.35}.sig-item .txt b{display:block;font-size:12.5px}.sig-item .txt span{color:var(--sub);font-size:11.5px}

    .qci{display:flex;align-items:center;gap:14px;background:linear-gradient(135deg,#eef1fd,#f6f8ff);border:1px solid #d3d9fb;border-radius:11px;padding:12px 16px;margin-bottom:12px}
    .qci-badge{display:inline-flex;align-items:center;gap:6px;background:#fff;border:1px solid #d3d9fb;border-radius:20px;padding:3px 11px;font-family:'IBM Plex Mono',monospace;font-size:9.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--blue);flex-shrink:0}
    .qci-dot{width:6px;height:6px;border-radius:50%;background:var(--blue);animation:qcipulse 2s infinite}
    @keyframes qcipulse{0%,100%{opacity:1}50%{opacity:.3}}
    .qci-txt{font-size:12.5px;line-height:1.4;color:var(--ink)}.qci-txt b{color:var(--blue)}
    .radar{display:flex;flex-direction:column;gap:7px}
    .rad-row{display:grid;grid-template-columns:22px 1fr auto 128px;align-items:center;gap:12px;background:#fff;border:1px solid var(--line);border-radius:9px;padding:9px 14px}
    .rad-emoji{font-size:15px}.rad-txt .t{font-size:12.5px;font-weight:700}.rad-txt .d{font-size:11.5px;color:var(--sub)}
    .rad-pill{font-family:'IBM Plex Mono',monospace;font-size:9.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:3px 8px;border-radius:5px;white-space:nowrap}
    .rad-pill.g{color:var(--g);background:var(--g-bg)}.rad-pill.a{color:var(--a);background:var(--a-bg)}.rad-pill.r{color:var(--r);background:var(--r-bg)}
    .rad-pill.rising::before{content:'▲ '}.rad-pill.steady::before{content:'— '}.rad-pill.mixed::before{content:'~ '}.rad-pill.weakening::before{content:'▼ '}.rad-pill.new::before{content:'◆ '}
    .rad-bar{height:5px;border-radius:3px;background:#eee;position:relative;overflow:hidden}.rad-bar i{position:absolute;left:0;top:0;bottom:0;border-radius:3px}
    .rad-bar i.g{background:var(--g)}.rad-bar i.a{background:var(--a)}.rad-bar i.r{background:var(--r)}
    .strength-very-high{width:88%}.strength-high{width:80%}.strength-medium{width:70%}.strength-mixed{width:52%}.strength-low{width:40%}

    .watch-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;counter-reset:watch}
    .watch-card{background:#fff;border:1px solid var(--line);border-top:3px solid var(--a);border-radius:10px;padding:13px 14px;counter-increment:watch}
    .watch-num{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--a);font-weight:700;margin-bottom:5px}.watch-num::before{content:counter(watch,decimal-leading-zero)}
    .watch-title{font-size:12.5px;font-weight:700;margin-bottom:4px;line-height:1.3}.watch-desc{font-size:11px;color:var(--sub);line-height:1.35}

    .bl-grid{display:flex;flex-direction:column;gap:8px}.bl-row{display:flex;align-items:flex-start;gap:12px;border-radius:10px;padding:13px 16px;border-left:4px solid}
    .bl-row.g{background:var(--g-bg);border-color:var(--g)}.bl-row.a{background:var(--a-bg);border-color:var(--a)}.bl-row.r{background:var(--r-bg);border-color:var(--r)}
    .bl-tag{font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;flex-shrink:0;width:76px;padding-top:2px}
    .bl-row.g .bl-tag{color:var(--g)}.bl-row.a .bl-tag{color:var(--a)}.bl-row.r .bl-tag{color:var(--r)}
    .bl-txt{font-size:13px;line-height:1.4}
    .foot{padding:14px 30px 0;font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--sub);border-top:1px solid var(--line);margin-top:26px}

    @media(max-width:760px){
      .qci{flex-direction:column;align-items:flex-start;gap:8px}
      .sig-grid,.watch-grid,.hero-strip{grid-template-columns:1fr}
      .rad-row{grid-template-columns:20px 1fr;row-gap:6px}.rad-row .rad-pill{grid-column:2}.rad-row .rad-bar{display:none}
      .sec{padding:0 18px}.hero{padding:22px 18px 20px;border-radius:0 0 14px 14px}h1.title{font-size:21px}
    }
  </style>
</head>
<body>
  <main class="wrap">
    <header class="hero">
      <div class="hero-top">
        <div>
          <div class="eyebrow">{{lens}} · {{asset_name}}</div>
          <h1 class="title">Disclosure Honesty</h1>
        </div>
        <div class="datestamp">{{#if period_start}}{{period_start}}→{{period_end}}{{/if}}{{#if computed_date}}<br>Computed {{computed_date}}{{/if}}</div>
      </div>

      <div class="hero-main">
        <div class="gauge {{score_badge.status_color}}">
          <svg viewBox="0 0 104 104" role="img" aria-label="Disclosure honesty score {{score_badge.score}} out of {{score_badge.scale}}">
            <circle cx="52" cy="52" r="44" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="9"/>
            <circle class="gauge-value" cx="52" cy="52" r="44" pathLength="100" fill="none" stroke-width="9" stroke-linecap="round" stroke-dasharray="{{score_badge.score}} 100"/>
          </svg>
          <div class="gauge-num"><span class="n">{{score_badge.score}}</span><span class="of">/ {{score_badge.scale}}</span></div>
        </div>
        <div class="hero-verdict">
          <div class="vbadge {{score_badge.status_color}}"><span class="d"></span>{{score_badge.label}}</div>
          <div class="vlead">{{hero_verdict}}</div>
          {{#if score_badge.description}}<div class="score-desc">{{score_badge.description}}</div>{{/if}}
        </div>
      </div>

      {{#if hero_reasons.length}}
      <div class="hero-strip">
        {{#each hero_reasons}}
        <article class="hs-card"><span class="hs-icon">{{icon}}</span><div class="hs-label">{{label}}</div><span class="hs-tag {{tone}}">{{tag}}</span></article>
        {{/each}}
      </div>
      {{/if}}
    </header>

    {{#if communication_analysis.columns.length}}
    <section class="sec">
      <div class="sec-head"><div class="sec-title">Communication Behaviour</div><div class="sec-note">{{communication_analysis.source_note}}</div></div>
      <div class="sig-grid">
        {{#each communication_analysis.columns}}
        <article class="sig-col {{tone}}">
          <div class="sig-head"><span class="sig-icon">{{icon}}</span><span class="sig-title">{{title}}</span></div>
          <div class="sig-sub">{{subtitle}}</div>
          {{#each items}}
          <div class="sig-item"><span class="num"></span><span class="txt"><b>{{label}}</b><span>{{note}}</span></span></div>
          {{/each}}
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if pattern_radar.patterns.length}}
    <section class="sec">
      <div class="sec-head">
        <div class="sec-title">Pattern Radar</div>
        <div class="sec-note mono">{{#if pattern_radar.signals_parsed}}{{pattern_radar.signals_parsed}} signals parsed{{/if}}{{#if pattern_radar.period_start}} · {{pattern_radar.period_start}} → {{pattern_radar.period_end}}{{/if}}</div>
      </div>
      {{#if pattern_radar.intuition}}
      <div class="qci"><span class="qci-badge"><span class="qci-dot"></span>QC Intuition</span><span class="qci-txt"><b>{{pattern_radar.intuition.lead}}</b> — {{pattern_radar.intuition.detail}}</span></div>
      {{/if}}
      <div class="radar">
        {{#each pattern_radar.patterns}}
        <article class="rad-row">
          <span class="rad-emoji">{{icon}}</span>
          <div class="rad-txt"><div class="t">{{name}}</div><div class="d">{{meaning}}</div></div>
          <span class="rad-pill {{tone}} {{trend}}">{{trend}}</span>
          <div class="rad-bar"><i class="{{tone}} strength-{{strength}}"></i></div>
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if watchpoints.length}}
    <section class="sec">
      <div class="sec-head"><div class="sec-title">Watch Next 4 Quarters</div></div>
      <div class="watch-grid">
        {{#each watchpoints}}
        <article class="watch-card"><div class="watch-num"></div><div class="watch-title">{{title}}</div><div class="watch-desc">{{desc}}</div></article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if bottom_line.length}}
    <section class="sec">
      <div class="sec-head"><div class="sec-title">Bottom Line</div></div>
      <div class="bl-grid">
        {{#each bottom_line}}
        <div class="bl-row {{tone}}"><span class="bl-tag">{{tag}}</span><span class="bl-txt">{{text}}</span></div>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <footer class="foot">DISCLOSURE HONESTY · {{asset_name}}{{#if footer.methodology}} — {{footer.methodology}}{{/if}}{{#if footer.sources}} Sources: {{footer.sources}}.{{/if}}</footer>
  </main>
</body>
</html>
