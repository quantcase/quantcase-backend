<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{asset_name}} · Disclosure Honesty</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Mono:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --paper:#f5f4ef;--surface:#fff;--surface-soft:#f0efe9;--ink:#141a21;
      --muted:#5c6570;--faint:#9aa1a9;--line:#e4e0d4;--line-dark:#c9c5ba;
      --teal:#0e9c86;--teal-dark:#0a6e5c;--teal-soft:#e3f4f0;
      --amber:#c07c12;--amber-soft:#fbf0dc;--red:#c43d34;--red-soft:#fbeae8;
      --blue:#3d5afe;--navy:#0d1b2b;--navy-hero:#1c254b;--navy-line:#40528f;
      --radius:14px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.5 'IBM Plex Sans',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
    .report{width:100%;max-width:980px;margin:0 auto;padding:28px 24px 60px}
    .topline{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid var(--line)}
    .topline-brand{color:var(--faint);font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase}
    .topline-brand strong{color:var(--ink)}
    .topline-period{margin:0;color:var(--faint);font:500 11px/1.45 'IBM Plex Mono',monospace;text-align:right}

    /* 1. NAVY — Hero */
    .hero{position:relative;display:grid;grid-template-columns:180px minmax(0,1fr);gap:38px;align-items:center;min-height:286px;padding:42px 40px;overflow:hidden;color:#fff;background:var(--navy-hero);border:1px solid var(--navy-line);border-radius:20px}
    .hero::after{position:absolute;inset:0;background:radial-gradient(500px 240px at 92% -20%,rgba(115,139,230,.16),transparent 70%);content:"";pointer-events:none}
    .hero-body,.score-ring{position:relative;z-index:1}
    .hero-body{min-width:0}
    .score-ring{--score:{{score_badge.score}};--score-color:var(--teal);position:relative;display:grid;width:180px;aspect-ratio:1;place-items:center;border-radius:50%;background:conic-gradient(var(--score-color) calc(var(--score) * 1%),rgba(255,255,255,.14) 0)}
    .score-ring.amber{--score-color:#efb552}.score-ring.red{--score-color:#ed8078}
    .score-ring::before{position:absolute;width:calc(100% - 24px);aspect-ratio:1;background:#13283d;border-radius:50%;content:""}
    .score-copy{position:relative;text-align:center}
    .score-value{display:block;color:#8ff0da;font-family:'Fraunces',Georgia,serif;font-size:52px;font-weight:600;line-height:1}
    .score-ring.amber .score-value{color:#ffd58c}.score-ring.red .score-value{color:#ffaaa4}
    .score-scale{display:block;margin-top:4px;color:rgba(255,255,255,.5);font:600 10.5px/1.4 'IBM Plex Mono',monospace;letter-spacing:.08em;text-transform:uppercase}
    .eyebrow{margin:0;color:#8ff0da;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase}
    .hero-title{margin:8px 0 2px;color:#fff;font-family:'Fraunces',Georgia,serif;font-size:34px;font-weight:600;line-height:1.2}
    .rating-line{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:8px 0 0}
    .rating-badge{display:inline-flex;align-items:center;gap:7px;padding:5px 11px;color:#8ff0da;background:rgba(14,156,134,.11);border:1px solid rgba(143,240,218,.25);border-radius:999px;font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
    .rating-badge.amber{color:#ffd58c;background:rgba(239,181,82,.11);border-color:rgba(255,213,140,.25)}
    .rating-badge.red{color:#ffaaa4;background:rgba(237,128,120,.11);border-color:rgba(255,170,164,.25)}
    .rating-badge::before{width:6px;height:6px;background:currentColor;border-radius:50%;content:""}
    .rating-text{color:rgba(255,255,255,.55);font:600 10.5px/1.4 'IBM Plex Mono',monospace;text-transform:uppercase}
    .verdict{max-width:680px;margin:10px 0 6px;color:rgba(255,255,255,.82);font-size:15px}
    .score-description{max-width:680px;margin:0;color:rgba(255,255,255,.55);font-size:12px;line-height:1.45}
    .reasons{display:flex;flex-wrap:wrap;gap:9px;margin-top:18px}
    .reason{display:inline-flex;align-items:center;gap:7px;padding:7px 12px;color:rgba(255,255,255,.86);background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);border-radius:999px;font-size:12.5px;font-weight:500}
    .reason::before{width:7px;height:7px;background:#9de1d3;border-radius:50%;content:""}.reason.a::before{background:#ffd58c}.reason.r::before{background:#ffaaa4}
    .reason-tag{color:rgba(255,255,255,.45);font:600 9px/1.3 'IBM Plex Mono',monospace;letter-spacing:.05em;text-transform:uppercase}
    .reason.g .reason-tag{color:#9de1d3}.reason.a .reason-tag{color:#ffd58c}.reason.r .reason-tag{color:#ffaaa4}

    section{padding:0;border:0}
    .section-head{display:flex;align-items:baseline;justify-content:flex-start;gap:10px;margin:34px 0 14px}
    .section-head>div{display:flex;align-items:baseline;gap:10px}
    .section-tag{margin:0;color:var(--teal-dark);font:700 10px/1.4 'IBM Plex Mono',monospace;letter-spacing:.1em;text-transform:uppercase}
    .section-title{margin:0;font-size:16px;font-weight:600;line-height:1.3}
    .section-note{margin:0 0 0 auto;color:var(--faint);font-size:11px;text-align:right}

    /* 2. WHITE — Three score cards matching the hero tags */
    /* Extra breathing room before the QC Intuition panel. */
    .headline-section{padding-bottom:26px}
    .headline-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;counter-reset:headline}
    .headline-card{position:relative;min-width:0;min-height:164px;padding:20px;background:var(--surface);border:1px solid var(--line);border-top:4px solid var(--teal);border-radius:var(--radius);counter-increment:headline}
    .headline-card.a{border-top-color:var(--amber)}.headline-card.r{border-top-color:var(--red)}
    .headline-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}
    .headline-number{color:var(--faint);font:600 10px/1.4 'IBM Plex Mono',monospace}.headline-number::before{content:counter(headline,decimal-leading-zero)}
    .headline-tag{padding:4px 8px;color:var(--teal-dark);background:var(--teal-soft);border-radius:999px;font:700 9px/1.3 'IBM Plex Mono',monospace;letter-spacing:.06em;text-transform:uppercase}
    .headline-card.a .headline-tag{color:#875408;background:var(--amber-soft)}.headline-card.r .headline-tag{color:#9a3029;background:var(--red-soft)}
    .headline-title{margin:0 0 7px;font-family:'Fraunces',Georgia,serif;font-size:19px;font-weight:600;line-height:1.25}
    .headline-description{margin:0;color:var(--muted);font-size:12.5px;line-height:1.5}

    /* Detailed communication analysis, positioned below The Edge. */
    .communication-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    .communication-card{min-width:0;padding:20px;background:var(--surface);border:1px solid var(--line);border-top:4px solid var(--teal);border-radius:var(--radius)}
    .communication-card.a{border-top-color:var(--amber)}.communication-card.r{border-top-color:var(--red)}
    .communication-title-row{display:flex;align-items:center;gap:8px}
    .communication-title{margin:0;font-size:13.5px;font-weight:600}.communication-subtitle{margin:3px 0 12px;color:var(--faint);font-size:11px}
    .communication-items{margin:0;padding:0;list-style:none;counter-reset:communication}
    .communication-item{position:relative;margin-top:9px;padding:9px 0 0 30px;border-top:1px solid var(--line);counter-increment:communication}
    .communication-item::before{position:absolute;top:10px;left:0;color:var(--faint);font:600 9.5px/1.5 'IBM Plex Mono',monospace;content:counter(communication,decimal-leading-zero)}
    .communication-item strong{display:block;font-size:12px;font-weight:600}.communication-item span{display:block;margin-top:2px;color:var(--muted);font-size:11.5px;line-height:1.4}

    /* 3. NAVY — QC Intuition */
    .intuition-panel{position:relative;min-height:260px;padding:34px 38px;overflow:hidden;color:#fff;background:#18213f;border:1px solid #3f4e87;border-radius:20px}
    .intuition-panel::before,.intuition-panel::after{position:absolute;border-radius:50%;background:rgba(115,139,230,.10);content:"";pointer-events:none}
    .intuition-panel::before{width:230px;height:230px;top:-105px;right:-55px}.intuition-panel::after{width:230px;height:230px;bottom:-190px;left:-95px}
    .intuition-content{position:relative;z-index:1;max-width:820px}
    .intuition-badge{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;color:#a9bafa;border:1px solid #5266aa;border-radius:999px;font-size:10.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase}
    .intuition-badge::before{width:7px;height:7px;background:#7895ff;border-radius:50%;box-shadow:0 0 0 6px rgba(120,149,255,.12);content:""}
    .intuition-heading{margin:38px 0 10px;font-family:'Fraunces',Georgia,serif;font-size:clamp(25px,4vw,38px);font-weight:500;line-height:1.15}
    .intuition-line{max-width:820px;margin:0;color:rgba(255,255,255,.64);font-size:15px;line-height:1.55}
    .intuition-meta{margin:20px 0 0;color:rgba(255,255,255,.36);font:500 10.5px/1.4 'IBM Plex Mono',monospace}

    /* 4. WHITE — Key Patterns */
    .pattern-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .pattern-card{position:relative;display:grid;grid-template-columns:82px minmax(0,1fr) auto;gap:14px;align-items:center;min-height:112px;padding:17px;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius)}
    .pattern-visual{display:grid;gap:8px;place-items:center}
    .sparkline{display:flex;width:72px;height:46px;align-items:end;justify-content:center;gap:4px;padding:0 4px 4px;border-bottom:1px solid var(--line-dark)}
    .sparkline i{display:block;width:8px;height:18%;background:var(--teal);border-radius:3px 3px 1px 1px}.pattern-card.a .sparkline i{background:var(--amber)}.pattern-card.r .sparkline i{background:var(--red)}
    .sparkline i.v0{height:8%}.sparkline i.v1{height:20%}.sparkline i.v2{height:38%}.sparkline i.v3{height:56%}.sparkline i.v4{height:76%}.sparkline i.v5{height:96%}
    .pattern-bar{position:relative;width:64px;height:5px;overflow:hidden;background:var(--surface-soft);border-radius:99px}
    .pattern-bar i{position:absolute;inset-block:0;left:0;width:70%;background:var(--teal);border-radius:inherit}.pattern-bar i.a{background:var(--amber)}.pattern-bar i.r{background:var(--red)}
    .pattern-bar i.very-high{width:92%}.pattern-bar i.high{width:80%}.pattern-bar i.medium{width:68%}.pattern-bar i.mixed{width:52%}.pattern-bar i.low{width:38%}
    .pattern-name{margin:0 0 4px;font-size:13.5px;font-weight:600}.pattern-meaning{margin:0;color:var(--muted);font-size:12px;line-height:1.4}
    .trend{padding:4px 8px;color:var(--muted);background:var(--surface-soft);border-radius:999px;font:700 9px/1.3 'IBM Plex Mono',monospace;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}
    .trend.rising{color:var(--teal-dark);background:var(--teal-soft)}.trend.weakening{color:#9a3029;background:var(--red-soft)}.trend.mixed{color:#875408;background:var(--amber-soft)}.trend.new{color:#3047bd;background:#eaedff}

    /* 5. NAVY — The Edge */
    .edge-panel{padding:22px 24px;color:#fff;background:var(--navy);border:1px solid #31465f;border-radius:var(--radius)}
    .edge-top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px}
    .edge-badge{display:inline-flex;padding:5px 10px;color:#b9c7ff;background:rgba(115,139,230,.10);border:1px solid #5266aa;border-radius:999px;font:700 10px/1.3 'IBM Plex Mono',monospace;letter-spacing:.07em;text-transform:uppercase}
    .edge-grid{display:grid;grid-template-columns:110px minmax(0,1fr);gap:11px 14px}.edge-grid>div{display:contents}
    .edge-label{margin:0;padding-top:2px;color:#8ba4fb;font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}
    .edge-copy{margin:0;color:rgba(255,255,255,.85);font-size:13px;line-height:1.5}.edge-copy.accent{color:#d9c9ff}
    .focus-chip{display:inline-block;margin-right:7px;padding:3px 8px;color:#c9d3ff;background:rgba(115,139,230,.13);border:1px solid rgba(139,164,251,.38);border-radius:999px;font:700 9.5px/1.35 'IBM Plex Mono',monospace;letter-spacing:.04em;text-transform:uppercase;vertical-align:1px}

    .insight-stack{margin-top:0}
    .insight-stack .intuition-panel{border-radius:20px 20px 0 0}
    .insight-patterns{padding:18px;background:var(--paper);border-right:1px solid var(--line-dark);border-left:1px solid var(--line-dark)}
    .insight-stack .edge-panel{border-radius:0 0 var(--radius) var(--radius)}

    .watch-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;counter-reset:watch}
    .watchpoint{padding:16px;background:var(--surface);border:1px solid var(--line);border-top:3px solid var(--amber);border-radius:var(--radius);counter-increment:watch}
    .watch-number{display:block;margin-bottom:6px;color:var(--amber);font:700 10px/1.4 'IBM Plex Mono',monospace}.watch-number::before{content:counter(watch,decimal-leading-zero)}
    .watch-name{margin:0 0 4px;font-size:13px;font-weight:600}.watch-desc{margin:0;color:var(--muted);font-size:12px;line-height:1.45}
    .bottom-line{display:grid;gap:10px}.bottom-row{display:grid;grid-template-columns:90px minmax(0,1fr);gap:12px;padding:14px 16px;background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--teal);border-radius:10px}
    .bottom-row.a{border-left-color:var(--amber)}.bottom-row.r{border-left-color:var(--red)}
    .bottom-tag{color:var(--teal-dark);font:700 10px/1.5 'IBM Plex Mono',monospace;letter-spacing:.06em;text-transform:uppercase}.bottom-row.a .bottom-tag{color:#875408}.bottom-row.r .bottom-tag{color:#9a3029}
    .bottom-copy{color:var(--muted);font-size:12.5px;line-height:1.5}
    footer{display:flex;justify-content:space-between;gap:18px;margin-top:34px;padding-top:16px;color:var(--faint);border-top:1px solid var(--line);font:500 10px/1.5 'IBM Plex Mono',monospace}
    footer span:last-child{text-align:right}

    @media(max-width:760px){
      .report{padding:18px 14px 42px}.topline{align-items:flex-start}.hero{grid-template-columns:1fr;padding:26px 20px;text-align:center}.score-ring{width:150px;margin:0 auto}.rating-line,.reasons{justify-content:center}
      .section-head,.section-head>div{align-items:flex-start;flex-direction:column;gap:3px}.section-note{margin-left:0;text-align:left}
      .headline-grid,.communication-grid,.pattern-grid,.watch-grid{grid-template-columns:1fr}.pattern-card{grid-template-columns:78px minmax(0,1fr) auto}
      .intuition-panel{min-height:0;padding:22px 18px}.intuition-heading{margin-top:28px}.edge-top{align-items:flex-start;flex-direction:column;gap:5px}
      footer{align-items:flex-start;flex-direction:column}footer span:last-child{text-align:left}
    }
    @media(max-width:480px){
      .hero{padding-inline:16px}.hero-title{font-size:29px}.headline-card,.communication-card,.edge-panel{padding:17px}.pattern-card{grid-template-columns:72px minmax(0,1fr);gap:10px}.pattern-card .trend{grid-column:2;justify-self:start}.pattern-bar{width:52px}.sparkline{width:64px}
      .edge-grid{grid-template-columns:1fr;gap:3px}.edge-grid>div{display:grid;gap:3px}.edge-copy+.edge-label{margin-top:9px}.bottom-row{grid-template-columns:1fr;gap:4px}
    }
    @media print{body{background:#fff}.report{max-width:none;padding:0}.hero,.headline-card,.communication-card,.intuition-panel,.pattern-card,.edge-panel,.watchpoint,.bottom-row{break-inside:avoid}}
  </style>
</head>
<body>
  <main class="report">
    <div class="topline">
      <span class="topline-brand"><strong>{{asset_name}}</strong> · {{lens}}</span>
      <p class="topline-period">{{#if period_start}}{{period_start}}{{#if period_end}} → {{period_end}}{{/if}}{{/if}}{{#if computed_date}}<br>Computed {{computed_date}}{{/if}}</p>
    </div>

    <header class="hero">
      <div class="score-ring {{score_badge.status_color}}" role="img" aria-label="Disclosure honesty score {{score_badge.score}} out of {{score_badge.scale}}">
        <div class="score-copy"><span class="score-value">{{score_badge.score}}</span><span class="score-scale">out of {{score_badge.scale}}</span></div>
      </div>
      <div class="hero-body">
        <p class="eyebrow">Disclosure Honesty</p>
        <h1 class="hero-title">{{score_badge.label}}</h1>
        <div class="rating-line"><span class="rating-badge {{score_badge.status_color}}">{{score_badge.rating}}</span></div>
        <p class="verdict">{{hero_verdict}}</p>
        {{#if score_badge.description}}<p class="score-description">{{score_badge.description}}</p>{{/if}}
        {{#if hero_reasons.length}}
        <div class="reasons">
          {{#each hero_reasons}}<div class="reason {{tone}}"><span>{{label}}</span><span class="reason-tag">{{tag}}</span></div>{{/each}}
        </div>
        {{/if}}
      </div>
    </header>

    {{#if hero_reasons.length}}
    <section class="headline-section">
      <div class="section-head">
        <div><p class="section-tag">Headline insights</p><h2 class="section-title">Why the score looks this way</h2></div>
      </div>
      <div class="headline-grid">
        {{#each hero_reasons}}
        <article class="headline-card {{tone}}">
          <div class="headline-top"><span class="headline-number"></span><span class="headline-tag">{{tag}}</span></div>
          <h3 class="headline-title">{{label}}</h3>
          <p class="headline-description">{{description}}</p>
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <section class="insight-stack">
    {{#if pattern_radar.intuition}}
      <div class="intuition-panel">
        <div class="intuition-content">
          <span class="intuition-badge">QC Intuition · Pattern Recognition</span>
          <h2 class="intuition-heading">{{pattern_radar.intuition.lead}}</h2>
          <p class="intuition-line">{{pattern_radar.intuition.detail}}</p>
          {{#if pattern_radar.period_start}}<p class="intuition-meta">{{#if pattern_radar.signals_parsed}}{{pattern_radar.signals_parsed}} signals · {{/if}}{{pattern_radar.period_start}}{{#if pattern_radar.period_end}} → {{pattern_radar.period_end}}{{/if}}</p>{{/if}}
        </div>
      </div>
    {{/if}}

    {{#if pattern_radar.patterns.length}}
    <div class="insight-patterns">
      <div class="pattern-grid">
        {{#each pattern_radar.patterns}}
        <article class="pattern-card {{tone}}">
          <div class="pattern-visual">
            {{#if spark.length}}
            <span class="sparkline" aria-label="Pattern over time">{{#each spark}}<i class="v{{level}}"></i>{{/each}}</span>
            {{else}}
            <span class="pattern-bar"><i class="{{tone}} {{strength}}"></i></span>
            {{/if}}
          </div>
          <div><h3 class="pattern-name">{{name}}</h3><p class="pattern-meaning">{{meaning}}</p></div>
          <span class="trend {{trend}}">{{trend}}</span>
        </article>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if edge}}
      <div class="edge-panel">
        <div class="edge-top"><span class="edge-badge">{{edge.badge}}</span></div>
        <div class="edge-grid">
          <div><p class="edge-label">Behaviour</p><p class="edge-copy">{{edge.behaviour}}</p></div>
          <div><p class="edge-label">Implication</p><p class="edge-copy accent">{{edge.implication}}</p></div>
          {{#if edge.investor_focus}}
          <div><p class="edge-label">Investor focus</p><p class="edge-copy"><span class="focus-chip">{{edge.investor_focus.chip}}</span>{{edge.investor_focus.tail}}</p></div>
          {{/if}}
        </div>
      </div>
    {{/if}}
    </section>

    {{#if communication_analysis.columns.length}}
    <section>
      <div class="section-head">
        <div><p class="section-tag">Disclosure detail</p><h2 class="section-title">Communication behaviour</h2></div>
        <p class="section-note">{{communication_analysis.source_note}}</p>
      </div>
      <div class="communication-grid">
        {{#each communication_analysis.columns}}
        <article class="communication-card {{tone}}">
          <div class="communication-title-row"><h3 class="communication-title">{{title}}</h3></div>
          <p class="communication-subtitle">{{subtitle}}</p>
          <ol class="communication-items">
            {{#each items}}<li class="communication-item"><strong>{{label}}</strong><span>{{note}}</span></li>{{/each}}
          </ol>
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#if watchpoints.length}}
    <section>
      <div class="section-head"><div><p class="section-tag">Forward look</p><h2 class="section-title">Watch next four quarters</h2></div></div>
      <div class="watch-grid">
        {{#each watchpoints}}<article class="watchpoint"><span class="watch-number"></span><h3 class="watch-name">{{title}}</h3><p class="watch-desc">{{desc}}</p></article>{{/each}}
      </div>
    </section>
    {{/if}}

    {{#if bottom_line.length}}
    <section>
      <div class="section-head"><div><p class="section-tag">Investor takeaway</p><h2 class="section-title">{{investor_takeaway_text}}</h2></div></div>
      <div class="bottom-line">
        {{#each bottom_line}}<div class="bottom-row {{tone}}"><span class="bottom-tag">{{tag}}</span><span class="bottom-copy">{{text}}</span></div>{{/each}}
      </div>
    </section>
    {{/if}}

    <footer>
      <span>Disclosure Honesty · {{asset_name}}</span>
      <span>{{#if footer.sources}}{{footer.sources}}{{/if}}{{#if footer.methodology}} · {{footer.methodology}}{{/if}}</span>
    </footer>
  </main>
</body>
</html>
