<!-- Generated from the corresponding Stage 1 JSON model and Stage 3 HTML contract. Required helper: json. -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>Earnings Forecast — {{{asset_name}}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Source+Serif+4:wght@500;600&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --ink: #1c1c1a;
            --muted: #6c6c68;
            --faint: #9a9a96;
            --line: #e8e7e3;
            --line2: #f0efeb;
            --card: #fafaf8;
            --bg: #fff;
            --green: #1c7a4d;
            --green-d: #155f3c;
            --green-bg: #eef5f0;
            --green-bd: #cfe5d8;
            --red: #bb3a32;
            --red-d: #9a2d27;
            --red-bg: #fbeeed;
            --red-bd: #f0d4d1;
            --amber: #b1750f;
            --amber-d: #8f5d0a;
            --amber-bg: #fbf3e3;
            --amber-bd: #ecd9b5;
            --blue: #4f6ef7;
            --blue-bg: #eef0ff;
            --radius: 10px;
            --qci-accent: #4f6ef7;
            --qci-accent-bg: #f0f2ff;
            --qci-accent-bd: #d0d8fd;
            --qci-accent-dark: #3652d9;
            --qci-glow: rgba(79, 110, 247, .12);
            --font-sans: 'Manrope', Inter, Arial, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        * {
            box-sizing: border-box
        }

        html, body, button, input, select, textarea {
            font-family: var(--font-sans) !important
        }

        body *, body *::before, body *::after {
            font-family: var(--font-sans) !important
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--ink);
            font: 15px/1.55 var(--font-sans);
            -webkit-font-smoothing: antialiased
        }

        .serif,
        .title,
        .big,
        .score-num,
        .qci-title,
        .lead {
            font-family: 'Source Serif 4', Lora, Georgia, serif
        }

        .wrap {
            max-width: 1180px;
            margin: auto;
            padding: 34px 40px 64px
        }

        .top {
            display: flex;
            justify-content: space-between;
            gap: 24px;
            border-bottom: 1px solid var(--line);
            padding-bottom: 20px
        }

        .lens-row {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap
        }

        .eyebrow,
        .sec-title {
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: .13em;
            text-transform: uppercase;
            color: var(--faint)
        }

        .title {
            font-size: 36px;
            line-height: 1.2;
            margin: 18px 0 0
        }
        .top-right { display: flex; align-items: flex-start; gap: 20px; }
        .top-meta { border-collapse: separate; border-spacing: 0; width: auto; min-width: 0; background: transparent; border: 1px solid var(--line); border-radius: 6px; margin-left: auto; margin-right: 0; align-self: flex-end; }
        .top-meta th, .top-meta td { padding: 2px 12px; font-size: 10.5px; color: var(--faint); white-space: nowrap; border-bottom: none; font-family: 'Manrope', sans-serif; }
        .top-meta tr:last-child td { padding-bottom: 8px; }
        .top-meta .meta-label { padding-right: 8px; text-align: right; text-transform: uppercase; letter-spacing: .04em; color: #b4b3ae; font-weight: 600; font-size: 9.5px; font-family: 'Manrope', sans-serif; }
        .xbtn {
            width: 38px;
            height: 38px;
            border: 1px solid var(--line);
            border-radius: 9px;
            background: #fff;
            color: var(--faint);
            font-size: 20px
        }

        .pill {
            display: inline-flex;
            align-items: center;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            padding: 4px 11px;
            border: 1px solid;
            border-radius: 6px;
            white-space: nowrap
        }

        /* Semantic colors for pills */
        .strong, .high, .transparent, .aligned, .positive, .g, .rising, .clean, .locked-in, .bull, .tailwind, .improving, .building, .elevated {
            color: var(--green-d);
            background: var(--green-bg);
            border-color: var(--green-bd)
        }

        .moderate, .track, .watch, .mixed, .developing, .a, .steady, .unresolved {
            color: var(--amber-d);
            background: var(--amber-bg);
            border-color: var(--amber-bd)
        }

        .weak, .low, .risk, .miss, .concerning, .negative, .r, .gap, .bear, .headwind, .falling, .worsening {
            color: var(--red-d);
            background: var(--red-bg);
            border-color: var(--red-bd)
        }

        .new, .revised, .base, .emerging {
            color: #3652d9;
            background: #eef0ff;
            border-color: #d0d8fd
        }
        
        /* --- Pill Icons for QCI Table --- */
        .pill.locked-in::before, 
        .pill.rising::before {
            content: "▲";
            font-size: 9px;
            margin-right: 4px;
            vertical-align: middle;
        }

        .pill.emerging::before,
        .pill.new::before {
            content: "●";
            font-size: 9px;
            margin-right: 4px;
            vertical-align: middle;
        }

        .pill.steady::before {
            content: "—";
            font-size: 9px;
            margin-right: 4px;
            vertical-align: middle;
        }

        .score-badge {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-top: 22px
        }

        .score-badge:not(.no-score)>div:last-child {
            flex: 1;
            min-width: 0;
            padding: 15px 18px;
            border: 1px solid var(--line);
            border-left: 3px solid var(--amber);
            border-radius: var(--radius);
            background: var(--card);
            box-shadow: 0 1px 0 rgba(18, 24, 39, .02)
        }

        .score-ring {
            --score: 0;
            --tone: var(--amber);
            position: relative;
            width: 72px;
            height: 72px;
            flex: 0 0 auto;
            border-radius: 50%;
            background: conic-gradient(var(--tone) calc(var(--score)*1%), #f0efeb 0) !important;
            display: grid;
            place-items: center
        }

        .score-ring:after {
            content: "";
            position: absolute;
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: #fff
        }

        .score-num {
            position: relative;
            z-index: 1;
            font-size: 21px;
            font-weight: 600
        }

        .score-label {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase
        }

        .score-desc {
            margin-top: 5px;
            color: var(--muted);
            font-size: 13.5px
        }

        .sec {
            margin-top: 42px
        }

        .sec-head {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 20px;
            margin-bottom: 16px
        }

        .sec-note {
            font-size: 13px;
            color: var(--faint);
            text-align: right
        }

        .grid {
            display: grid;
            gap: 16px
        }

        .grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)) }
        .grid.three { grid-template-columns: repeat(3, minmax(0, 1fr)) }
        .grid.four { grid-template-columns: repeat(4, minmax(0, 1fr)) }

        .card,
        .stat,
        .watch-card,
        .keymsg,
        .chart-card {
            border: 1px solid var(--line);
            border-radius: var(--radius);
            background: var(--card) !important;
            padding: 22px 24px
        }

        .stat { min-width: 0 }

        .lab {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--muted);
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: currentColor
        }

        .big {
            font-size: 26px;
            line-height: 1.2;
            font-weight: 600;
            margin: 12px 0 9px
        }

        .desc, .sub, .meta {
            color: var(--muted);
            font-size: 13px
        }
        .meta { color: var(--faint) }

        .qci {
            margin-top: 48px;
            border: 1px solid var(--qci-accent-bd);
            border-radius: 14px;
            background: #fcfcff;
            overflow: hidden
        }

        .qci-head {
            position: relative;
            padding: 28px 32px 24px;
            background: linear-gradient(135deg, #1a1f3a, #2a3060);
            color: #fff
        }

        .qci-badge {
            display: inline-flex;
            padding: 5px 12px;
            border: 1px solid rgba(139, 164, 251, .35);
            border-radius: 99px;
            color: #a9bafa;
            background: rgba(79, 110, 247, .12);
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase
        }

        .qci-count {
            position: absolute;
            right: 32px;
            top: 23px;
            color: #8ba4fb;
            font: 600 30px 'Source Serif 4', Lora
        }

        .qci-title {
            margin-top: 18px;
            font-size: 26px
        }

        .qci-sub {
            max-width: 760px;
            margin-top: 6px;
            color: rgba(255, 255, 255, .62);
            font-size: 13.5px
        }

        .qci-edge {
            display: grid;
            grid-template-columns: 120px 1fr;
            gap: 20px;
            padding: 22px 28px;
            align-items: start;
            background: #172445 !important;
            color: rgba(255, 255, 255, .86)
        }

        .qci-edge-label {
            color: #8ba4fb;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .1em
        }

        .qci-edge .edge-copy {
            margin: 0;
            font-size: 14.5px;
            line-height: 1.68;
            color: rgba(255, 255, 255, .84)
        }

        .edge-accent { color: #9fb1ff; font-weight: 700; }
        .edge-positive { color: #77dec0; font-weight: 700; }
        .edge-watch { color: #f0c66c; font-weight: 700; }

        .table-wrap {
            overflow-x: auto;
            border: 1px solid var(--line);
            border-radius: var(--radius)
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 760px;
            background: #fff
        }

        th {
            background: #fff; 
            color: var(--ink);
            border-bottom: 1px solid var(--line);
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .11em;
            text-transform: uppercase;
            padding: 15px 18px;
            text-align: left;
        }

        td {
            text-align: left;
            vertical-align: top;
            border-bottom: 1px solid var(--line);
            padding: 15px 18px;
            font-size: 13px
        }

        tbody tr:last-child td { border-bottom: 0 }

        /* --- QCI Pattern Table Metrics --- */
        .pattern-metrics {
            margin-top: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .metric-item {
            font-size: 12px;
            line-height: 1.4;
        }

        .metric-item strong {
            color: var(--ink);
            margin-right: 4px;
        }

        .metric-item .meta {
            color: var(--faint);
        }

        .list {
            list-style: none;
            padding: 0;
            margin: 12px 0 0
        }

        .list li {
            padding: 9px 0;
            border-bottom: 1px solid var(--line)
        }

        .list li:last-child { border: 0 }

        .keymsg {
            border-left: 3px solid var(--green);
            border-radius: 0 var(--radius) var(--radius) 0;
            padding: 24px 28px;
            background: var(--card)
        }

        .lead {
            font-size: 21px;
            line-height: 1.4;
            margin: 8px 0 12px
        }

        .synthesis-card { padding: 24px 26px !important }
        .synthesis-card > .sec-title { margin-bottom: 14px }

        .synthesis-grid {
            display: grid;
            grid-template-columns: 1fr 1fr; /* Forces a 2-column layout (2x2 grid) */
            border-top: 1px solid var(--line)
        }

        .synthesis-panel {
            min-width: 0;
            padding: 24px 18px 24px 18px; /* Added bottom padding to separate the rows */
            border-left: 1px solid var(--line)
        }

        /* Removes left border/padding for the 1st (Forecast) and 3rd (Bull) panels */
        .synthesis-panel:nth-child(odd) {
            padding-left: 0;
            border-left: 0
        }

        /* Adds a top border to the 3rd (Bull) and 4th (Bear) panels to separate the rows */
        .synthesis-panel:nth-child(n+3) {
            border-top: 1px solid var(--line)
        }

        .synthesis-panel:first-child {
            padding-left: 0;
            border-left: 0
        }

        .synthesis-panel .lead {
            margin: 0;
            font-size: 18px;
            line-height: 1.45
        }

        .synthesis-panel p {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.58
        }
        .card-meta {
            margin: 0 0 9px;
            color: var(--faint);
            font: 600 9.5px/1.35 'Manrope', system-ui, sans-serif;
            text-transform: uppercase
        }

        .synthesis-label {
            display: block;
            margin-bottom: 7px;
            font-size: 10.5px;
            font-weight: 800;
            letter-spacing: .09em;
            text-transform: uppercase;
            background: none !important; /* Forces the background to be transparent */
            border: 0 !important;        /* Removes the border */
        }

        .synthesis-label.neutral { color: #5267c8 }
        .synthesis-label.positive { color: var(--green-d) }
        .synthesis-label.risk { color: var(--red-d) }

        .foot {
            margin-top: 46px;
            padding-top: 18px;
            border-top: 1px solid var(--line);
            color: var(--faint);
            font-size: 12.5px
        }

        .foot strong { color: var(--muted) }

        .asset-kicker {
            margin-top: 5px;
            color: var(--muted);
            font-size: 13px
        }

        .score-ring.green, .score-ring.strong, .score-ring.g { --tone: var(--green) }
        .score-ring.amber, .score-ring.moderate, .score-ring.a, .score-ring.watch { --tone: var(--amber) }
        .score-ring.red, .score-ring.weak, .score-ring.r { --tone: var(--red) }

        .missing-value {
            font-family: var(--font-sans);
            font-size: 13px;
            color: var(--faint);
            font-weight: 600
        }

        .chart-wrap {
            height: 330px;
            padding: 18px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: var(--radius)
        }
        .chart-scroll { overflow-x: auto }
        .chart-scroll > .chart-wrap { min-width: 720px }

        @media(max-width:820px) {
            .wrap { padding: 24px 20px 48px }
            .title { font-size: 28px }
            .grid.two, .grid.three, .grid.four { grid-template-columns: 1fr }
            .sec-head { display: block }
            .sec-note { text-align: left; margin-top: 4px }
            .qci-count { position: static; margin-top: 14px }
            .qci-edge { grid-template-columns: 1fr }
            .score-badge { align-items: flex-start }
            .chart-wrap { height: 290px }
            ..synthesis-grid { grid-template-columns: 1fr }
            
            .synthesis-panel, 
            .synthesis-panel:first-child,
            .synthesis-panel:nth-child(odd),
            .synthesis-panel:nth-child(n+3) {
                padding: 15px 0;
                border-left: 0;
                border-top: 1px solid var(--line)
            }
            
            .synthesis-panel:first-child { border-top: 0 }
        }
            /* QC Intuition Table PC Layout Fix */
        .qci table, .qci-table { table-layout: fixed; }
        .qci table th:nth-child(1), .qci-table th:nth-child(1) { width: 32% !important; }
        .qci table th:nth-child(2), .qci-table th:nth-child(2) { width: 14% !important; }
        .qci table th:nth-child(3), .qci-table th:nth-child(3) { width: 14% !important; }
        .qci table th:nth-child(4), .qci-table th:nth-child(4) { width: 40% !important; }
</style>
    
    {{#if earnings_chart.labels.length}}
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    {{else}}
        {{#if margin_chart.labels.length}}
            <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
        {{/if}}
    {{/if}}
</head>

<body>
    <main class="wrap" data-template-category="earnings-forecast">
        <header class="top">
            <div>
                <div class="lens-row">
                    <span class="eyebrow">Forecast Lens</span>
                    {{#if primary_scenario}}
                        <span class="pill {{{primary_scenario.case}}}">{{{primary_scenario.pill_label}}}</span>
                    {{/if}}
                </div>
                <h1 class="title">Earnings Forecast</h1>
                <div class="asset-kicker">{{{asset_name}}}</div>
            </div>
            <div class="top-right">
            {{#if source_meta}}
            <table class="top-meta">
                <tr><th colspan="2" style="padding: 8px 12px 4px; text-align: center; color: #b4b3ae; font-size: 9.5px; font-weight: 400; white-space: nowrap; border-bottom: none;">Latest analysed</th></tr>
                {{#if source_meta.transcript}}<tr><td class="meta-label">Transcript</td><td>{{{source_meta.transcript}}}</td></tr>{{/if}}
                {{#if source_meta.ppt}}<tr><td class="meta-label">Investor Presentation</td><td>{{{source_meta.ppt}}}</td></tr>{{/if}}
                {{#if source_meta.annual_report}}<tr><td class="meta-label">Annual Report</td><td>{{{source_meta.annual_report}}}</td></tr>{{/if}}
            </table>
            {{/if}}
            </div>
        </header>

        {{#if score_badge}}
            <section class="score-badge">
                <div class="score-ring amber" style="--score:{{{score_badge.score}}}">
                    <span class="score-num">{{{score_badge.score}}}</span>
                </div>
                <div>
                    <div class="score-label">{{{score_badge.rating}}} · {{{score_badge.label}}}</div>
                    <div class="score-desc">{{{score_badge.desc}}}</div>
                </div>
            </section>
        {{/if}}

        {{#if scenarios.length}}
            <section class="sec">
                <div class="sec-head">
                    <div class="sec-title">Bull · base · bear scenarios</div>
                </div>
                <div class="grid three">
                    {{#each scenarios}}
                        <article class="card {{{case}}}">
                            <span class="pill {{{case}}}">{{{case}}}</span>
                            {{#if cagr}}
                                <div class="big">{{{cagr}}}</div>
                                <p class="card-meta">Earnings CAGR 3 YEARS</p>
                            {{else}}
                                <div class="big missing-value">CAGR not quantified</div>
                            {{/if}}
                            <ul class="list">
                                {{#each drivers}}
                                    <li>
                                        <strong>{{{label}}}</strong>
                                        <div class="sub">{{{detail}}}</div>
                                    </li>
                                {{/each}}
                            </ul>
                        </article>
                    {{/each}}
                </div>
            </section>
        {{/if}}

        {{!-- {{#if earnings_chart.labels.length}}
            <section class="sec">
                <div class="sec-head">
                    <div class="sec-title">Earnings growth path by scenario</div>
                    <div class="sec-note">Scenario growth path · %</div>
                </div>
                <div class="chart-scroll">
                    <div class="chart-wrap">
                        <canvas id="earningsForecastDetailed" aria-label="Earnings forecast chart"></canvas>
                    </div>
                </div>
            </section>
        {{/if}}

        {{#if margin_chart.labels.length}}
            <section class="sec">
                <div class="sec-head">
                    <div class="sec-title">{{{margin_chart.metric_label}}}</div>
                    <div class="sec-note">{{{margin_chart.metric_note}}} · {{{margin_chart.unit}}}</div>
                </div>
                <div class="chart-scroll">
                    <div class="chart-wrap">
                        <canvas id="marginForecastDetailed" aria-label="Margin forecast chart"></canvas>
                    </div>
                </div>
            </section>
        {{/if}} --}}


        {{#if assumption_table.rows.length}}
            <section class="sec">
                <div class="sec-head">
                    <div class="sec-title">Key assumption summary</div>
                    <div class="sec-note">Unit · {{{assumption_table.unit}}}</div>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Metric</th>
                                <th>Bull</th>
                                <th>Base</th>
                                <th>Bear</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each assumption_table.rows}}
                                <tr>
                                    <td><strong>{{{metric}}}</strong></td>
                                    <td class="g">{{{bull}}}</td>
                                    <td style="color:#3652d9;font-weight:700">{{{base}}}</td>
                                    <td class="r">{{{bear}}}</td>
                                </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </section>
        {{/if}}


        {{#if patterns.items.length}}
            <section class="qci">
                <div class="qci-head">
                    <div class="qci-badge">QC Intuition · Pattern Recognition</div>
                    <div class="qci-title">What drives the earnings path</div>
                    {{!-- <div class="qci-sub">{{{patterns.source_types}}}</div> --}}
                </div>
                <div class="table-wrap">
                    <table>
                        <!-- Defines structural column widths -->
                        <colgroup>
                            <col style="width: 26%; min-width: 190px;"> <!-- Pattern (Wider base) -->
                            <col style="width: 23%;">                   <!-- Read -->
                            <col style="width: 10%; min-width: 90px;">  <!-- Status (Thinner) -->
                            <col style="width: 21%;">                   <!-- Interpretation -->
                            <col style="width: 20%;">                   <!-- What it means -->
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Pattern</th>
                                <th>Read</th>
                                <th>Status</th>
                                <th>Interpretation</th>
                                <th>What it means for earnings</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each patterns.items}}
                                <tr>
                                    <td>
                                        <strong>{{{title}}}</strong>
                                        {{#if metrics.length}}
                                        <div class="pattern-metrics">
                                            {{#each metrics}}
                                                <div class="metric-item">
                                                    <strong>{{{value}}}</strong> 
                                                    <span class="meta">{{{label}}}</span>
                                                </div>
                                            {{/each}}
                                        </div>
                                        {{/if}}
                                    </td>
                                    <td>{{{read_text}}}</td>
                                    <td>
                                        <span class="pill {{{status_class}}}">{{{status_label}}}</span>
                                    </td>
                                    <td>{{{interpretation}}}</td>
                                    <td>{{{earnings_impact}}}</td>
                                </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
                {{#if patterns.edge}}
                    <div class="qci-edge">
                        <div class="qci-edge-label">THE EDGE</div>
                        <div>
                            <p class="edge-copy">
                                <strong class="edge-accent">{{{patterns.edge.hl_theme}}}</strong> and
                                <strong class="edge-positive">{{{patterns.edge.hl2_theme}}}</strong> are the decisive mechanisms.
                                {{#if patterns.edge.mechanical_floor}}<span>{{{patterns.edge.mechanical_floor}}}</span>{{/if}}
                                {{#if patterns.edge.floor_reason}}<span>{{{patterns.edge.floor_reason}}}</span>{{/if}}
                                {{#if patterns.edge.pct_qualifier}}<span class="edge-accent">{{{patterns.edge.pct_qualifier}}}</span>.{{/if}} 
                                <span class="edge-watch">{{{patterns.edge.swing_variable}}}</span>
                            </p>
                        </div>
                    </div>
                {{/if}}
            </section>
        {{/if}}

        

        {{#if key_message}}
            <section class="sec keymsg synthesis-card">
                <div class="sec-title">Synthesis</div>
                <div class="synthesis-grid">
                    <div class="synthesis-panel">
                        <span class="synthesis-label neutral">Forecast read</span>
                        <div class="lead">{{{key_message.lead}}}</div>
                    </div>
                    <div class="synthesis-panel">
                        <span class="synthesis-label neutral">Scenario rationale</span>
                        {{#each key_message.paras}}
                            <p>{{{this}}}</p>
                        {{/each}}
                    </div>
                    <div class="synthesis-panel">
                        <span class="synthesis-label positive">Bull trigger</span>
                        <p>{{{key_message.bull_trigger}}}</p>
                    </div>
                    <div class="synthesis-panel">
                        <span class="synthesis-label risk">Bear trigger</span>
                        <p>{{{key_message.bear_trigger}}}</p>
                    </div>
                </div>
            </section>
        {{/if}}
        {{#if earnings_chart.labels.length}}
            <script>
                (() => { 
                    if (typeof Chart === 'undefined') return; 
                    const colors = { bull: '#1c7a4d', base: '#4f6ef7', bear: '#bb3a32' }; 
                    const e = document.getElementById('earningsForecastDetailed'); 
                    if (!e) return; 
                    new Chart(e, { 
                        type: 'line', 
                        data: { 
                            labels: {{{ json earnings_chart.labels }}}, 
                            datasets: [
                                { label: 'Bull', data: {{{ json earnings_chart.datasets.bull }}}, borderColor: colors.bull, backgroundColor: 'rgba(28,122,77,.08)', fill: true, tension: .3}, 
                                { label: 'Base', data: {{{ json earnings_chart.datasets.base }}}, borderColor: colors.base, backgroundColor: 'rgba(79,110,247,.06)', fill: true, tension: .3}, 
                                { label: 'Bear', data: {{{ json earnings_chart.datasets.bear }}}, borderColor: colors.bear, backgroundColor: 'rgba(187,58,50,.06)', fill: true, tension: .3}
                            ]
                        }, 
                        options: { 
                            responsive: true, 
                            maintainAspectRatio: false, 
                            interaction: { mode: 'index', intersect: false }, 
                            plugins: { legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 8 } } }, 
                            scales: { 
                                x: { grid: { display: false } }, 
                                y: { beginAtZero: true, max: {{{ json earnings_chart.y_max }}}, grid: { color: '#efeee9' }, ticks: { callback: v => v + '%' } } 
                            } 
                        } 
                    });
                })();
            </script>
        {{/if}}

        {{#if margin_chart.labels.length}}
            <script>
                (() => { 
                    if (typeof Chart === 'undefined') return; 
                    const colors = { bull: '#1c7a4d', base: '#4f6ef7', bear: '#bb3a32' }; 
                    const m = document.getElementById('marginForecastDetailed'); 
                    if (!m) return; 
                    const unit = {{{ json margin_chart.unit }}}; 
                    new Chart(m, { 
                        type: 'bar', 
                        data: { 
                            labels: {{{ json margin_chart.labels }}}, 
                            datasets: [
                                { label: 'Bull', data: {{{ json margin_chart.datasets.bull }}}, backgroundColor: colors.bull, borderRadius: 4}, 
                                { label: 'Base', data: {{{ json margin_chart.datasets.base }}}, backgroundColor: colors.base, borderRadius: 4}, 
                                { label: 'Bear', data: {{{ json margin_chart.datasets.bear }}}, backgroundColor: colors.bear, borderRadius: 4}
                            ]
                        }, 
                        options: { 
                            responsive: true, 
                            maintainAspectRatio: false, 
                            interaction: { mode: 'index', intersect: false }, 
                            plugins: { legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 8 } } }, 
                            scales: { 
                                x: { grid: { display: false } }, 
                                y: { beginAtZero: true, grid: { color: '#efeee9' }, ticks: { callback: v => v + unit } } 
                            } 
                        } 
                    });
                })();
            </script>
        {{/if}}
    </main>
</body>

</html>