<body><main class="wrap" data-template-category="earnings-forecast">
<header class="top"><div><div class="lens-row"><span class="eyebrow">Deal Lens</span>{{#if primary_scenario}}<span class="pill {{primary_scenario.case}}">{{primary_scenario.pill_label}}</span>{{/if}}</div><h1 class="title">Earnings Forecast</h1><div class="asset-kicker">{{asset_name}}</div></div><button class="xbtn" aria-label="Close">&times;</button></header>
{{#if score_badge}}<section class="score-badge"><div class="score-ring amber" style="--score:{{score_badge.score}}"><span class="score-num">{{score_badge.score}}</span></div><div><div class="score-label">{{score_badge.rating}} · {{score_badge.label}}</div><div class="score-desc">{{score_badge.desc}}</div></div></section>{{/if}}
{{#if scenarios.length}}<section class="sec"><div class="sec-head"><div class="sec-title">Bull · base · bear scenarios</div></div><div class="grid three">{{#each scenarios}}<article class="card {{case}}"><span class="pill {{case}}">{{case}}</span><div class="big">{{cagr}}</div><ul class="list">{{#each drivers}}<li><strong>{{label}}</strong><div class="sub">{{detail}}</div></li>{{/each}}</ul></article>{{/each}}</div></section>{{/if}}
{{#if earnings_chart.labels.length}}<section class="sec"><div class="sec-head"><div class="sec-title">Earnings forecast path</div><div class="sec-note">Scenario growth path · %</div></div><div class="chart-scroll"><div class="chart-wrap"><canvas id="earningsForecastDetailed" aria-label="Earnings forecast chart"></canvas></div></div></section>{{/if}}
{{#if margin_chart.labels.length}}<section class="sec"><div class="sec-head"><div class="sec-title">{{margin_chart.metric_label}}</div><div class="sec-note">{{margin_chart.metric_note}} · {{margin_chart.unit}}</div></div><div class="chart-scroll"><div class="chart-wrap"><canvas id="marginForecastDetailed" aria-label="Margin forecast chart"></canvas></div></div></section>{{/if}}
{{#if patterns.items.length}}<section class="qci"><div class="qci-head"><div class="qci-count">{{patterns.n_patterns}}</div><div class="qci-badge">QC Intuition · Forecast Patterns</div><div class="qci-title">What drives the forecast range</div><div class="qci-sub">{{patterns.source_types}}</div></div><div class="table-wrap"><table><thead><tr><th>Pattern</th><th>Evidence</th><th>Read</th><th>Interpretation</th></tr></thead><tbody>{{#each patterns.items}}<tr><td><strong>{{title}}</strong><div class="sub">{{interp_short}}</div></td><td><div class="metric-chips">{{#each metrics}}<span class="metric-chip">{{label}} · <strong>{{value}}</strong></span>{{/each}}</div></td><td><span class="pill {{read}}">{{read_label}}</span></td><td>{{interp_long}}</td></tr>{{/each}}</tbody></table></div><div class="tag-row" style="padding:14px 20px">{{#each patterns.sources}}<span class="tag">{{short}} · {{long}}</span>{{/each}}</div>{{#if patterns.edge}}<div class="qci-edge"><div class="qci-edge-label">The Edge</div><div><p><strong>{{patterns.edge.hl_theme}}</strong> and <strong>{{patterns.edge.hl2_theme}}</strong> are the decisive mechanisms.</p><p><strong>{{patterns.edge.mechanical_floor}}</strong> · {{patterns.edge.floor_reason}} · {{patterns.edge.pct_qualifier}}</p><p>{{patterns.edge.swing_variable}}</p></div></div>{{/if}}</section>{{/if}}
{{#if assumption_table.rows.length}}<section class="sec"><div class="sec-head"><div class="sec-title">Key assumption summary</div><div class="sec-note">Unit · {{assumption_table.unit}}</div></div><div class="table-wrap"><table><thead><tr><th>Metric</th><th>Bull</th><th>Base</th><th>Bear</th></tr></thead><tbody>{{#each assumption_table.rows}}<tr><td><strong>{{metric}}</strong></td><td class="g">{{bull}}</td><td style="color:#3652d9;font-weight:700">{{base}}</td><td class="r">{{bear}}</td></tr>{{/each}}</tbody></table></div></section>{{/if}}
{{#if key_message}}<section class="sec keymsg"><div class="sec-title">{{key_message.kicker}}</div><div class="lead">{{key_message.lead}}</div>{{#each key_message.paras}}<p>{{this}}</p>{{/each}}<div class="grid two"><div><strong class="g">Bull trigger</strong><p>{{key_message.bull_trigger}}</p></div><div><strong class="r">Bear trigger</strong><p>{{key_message.bear_trigger}}</p></div></div></section>{{/if}}
<footer class="foot"><strong>Forecast sources.</strong> {{footer_sources}}</footer>
<script>(()=>{if(typeof Chart==='undefined')return;const colors={bull:'#1c7a4d',base:'#4f6ef7',bear:'#bb3a32'};const common={responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{position:'top',labels:{usePointStyle:true,boxWidth:8}}},scales:{x:{grid:{display:false}},y:{beginAtZero:true,grid:{color:'#efeee9'}}}};const e=document.getElementById('earningsForecastDetailed');if(e)new Chart(e,{type:'line',data:{labels:{{{json earnings_chart.labels}}},datasets:[{label:'Bull',data:{{{json earnings_chart.datasets.bull}}},borderColor:colors.bull,backgroundColor:'rgba(28,122,77,.08)',fill:true,tension:.3},{label:'Base',data:{{{json earnings_chart.datasets.base}}},borderColor:colors.base,backgroundColor:'rgba(79,110,247,.06)',fill:true,tension:.3},{label:'Bear',data:{{{json earnings_chart.datasets.bear}}},borderColor:colors.bear,backgroundColor:'rgba(187,58,50,.06)',fill:true,tension:.3}]},options:{...common,scales:{...common.scales,y:{...common.scales.y,max:{{{json earnings_chart.y_max}}},ticks:{callback:v=>v+'%'}}}}});const m=document.getElementById('marginForecastDetailed');const unit={{{json margin_chart.unit}}};if(m)new Chart(m,{type:'bar',data:{labels:{{{json margin_chart.labels}}},datasets:[{label:'Bull',data:{{{json margin_chart.datasets.bull}}},backgroundColor:colors.bull,borderRadius:4},{label:'Base',data:{{{json margin_chart.datasets.base}}},backgroundColor:colors.base,borderRadius:4},{label:'Bear',data:{{{json margin_chart.datasets.bear}}},backgroundColor:colors.bear,borderRadius:4}]},options:{...common,scales:{...common.scales,y:{...common.scales.y,ticks:{callback:v=>v+unit}}}}});})();</script>
</main></body></html>