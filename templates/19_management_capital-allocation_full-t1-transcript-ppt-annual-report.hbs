            }
        }

        .stat .lab,
        .stat .big {
            background: transparent !important;
            border-color: transparent !important;
            box-shadow: none !important
        }

        .semantic-status-reset-marker {
            display: none
        }

        .g,
        .strong,
        .high,
        .transparent,
        .aligned,
        .positive,
        .rising,
        .clean,
        .a,
        .moderate,
        .track,
        .watch,
        .mixed,
        .developing,
        .steady,
        .unresolved,
        .r,
        .weak,
        .low,
        .risk,
        .miss,
        .concerning,
        .negative,
        .gap,
        .new,
        .revised {
            background: transparent !important
        }

        .pill.g,
        .pill.strong,
        .pill.high,
        .pill.transparent,
        .pill.aligned,
        .pill.positive,
        .pill.rising,
        .pill.clean {
            background: var(--green-bg) !important
        }

        .pill.a,
        .pill.moderate,
        .pill.track,
        .pill.watch,
        .pill.mixed,
        .pill.developing,
        .pill.steady,
        .pill.unresolved {
            background: var(--amber-bg) !important
        }

        .pill.r,
        .pill.weak,
        .pill.low,
        .pill.risk,
        .pill.miss,
        .pill.concerning,
        .pill.negative,
        .pill.gap {
            background: var(--red-bg) !important
        }

        .pill.new,
        .pill.revised {
            background: #eef0ff !important
        }

        .score-ring {
            background: conic-gradient(var(--tone) calc(var(--score)*1%), #f0efeb 0) !important
        }

        .card,
        .stat,
        .watch-card,
        .timeline-card,
        .analysis-card,
        .challenge-card,
        .traction-stat,
        .signal-card {
            background: var(--card) !important
        }

        .card.g,
        .card.a,
        .card.r,
        .card.positive,
        .card.negative,
        .stat.g,
        .stat.a,
        .stat.r,
        .watch-card.g,
        .watch-card.a,
        .watch-card.r,
        .timeline-card.g,
        .timeline-card.a,
        .timeline-card.r,
        .analysis-card.g,
        .analysis-card.a,
        .analysis-card.r,
        .challenge-card.g,
        .challenge-card.a,
        .challenge-card.r,
        .traction-stat.g,
        .traction-stat.a,
        .traction-stat.r,
        .signal-card.g,
        .signal-card.a,
        .signal-card.r,
        .signal-card.positive,
        .signal-card.negative {
            background: var(--card) !important
        }

        .fill.g,
        .fill.green {
            background: var(--green) !important
        }

        .fill.a,
        .fill.amber {
            background: var(--amber) !important
        }

        .fill.r,
        .fill.red {
            background: var(--red) !important
        }

        .watch-card.green {
            border-left-color: var(--green)
        }

        .watch-card.amber {
            border-left-color: var(--amber)
        }

        .watch-card.red {
            border-left-color: var(--red)
        }

        .keymsg {
            border-left: 3px solid var(--green);
            border-radius: 0 var(--radius) var(--radius) 0;
            padding: 24px 28px;
            background: var(--card)
        }

        .keymsg .sec-title {
            margin-bottom: 10px
        }

        .keymsg .lead {
            font-size: 22px;
            line-height: 1.32;
            margin: 0 0 14px
        }

        .keymsg p {
            margin: 10px 0
        }

        .keymsg .g,
        .keymsg .a,
        .keymsg .r {
            font-weight: 700
        }

        .keymsg .up {
            color: var(--green);
            font-weight: 700
        }

        .keymsg .dn {
            color: var(--red);
            font-weight: 700
        }

        .balance {
            border: 1px solid var(--line);
            border-radius: var(--radius);
            background: var(--card);
            overflow: hidden
        }

        .balance-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr))
        }

        .balance-block {
            padding: 24px 26px;
            border-right: 1px solid var(--line)
        }

        .balance-block:last-child {
            border-right: 0
        }

        .balance-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 14px
        }

        .balance-count {
            font: 600 20px/1.1 'Source Serif 4', Georgia, serif;
            white-space: nowrap
        }

        .balance-track {
            height: 10px;
            border-radius: 99px;
            background: #e8e7e3;
            overflow: hidden;
            margin: 14px 0
        }

        .balance-fill {
            height: 100%;
            max-width: 100%;
            border-radius: inherit
        }

        .balance-fill.g {
            background: var(--green) !important
        }

        .balance-fill.a {
            background: var(--amber) !important
        }

        .balance-fill.r {
            background: var(--red) !important
        }

        .balance-takeaway {
            border-top: 1px solid var(--line);
            padding: 18px 26px;
            line-height: 1.6
        }

        @media(max-width:820px) {
            .balance-grid {
                grid-template-columns: 1fr
            }

            .balance-block {
                border-right: 0;
                border-bottom: 1px solid var(--line)
            }

            .balance-block:last-child {
                border-bottom: 0
            }

            .keymsg {
                padding: 22px 20px
            }
        }

        body {
            font-family: 'Manrope', system-ui, sans-serif
        }

        .serif,
        .title,
        .big,
        .score-num,
        .qci-title,
        .lead {
            font-family: 'Source Serif 4', Georgia, serif
        }

        /* Shared visual-consistency update */
        .score-badge:not(.no-score)>div:last-child {
            flex: 1;
            min-width: 0;
            padding: 15px 18px;
            border: 1px solid var(--line);
            border-left: 3px solid var(--amber);
            border-radius: var(--radius);
            background: var(--card);
            box-shadow: 0 1px 0 rgba(18, 24, 39, .02)
        }

        .score-badge:not(.no-score) .score-desc {
            max-width: none
        }

        .qci-edge {
            align-items: start;
            background: #172445 !important
        }

        .qci-edge .edge-copy {
            margin: 0;
            font-size: 14.5px;
            line-height: 1.68;
            color: rgba(255, 255, 255, .84)
        }

        .qci-edge .edge-copy strong {
            color: #fff
        }

        .edge-accent,
        .edge-positive,
        .edge-watch,
        .edge-risk,
        .edge-segment {
            font-weight: 700
        }

        .edge-accent,
        .edge-segment-0 {
            color: #9fb1ff
        }

        .edge-positive,
        .edge-segment-1 {
            color: #77dec0
        }

        .edge-watch,
        .edge-segment-2 {
            color: #f0c66c
        }

        .edge-risk,
        .edge-segment-3 {
            color: #ff9b8f
        }

        .edge-segment+.edge-segment:before {
            content: " ";
            white-space: pre
        }

        .synthesis-card {
            padding: 24px 26px !important
        }

        .synthesis-card>.sec-title {
            margin-bottom: 14px
        }

        .synthesis-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(205px, 1fr));
            border-top: 1px solid var(--line)
        }

        .synthesis-panel {
            min-width: 0;
            padding: 17px 18px 2px;
            border-left: 1px solid var(--line)
        }

        .synthesis-panel:first-child {
            padding-left: 0;
            border-left: 0
        }

        .synthesis-panel .lead {
            margin: 0;
            font-size: 18px;
            line-height: 1.45
        }

        .synthesis-panel p {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.58
        }

        .synthesis-label {
            display: block;
            margin-bottom: 7px;
            font-size: 10.5px;
            font-weight: 800;
            letter-spacing: .09em;
            text-transform: uppercase;
            background: none !important;
            border: 0 !important
        }

        .synthesis-label.neutral {
            color: #5267c8
        }

        .synthesis-label.positive {
            color: var(--green-d)
        }

        .synthesis-label.watch {
            color: var(--amber-d)
        }

        .synthesis-label.risk {
            color: var(--red-d)
        }

        @media(max-width:820px) {
            .synthesis-grid {
                grid-template-columns: 1fr
            }

            .synthesis-panel,
            .synthesis-panel:first-child {
                padding: 15px 0;
                border-left: 0;
                border-top: 1px solid var(--line)
            }

            .synthesis-panel:first-child {
                border-top: 0
            }

            .qci-edge .edge-copy {
                font-size: 13.5px
            }
        }

        /* Unified typography: one sans-serif family across every UI element. */
        :root {
            --font-sans: 'Manrope', Inter, Arial, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
        }

        html,
        body,
        button,
        input,
        select,
        textarea {
            font-family: var(--font-sans) !important
        }

        body *,
        body *::before,
        body *::after {
            font-family: var(--font-sans) !important
        }
            /* QC Intuition Table PC Layout Fix */
        .qci table, .qci-table { table-layout: fixed; }
        .qci table th:nth-child(1), .qci-table th:nth-child(1) { width: 32% !important; }
        .qci table th:nth-child(2), .qci-table th:nth-child(2) { width: 14% !important; }
        .qci table th:nth-child(3), .qci-table th:nth-child(3) { width: 14% !important; }
        .qci table th:nth-child(4), .qci-table th:nth-child(4) { width: 40% !important; }
</style>
</head>

<body>
    <main class="wrap" data-template-category="capital-allocation">
        <header class="top">
            <div>
                <div class="lens-row"><span class="eyebrow">Management Lens</span>{{#if overall_rating}}<span
                            class="pill {{{overall_rating.pill}}}">{{{overall_rating.label}}}</span>{{/if}}</div>
                <h1 class="title">Capital Allocation Quality</h1>
                <div class="asset-kicker">{{{asset_name}}}</div>
            </div>
            <div class="top-right">
            {{#if source_meta}}
            <table class="top-meta">
                <tr><th colspan="2" style="padding: 8px 12px 4px; text-align: center; color: #b4b3ae; font-size: 9.5px; font-weight: 400; font-style: italic; white-space: nowrap; border-bottom: none;">Latest analysed</th></tr>
                {{#if source_meta.transcript}}<tr><td class="meta-label">Transcript</td><td>{{{source_meta.transcript}}}</td></tr>{{/if}}
                {{#if source_meta.ppt}}<tr><td class="meta-label">Investor Presentation</td><td>{{{source_meta.ppt}}}</td></tr>{{/if}}
                {{#if source_meta.annual_report}}<tr><td class="meta-label">Annual Report</td><td>{{{source_meta.annual_report}}}</td></tr>{{/if}}
            </table>
            {{/if}}
            </div>
        </header>
        {{#if score_badge}}{{#if score_badge.score}}
                <section class="score-badge">
                    <div class="score-ring {{{score_badge.status_color}}}" style="--score:{{{score_badge.score}}}"><span
                            class="score-num">{{{score_badge.score}}}</span></div>
                    <div>
                        <div class="score-label">{{{score_badge.rating}}} · {{{score_badge.label}}}</div>
                        <div class="score-desc">{{{score_badge.desc}}}</div>
                    </div>
                </section>
            {{else}}
                <section class="score-badge no-score {{{score_badge.status_color}}}">
                    <div>
                        <div class="score-label {{{score_badge.status_color}}}">{{{score_badge.rating}}} ·
                            {{{score_badge.label}}}</div>
                        <div class="score-desc">{{{score_badge.desc}}}</div>
                    </div>
                </section>
            {{/if}}{{/if}}
        {{#if headline.length}}
            <section class="sec">
                <div class="sec-head">
                    <div class="sec-title">Headline insights</div>
                    <div class="sec-note">Highest-confidence capital deployment signals.</div>
                </div>
                <div class="grid three">{{#each headline}}
                        <article class="stat">
                            <div class="lab {{{dot}}}"><span class="dot"></span>{{{label}}}</div>
                            <div class="big {{{value_color}}}">{{{value}}}</div>
                            <div class="desc">{{{desc}}}</div>
                        </article>
                    {{/each}}</div>
            </section>
        {{/if}}
        {{#if pattern_intelligence.patterns.length}}
            <section class="qci">
                <div class="qci-head">
                    <div class="qci-badge">QC Intuition · Pattern Recognition</div>
                    <div class="qci-title">What the capital allocation signals reveal.</div>
                    {{!-- <div class="qci-sub">{{{pattern_intelligence.source_types}}}{{#if pattern_intelligence.period_start}}
                            · {{{pattern_intelligence.period_start}}} → {{{pattern_intelligence.period_end}}}{{/if}}</div> --}}
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Pattern</th>
                                <th>Trajectory</th>
                                <th>Status</th>
                                <th>Interpretation</th>
                            </tr>
                        </thead>
                        <tbody>{{#each pattern_intelligence.patterns}}
                                <tr>
                                    <td><strong>{{{name}}}</strong>
                                        <div class="sub">{{{sub}}}</div>
                                    </td>
                                    <td>
                                      <div style="width: 110px;">
                                        <svg class="spark" viewBox="0 0 110 46" preserveAspectRatio="xMidYMid meet" aria-hidden="true"
                                          style="display:block;">
                                          <polyline points="{{{trendSparkPoints trend}}}" fill="none" stroke="{{{trendHex trend}}}"
                                            stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                                            vector-effect="non-scaling-stroke" />
                                          <circle cx="104" cy="{{{trendSparkEndY trend}}}" r="3.5" fill="{{{trendHex trend}}}" />
                                        </svg>
                                        <div
                                          style="display: flex; justify-content: space-between; font-size: 10.5px; color: var(--faint); margin-top: 4px; font-weight: 600; letter-spacing: 0.02em;">
                                          <span>{{{shortPeriod date}}}</span>
                                          <span>{{{shortPeriod (lookup this 'end date')}}}</span>
                                        </div>
                                      </div>
                                    </td>
                                    <td><span class="pill {{{trend}}}">{{{trend}}}</span></td>
                                    <td data-inline-markdown>{{{interp}}}</td>
                                </tr>
                            {{/each}}</tbody>
                    </table>
                </div>
                {{#if pattern_intelligence.pattern_call.length}}
                    <div class="qci-edge">
                        <div class="qci-edge-label">THE EDGE</div>
                        <div>
                            <p class="edge-copy">{{{pattern_intelligence.pattern_call}}}</p>
                        </div>
                    </div>
                {{/if}}
            </section>
        {{/if}}
        {{#if analysis}}
            <section class="sec">
                <div class="sec-head">
                    <div class="sec-title">Analysis</div>
                    <div class="sec-note">Allocation posture, core evidence and trajectory</div>
                </div>{{#if analysis.verdict}}
                    <div class="keymsg">
                        <div class="lead">{{{analysis.verdict}}}</div>
                    </div>
                {{/if}}
                <div class="grid two" style="margin-top:16px">
                    <article class="card">
                        <h3>Core Signals</h3>
                        <div class="signal-stack">{{#each analysis.core_signals}}
                                <div class="signal-item"><strong class="{{{dot}}}">{{{this.bold}}}</strong>
                                    <div class="desc">{{{text}}}</div>
                                </div>
                            {{/each}}</div>
                    </article>
                    <article class="card">
                        <h3>Trajectory</h3>
                        <div class="signal-stack">{{#each analysis.trajectory}}
                                <div class="signal-item"><strong class="{{{dot}}}">{{{this.bold}}}</strong>
                                    <div class="desc">{{{text}}}</div>
                                </div>
                            {{/each}}</div>
                    </article>
                </div>
            </section>
        {{/if}}
        {{#if watchpoints.length}}
            <section class="sec">
                <div class="sec-head">
                    <div class="sec-title">Watchpoints</div>
                    <div class="sec-note">Key evidence that could strengthen or weaken confidence over the next 4–6 quarters</div>
                </div>
                <div class="grid two numbered-grid">{{#each watchpoints}}
                        <article class="watch-card">
                            <h3>{{{title}}}</h3>
                            <p class="desc">{{{desc}}}</p>
                        </article>
                    {{/each}}</div>
            </section>
        {{/if}}
        {{#if key_message}}
            <section class="sec keymsg synthesis-card">
                <div class="sec-title">Synthesis</div>
                <div class="synthesis-grid">
                    <div class="synthesis-panel"><span class="synthesis-label neutral">Bottom line</span>
                        <div class="lead">{{{key_message.lead}}}</div>
                    </div>
                    <div class="synthesis-panel"><span class="synthesis-label positive">Positive</span>
                        <p>{{{key_message.positive}}}</p>
                    </div>
                    <div class="synthesis-panel"><span class="synthesis-label watch">Watch</span>
                        <p>{{{key_message.watch}}}</p>
                    </div>
                    <div class="synthesis-panel"><span class="synthesis-label risk">Risk</span>
                        <p>{{{key_message.risk}}}</p>
                    </div>
                </div>
            </section>
        {{/if}}
        <script>document.querySelectorAll('[data-inline-markdown]').forEach(el => { const parts = el.textContent.split('**'); el.textContent = ''; parts.forEach((part, i) => { const node = i % 2 ? document.createElement('strong') : document.createTextNode(part); if (i % 2) node.textContent = part; el.appendChild(node) }) });</script>
    </main>
</body>

</html>