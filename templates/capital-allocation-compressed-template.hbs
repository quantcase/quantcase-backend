<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Capital Allocation — {{asset_name}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Mono:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --paper: #f5f4ef;
      --surface: #ffffff;
      --surface-soft: #f0efe9;
      --ink: #141a21;
      --muted: #5c6570;
      --faint: #9aa1a9;
      --line: #e4e0d4;
      --line-dark: #c9c5ba;
      --teal: #0e9c86;
      --teal-dark: #0a6e5c;
      --teal-soft: #e3f4f0;
      --amber: #c07c12;
      --amber-soft: #fbf0dc;
      --red: #c43d34;
      --red-soft: #fbeae8;
      --blue: #3d5afe;
      --navy: #0d1b2b;
      --navy-2: #18304a;
      --radius: 14px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font: 14px/1.55 'IBM Plex Sans', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .report { width: min(1040px, 100%); margin: auto; padding: 28px 28px 52px; }

    .topline { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--line); margin-bottom: 20px; }
    .topline-brand { color: var(--faint); font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
    .topline-brand strong { color: var(--ink); }
    .topline-period { margin: 0; color: var(--faint); font: 500 11px/1.4 'IBM Plex Mono', monospace; text-align: right; }

    /* Hero Section (Reliance Style) */
    .hero {
      position: relative;
      display: grid;
      grid-template-columns: 180px minmax(0, 1fr);
      gap: 38px;
      align-items: center;
      min-height: 286px;
      margin-top: 0;
      padding: 42px 40px;
      overflow: hidden;
      color: #fff;
      background: #1c254b;
      border: 1px solid #40528f;
      border-radius: 20px;
    }
    .hero::after {
      position: absolute;
      inset: 0;
      background: radial-gradient(500px 240px at 92% -20%, rgba(115,139,230,.16), transparent 70%);
      content: "";
      pointer-events: none;
    }
    .hero-body, .score-ring { position: relative; z-index: 1; }
    .hero-body { min-width: 0; }
    
    .score-ring {
      --score-color: var(--amber);
      position: relative;
      display: grid;
      width: 180px;
      aspect-ratio: 1;
      place-items: center;
      border-radius: 50%;
      background: conic-gradient(var(--score-color) calc(var(--score) * 1%), rgba(255,255,255,.14) 0);
    }
    .score-ring.green { --score-color: var(--teal); }
    .score-ring.amber { --score-color: var(--amber); }
    .score-ring.red { --score-color: #ed8078; }
    .score-ring::before {
      position: absolute;
      width: calc(100% - 24px);
      aspect-ratio: 1;
      background: #13283d;
      border-radius: 50%;
      content: "";
    }
    
    .score-copy { position: relative; text-align: center; }
    .score-value {
      display: block;
      color: #ffd58c;
      font-family: 'Fraunces', Georgia, serif;
      font-size: 52px;
      font-weight: 600;
      line-height: 1;
    }
    .score-ring.green .score-value { color: #8ff0da; }
    .score-ring.red .score-value { color: #ffaaa4; }
    .score-scale {
      display: block;
      margin-top: 4px;
      color: rgba(255,255,255,.5);
      font: 600 10.5px/1.4 'IBM Plex Mono', monospace;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .eyebrow, .section-tag { margin: 0; color: var(--faint); font-size: 10.5px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
    .hero .eyebrow { color: #8ff0da; }
    .action-title { max-width: none; margin: 8px 0 2px; color: #fff; font-family: 'Fraunces', Georgia, serif; font-size: 34px; font-weight: 600; line-height: 1.2; }
    .verdict { max-width: 670px; margin: 6px 0 20px; color: rgba(255,255,255,.74); font-size: 15px; }
    
    .reasons { display: flex; flex-wrap: wrap; gap: 9px; }
    .reason {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 12px;
      color: rgba(255,255,255,.85);
      background: rgba(255,255,255,.07);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 500;
    }
    .reason::before { font-weight: 700; font-size: 13px; }
    .reason.g::before { color: #9de1d3; content: "✓"; }
    .reason.a::before { color: #ffd58c; content: "!"; }
    .reason.r::before { color: #ffaaa4; content: "×"; }

    section { margin-top: 36px; padding: 0; border: 0; }
    .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 14px; }
    .section-title { margin: 4px 0 0; font-family: 'IBM Plex Sans', sans-serif; font-size: 16px; font-weight: 600; line-height: 1.3; }
    .section-note { max-width: 520px; margin: 0; color: var(--faint); font-size: 11px; text-align: right; }

    /* Headline Cards (Reliance Style) */
    .headline-grid, .three-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .headline-card { padding: 18px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
    .headline-label { display: flex; align-items: center; gap: 8px; margin: 0 0 12px; color: var(--muted); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; }
    .headline-dot { width: 8px; height: 8px; flex: 0 0 auto; background: var(--teal); border-radius: 50%; }
    .headline-dot.a { background: var(--amber); }
    .headline-dot.r { background: var(--red); }
    .headline-value { margin: 0; font: 600 22px/1.15 'Fraunces', Georgia, serif; }
    .headline-value.g { color: var(--teal-dark); }
    .headline-value.a { color: #875408; }
    .headline-value.r { color: #9a3029; }
    .headline-sub { margin: 9px 0 0; color: var(--muted); font-size: 12px; line-height: 1.48; }

    /* ============================================================== */
    /* QC INTUITION SECTION (PRESERVED EXACTLY FROM SOURCE 6 TEMPLATE) */
    /* ============================================================== */
    .insight-stack{margin-top:36px}
    .insight-stack .intuition-panel{border-radius:16px 16px 0 0}
    .insight-patterns{padding:18px;background:var(--page);border-right:1px solid var(--line-dark);border-left:1px solid var(--line-dark)}
    .insight-stack .edge-panel{border-radius:0 0 15px 15px}
    .intuition-panel{min-height:210px;padding:28px;background:var(--navy);color:#fff;border-radius:16px}
    .intuition-badge,.edge-badge{display:inline-flex;padding:5px 10px;border:1px solid rgba(139,164,251,.35);border-radius:999px;color:#a9bafa;background:rgba(79,110,247,.1);font:700 9.5px/1.3 'IBM Plex Mono',monospace;letter-spacing:.08em;text-transform:uppercase}
    .intuition-heading{max-width:760px;margin:42px 0 8px;font:600 27px/1.2 Lora,Georgia,serif}
    .intuition-line{max-width:820px;margin:0;color:rgba(255,255,255,.68);font-size:13px}
    /* ============================================================== */

    /* Patterns (Horizontal layout per Reliance) */
    .pattern-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .pattern-card {
      position: relative;
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 14px;
      align-items: center;
      min-height: 96px;
      padding: 15px 16px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
    }
    .pattern-card.full { grid-column: span 2; }
    .pattern-visual { display: grid; gap: 8px; place-items: center; }
    .sparkline { display: flex; width: 68px; height: 38px; align-items: end; justify-content: center; gap: 3px; padding-bottom: 3px; border-bottom: 1px solid var(--line-dark); }
    .sparkline i { width: 6px; height: 45%; background: var(--teal); border-radius: 3px 3px 0 0; }
    .sparkline i.v1 { height: 20%; } .sparkline i.v2 { height: 36%; } .sparkline i.v3 { height: 52%; } .sparkline i.v4 { height: 72%; } .sparkline i.v5 { height: 96%; }
    .pattern-card.a .sparkline i { background: var(--amber); }
    .pattern-card.r .sparkline i { background: var(--red); }
    .pattern-name { margin: 20px 0 4px; font-size: 13.5px; font-weight: 600; }
    .pattern-meaning { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.4; }
    
    .trend {
      position: absolute;
      top: 15px;
      left: 102px;
      padding: 3px 8px;
      border-radius: 20px;
      font-size: 9.5px;
      font-weight: 700;
      text-transform: uppercase;
    }
    .trend.rising { color: var(--teal-dark); background: var(--teal-soft); }
    .trend.steady, .trend.mixed { color: #875408; background: var(--amber-soft); }
    .trend.weakening { color: #9a3029; background: var(--red-soft); }
    .trend.new { color: #2944bd; background: var(--blue-soft); }

    /* Edge Panel (Preserved styling but adapted for parent font) */
    .edge-panel { padding: 22px; background: var(--navy); color: #fff; border-radius: 15px; }
    .edge-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: 20px; }
    .edge-label { margin: 0 0 5px; color: #8ba4fb; font: 700 9px/1.3 'IBM Plex Mono', monospace; letter-spacing: .08em; text-transform: uppercase; }
    .edge-copy { margin: 0; color: rgba(255,255,255,.75); font-size: 12.5px; }
    .edge-copy.accent { color: #91dfd1; }
    .focus-chip { display: inline-block; margin-right: 7px; padding: 3px 7px; color: #f0c070; background: rgba(240, 192, 112, .1); border-radius: 5px; font-weight: 700; }

    /* NEW: Analysis Signal Grid (Reliance Deep-Dive Style) */
    .signal-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .signal-card { padding: 20px; background: var(--surface); border: 1px solid var(--line); border-top: 3px solid var(--teal); border-radius: var(--radius); }
    .signal-card.amber { border-top-color: var(--amber); }
    .signal-card-title { margin: 0 0 3px; font-size: 14px; font-weight: 700; }
    .signal-card-sub { margin: 0 0 14px; color: var(--faint); font-size: 11px; line-height: 1.4; }
    .signal-items { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
    .signal-item { display: grid; grid-template-columns: 10px minmax(0, 1fr); gap: 10px; padding: 9px 0 0; border-top: 1px solid var(--line); }
    .signal-item:first-child { padding-top: 0; border-top: 0; }
    .signal-dot { width: 9px; height: 9px; margin-top: 5px; background: var(--teal); border-radius: 50%; }
    .signal-dot.a { background: var(--amber); }
    .signal-dot.r { background: var(--red); }
    .signal-text { color: var(--muted); font-size: 12px; line-height: 1.5; }
    .signal-text strong { color: var(--ink); }

    /* Watchpoints (Reliance Counter Style) */
    .watch-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; counter-reset: watch; }
    .watch-card {
      padding: 13px 15px;
      background: var(--amber-soft);
      border-left: 3px solid var(--amber);
      border-radius: 8px;
      counter-increment: watch;
    }
    .watch-card.g { background: var(--teal-soft); border-left-color: var(--teal); }
    .watch-card.r { background: var(--red-soft); border-left-color: var(--red); }
    
    .watch-title { margin: 4px 0 3px; font-size: 12.5px; font-weight: 600; }
    .watch-title::before {
      content: counter(watch, decimal-leading-zero) " ";
      color: var(--amber);
      font: 700 11px/1.4 'IBM Plex Mono', monospace;
      display: block;
      margin-bottom: 2px;
    }
    .watch-card.g .watch-title::before { color: var(--teal-dark); }
    .watch-card.r .watch-title::before { color: var(--red); }
    
    .watch-desc { margin: 0; color: var(--muted); font-size: 11.5px; line-height: 1.4; }
    .watch-meta { margin-top: 8px; color: var(--faint); font: 500 9.5px/1.35 'IBM Plex Mono', monospace; text-transform: uppercase; }

    /* Bottom Line */
    .bottom-line { display: grid; gap: 10px; }
    .bottom-row {
      display: grid;
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 14px;
      align-items: start;
      padding: 13px 15px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-left: 3px solid var(--teal);
      border-radius: 10px;
    }
    .bottom-row.a { border-left-color: var(--amber); }
    .bottom-row.r { border-left-color: var(--red); }
    .bottom-tag { color: var(--teal-dark); font: 700 10px/1.5 'IBM Plex Mono', monospace; letter-spacing: .06em; text-transform: uppercase; }
    .bottom-row.a .bottom-tag { color: #875408; }
    .bottom-row.r .bottom-tag { color: #9a3029; }
    .bottom-copy { color: var(--muted); font-size: 12.5px; line-height: 1.5; }

    .foot { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-top: 34px; padding-top: 15px; color: var(--faint); border-top: 1px solid var(--line); font-size: 10.5px; }
    .foot span:last-child { text-align: right; }

    @media(max-width: 760px) {
      .report { padding: 20px 16px 40px; }
      .topline { align-items: flex-start; flex-direction: column; gap: 4px; }
      .topline-period { text-align: left; }
      .hero { grid-template-columns: 1fr; min-height: 0; padding: 26px 20px; text-align: center; }
      .score-ring { width: 150px; margin: auto; }
      .action-title { font-size: 30px; }
      .reasons { justify-content: center; }
      .section-head { align-items: flex-start; flex-direction: column; gap: 4px; }
      .section-note { text-align: left; }
      .headline-grid, .pattern-grid, .signal-grid, .three-grid, .two-grid, .watch-grid, .edge-grid { grid-template-columns: 1fr; }
      .pattern-card.full { grid-column: auto; }
      .foot { flex-direction: column; }
      .foot span:last-child { text-align: left; }
    }

    @media(max-width: 480px) {
      .report { padding-inline: 12px; }
      .hero { padding-inline: 16px; }
      .action-title { font-size: 25px; }
      .intuition-panel { padding: 23px 18px; }
      .intuition-heading { margin-top: 32px; font-size: 24px; }
      .edge-panel { padding: 18px; }
      .bottom-row { grid-template-columns: 1fr; gap: 4px; }
    }
  </style>
</head>

<body>
<main class="report" data-template-category="capital-allocation-compressed">
  
  <div class="topline">
    <span class="topline-brand">{{lens}} · <strong>{{asset_name}}</strong></span>
    <p class="topline-period">{{#if period_start}}{{period_start}}{{#if period_end}} → {{period_end}}{{/if}}{{/if}}{{#if computed_date}}<br>Computed {{computed_date}}{{/if}}</p>
  </div>

  <header class="hero">
    <div class="score-ring {{score_badge.status_color}}" style="--score:{{score_badge.score}}" role="img" aria-label="Capital allocation score {{score_badge.score}} out of {{score_badge.scale}}">
      <div class="score-copy"><span class="score-value">{{score_badge.score}}</span><span class="score-scale">out of {{score_badge.scale}}</span></div>
    </div>
    <div class="hero-body">
      <p class="eyebrow">Capital Allocation</p>
      <h1 class="action-title">{{hero.action_title}}</h1>
      <p class="verdict">{{hero.verdict}}</p>
      {{#if hero.reasons.length}}
        <div class="reasons">
            {{#each hero.reasons}}
                <span class="reason {{tone}}">{{text}}</span>
            {{/each}}
        </div>
      {{/if}}
    </div>
  </header>

  {{#if headline.cards.length}}
    <section>
      <div class="section-head">
          <div><p class="section-tag">{{headline.section_tag}}</p><h2 class="section-title">{{headline.section_title}}</h2></div>
      </div>
      <div class="headline-grid">
          {{#each headline.cards}}
            <article class="headline-card">
              <p class="headline-label"><span class="headline-dot {{dot}}"></span>{{label}}</p>
              <p class="headline-value {{value_color}}">{{value}}</p>
              <p class="headline-sub">{{sub}}</p>
            </article>
          {{/each}}
      </div>
    </section>
  {{/if}}

  <!-- PRESERVED QC INTUITION STACK (Untouched structure) -->
  <section class="insight-stack">
    {{#if qc_intuition.summary}}
        <div class="intuition-panel">
            <span class="intuition-badge">QC Intuition · Pattern Recognition</span>
            <h2 class="intuition-heading">How management deploys and reallocates capital.</h2>
            <p class="intuition-line">{{qc_intuition.summary}}</p>
        </div>
    {{/if}}
    
    {{#if patterns.cards.length}}
        <div class="insight-patterns">
            <div class="pattern-grid">
                {{#each patterns.cards}}
                    <article class="pattern-card {{tone}} {{#if full_width}}full{{/if}}">
                        <div class="pattern-visual">
                            <span class="sparkline" aria-label="Relative pattern evolution">
                                {{#each spark}}<i class="v{{this}}"></i>{{/each}}
                            </span>
                        </div>
                        <div>
                            <h3 class="pattern-name">{{name}}</h3>
                            <p class="pattern-meaning">{{meaning}}</p>
                        </div>
                        <span class="trend {{trend}}">{{trend}}</span>
                    </article>
                {{/each}}
            </div>
        </div>
    {{/if}}

    {{#if edge}}
        <div class="edge-panel">
            <span class="edge-badge">{{edge.badge}}</span>
            <div class="edge-grid">
                <div><p class="edge-label">Behaviour</p><p class="edge-copy">{{edge.behaviour}}</p></div>
                <div><p class="edge-label">Implication</p><p class="edge-copy accent">{{edge.implication}}</p></div>
                {{#if edge.investor_focus.chip}}
                    <div><p class="edge-label">Investor focus</p><p class="edge-copy"><span class="focus-chip">{{edge.investor_focus.chip}}</span>{{edge.investor_focus.tail}}</p></div>
                {{/if}}
            </div>
        </div>
    {{/if}}
  </section>

  <!-- NEW DEEP-DIVE SECTION (Replacing capital_evolution timeline to match Reliance) -->
  {{#if analysis}}
    <section>
      <div class="section-head">
        <div><p class="section-tag">{{analysis.section_tag}}</p><h2 class="section-title">{{analysis.section_title}}</h2></div>
      </div>
      <div class="signal-grid">
        <article class="signal-card">
          <h3 class="signal-card-title">Core signals</h3>
          <p class="signal-card-sub">What's working in the current cycle</p>
          <ul class="signal-items">
            {{#each analysis.core_signals}}
              <li class="signal-item">
                <span class="signal-dot {{dot}}"></span>
                <span class="signal-text"><strong>{{bold}}:</strong> {{text}}</span>
              </li>
            {{/each}}
          </ul>
        </article>
        
        <article class="signal-card amber">
          <h3 class="signal-card-title">Trajectory &amp; risks</h3>
          <p class="signal-card-sub">What to watch as the cycle unfolds</p>
          <ul class="signal-items">
            {{#each analysis.trajectory}}
              <li class="signal-item">
                <span class="signal-dot {{dot}}"></span>
                <span class="signal-text"><strong>{{bold}}:</strong> {{text}}</span>
              </li>
            {{/each}}
          </ul>
        </article>
      </div>
    </section>
  {{/if}}

  {{#if watchpoints.length}}
    <section>
        <div class="section-head"><div><p class="section-tag">Forward look</p><h2 class="section-title">Capital proof points</h2></div></div>
        <div class="watch-grid">
            {{#each watchpoints}}
                <article class="watch-card {{tone}}">
                    <h3 class="watch-title">{{title}}</h3>
                    <p class="watch-desc">{{desc}}</p>
                    {{#if resolves}}<p class="watch-meta">Resolves: {{resolves}}</p>{{/if}}
                </article>
            {{/each}}
        </div>
    </section>
  {{/if}}

  {{#if bottom_line.length}}
    <section>
        <div class="section-head"><div><p class="section-tag">Investor takeaway</p><h2 class="section-title">{{investor_takeaway_text}}</h2></div></div>
        <div class="bottom-line">
            {{#each bottom_line}}
                <div class="bottom-row {{tone}}">
                    <span class="bottom-tag">{{tag}}</span>
                    <span class="bottom-copy">{{text}}</span>
                </div>
            {{/each}}
        </div>
    </section>
  {{/if}}

  <footer class="foot">
      <span>Capital Allocation · {{asset_name}}</span>
      <span>{{footer.sources}}{{#if footer.methodology}} · {{footer.methodology}}{{/if}}</span>
  </footer>
</main>
</body>
</html>
