generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── Core Pipeline ────────────────────────────────────────────────────────────

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model earnings_calls {
  id                    String    @id(map: "earnings_calls_pkey1")
  company               String
  fiscal_year           String?
  quarter               String?
  call_date             String?
  transcript_url        String?
  transcript_text       String?
  ppt_url               String?
  ppt_text              String?
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
  basic_industry        String?
  company_name          String?
  quarterly_result      String?
  quarterly_result_url  String?
  quarterly_result_text String?

  @@unique([company, fiscal_year, quarter], map: "earnings_calls_unique_key")
  @@index([company, fiscal_year, quarter])
}

model annual_reports {
  id                BigInt    @id @default(autoincrement())
  company           String?
  document_type     String?
  fiscal_year       String?
  call_date         String?
  annual_report_url String?
  created_at        DateTime? @db.Timestamp(6)

  @@map("annual_reports")
}

model Job {
  id           String   @id @default(uuid())
  callId       String   @map("call_id")
  type         String
  status       String   @default("pending")
  result       Json?
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  bullmqId     String?  @unique @map("bullmq_id")
  llm_response String?  @map("llm_response")
  prompt       String?

  @@index([callId])
  @@index([status])
  @@map("jobs")
}

model PipelineJobFailure {
  id              String   @id @default(uuid())
  queue           String
  bullmq_job_id   String   @unique
  call_id         String
  source_doc_type String
  chunk_index     Int?
  total_chunks    Int?
  lineage_id      String?
  error_message   String?
  attempts_made   Int?
  failed_at       DateTime @default(now())

  @@index([call_id])
  @@index([source_doc_type])
  @@index([failed_at])
  @@map("pipeline_job_failures")
}

// ─── KPI & Prowess ────────────────────────────────────────────────────────────

model Kpi {
  id            String            @id @default(uuid())
  abbr          String            @unique
  full_form     String
  denomination  DenominationType?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  industry      String[]          @default([])
  source        KpiSource
  kpi_type      KpiTypeCategory?
  // Raw indicator name as it appears in the annual Prowess CSV, used to
  // resolve annual columns to this KPI without a code deploy. Defaults to the
  // same value as `abbr` when the two coincide. ProwessUploader's annual path
  // (runAnnual) matches on this field exclusively.
  prowess_name  String?
  // Same idea as prowess_name, but for the quarterly CSV's own header text --
  // kept separate because ~2/3 of abbrs that appear in both templates use
  // different wording per template (e.g. TOTAL_INCOME: 'Total income'
  // annually vs 'Total income from continuing operations' quarterly), so one
  // string field can't hold both. Not yet wired into runQuarterly() (which
  // still resolves via the hardcoded QTR_COL_MAP) -- seeded here for
  // reference/future use, no ingestion code depends on it yet.
  quarterly_prowess_name String?
  prowessValues ProwessValueNew[]

  // ── Generic, admin-defined computation (see utils/formulaRegistry) ──────────
  // True for every Kpi row formulaRegistry's registry cache should load.
  // Needed because `abbr` is a shared namespace with an unrelated
  // transcript-metric dedup pipeline (~23k rows, source:'transcript') — a
  // handful of abbrs (EBITDA, ROE, EPS_BASIC, ...) collide with that
  // pipeline's canonical names. `source: 'QE'` alone can't disambiguate raw
  // leaves (frequency stays null by design, since e.g. EPS_BASIC is fetched
  // at either annual or quarterly cadence depending on caller context) from
  // an untouched transcript-dedup row that also happens to have no formula.
  registry_enabled   Boolean       @default(false)
  // Anchored to the 3 real ingestion pipelines (Prowess annual/quarterly CSV,
  // daily OHLCV/valuation) — not a business taxonomy, so this stays an enum.
  // Null for purely organizational "header" Kpi rows (see KpiRelationship's
  // 'statement_of' usage) that have no data of their own.
  frequency          KpiFrequency?
  // Null = raw leaf, value read directly from the frequency-appropriate
  // source table for this abbr. Non-null = admin-authored expression,
  // evaluated by utils/formulaRegistry/expressionEvaluator.js.
  formula_expression String?
  // Ordered list of other Kpi.abbr to try (in order) if this metric's own
  // resolution comes back null. Plain string refs, not a DB relation —
  // validated at write time, mirrors ProwessUploader's abbr-string matching.
  fallback_abbrs     String[]      @default([])
  // Display unit, e.g. "Cr", "%", "x", "₹" — finer-grained than `denomination`.
  unit_label         String?
  description        String?
  // Default ordering among siblings; overridable per-relationship via
  // KpiRelationship.display_order.
  display_order      Int           @default(0)

  @@index([abbr])
  @@index([source])
  @@index([prowess_name])
  @@index([frequency])
  @@index([registry_enabled])
  @@map("kpis")
}

// Generic, admin-editable relationships between KPIs (and optionally a
// CompanyGroup). Originally also covered display grouping (expandable
// constituent rollups, PnL/Balance Sheet/Cashflow statement sections) via
// 'constituent_of'/'statement_of' — both superseded by KpiGroup below (a
// real tree; these were flat/single-level). It also used to carry
// 'variant_for_group' — a silent, per-abbr, company-group-scoped formula
// swap (e.g. BFSI companies transparently resolving EBIT_BFSI instead of
// EBIT with no visible indication) — removed because it was invisible to
// admin and produced inconsistent results between callers. The admin-visible
// replacement is ScreenConfig.variant_of_key/company_group_slug (see below):
// a whole separate, explicitly-authored config/KpiGroup per company group,
// not a hidden per-row substitution. No relationship_type is read by any
// consumer today; existing rows are left in place for reference only.
// `relationship_type` is deliberately a free string, not an enum — new
// relationship kinds should never require a schema migration.
model KpiRelationship {
  id                 String   @id @default(uuid())
  kpi_abbr           String
  relationship_type  String
  // kpi-to-kpi target: parent in a rollup, statement header, or the variant
  // abbr to use instead of kpi_abbr. Plain string ref, not a DB relation.
  related_kpi_abbr   String?
  // kpi-to-CompanyGroup scoping (e.g. 'variant_for_group' rows) — references
  // CompanyGroup.slug as a plain string, not an FK; CompanyGroup is owned by
  // services/companyGroups and intentionally untouched by this feature.
  company_group_slug String?
  display_order      Int      @default(0)
  created_at         DateTime @default(now())

  @@index([kpi_abbr])
  @@index([relationship_type])
  @@map("kpi_relationships")
}

// Admin-editable display hierarchy for KPIs — replaces KpiRelationship's old
// 'constituent_of'/'statement_of' usage (both were flat, single-level; this
// is a real tree). A node is either a container (kpi_abbr null, e.g. "P&L
// Statement", "Reserves & Surplus") or a leaf pointing at one Kpi.abbr.
// Siblings need no separate concept — just query WHERE parent_id = X.
// Seeded with one root per existing Kpi.kpi_type value so the old
// enum-based grouping and this free-form tree coexist (kpi_type roots are
// just ordinary KpiGroup rows an admin can rename/re-nest/add siblings to).
// Purely a display/layout concern — never consulted by resolveMetric.
model KpiGroup {
  id                 String     @id @default(uuid())
  slug               String     @unique
  label              String
  parent_id          String?
  parent             KpiGroup?  @relation("KpiGroupTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children           KpiGroup[] @relation("KpiGroupTree")
  // Set = this node represents one specific Kpi (a leaf). Null = pure
  // container node. Plain string ref, not a DB relation (matches
  // KpiRelationship's related_kpi_abbr convention).
  kpi_abbr           String?
  // Optional: this node/branch is only shown for companies in this group
  // (e.g. a BFSI-only "Provisions" branch). Plain string ref to
  // CompanyGroup.slug, not an FK — same convention as KpiRelationship.
  company_group_slug String?
  display_order      Int        @default(0)
  created_at         DateTime   @default(now())

  @@index([parent_id])
  @@index([kpi_abbr])
  @@map("kpi_groups")
}

// A single, reusable threshold condition on a Kpi's resolved value (e.g.
// "EBITDA > 10000"). Not tied to any one CompanyGroup — see
// CompanyGroupFilter for how filters are attached to a group (many-to-many,
// AND-combined).
model KpiFilter {
  id         String        @id @default(uuid())
  slug       String        @unique
  label      String
  kpi_abbr   String
  operator   String // '>' | '<' | '>=' | '<=' | '=' | '!=' | 'between' — validated against this fixed set at write time (see admin.kpiFilters.service.js)
  value      Float
  value_max  Float? // only used when operator = 'between'
  // Which cadence to resolve kpi_abbr at. Required at the validation layer
  // (admin.kpiFilters.routes.js/.service.js) — the resolver never defaults or
  // infers a frequency, so this can't be left unset; stays nullable here only
  // because adding NOT NULL to a live column isn't worth its own migration.
  frequency  KpiFrequency?
  created_at DateTime      @default(now())

  companyGroupFilters CompanyGroupFilter[]

  @@index([kpi_abbr])
  @@map("kpi_filters")
}

// Attaches a reusable KpiFilter to a CompanyGroup. All filters attached to
// the same company_group_slug are AND-combined when the group is recomputed
// (see services/companyGroups/recompute.service.js). company_group_slug is a
// plain string ref to CompanyGroup.slug, not an FK — same convention as
// KpiRelationship/KpiGroup.
model CompanyGroupFilter {
  id                 String    @id @default(uuid())
  company_group_slug String
  kpi_filter_id      String
  kpi_filter         KpiFilter @relation(fields: [kpi_filter_id], references: [id], onDelete: Cascade)
  created_at         DateTime  @default(now())

  @@unique([company_group_slug, kpi_filter_id])
  @@index([company_group_slug])
  @@map("company_group_filters")
}

// Materialized membership cache for CompanyGroup rows with
// filter_type: 'kpi_filter' — resolving a KPI value for every company on
// every request would be expensive, so membership is computed once (admin
// POST /admin/company-groups/:slug/recompute) and read from here instead of
// live-scanned, unlike the existing 'manual'/'dynamic' filter_types.
// company_group_slug is a plain string ref to CompanyGroup.slug, not an FK.
model CompanyGroupMember {
  id                 String   @id @default(uuid())
  company_group_slug String
  symbol             String
  computed_at        DateTime @default(now())

  @@unique([company_group_slug, symbol])
  @@index([company_group_slug])
  @@map("company_group_members")
}

model SubstituteKpi {
  id             String   @id @default(uuid())
  primaryKpiAbbr String   @unique @map("primary_kpi_abbr")
  substitutes    String[]
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([primaryKpiAbbr])
  @@map("substitute_kpis")
}

model KpiValue {
  id          String    @id @default(uuid())
  callId      String    @map("call_id")
  company     String
  fiscal_year String?
  quarter     String?
  call_date   String?
  kpi_abbr    String
  value       Float?
  raw_value   String?   @map("raw_value")
  unit        String?
  multiplier  Int       @default(1)
  source      KpiSource
  source_path String    @default("")
  statement   String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  end_date    String?   @map("end_date")
  start_date  String?   @map("start_date")
  period_type String?   @map("period_type")

  @@unique([callId, kpi_abbr], map: "kpi_values_call_kpi_unique")
  @@index([callId])
  @@index([company, fiscal_year, quarter])
  @@index([company, kpi_abbr])
  @@index([kpi_abbr])
  @@index([kpi_abbr, period_type])
  @@map("kpi_values")
}

model ProwessValueNew {
  id          String    @default(uuid())
  callId      String    @map("call_id")
  company     String
  fiscal_year String?
  quarter     String?
  call_date   String?
  kpi_abbr    String
  value       Float?
  raw_value   String?   @map("raw_value")
  unit        String?
  multiplier  Int       @default(1)
  source      KpiSource
  source_path String    @default("")
  statement   String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  end_date    String?   @map("end_date")
  start_date  String?   @map("start_date")
  period_type String?   @map("period_type")
  source_type String    @default("C") @map("source_type")
  kpi         Kpi       @relation(fields: [kpi_abbr], references: [abbr], onDelete: Cascade)

  @@unique([callId, kpi_abbr], map: "pnv_call_kpi_unique")
  @@index([company, fiscal_year, quarter], map: "idx_pnv_company_fy_q")
  @@index([company, kpi_abbr], map: "idx_pnv_company_kpi")
  @@index([kpi_abbr], map: "idx_pnv_kpi")
  @@index([kpi_abbr, period_type], map: "idx_pnv_kpi_period")
  @@index([company, source_type], map: "idx_pnv_company_srctype")
  @@map("prowess_values_new")
}

// Tracks the async SendBatch → GetBatch lifecycle for the live Prowess batch
// API (a request submitted once via SendBatch is polled later by token via
// GetBatch — possibly from a different process, see scheduler.js). Deliberately
// not BullMQ: SendBatch is an expensive, admin-gated call with no automatic
// retry wanted; this table just needs to survive a server restart and be
// readable from both the API server and the scheduler process.
model ProwessBatchRequest {
  id          String    @id @default(uuid())
  token       String    @unique
  mode        String // 'annual' | 'quarterly' — mirrors ProwessUploader's mode strings
  status      String    @default("pending") // 'pending' | 'completed' | 'failed' | 'aborted'
  requestMeta Json?     @map("request_meta") // admin-supplied context: indicators/companies requested
  result      Json?
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([status])
  @@map("prowess_batch_requests")
}

model SummaryNew {
  id                String   @id @default(uuid())
  callId            String   @unique @map("call_id")
  kpis              Json?
  entities          Json?
  milestones        Json?
  riskDisclosures   Json?    @map("risk_disclosures")
  governanceSignals Json?    @map("governance_signals")
  industryAnalysis  Json?    @map("industry_analysis")
  financialStrength Json?    @map("financial_strength")
  clientTraction    Json?    @map("client_traction")
  tone              String?
  confidence        String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([callId])
  @@map("summary_new")
}

// ─── Signals & Lenses ─────────────────────────────────────────────────────────

model TranscriptSignalV2 {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  call_id         String
  ticker          String
  company         String
  fiscal_year     String?
  quarter         String?
  call_date       String?
  signal_type     String
  source_context  String?
  source_stmt_id  String?
  signal_seq_id   String?
  metric          String?
  impact          String?
  severity        String?
  statement       String?
  data            Json
  source_hash     String
  prompt_v        String
  extractor_model String
  lineage_id      String
  is_invalidated  Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  source_doc_type String?

  @@index([source_doc_type])
  @@index([call_id], map: "tsv2_call_id")
  @@index([call_id, signal_type], map: "tsv2_call_type")
  @@index([lineage_id], map: "tsv2_lineage")
  @@index([source_hash], map: "tsv2_src_hash")
  @@index([ticker, signal_type], map: "tsv2_tick_type")
  @@index([ticker], map: "tsv2_ticker")
  // Speeds up fetchDoneCallIds (services/pipelineDispatch/signalStore.js) —
  // its WHERE clause filters on source_doc_type + is_invalidated then reads
  // call_id; the old indexes didn't cover that combination, causing 70-120s+
  // queries on company-group extracted/pending filters. Built CONCURRENTLY
  // directly via psql against DIRECT_DATABASE_URL, not through db:push.
  @@index([source_doc_type, is_invalidated, call_id], map: "tsv2_doctype_invalidated_call")
  // Speeds up buildSignalAvailabilityReport (services/pipelineDispatch/l2MultiDispatch.service.js)
  // — its WHERE clause filters ticker = ANY(...) + is_invalidated = false,
  // then GROUP BYs (ticker, source_doc_type, fiscal_year, quarter). Without
  // this, a broad signal-type whitelist (near-total selectivity) run against
  // a large company group scaled query cost with ticker-set size almost as
  // if unfiltered (~115s extrapolated for 586 tickers). Built CONCURRENTLY
  // directly via psql against DIRECT_DATABASE_URL, not through db:push.
  @@index([ticker, is_invalidated, source_doc_type, fiscal_year, quarter], map: "tsv2_ticker_invalidated_doctype_period")
  @@map("transcript_signals_v2")
}

model ExtractedSignal {
  id              String           @id @default(uuid())
  call_id         String
  ticker          String
  company         String
  fiscal_year     String?
  quarter         String?
  call_date       String?
  source_type     SignalSourceType
  signal_type     String
  metric          String
  value           Float?
  raw_value       String?
  unit            String?
  multiplier      Float            @default(1)
  w               Float            @default(1.0)
  b               Float            @default(0.0)
  confidence      Float?
  time_horizon    String?
  esg_tag         String?
  risk_tag        String?
  sector          String?
  metric_family   String?
  source_hash     String
  prompt_v        String
  schema_v        String           @default("2.0.0")
  extractor_model String
  lineage_id      String
  statement       String?
  start_date      String?
  end_date        String?
  period_type     String?
  is_invalidated  Boolean          @default(false)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  impact          String?
  severity        String?

  @@unique([call_id, signal_type, metric, source_hash, prompt_v, start_date])
  @@index([ticker])
  @@index([call_id])
  @@index([ticker, metric_family])
  @@index([source_hash])
  @@map("extracted_signals")
}

model LensConfig {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  is_active   Boolean  @default(true)
  version     String   @default("1.0.0")
  config      Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  category    String?

  @@index([slug])
  @@index([category])
  @@map("lens_configs")
}

model LensScore {
  id               String   @id @default(uuid())
  call_id          String
  ticker           String
  lens_slug        String
  z_score          Float
  confidence_lo    Float?
  confidence_hi    Float?
  signal_count     Int
  lens_config_v    String
  signals_snapshot Json
  is_stale         Boolean  @default(false)
  computed_at      DateTime @default(now())
  updated_at       DateTime @updatedAt
  lens_data        Json?
  signals_hash     String?

  @@unique([call_id, lens_slug])
  @@index([ticker, lens_slug])
  @@index([call_id])
  @@map("lens_scores")
}

model AiInsight {
  id               String   @id @default(uuid())
  ticker           String
  type             String
  insight          Json
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  lens_scores_hash String?  @map("lens_scores_hash")
  prompt_v         String?  @map("prompt_v")

  @@unique([ticker, type])
  @@index([ticker])
  @@index([type])
  @@map("ai_insights")
}

// Prompt/schema config for the post-HTML-analysis pipeline (L3/L4), keyed by
// layer_id ("l3" | "l4") + type ("management" | "opportunity" | "deal" | "summary").
// L3 configs synthesise the 4 lens-level HtmlIncrementalSkillOutput HTML blocks
// (per lib/postHtmlAnalysisLenses.js) for one type into a verdict; the single L4
// config synthesises the 3 L3 PostHtmlAnalysis results into a top-level summary.
model PostHtmlAnalysisConfig {
  id            String             @id @default(uuid())
  layer_id      String
  type          String
  name          String
  prompt        String
  output_schema Json
  model         String?
  max_tokens    Int?
  is_active     Boolean            @default(true)
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
  results       PostHtmlAnalysis[]

  @@unique([layer_id, type])
  @@index([layer_id])
  @@map("post_html_analysis_configs")
}

// Result of running a PostHtmlAnalysisConfig for a given ticker. One row per
// (layer_id, type, ticker) — latest run wins, same convention as ai_insights.
model PostHtmlAnalysis {
  id            String                 @id @default(uuid())
  layer_id      String
  type          String
  ticker        String
  fiscal_year   String?
  quarter       String?
  config_id     String
  input_hash    String?
  result        Json
  model         String
  input_tokens  Int?
  output_tokens Int?
  cost_usd      Float?
  created_at    DateTime               @default(now())
  updated_at    DateTime               @updatedAt
  config        PostHtmlAnalysisConfig @relation(fields: [config_id], references: [id], onDelete: Cascade)

  @@unique([layer_id, type, ticker])
  @@index([ticker])
  @@index([layer_id, type])
  @@map("post_html_analysis")
}

// ─── Skills & Plugins ─────────────────────────────────────────────────────────

model HtmlSkill {
  id                         String            @id @default(uuid())
  slug                       String            @unique
  name                       String
  data_extraction_prompt     String            @default("")
  html_template_prompt       String            @default("")
  enable_data_validation     Boolean           @default(true)
  data_validation_loops      Int               @default(1)
  enable_html_validation     Boolean           @default(false)
  transcript_signal_types    String[]
  ppt_signal_types           String[]
  annual_report_signal_types String[]
  category                   PluginCategory
  model                      String            @default("~anthropic/claude-haiku-latest")
  max_tokens                 Int               @default(16000)
  max_transcript_qtrs        Int?
  max_ppt_qtrs               Int?
  max_annual_report_years    Int?
  market_data_signal_types   String[]
  max_market_data_months     Int?
  is_active                  Boolean           @default(true)
  created_at                 DateTime          @default(now())
  updated_at                 DateTime          @updatedAt
  outputs                    HtmlSkillOutput[]

  @@index([slug])
  @@index([category])
  @@map("html_skills")
}

model HtmlSkillOutput {
  id            String    @id @default(uuid())
  skill_id      String    @map("skill_id")
  ticker        String
  call_id       String?   @map("call_id")
  fiscal_year   String?   @map("fiscal_year")
  quarter       String?
  raw_html      String
  extracted_json Json?
  audit_logs    Json?
  prompt_v      String    @map("prompt_v")
  model         String
  input_tokens  Int?      @map("input_tokens")
  output_tokens Int?      @map("output_tokens")
  cost_usd      Float?    @map("cost_usd")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  skill         HtmlSkill @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([skill_id, ticker, fiscal_year, quarter])
  @@index([ticker])
  @@index([skill_id])
  @@index([call_id])
  @@map("html_skill_outputs")
}

model HtmlIncrementalSkill {
  id                               String                       @id @default(uuid())
  slug                             String                       @unique
  name                             String
  category                         PluginCategory
  data_extraction_prompt           String @default("")
  html_template_prompt             String @default("")
  extraction_model                 String                       @default("~anthropic/claude-haiku-latest")
  fact_validation_model            String                       @default("~anthropic/claude-haiku-latest")
  html_template_model              String                       @default("~anthropic/claude-haiku-latest")
  visual_qa_model                  String                       @default("~anthropic/claude-haiku-latest")
  enable_data_validation           Boolean                      @default(true)
  data_validation_loops            Int                          @default(1)
  enable_html_validation           Boolean                      @default(false)
  max_tokens                       Int                          @default(16000)
  transcript_signal_types          String[]
  ppt_signal_types                 String[]
  annual_report_signal_types       String[]
  // Incremental (historic=false) mode: max NEW distinct periods (since the base
  // output was last generated) to include per source type — not a trailing window.
  max_transcript_qtrs              Int?
  max_ppt_qtrs                     Int?
  max_annual_report_years          Int?
  market_data_signal_types         String[]
  max_market_data_months           Int?
  // Wider, trailing-window signal windows used for historic=true runs
  // (cold-start / full-history recompute). Null = fall back to the fields above.
  historic_max_transcript_qtrs     Int?
  historic_max_ppt_qtrs            Int?
  historic_max_annual_report_years Int?
  historic_max_market_data_months  Int?
  strip_html                       Boolean                      @default(true)
  max_base_analyses                Int                          @default(1)
  // Global base pin: one admin decision applies to every ticker for this skill —
  // an incremental run for ticker X uses whichever of X's outputs matches this
  // exact (fiscal_year, quarter, is_historic), never a per-ticker "most recent"
  // fallback. Setting this doesn't backfill missing tickers' outputs itself —
  // that's the scheduler's job (generating historic runs at this period across
  // tickers); this field only controls which existing output counts as base.
  // Null = no global pin set, falls back to per-ticker "N most recent" behavior.
  pinned_fiscal_year               String?
  pinned_quarter                   String?
  pinned_historic                  Boolean?
  is_active                        Boolean                      @default(true)
  created_at                       DateTime                     @default(now())
  updated_at                       DateTime                     @updatedAt
  outputs                          HtmlIncrementalSkillOutput[]
  configs                          HtmlIncrementalSkillConfig[]

  @@index([slug])
  @@index([category])
  @@map("html_incremental_skills")
}

// A named, alternate settings bundle for a skill — e.g. one config per
// data-availability shape (transcript-only, ppt+annual_report, full, ...).
// Purely additive: the skill's own top-level fields keep working unchanged
// when no config is selected. Admin picks a config explicitly by key when
// running (see configKey on POST /:slug/run and GET /:slug/prompt/:ticker) —
// no auto-detection of which sources are available; that's handled in the
// monitoring system elsewhere, ahead of the admin choosing a config.
model HtmlIncrementalSkillConfig {
  id                               String               @id @default(uuid())
  skill_id                         String
  key                              String // machine identifier, unique per skill, e.g. "transcript_only"
  name                             String // human label, e.g. "Transcript Only"
  data_extraction_prompt           String @default("")
  html_template_prompt             String @default("")
  extraction_model                 String                       @default("~anthropic/claude-haiku-latest")
  fact_validation_model            String                       @default("~anthropic/claude-haiku-latest")
  html_template_model              String                       @default("~anthropic/claude-haiku-latest")
  visual_qa_model                  String                       @default("~anthropic/claude-haiku-latest")
  enable_data_validation           Boolean                      @default(true)
  data_validation_loops            Int                          @default(1)
  enable_html_validation           Boolean                      @default(false)
  transcript_signal_types          String[]
  ppt_signal_types                 String[]
  annual_report_signal_types       String[]
  max_transcript_qtrs              Int?
  max_ppt_qtrs                     Int?
  max_annual_report_years          Int?
  market_data_signal_types         String[]
  max_market_data_months           Int?
  historic_max_transcript_qtrs     Int?
  historic_max_ppt_qtrs            Int?
  historic_max_annual_report_years Int?
  historic_max_market_data_months  Int?
  // Nullable — falls back to the parent skill's own value when unset, same
  // fallback convention as historic_max_* above.
  model                            String?
  max_tokens                       Int?
  strip_html                       Boolean?
  is_active                        Boolean              @default(true)
  created_at                       DateTime             @default(now())
  updated_at                       DateTime             @updatedAt
  skill                            HtmlIncrementalSkill @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([skill_id, key])
  @@index([skill_id])
  @@map("html_incremental_skill_configs")
}

model HtmlIncrementalSkillOutput {
  id             String               @id @default(uuid())
  skill_id       String
  ticker         String
  call_id        String
  fiscal_year    String?
  quarter        String?
  raw_html       String
  extracted_json Json?
  audit_logs     Json?
  text_summary   String?
  prompt_v       String
  model          String
  input_tokens   Int?
  output_tokens  Int?
  cost_usd       Float?
  is_historic    Boolean              @default(false)
  // Which named HtmlIncrementalSkillConfig (by key, not FK — so deleting a
  // config never orphans output history) produced this output. Null = ran
  // with the skill's own top-level fields (no config selected).
  config_key     String?
  // LEGACY — superseded by HtmlIncrementalSkill.pinned_fiscal_year/pinned_quarter/
  // pinned_historic (a single global pin per skill, applied per-ticker at lookup
  // time). No longer read or written anywhere. Left in place rather than dropped
  // since it still holds real historical pin state; safe to drop once confirmed
  // nothing depends on it.
  is_pinned_base Boolean              @default(false)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  skill          HtmlIncrementalSkill @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  // is_historic is part of the identity so a historic run and an incremental run
  // for the same period never collide/overwrite each other.
  @@unique([skill_id, ticker, fiscal_year, quarter, is_historic], name: "skill_ticker_period_mode", map: "html_incremental_skill_outputs_ticker_period_mode_key")
  @@index([skill_id, ticker])
  @@index([ticker])
  @@index([call_id])
  @@map("html_incremental_skill_outputs")
}

model Skill {
  id                  String        @id @default(uuid())
  name                String        @unique
  description         String?
  promptKey           String        @map("prompt_key")
  model               String        @default("anthropic/claude-haiku-4.5")
  maxTokens           Int           @default(16000) @map("max_tokens")
  outputSchema        Json?         @map("output_schema")
  isActive            Boolean       @default(true) @map("is_active")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  defaultInstructions String?       @map("default_instructions")
  promptTemplate      String?       @map("prompt_template")
  slug                String?       @unique
  pluginSkills        PluginSkill[]

  @@index([name])
  @@map("skills")
}

model Plugin {
  id           String         @id @default(uuid())
  name         String         @unique
  description  String?
  category     PluginCategory
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  slug         String?        @unique
  pluginSkills PluginSkill[]

  @@index([category])
  @@map("plugins")
}

model PluginSkill {
  id       String @id @default(uuid())
  pluginId String @map("plugin_id")
  skillId  String @map("skill_id")
  order    Int
  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([pluginId, skillId])
  @@unique([pluginId, order])
  @@index([pluginId])
  @@index([skillId])
  @@map("plugin_skills")
}

