/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model nse_equity {
  id       Int       @id(map: "nse_daily_data_pkey") @default(autoincrement())
  symbol   String?
  datetime DateTime? @db.Timestamp(6)
  open     Float?
  high     Float?
  low      Float?
  close    Float?
  volume   BigInt?

  @@unique([symbol, datetime], map: "unique_symbol_datetime")
}

model nse_index {
  id       Int       @id @default(autoincrement())
  sector   String?
  datetime DateTime? @db.Date
  open     Decimal?  @db.Decimal
  high     Decimal?  @db.Decimal
  low      Decimal?  @db.Decimal
  close    Decimal?  @db.Decimal
  volume   BigInt?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  email      String?
  password   String?
  role       String?
}

// Jobs table for API
model Job {
  id        String   @id @default(uuid())
  callId    String   @map("call_id")
  type      String
  status    String   @default("pending")
  bullmqId  String?  @unique @map("bullmq_id")
  result    Json?
  error     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("jobs")
  @@index([callId])
  @@index([status])
}

// Summaries table for storing extracted call data
model Summary {
  id                String   @id @default(uuid())
  callId            String   @unique @map("call_id")
  entities          Json?
  milestones        Json?
  riskDisclosures   Json?    @map("risk_disclosures")
  governanceSignals Json?    @map("governance_signals")
  industryAnalysis  Json?    @map("industry_analysis")  // new
  tone              String?
  confidence        String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  @@map("summaries")
  @@index([callId])
}
model Kpi {
  id             String   @id @default(uuid())
  abbr           String   @unique
  full_form      String
  type           KpiType
  denomination   DenominationType?   // only for standalone
  numerator_id   String?             // only for ratio
  denominator_id String?             // only for ratio
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt  @map("updated_at")

  numerator      Kpi?     @relation("KpiRatioNumerator",   fields: [numerator_id],   references: [id])
  denominator    Kpi?     @relation("KpiRatioDenominator", fields: [denominator_id], references: [id])

  // Back-relations (required by Prisma for self-referential)
  usedAsNumerator   Kpi[] @relation("KpiRatioNumerator")
  usedAsDenominator Kpi[] @relation("KpiRatioDenominator")

  @@map("kpis")
  @@index([abbr])
  @@index([type])
}

enum KpiType {
  standalone
  ratio
}

enum DenominationType {
  INR
  USD
  percentage
  days
  times
  units
}