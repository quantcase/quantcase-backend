  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([week_date, basic_industry])
  @@index([week_date])
  @@index([basic_industry])
  @@index([week_date, rank])
  @@map("iit_cluster_scores")
}

// ─── WealthOS ─────────────────────────────────────────────────────────────────

model WealthRmUser {
  id                String              @id @default(uuid())
  name              String
  email             String?             @unique
  team              String?
  performance_score Float               @default(0)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  actions           WealthAction[]
  clients           WealthClient[]
  interactions      WealthInteraction[]

  @@index([team])
  @@map("wealth_rm_users")
}

model WealthClient {
  id                String                     @id @default(uuid())
  name              String
  email             String?
  phone             String?
  rm_id             String?
  segment           WealthClientSegment
  risk_profile      WealthRiskProfile
  engagement_score  Float                      @default(0)
  churn_probability Float                      @default(0)
  last_contact_at   DateTime?
  metadata          Json?
  created_at        DateTime                   @default(now())
  updated_at        DateTime                   @updatedAt
  actions           WealthAction[]
  model_mappings    WealthClientModelMapping[]
  rm                WealthRmUser?              @relation(fields: [rm_id], references: [id])
  feature_store     WealthFeatureStore[]
  interactions      WealthInteraction[]
  portfolio         WealthPortfolio?
  suggestions       WealthSuggestion[]

  @@index([rm_id])
  @@index([segment])
  @@index([churn_probability])
  @@index([last_contact_at])
  @@map("wealth_clients")
}

model WealthPortfolio {
  id                  String       @id @default(uuid())
  client_id           String       @unique
  total_value         Float        @default(0)
  risk_score          Float        @default(0)
  last_rebalance_date DateTime?
  holdings            Json?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt
  client              WealthClient @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
  @@map("wealth_portfolios")
}

model WealthInteraction {
  id         String                @id @default(uuid())
  client_id  String
  rm_id      String?
  type       WealthInteractionType
  summary    String?
  sentiment  String?
  timestamp  DateTime              @default(now())
  metadata   Json?
  created_at DateTime              @default(now())
  client     WealthClient          @relation(fields: [client_id], references: [id], onDelete: Cascade)
  rm         WealthRmUser?         @relation(fields: [rm_id], references: [id])

  @@index([client_id])
  @@index([rm_id])
  @@index([timestamp])
  @@map("wealth_interactions")
}

model WealthSuggestion {
  id               String                   @id @default(uuid())
  client_id        String
  priority         WealthSuggestionPriority @default(MEDIUM)
  reason           String?
  suggested_action String?
  message          String?
  talking_points   Json?
  status           WealthSuggestionStatus   @default(pending)
  score            Float                    @default(0)
  job_id           String?
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt
  actions          WealthAction[]
  client           WealthClient             @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
  @@index([status])
  @@index([priority])
  @@index([score])
  @@map("wealth_suggestions")
}

model WealthAction {
  id            String            @id @default(uuid())
  suggestion_id String?
  client_id     String
  rm_id         String?
  action_type   String
  content       String?
  outcome       String?
  created_at    DateTime          @default(now())
  client        WealthClient      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  rm            WealthRmUser?     @relation(fields: [rm_id], references: [id])
  suggestion    WealthSuggestion? @relation(fields: [suggestion_id], references: [id])

  @@index([client_id])
  @@index([rm_id])
  @@index([suggestion_id])
  @@map("wealth_actions")
}

model WealthApprovedModel {
  id              String                     @id @default(uuid())
  name            String
  description     String?
  model_type      WealthModelType
  data            Json?
  created_at      DateTime                   @default(now())
  updated_at      DateTime                   @updatedAt
  client_mappings WealthClientModelMapping[]

  @@index([model_type])
  @@map("wealth_approved_models")
}

model WealthClientModelMapping {
  id          String              @id @default(uuid())
  client_id   String
  model_id    String
  assigned_at DateTime            @default(now())
  client      WealthClient        @relation(fields: [client_id], references: [id], onDelete: Cascade)
  model       WealthApprovedModel @relation(fields: [model_id], references: [id], onDelete: Cascade)

  @@unique([client_id, model_id])
  @@index([client_id])
  @@index([model_id])
  @@map("wealth_client_model_mappings")
}

model WealthAuditLog {
  id           String   @id @default(uuid())
  entity_type  String
  entity_id    String
  action       String
  performed_by String?
  timestamp    DateTime @default(now())
  payload      Json?

  @@index([entity_type, entity_id])
  @@index([performed_by])
  @@index([timestamp])
  @@map("wealth_audit_logs")
}

model WealthFeatureStore {
  id           String       @id @default(uuid())
  client_id    String
  feature_name String
  value        Float
  updated_at   DateTime     @updatedAt
  client       WealthClient @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([client_id, feature_name])
  @@index([client_id])
  @@index([feature_name])
  @@map("wealth_feature_store")
}

// ─── User & Auth ──────────────────────────────────────────────────────────────

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  created_at DateTime @default(now()) @db.Timestamptz(6)
  email      String?
  password   String?
  role       String?
  id         BigInt   @id @default(autoincrement())
}

model User {
  id                String            @id @default(uuid())
  email             String?           @unique
  mobile            String?           @unique
  password_hash     String?           @map("password_hash")
  google_id         String?           @unique @map("google_id")
  display_name      String?           @map("display_name")
  display_picture   String?           @map("display_picture")
  account_type      AccountType       @map("account_type")
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  shadow_portfolios ShadowPortfolio?
  team_memberships  TeamMember[]
  user_portfolios   UserPortfolio?
  profile           UserProfile?
  subscription      UserSubscription?
  payment_methods   PaymentMethod[]
  transactions      Transaction[]
  discounts         Discount[]
  smallcase_user    SmallcaseUser?

  @@index([email])
  @@index([mobile])
  @@index([google_id])
  @@map("qc_users")
}

model Team {
  id         String       @id @default(uuid())
  name       String
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  members    TeamMember[]

  @@map("qc_teams")
}

model TeamMember {
  id         String   @id @default(uuid())
  team_id    String
  user_id    String
  created_at DateTime @default(now())
  team       Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@index([team_id])
  @@index([user_id])
  @@map("qc_team_members")
}

model UserProfile {
  id                   String         @id @default(uuid())
  user_id              String         @unique @map("user_id")
  full_name            String?        @map("full_name")
  phone                String?
  date_of_birth        DateTime?      @map("date_of_birth") @db.Date
  risk_profile         RiskProfile?   @map("risk_profile")
  onboarding_completed Boolean        @default(false) @map("onboarding_completed")
  onboarding_step      OnboardingStep @default(profile) @map("onboarding_step")
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt
  user                 User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("qc_user_profiles")
}

// ─── Portfolio ────────────────────────────────────────────────────────────────

model PortfolioModel {
  id               String   @id @default(uuid())
  name             String
  riskProfile      String   @map("risk_profile")
  capital          Float
  assetClasses     Json     @map("asset_classes")
  client           Json?
  positions        Json?
  whyThisPortfolio Json?    @map("why_this_portfolio")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([riskProfile])
  @@map("portfolio_models")
}

model UserPortfolio {
  id         String    @id @default(uuid())
  user_id    String    @unique @map("user_id")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  holdings   Holding[]
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("qc_user_portfolios")
}

model ShadowPortfolio {
  id         String    @id @default(uuid())
  user_id    String    @unique @map("user_id")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  holdings   Holding[]
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("qc_shadow_portfolios")
}

model Holding {
  id                  String           @id @default(uuid())
  ticker              String
  amount_invested     Float            @map("amount_invested")
  invested_at         DateTime         @map("invested_at")
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  user_portfolio_id   String?          @map("user_portfolio_id")
  shadow_portfolio_id String?          @map("shadow_portfolio_id")
  notes               HoldingNote[]
  shadow_portfolio    ShadowPortfolio? @relation(fields: [shadow_portfolio_id], references: [id], onDelete: Cascade)
  user_portfolio      UserPortfolio?   @relation(fields: [user_portfolio_id], references: [id], onDelete: Cascade)

  @@index([user_portfolio_id])
  @@index([shadow_portfolio_id])
  @@index([ticker])
  @@map("qc_holdings")
}

model HoldingNote {
  id         String   @id @default(uuid())
  holding_id String   @map("holding_id")
  note_text  String   @map("note_text")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  holding    Holding  @relation(fields: [holding_id], references: [id], onDelete: Cascade)

  @@index([holding_id])
  @@map("qc_holding_notes")
}

model InvestmentJournal {
  id               String                   @id @default(uuid())
  user_id          String                   @map("user_id")
  ticker           String
  portfolio_type   String                   @map("portfolio_type") @default("user") // "user" | "shadow"
  dimension        String
  sub_factors      Json                     @map("sub_factors")
  thesis           String
  conviction       Int
  scores_snapshot  Json?                    @map("scores_snapshot")
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt
  health           InvestmentJournalHealth?

  @@unique([user_id, ticker, portfolio_type])
  @@index([user_id])
  @@index([ticker])
  @@map("qc_investment_journals")
}

model InvestmentJournalHealth {
  id            String           @id @default(uuid())
  journal_id    String           @unique @map("journal_id")
  thesis_health String           @map("thesis_health")
  ai_nudge      String?          @map("ai_nudge")
  evaluated_at  DateTime         @default(now()) @map("evaluated_at")
  journal       InvestmentJournal @relation(fields: [journal_id], references: [id], onDelete: Cascade)

  @@index([journal_id])
  @@map("qc_investment_journal_health")
}

model MutualFundScheme {
  amfi_code      String   @id
  name           String
  isin           String?
  plan_type      String?
  option_type    String?
  nav            Float?
  nav_date       String?
  day_change     Float?
  day_change_pct Float?
  morningstar    Int?
  risk_label     String?
  expense_ratio  Float?
  aum            Float?
  family_name    String?
  family_id      Int?
  amc_name       String?
  amc_slug       String?
  category       String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  returns_1y     Float?
  returns_3y     Float?
  returns_5y     Float?

  @@index([amc_slug])
  @@index([category])
  @@index([family_id])
  @@map("mutual_fund_schemes")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  is_active   Boolean  @default(true) @map("is_active")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  prices      Price[]

  @@index([is_active])
  @@map("qc_products")
}

model Price {
  id               String             @id @default(uuid())
  product_id       String             @map("product_id")
  plan_type        SubscriptionPlan   @map("plan_type")
  amount           Int
  currency         String             @default("INR")
  interval_months  Int                @map("interval_months")
  razorpay_plan_id String?            @unique @map("razorpay_plan_id")
  is_active        Boolean            @default(true) @map("is_active")
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  product          Product            @relation(fields: [product_id], references: [id], onDelete: Cascade)
  subscriptions    UserSubscription[]

  @@index([product_id])
  @@index([plan_type])
  @@index([is_active])
  @@map("qc_prices")
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  discount_type  DiscountType @map("discount_type")
  discount_value Decimal      @map("discount_value") @db.Decimal(10, 2)
  max_uses       Int?         @map("max_uses")
  used_count     Int          @default(0) @map("used_count")
  expires_at     DateTime?    @map("expires_at")
  is_active      Boolean      @default(true) @map("is_active")
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  discounts      Discount[]

  @@index([code])
  @@index([is_active])
  @@map("qc_coupons")
}

model Discount {
  id         String   @id @default(uuid())
  coupon_id  String   @map("coupon_id")
  user_id    String   @map("user_id")
  applied_at DateTime @default(now()) @map("applied_at")
  coupon     Coupon   @relation(fields: [coupon_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([coupon_id, user_id])
  @@index([coupon_id])
  @@index([user_id])
  @@map("qc_discounts")
}

model PaymentMethod {
  id                   String            @id @default(uuid())
  user_id              String            @map("user_id")
  type                 PaymentMethodType
  razorpay_token_id    String?           @unique @map("razorpay_token_id")
  razorpay_customer_id String?           @map("razorpay_customer_id")
  last4                String?
  brand                String?
  is_default           Boolean           @default(false) @map("is_default")
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  user                 User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("qc_payment_methods")
}

model UserSubscription {
  id                       String             @id @default(uuid())
  user_id                  String             @unique @map("user_id")
  price_id                 String?            @map("price_id")
  plan_type                SubscriptionPlan   @map("plan_type")
  status                   SubscriptionStatus
  trial_starts_at          DateTime?          @map("trial_starts_at")
  trial_ends_at            DateTime?          @map("trial_ends_at")
  current_period_start     DateTime?          @map("current_period_start")
  current_period_end       DateTime?          @map("current_period_end")
  razorpay_subscription_id String?            @unique @map("razorpay_subscription_id")
  razorpay_customer_id     String?            @map("razorpay_customer_id")
  cancelled_at             DateTime?          @map("cancelled_at")
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt
  user                     User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  price                    Price?             @relation(fields: [price_id], references: [id])
  transactions             Transaction[]

  @@index([status])
  @@index([trial_ends_at])
  @@map("qc_user_subscriptions")
}

model Transaction {
  id                  String            @id @default(uuid())
  subscription_id     String?           @map("subscription_id")
  user_id             String            @map("user_id")
  razorpay_order_id   String?           @unique @map("razorpay_order_id")
  razorpay_payment_id String?           @unique @map("razorpay_payment_id")
  amount              Int
  currency            String            @default("INR")
  status              TransactionStatus
  failure_reason      String?           @map("failure_reason")
  metadata            Json?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt
  user                User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subscription        UserSubscription? @relation(fields: [subscription_id], references: [id])

  @@index([user_id])
  @@index([subscription_id])
  @@index([razorpay_order_id])
  @@index([status])
  @@map("qc_transactions")
}

// ─── Smallcase ────────────────────────────────────────────────────────────────

model SmallcaseUser {
  id                String              @id @default(uuid())
  user_id           String              @unique @map("user_id")
  smallcase_user_id String?             @map("smallcase_user_id")
  auth_token        String?             @map("auth_token")
  broker            String?
  broker_client_id  String?             @map("broker_client_id")
  is_connected      Boolean             @default(false) @map("is_connected")
  last_synced_at    DateTime?           @map("last_synced_at")
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  user              User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  holdings          SmallcaseHolding[]
  orders            SmallcaseOrder[]
  portfolio         SmallcasePortfolio?

  @@index([user_id])
  @@map("qc_smallcase_users")
}

model SmallcasePortfolio {
  id                String        @id @default(uuid())
  smallcase_user_id String        @unique @map("smallcase_user_id")
  total_value       Float         @default(0) @map("total_value")
  total_invested    Float         @default(0) @map("total_invested")
  total_pnl         Float         @default(0) @map("total_pnl")
  total_pnl_pct     Float         @default(0) @map("total_pnl_pct")
  synced_at         DateTime?     @map("synced_at")
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  smallcase_user    SmallcaseUser @relation(fields: [smallcase_user_id], references: [id], onDelete: Cascade)

  @@index([smallcase_user_id])
  @@map("qc_smallcase_portfolios")
}

model SmallcaseHolding {
  id                String        @id @default(uuid())
  smallcase_user_id String        @map("smallcase_user_id")
  ticker            String
  quantity          Float
  avg_price         Float         @map("avg_price")
  current_price     Float?        @map("current_price")
  current_value     Float?        @map("current_value")
  invested_value    Float         @map("invested_value")
  pnl               Float?
  pnl_pct           Float?        @map("pnl_pct")
  exchange          String?
  isin              String?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  smallcase_user    SmallcaseUser @relation(fields: [smallcase_user_id], references: [id], onDelete: Cascade)

  @@unique([smallcase_user_id, ticker])
  @@index([smallcase_user_id])
  @@index([ticker])
  @@map("qc_smallcase_holdings")
}

model SmallcaseOrder {
  id                String               @id @default(uuid())
  smallcase_user_id String               @map("smallcase_user_id")
  order_id          String               @unique @map("order_id")
  status            SmallcaseOrderStatus
  type              SmallcaseOrderType
  amount            Float?
  smallcase_name    String?              @map("smallcase_name")
  metadata          Json?
  placed_at         DateTime?            @map("placed_at")
  completed_at      DateTime?            @map("completed_at")
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt
  smallcase_user    SmallcaseUser        @relation(fields: [smallcase_user_id], references: [id], onDelete: Cascade)

  @@index([smallcase_user_id])
  @@index([status])
  @@index([placed_at])
  @@map("qc_smallcase_orders")
}

