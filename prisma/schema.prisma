/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model kv_store_abda8bef {
  key   String @id
  value Json

  @@index([key])
  @@index([key], map: "kv_store_abda8bef_key_idx1")
  @@index([key], map: "kv_store_abda8bef_key_idx2")
  @@index([key], map: "kv_store_abda8bef_key_idx3")
