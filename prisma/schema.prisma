  data_flags          Json?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@unique([week_date, ticker])
  @@index([week_date])
  @@index([ticker])
  @@index([basic_industry])
  @@index([week_date, basic_industry])
  @@map("iit_weekly_stock_scores")
