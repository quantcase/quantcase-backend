// Per-candidate-URL metadata captured during discovery resolution (the resolver
// already downloads + parses every PDF, so page count / size are free there).
// Keyed by the URL itself so the admin listing can join it and filter.
// status: 'resolved' (downloaded + is a PDF), 'pending' (404/timeout — BSE
// propagation delay, retry later), 'non_pdf' (downloaded but not a PDF).
model BseUrlMeta {
  url        String   @id
  page_count Int?
  file_size  Int?
  status     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@map("bse_url_meta")
}

// Soft-delete for discovery candidates. A URL listed here is hidden from the
// admin discovery listing (unless showDismissed=true). Restorable by deleting
// the row (POST /admin/bse-discovery/undismiss).
model BseDismissedUrl {
  url          String   @id
  reason       String?
  dismissed_at DateTime @default(now())

  @@map("bse_dismissed_urls")
}

// ─── Scheduler ───────────────────────────────────────────────────────────────

model SchedulerJob {
  id              String         @id @default(uuid())
  slug            String         @unique
  name            String
  description     String?
  job_type        String
  cron_expression String
  is_active       Boolean        @default(true)
  config          Json           @default("{}")
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  runs            SchedulerRun[]

  @@map("scheduler_jobs")
}

model SchedulerRun {
  id                String       @id @default(uuid())
  job_id            String
  job               SchedulerJob @relation(fields: [job_id], references: [id])
  status            String
  started_at        DateTime
  ended_at          DateTime?
  records_processed Int?
  error             String?
  metadata          Json?

  @@index([job_id, started_at])
  @@map("scheduler_runs")
}

// Reusable, named ticker sets selectable across L1/L2/L3 admin dispatch flows.
// filter_type 'manual' → filter_config: { tickers: string[] }.
// filter_type 'dynamic' → filter_config combines any of: coverage, pendingExtraction,
// marketCap, industries — resolved fresh every time the group is used (see
// services/companyGroups/resolver.js).
model CompanyGroup {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  filter_type   String
  filter_config Json     @default("{}")
  // Which HtmlIncrementalSkillConfig.key (e.g. "t1"/"t2"/"t3") every ticker in
  // this group should run with — a plain string, not an FK, since configs are
  // saved per-skill but this pairing is skill-agnostic (the same key
  // convention is expected across skills). Resolved automatically at run time
  // for any ticker whose configKey wasn't passed explicitly — see
  // resolveConfigKeyForTicker in services/companyGroups/resolver.js. A ticker
  // that resolves to no config_key at all (not covered by any config-mapped
  // group, and no explicit configKey given) blocks the run with a 400 rather
  // than silently falling back to the skill's own top-level fields.
  config_key    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("company_groups")
}

// ─── Curated Screens ──────────────────────────────────────────────────────────
//
// Precomputed screener cards for the investor dashboard (GET /api/discover/screens)
// and the screener pages. The live screeners in controllers/baskets.controller.js
// derive their results from the full universe at request time (~11-13s per screen,
// ~40s+ for the dashboard's three cards) because each run pulls 5 years x 76 KPIs
// x ~2900 companies out of prowess_values_new to compute what the UI renders as a
// count and a list of names. Screen membership only changes when fundamentals are
// refreshed (quarterly), so it is stored here instead and served as an indexed read.
//
// Seeded by prisma/seedScreens.js; intended to be maintained via admin APIs later.

model Screen {
  id          String    @id @default(uuid())
  slug        String    @unique // stable id used by the FE (e.g. 'quality-compounders')
  basketId    String?   @map("basket_id") // source screener in baskets.controller.js, if derived from one
  category    String?
  icon        String? // FE icon key (e.g. 'activity')
  badgeKind   String?   @map("badge_kind") // 'warning' | 'new' | 'info'
  title       String
  description String?
  conditions  String? // human-readable screen criteria
  href        String?
  sortOrder   Int       @default(0) @map("sort_order") // display order on the dashboard
  isActive    Boolean   @default(true) @map("is_active")
  computedAt  DateTime? @map("computed_at") // when the ticker list was last refreshed
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tickers ScreenTicker[]

  @@index([isActive, sortOrder])
  @@map("qc_screens")
}

model ScreenTicker {
  id            String   @id @default(uuid())
  screenId      String   @map("screen_id")
  ticker        String // NSE symbol, uppercase
  companyName   String?  @map("company_name")
  // Denormalised display/stat fields so a card or table renders from one query.
  marketCapCr   Float?   @map("market_cap_cr")
  pe            Float?
  qcScore       Float?   @map("qc_score") // latest iit_weekly_stock_scores.composite_score
  basicIndustry String?  @map("basic_industry") // powers the "IN YOUR SECTORS" stat
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@unique([screenId, ticker])
  @@index([screenId])
  @@index([ticker])
  @@map("qc_screen_tickers")
}

// Admin config for which metrics/rows/series/columns a given API response
// section shows, in what order, with what precision — decoupled from
// KpiGroup (which stays the KPI display-hierarchy tool, kpi_type roots +
// statement tree). Intentionally its own mechanism, not bolted onto KpiGroup,
// since this is meant to eventually cover config for any controller's
// response shape, not just KPI grouping specifically.
// One ScreenConfig per screen table/chart-group/column-set (e.g.
// "financials.pnl.annual", "charts.pe-ratio", "peers.columns"); one
// ScreenConfigItem per row/series/column within it. A ScreenConfig can also
// be a company-group-scoped *variant* of another one (variant_of_key +
// company_group_slug below) -- e.g. a BFSI-specific P&L table with its own
// rows -- fully admin-visible/editable, not a silent per-row formula swap.
model ScreenConfig {
  id                 String             @id @default(uuid())
  // Stable identifier code refers to directly.
  key                String             @unique
  label              String
  // Free-text note of which endpoint/controller this powers — admin
  // browsing only, not read by any resolution logic.
  endpoint           String?
  // Null = show all available periods (today's unconditional behavior).
  periods_shown      Int?
  decimal_places     Int                @default(2)
  // Which KpiGroup branch populates this section's rows (e.g.
  // "pnl-statement--annual") -- its direct children become top-level rows,
  // and any of THEIR children (e.g. Fixed Assets' component assets) become
  // nested rows. Plain string ref to KpiGroup.slug, not an FK -- same
  // convention as kpi_abbr/company_group_slug elsewhere. Null = section has
  // no rows (or, for chart/peer configs, isn't row-based at all -- those
  // keep using `items` below, untouched).
  kpi_group_slug     String?
  // Which cadence every Kpi in this section resolves at — the resolver no
  // longer defaults or infers a frequency (a Kpi's own definition never pins
  // one), so every screener section must declare it explicitly here instead
  // of the frequency being a hardcoded literal in lib/financials.js/
  // prowess.controller.js. Nullable only during the backfill migration —
  // every row must have one before this is tightened to required.
  frequency          KpiFrequency?
  // Company-group-scoped alternate of another ScreenConfig — e.g. a BFSI-only
  // version of "financials.pnl.quarterly" with its own kpi_group_slug tree.
  // When set, `company_group_slug` must be set too (and vice versa). Plain
  // string ref to another ScreenConfig.key, not an FK -- same convention as
  // kpi_abbr/company_group_slug elsewhere. Resolved by
  // lib/financials.js#_resolveScreenConfig: for a given base key, any
  // ScreenConfig with variant_of_key == that key is preferred over the base
  // when the company being rendered belongs to company_group_slug. Null for
  // every ordinary (non-variant) ScreenConfig, including every base config a
  // variant points at.
  variant_of_key     String?
  // Which CompanyGroup.slug this variant applies to (e.g. "bfsi"). Plain
  // string ref, not an FK -- same convention as KpiGroup/KpiRelationship.
  company_group_slug String?
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  items              ScreenConfigItem[]

  @@index([variant_of_key])
  @@map("screen_configs")
}

model ScreenConfigItem {
  id                 String       @id @default(uuid())
  screen_config_id   String
  screen_config      ScreenConfig @relation(fields: [screen_config_id], references: [id], onDelete: Cascade)
  // Which Kpi this row/series/column represents. Plain string ref, not a DB
  // relation — matches KpiGroup/KpiRelationship's existing convention.
  kpi_abbr           String
  // Override label; null = use Kpi.full_form.
  label              String?
  display_order      Int          @default(0)
  highlight          Boolean      @default(false)
  expandable         Boolean      @default(false)
  // Overrides the parent ScreenConfig's decimal_places.
  decimal_places     Int?
  // Optional — only include this row for companies in this group (same
  // mechanism KpiGroup/variant_for_group already use), e.g. a BFSI-only
  // "Provisions" row in the balance sheet. Plain string ref to
  // CompanyGroup.slug, not an FK.
  company_group_slug String?
  // 'line' | 'bar' — only meaningful for chart-shaped ScreenConfigs
  // (financials tables ignore this). Default 'line' matches every ratio
  // series (PE, GPM/OPM/NPM, EV/EBITDA, P/B, Mcap/Sales); a chart's backdrop
  // metric (Quarter Sales, Enterprise Value, Stock Price, Market Cap) is
  // seeded as 'bar'.
  series_type        String       @default("line")

  @@unique([screen_config_id, kpi_abbr])
  @@index([screen_config_id])
  @@map("screen_config_items")
}

model TierClassification {
  id      String @id @default(uuid())
  company String @unique
  tier    String // e.g. 'Tier 1', 'Tier 2', 'Tier 3'

  @@map("tier_classification")
}
