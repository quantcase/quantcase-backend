model Watchlist {
  id             String           @id @default(uuid())
  user_id        String
  name           String
  total_assets   Int              @default(0) @map("total_assets")
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  assets         WatchlistAsset[]

  @@index([user_id])
  @@map("watchlists")
}

model WatchlistAsset {
  id           String    @id @default(uuid())
  watchlist_id String
  symbol       String
  added_on     DateTime  @default(now())
  notes        String?
  watchlist    Watchlist @relation(fields: [watchlist_id], references: [id], onDelete: Cascade)

  @@unique([watchlist_id, symbol])
  @@index([watchlist_id])
  @@index([symbol])
  @@map("watchlist_assets")
}

// ─── Auth: Users, Teams ────────────────────────────────────────────────────────

enum AccountType {
  manager
  investor
}

model User {
  id              String      @id @default(uuid())
  email           String?     @unique
  mobile          String?     @unique
  password_hash   String?     @map("password_hash")
  google_id       String?     @unique @map("google_id")
  display_name    String?     @map("display_name")
  display_picture String?     @map("display_picture")
  account_type    AccountType @map("account_type")
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  team_memberships  TeamMember[]
  user_portfolios   UserPortfolio[]
  shadow_portfolios ShadowPortfolio[]

  @@index([email])
  @@index([mobile])
  @@index([google_id])
  @@map("qc_users")
}

model Team {
  id         String       @id @default(uuid())
  name       String
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  members    TeamMember[]

  @@map("qc_teams")
}

model TeamMember {
  id         String   @id @default(uuid())
  team_id    String
  user_id    String
  created_at DateTime @default(now())

  team       Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@index([team_id])
  @@index([user_id])
  @@map("qc_team_members")
}

// ─── Portfolio & Shadow Portfolio ─────────────────────────────────────────────

model UserPortfolio {
  id         String    @id @default(uuid())
  user_id    String    @unique @map("user_id")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  holdings Holding[]

  @@map("qc_user_portfolios")
}

model ShadowPortfolio {
  id         String    @id @default(uuid())
  user_id    String    @unique @map("user_id")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  holdings Holding[]

  @@map("qc_shadow_portfolios")
}

model Holding {
  id                  String   @id @default(uuid())
  ticker              String
  amount_invested     Float    @map("amount_invested")
  invested_at         DateTime @map("invested_at")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  user_portfolio_id   String?  @map("user_portfolio_id")
  shadow_portfolio_id String?  @map("shadow_portfolio_id")

  user_portfolio   UserPortfolio?   @relation(fields: [user_portfolio_id], references: [id], onDelete: Cascade)
  shadow_portfolio ShadowPortfolio? @relation(fields: [shadow_portfolio_id], references: [id], onDelete: Cascade)
  notes            HoldingNote[]

  @@index([user_portfolio_id])
  @@index([shadow_portfolio_id])
  @@index([ticker])
  @@map("qc_holdings")
}

model HoldingNote {
  id         String   @id @default(uuid())
  holding_id String   @map("holding_id")
  note_text  String   @map("note_text")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  holding    Holding  @relation(fields: [holding_id], references: [id], onDelete: Cascade)

  @@index([holding_id])
  @@map("qc_holding_notes")
}

// ─── Mutual Funds ─────────────────────────────────────────────────────────────

model MutualFundScheme {
  amfi_code      String   @id
  name           String
  isin           String?
  plan_type      String?
  option_type    String?
  nav            Float?
  nav_date       String?
  day_change     Float?
  day_change_pct Float?
  morningstar    Int?
  risk_label     String?
  expense_ratio  Float?
  aum            Float?
  family_name    String?
  family_id      Int?
  amc_name       String?
  amc_slug       String?
  category       String?
  returns_1y     Float?
  returns_3y     Float?
  returns_5y     Float?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([amc_slug])
  @@index([category])
  @@index([family_id])
  @@map("mutual_fund_schemes")
}

// ─── Skills & Plugins ────────────────────────────────────────────────────────

enum PluginCategory {
  management
  deal
  opportunity
  wealthos
  technicals
  private_equity
  fundamentals
}

model Skill {
  id                  String        @id @default(uuid())
  name                String        @unique
  slug                String?       @unique
  description         String?
  promptKey           String        @map("prompt_key")
  promptTemplate      String?       @map("prompt_template")        // Static instructional portion of the prompt — editable without code deploys
  defaultInstructions String?       @map("default_instructions")   // DEFAULT_INSTRUCTIONS text injected at {{DEFAULT_INSTRUCTIONS}} in the template
  model               String        @default("anthropic/claude-haiku-4.5")
  maxTokens           Int           @default(16000) @map("max_tokens")
  outputSchema        Json?         @map("output_schema")
  isActive            Boolean       @default(true) @map("is_active")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  pluginSkills        PluginSkill[]

  @@index([name])
  @@map("skills")
}

model Plugin {
  id           String         @id @default(uuid())
  name         String         @unique
  slug         String?        @unique
  description  String?
  category     PluginCategory
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  pluginSkills PluginSkill[]

  @@index([category])
  @@map("plugins")
}

model PluginSkill {
  id       String @id @default(uuid())
  pluginId String @map("plugin_id")
  skillId  String @map("skill_id")
  order    Int
  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId],  references: [id], onDelete: Cascade)

  @@unique([pluginId, skillId])
  @@unique([pluginId, order])
  @@index([pluginId])
  @@index([skillId])
  @@map("plugin_skills")
}

// ─── 3-Layer Analysis Pipeline ───────────────────────────────────────────────

enum SignalSourceType {
  transcript
  qe
  management
  ofactor
  prowess
}

// Controlled vocabularies for signal classification
// signal_type: what kind of signal this is
//   kpi            — numeric financial/operational KPI (REV_OP, EPS, P_E, etc.)
//   governance     — board/disclosure quality flag (transparent, defensive_language, …)
//   entity         — named entity extracted from text (person, segment, geography)
//   milestone      — forward-looking target or past achievement
//   industry       — industry-level demand/supply/margin signal
//   customer       — customer-traction signal (growth, churn, ARPU, …)
//   financial_health — qualitative financial-strength driver (FCF quality, leverage, …)
//   tone           — overall management tone signal
//   ofactor_section — opportunity factor section score
//   management_score — management quality score
//
// metric_family: broad category for lens composition
//   profitability | growth | governance | customer | capital | industry | qualitative | milestone | ofactor

model ExtractedSignal {
  id              String          @id @default(uuid())
  call_id         String
  ticker          String
  company         String
  fiscal_year     String?
  quarter         String?
  call_date       String?
  source_type     SignalSourceType
  signal_type     String          // controlled vocab — see comment above
  metric          String          // e.g. "REV_OP", "transparent", "churn_rate", "tone"
  value           Float?          // numeric value (null for qualitative-only)
  raw_value       String?         // original text / stringified number from LLM
  unit            String?
  multiplier      Float           @default(1)
  w               Float           @default(1.0)
  b               Float           @default(0.0)
  confidence      Float?          // 0.0–1.0
  time_horizon    String?         // "short" | "medium" | "long"
  esg_tag         String?
  risk_tag        String?
  sector          String?
  metric_family   String?         // controlled vocab — see comment above
  impact          String?         // "high" | "medium" | "low" — LLM-assigned, cross-signal comparable
  severity        String?         // "critical" | "high" | "medium" | "low" | "informational"
  source_hash     String          // SHA-256 of source document; gates L1 re-runs
  prompt_v        String          // skillSlug@updatedAt — invalidated when prompt changes
  schema_v        String          @default("2.0.0")
  extractor_model String
  lineage_id      String          // groups all signals from one extraction run
  statement       String?         // evidence quote from source
  start_date      String?
  end_date        String?
  period_type     String?
  is_invalidated  Boolean         @default(false)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  @@unique([call_id, signal_type, metric, source_hash, prompt_v, start_date])
  @@index([ticker])
  @@index([call_id])
  @@index([ticker, metric_family])
  @@index([source_hash])
  // Partial indexes covering the is_invalidated=false hot path (100% of active rows)
  @@index([call_id, signal_type], map: "extracted_signals_call_id_type_active_idx")
  @@index([ticker, signal_type], map: "extracted_signals_ticker_type_active_idx")
  @@map("extracted_signals")
}

model LensConfig {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  category    String?  // "management" | "opportunity" | "deal" — groups lenses into insight types
  is_active   Boolean  @default(true)
  version     String   @default("1.0.0")
  config      Json     // { signal_filters: { signal_types, metric_family, source_types }, weights: [{ metric, w, b }], aggregation: "weighted_sum" }
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@map("lens_configs")
}

model LensScore {
  id               String   @id @default(uuid())
  call_id          String
  ticker           String
  lens_slug        String
  z_score          Float
  confidence_lo    Float?
  confidence_hi    Float?
  signal_count     Int
  lens_config_v    String   // LensConfig.version at compute time
  signals_snapshot Json     // [{ signal_id, metric, value, w, b, contribution }]
  lens_data        Json?    // Full structured output from L2 LLM call {score, status, takeaway, key_metrics, highlights, risks}
  signals_hash     String?  // SHA-256 of signal IDs+values; L2 LLM cache key
  is_stale         Boolean  @default(false)
  computed_at      DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([call_id, lens_slug])
  @@index([ticker, lens_slug])
  @@index([call_id])
  // Partial indexes for is_stale=false hot path (~89% of rows)
  @@index([ticker, lens_slug], map: "lens_scores_ticker_slug_active_idx")
  @@index([call_id], map: "lens_scores_call_id_active_idx")
  @@map("lens_scores")
}
