/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model earnings_calls_test {
  id                    String    @id(map: "earnings_calls_pkey")
  company               String
  fiscal_year           String?
  quarter               String?
  call_date             String?
  transcript_url        String?
  transcript_text       String?
  ppt_url               String?
  ppt_text              String?
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
  quarterly_result      String?
  quarterly_result_url  String?
  quarterly_result_text String?
  updated_ppt_text      String?

  @@index([company, fiscal_year, quarter], map: "idx_company_fy_quarter")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model kv_store_abda8bef {
  key   String @id
  value Json

  @@index([key])
  @@index([key], map: "kv_store_abda8bef_key_idx1")
  @@index([key], map: "kv_store_abda8bef_key_idx2")
  @@index([key], map: "kv_store_abda8bef_key_idx3")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model nse_equity {
  id       Int       @id(map: "nse_daily_data_pkey") @default(autoincrement())
  symbol   String?
  datetime DateTime? @db.Timestamp(6)
  open     Float?
  high     Float?
  low      Float?
  close    Float?
  volume   BigInt?

  @@unique([symbol, datetime], map: "unique_symbol_datetime")
}

model nse_index {
  id       Int       @id @default(autoincrement())
  sector   String?
  datetime DateTime? @db.Date
  open     Decimal?  @db.Decimal
  high     Decimal?  @db.Decimal
  low      Decimal?  @db.Decimal
  close    Decimal?  @db.Decimal
  volume   BigInt?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  email      String?
  password   String?
  role       String?
}

model Job {
  id           String   @id @default(uuid())
  callId       String   @map("call_id")
  type         String
  status       String   @default("pending")
  result       Json?
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  bullmqId     String?  @unique @map("bullmq_id")
  llm_response String?  @map("llm_response")
  prompt       String?

  @@index([callId])
  @@index([status])
  @@map("jobs")
}

model Summary {
  id                String   @id @default(uuid())
  callId            String   @unique @map("call_id")
  entities          Json?
  milestones        Json?
  governanceSignals Json?    @map("governance_signals")
  confidence        String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  riskDisclosures   Json?    @map("risk_disclosures")
  tone              String?
  industryAnalysis  Json?    @map("industry_analysis")
  kpis              Json?

  @@index([callId])
  @@map("summaries")
}

model SummaryNew {
  id                String   @id @default(uuid())
  callId            String   @unique @map("call_id")
  kpis              Json?
  entities          Json?
  milestones        Json?
  riskDisclosures   Json?    @map("risk_disclosures")
  governanceSignals Json?    @map("governance_signals")
  industryAnalysis  Json?    @map("industry_analysis")
  financialStrength Json?    @map("financial_strength")
  clientTraction    Json?    @map("client_traction")
  tone              String?
  confidence        String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([callId])
  @@map("summary_new")
}

model Kpi {
  id           String            @id @default(uuid())
  abbr         String            @unique
  full_form    String
  denomination DenominationType?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  industry     String[]          @default([])
  source       KpiSource
  kpi_type     KpiTypeCategory?

  @@index([abbr])
  @@index([source])
  @@map("kpis")
}

model market_cap {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date          DateTime? @db.Date
  symbol        String?
  market_cap_cr Float?    @map("market_cap(Cr)")
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  market_cap    BigInt?
}

model pe_data {
  id         BigInt    @id @default(autoincrement())
  company    String
  date       DateTime  @db.Date
  pe         Decimal?  @db.Decimal
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([company, date])
  @@index([company])
}

model SubstituteKpi {
  id             String   @id @default(uuid())
  primaryKpiAbbr String   @unique @map("primary_kpi_abbr")
  substitutes    String[]
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([primaryKpiAbbr])
  @@map("substitute_kpis")
}

model OFactorResult {
  id            String   @id @default(uuid())
  callId        String   @unique @map("call_id")
  subjectTicker String   @map("subject_ticker")
  peerTickers   String[] @map("peer_tickers")
  result        Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([callId])
  @@index([subjectTicker])
  @@map("ofactor_results")
}

model DealResult {
  id        String   @id @default(uuid())
  callId    String   @unique @map("call_id")
  ticker    String
  result    Json
  inputs    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([callId])
  @@index([ticker])
  @@map("deal_results")
}

model KpiValue {
  id          String    @id @default(uuid())
  callId      String    @map("call_id")
  company     String
  fiscal_year String?
  quarter     String?
  call_date   String?
  kpi_abbr    String
  value       Float?
  raw_value   String?   @map("raw_value")
  unit        String?
  multiplier  Int       @default(1)
  source      KpiSource
  source_path String    @default("")
  statement   String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  end_date    String?   @map("end_date")
  start_date  String?   @map("start_date")
  period_type String?   @map("period_type")

  @@unique([callId, kpi_abbr], map: "kpi_values_call_kpi_unique")
  @@index([callId])
  @@index([company, fiscal_year, quarter])
  @@index([company, kpi_abbr])
  @@index([kpi_abbr])
  @@index([kpi_abbr, period_type])
  @@map("kpi_values")
}

model ProwessValueNew {
  id          String    @default(uuid())
  callId      String    @map("call_id")
  company     String
  fiscal_year String?
  quarter     String?
  call_date   String?
  kpi_abbr    String
  value       Float?
  raw_value   String?   @map("raw_value")
  unit        String?
  multiplier  Int       @default(1)
  source      KpiSource
  source_path String    @default("")
  statement   String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  end_date    String?   @map("end_date")
  start_date  String?   @map("start_date")
  period_type String?   @map("period_type")

  @@unique([callId, kpi_abbr], map: "pnv_call_kpi_unique")
  @@index([callId], map: "idx_pnv_call_id")
  @@index([company, fiscal_year, quarter], map: "idx_pnv_company_fy_q")
  @@index([company, kpi_abbr], map: "idx_pnv_company_kpi")
  @@index([kpi_abbr], map: "idx_pnv_kpi")
  @@index([kpi_abbr, period_type], map: "idx_pnv_kpi_period")
  @@map("prowess_values_new")
}

model MilestoneKpiTarget {
  id             String   @id @default(uuid())
  callId         String   @map("call_id")
  company        String
  fiscal_year    String?
  quarter        String?
  call_date      String?
  category       String
  kpi_abbr       String
  statement      String?
  current_value  Float?   @map("current_value")
  targeted_value Float?   @map("targeted_value")
  initial_time      String?  @map("initial_time")
  target_time       String?  @map("target_time")
  cumulative_period Int?     @map("cumulative_period")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  multiplier        Int      @default(1)
  currency          String?  @map("currency")

  @@index([callId])
  @@index([company, kpi_abbr])
  @@index([kpi_abbr])
  @@map("milestone_kpi_targets")
}

model WealthRmUser {
  id                String              @id @default(uuid())
  name              String
  email             String?             @unique
  team              String?
  performance_score Float               @default(0)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  actions           WealthAction[]
  clients           WealthClient[]
  interactions      WealthInteraction[]

  @@index([team])
  @@map("wealth_rm_users")
}

model WealthClient {
  id                String                     @id @default(uuid())
  name              String
  email             String?
  phone             String?
  rm_id             String?
  segment           WealthClientSegment
  risk_profile      WealthRiskProfile
  engagement_score  Float                      @default(0)
  churn_probability Float                      @default(0)
  last_contact_at   DateTime?
  metadata          Json?
  created_at        DateTime                   @default(now())
  updated_at        DateTime                   @updatedAt
  actions           WealthAction[]
  model_mappings    WealthClientModelMapping[]
  rm                WealthRmUser?              @relation(fields: [rm_id], references: [id])
  feature_store     WealthFeatureStore[]
  interactions      WealthInteraction[]
  portfolio         WealthPortfolio?
  suggestions       WealthSuggestion[]

  @@index([rm_id])
  @@index([segment])
  @@index([churn_probability])
  @@index([last_contact_at])
  @@map("wealth_clients")
}

model WealthPortfolio {
  id                  String       @id @default(uuid())
  client_id           String       @unique
  total_value         Float        @default(0)
  risk_score          Float        @default(0)
  last_rebalance_date DateTime?
  holdings            Json?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt
  client              WealthClient @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
  @@map("wealth_portfolios")
}

model WealthInteraction {
  id         String                @id @default(uuid())
  client_id  String
  rm_id      String?
  type       WealthInteractionType
  summary    String?
  sentiment  String?
  timestamp  DateTime              @default(now())
  metadata   Json?
  created_at DateTime              @default(now())
  client     WealthClient          @relation(fields: [client_id], references: [id], onDelete: Cascade)
  rm         WealthRmUser?         @relation(fields: [rm_id], references: [id])

  @@index([client_id])
  @@index([rm_id])
  @@index([timestamp])
  @@map("wealth_interactions")
}

model WealthSuggestion {
  id               String                   @id @default(uuid())
  client_id        String
  priority         WealthSuggestionPriority @default(MEDIUM)
  reason           String?
  suggested_action String?
  message          String?
  talking_points   Json?
  status           WealthSuggestionStatus   @default(pending)
  score            Float                    @default(0)
  job_id           String?
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt
  actions          WealthAction[]
  client           WealthClient             @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
  @@index([status])
  @@index([priority])
  @@index([score])
  @@map("wealth_suggestions")
}

model WealthAction {
  id            String            @id @default(uuid())
  suggestion_id String?
  client_id     String
  rm_id         String?
  action_type   String
  content       String?
  outcome       String?
  created_at    DateTime          @default(now())
  client        WealthClient      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  rm            WealthRmUser?     @relation(fields: [rm_id], references: [id])
  suggestion    WealthSuggestion? @relation(fields: [suggestion_id], references: [id])

  @@index([client_id])
  @@index([rm_id])
  @@index([suggestion_id])
  @@map("wealth_actions")
}

model WealthApprovedModel {
  id              String                     @id @default(uuid())
  name            String
  description     String?
  model_type      WealthModelType
  data            Json?
  created_at      DateTime                   @default(now())
  updated_at      DateTime                   @updatedAt
  client_mappings WealthClientModelMapping[]

  @@index([model_type])
  @@map("wealth_approved_models")
}

model WealthClientModelMapping {
  id          String              @id @default(uuid())
  client_id   String
  model_id    String
  assigned_at DateTime            @default(now())
  client      WealthClient        @relation(fields: [client_id], references: [id], onDelete: Cascade)
  model       WealthApprovedModel @relation(fields: [model_id], references: [id], onDelete: Cascade)

  @@unique([client_id, model_id])
  @@index([client_id])
  @@index([model_id])
  @@map("wealth_client_model_mappings")
}

model WealthAuditLog {
  id           String   @id @default(uuid())
  entity_type  String
  entity_id    String
  action       String
  performed_by String?
  timestamp    DateTime @default(now())
  payload      Json?

  @@index([entity_type, entity_id])
  @@index([performed_by])
  @@index([timestamp])
  @@map("wealth_audit_logs")
}

model WealthFeatureStore {
  id           String       @id @default(uuid())
  client_id    String
  feature_name String
  value        Float
  updated_at   DateTime     @updatedAt
  client       WealthClient @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([client_id, feature_name])
  @@index([client_id])
  @@index([feature_name])
  @@map("wealth_feature_store")
}

model investor_presentations_ppt {
  id             String    @id
  company        String?
  fiscal_year    String?
  quarter        String?
  call_date      String?
  ppt_url        String?
  ppt_text       String?
  basic_industry String?
  company_name   String?
  created_at     DateTime? @db.Timestamp(6)
  updated_at     DateTime? @db.Timestamp(6)
}

model prowess_kpi_values {
  id          String
  call_id     String
  company     String
  fiscal_year String?
  quarter     String?
  call_date   String?
  kpi_abbr    String
  value       Float?
  raw_value   String?
  unit        String?
  multiplier  Int       @default(1)
  source      KpiSource
  source_path String    @default("")
  statement   String?
  created_at  DateTime  @default(now())
  updated_at  DateTime
  end_date    String?
  start_date  String?
  period_type String?

  @@unique([call_id, kpi_abbr], map: "prowess_kv_call_kpi_unique")
  @@index([call_id], map: "idx_pkv_call_id")
  @@index([company, fiscal_year, quarter], map: "idx_pkv_company_fy_q")
  @@index([company, kpi_abbr], map: "idx_pkv_company_kpi")
  @@index([kpi_abbr], map: "idx_pkv_kpi")
  @@index([kpi_abbr, period_type], map: "idx_pkv_kpi_period")
}

enum DenominationType {
  rupee
  percentage
  ratio
  other
}

enum KpiSource {
  transcript
  QE
}

enum KpiTypeCategory {
  assets
  liabilities
  equity
  revenue
  cogs
  operating_expenses
  profit_lines
  cashflow
  customer_kpis
  industry_specific
}

enum WealthClientSegment {
  HNI
  UHNI
  Retail
  Institutional
  Private
}

enum WealthRiskProfile {
  conservative
  moderate
  aggressive
}

enum WealthInteractionType {
  call
  email
  whatsapp
  meeting
  sms
}

enum WealthSuggestionPriority {
  HIGH
  MEDIUM
  LOW
}

enum WealthSuggestionStatus {
  pending
  used
  ignored
}

enum WealthModelType {
  equity
  debt
  hybrid
  structured
  pms
  aif
}

model AiInsight {
  id         String   @id @default(uuid())
  ticker     String
  type       String                        // e.g. "technicals", "financials", "peers"
  insight    Json                          // raw LLM output, stored as-is for frontend rendering
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([ticker, type])
  @@map("ai_insights")
  @@index([ticker])
  @@index([type])
}

// ─── Watchlists ──────────────────────────────────────────────────────────────

model Watchlist {
  id             String           @id @default(uuid())
  user_id        String
  name           String
  total_assets   Int              @default(0) @map("total_assets")
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  assets         WatchlistAsset[]

  @@index([user_id])
  @@map("watchlists")
}

model WatchlistAsset {
  id           String    @id @default(uuid())
  watchlist_id String
  symbol       String
  added_on     DateTime  @default(now())
  notes        String?
  watchlist    Watchlist @relation(fields: [watchlist_id], references: [id], onDelete: Cascade)

  @@unique([watchlist_id, symbol])
  @@index([watchlist_id])
  @@index([symbol])
  @@map("watchlist_assets")
}

// ─── Skills & Plugins ────────────────────────────────────────────────────────

enum PluginCategory {
  management
  deal
  opportunity
  wealthos
  technicals
}

model Skill {
  id                  String        @id @default(uuid())
  name                String        @unique
  slug                String?       @unique
  description         String?
  promptKey           String        @map("prompt_key")
  promptTemplate      String?       @map("prompt_template")        // Static instructional portion of the prompt — editable without code deploys
  defaultInstructions String?       @map("default_instructions")   // DEFAULT_INSTRUCTIONS text injected at {{DEFAULT_INSTRUCTIONS}} in the template
  model               String        @default("anthropic/claude-sonnet-4-6")
  maxTokens           Int           @default(16000) @map("max_tokens")
  outputSchema        Json?         @map("output_schema")
  isActive            Boolean       @default(true) @map("is_active")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  pluginSkills        PluginSkill[]

  @@index([name])
  @@map("skills")
}

model Plugin {
  id           String         @id @default(uuid())
  name         String         @unique
  slug         String?        @unique
  description  String?
  category     PluginCategory
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  pluginSkills PluginSkill[]

  @@index([category])
  @@map("plugins")
}

model PluginSkill {
  id       String @id @default(uuid())
  pluginId String @map("plugin_id")
  skillId  String @map("skill_id")
  order    Int
  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId],  references: [id], onDelete: Cascade)

  @@unique([pluginId, skillId])
  @@unique([pluginId, order])
  @@index([pluginId])
  @@index([skillId])
  @@map("plugin_skills")
}
