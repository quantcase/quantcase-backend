// ─── Unified Journal ──────────────────────────────────────────────────────────
// A journal is a named container that tracks multiple tickers (like a watchlist).
// Each ticker holds multiple timestamped entries; an entry is either a plain note
// or a full thesis (dimension + conviction + AI health evaluation). Every user gets
// 2 auto-provisioned defaults ("Holdings", "Tracking"); the Holdings journal
// auto-populates (add-only) from all holdings sources.

model Journal {
  id           String          @id @default(uuid())
  user_id      String          @map("user_id")
  name         String
  kind         String          @default("custom") // "holdings" | "tracking" | "custom"
  is_default   Boolean         @default(false) @map("is_default")
  default_kind String?         @map("default_kind") // "holdings"/"tracking" for defaults, NULL for custom
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  user         User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tickers      JournalTicker[]

  // NULL is distinct in Postgres → one holdings + one tracking default per user,
  // while custom journals (default_kind NULL) never collide.
  @@unique([user_id, default_kind])
  @@index([user_id])
  @@map("qc_journals")
}

model JournalTicker {
