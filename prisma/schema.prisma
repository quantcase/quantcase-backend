/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model nse_equity {
  id            Int       @id(map: "nse_daily_data_pkey") @default(autoincrement())
  symbol        String?
  datetime      DateTime? @db.Timestamp(6)
  open          Float?
  high          Float?
  low           Float?
  close         Float?
  volume        BigInt?
  pe            Float?
  market_cap_cr Float?

  @@unique([symbol, datetime], map: "unique_symbol_datetime")
  @@index([symbol])
}

model nse_equity_new {
  symbol        String   @db.VarChar
  company_name  String   @db.VarChar
  datetime      DateTime @db.Date
  open          Float?
  high          Float?
  low           Float?
  close         Float?
  volume        Int?
  pe            Float?
  eps           Float?
  market_cap_cr Float?

  @@id([symbol, datetime])
  @@map("nse_equity_new")
}

model nse_index {
  id       Int       @id @default(autoincrement())
  sector   String?
  datetime DateTime? @db.Date
  open     Decimal?  @db.Decimal
  high     Decimal?  @db.Decimal
  low      Decimal?  @db.Decimal
  close    Decimal?  @db.Decimal
  volume   BigInt?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  created_at DateTime @default(now()) @db.Timestamptz(6)
  email      String?
  password   String?
  role       String?
  id         BigInt   @id @default(autoincrement())
}

model Job {
  id           String   @id @default(uuid())
  callId       String   @map("call_id")
  type         String
  status       String   @default("pending")
  result       Json?
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  bullmqId     String?  @unique @map("bullmq_id")
  llm_response String?  @map("llm_response")
  prompt       String?

  @@index([callId])
  @@index([status])
  @@map("jobs")
}

model Summary {
  id                String   @id @default(uuid())
  callId            String   @unique @map("call_id")
  entities          Json?
  milestones        Json?
  governanceSignals Json?    @map("governance_signals")
  confidence        String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  riskDisclosures   Json?    @map("risk_disclosures")
  tone              String?
  industryAnalysis  Json?    @map("industry_analysis")
  kpis              Json?

  @@index([callId])
  @@map("summaries")
}

model SummaryNew {
  id                String   @id @default(uuid())
  callId            String   @unique @map("call_id")
  kpis              Json?
  entities          Json?
  milestones        Json?
  riskDisclosures   Json?    @map("risk_disclosures")
  governanceSignals Json?    @map("governance_signals")
  industryAnalysis  Json?    @map("industry_analysis")
  financialStrength Json?    @map("financial_strength")
  clientTraction    Json?    @map("client_traction")
  tone              String?
  confidence        String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([callId])
  @@map("summary_new")
}

model Kpi {
  id            String            @id @default(uuid())
  abbr          String            @unique
  full_form     String
  denomination  DenominationType?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  industry      String[]          @default([])
  source        KpiSource
  kpi_type      KpiTypeCategory?
  prowessValues ProwessValueNew[]

  @@index([abbr])
  @@index([source])
  @@map("kpis")
}

model SubstituteKpi {
  id             String   @id @default(uuid())
  primaryKpiAbbr String   @unique @map("primary_kpi_abbr")
  substitutes    String[]
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([primaryKpiAbbr])
  @@map("substitute_kpis")
}

model KpiValue {
  id          String    @id @default(uuid())
  callId      String    @map("call_id")
  company     String
  fiscal_year String?
  quarter     String?
  call_date   String?
  kpi_abbr    String
  value       Float?
  raw_value   String?   @map("raw_value")
  unit        String?
  multiplier  Int       @default(1)
  source      KpiSource
  source_path String    @default("")
  statement   String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  end_date    String?   @map("end_date")
  start_date  String?   @map("start_date")
  period_type String?   @map("period_type")

  @@unique([callId, kpi_abbr], map: "kpi_values_call_kpi_unique")
  @@index([callId])
  @@index([company, fiscal_year, quarter])
  @@index([company, kpi_abbr])
  @@index([kpi_abbr])
  @@index([kpi_abbr, period_type])
  @@map("kpi_values")
}

model ProwessValueNew {
  id          String    @default(uuid())
  callId      String    @map("call_id")
  company     String
  fiscal_year String?
  quarter     String?
  call_date   String?
  kpi_abbr    String
  value       Float?
  raw_value   String?   @map("raw_value")
  unit        String?
  multiplier  Int       @default(1)
  source      KpiSource
  source_path String    @default("")
  statement   String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  end_date    String?   @map("end_date")
  start_date  String?   @map("start_date")
  period_type String?   @map("period_type")
  source_type String    @default("C") @map("source_type")
  kpi         Kpi       @relation(fields: [kpi_abbr], references: [abbr], onDelete: Cascade)

  @@unique([callId, kpi_abbr], map: "pnv_call_kpi_unique")
  @@index([company, fiscal_year, quarter], map: "idx_pnv_company_fy_q")
  @@index([company, kpi_abbr], map: "idx_pnv_company_kpi")
  @@index([kpi_abbr], map: "idx_pnv_kpi")
  @@index([kpi_abbr, period_type], map: "idx_pnv_kpi_period")
  @@index([company, source_type], map: "idx_pnv_company_srctype")
  @@map("prowess_values_new")
}

model MilestoneKpiTarget {
  id                String   @id @default(uuid())
  callId            String   @map("call_id")
  company           String
  fiscal_year       String?
  quarter           String?
  call_date         String?
  category          String
  kpi_abbr          String
  statement         String?
  current_value     Float?   @map("current_value")
  targeted_value    Float?   @map("targeted_value")
  initial_time      String?  @map("initial_time")
  target_time       String?  @map("target_time")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  multiplier        Int      @default(1)
  currency          String?  @map("currency")
  cumulative_period Int?     @map("cumulative_period")

  @@index([callId])
  @@index([company, kpi_abbr])
  @@index([kpi_abbr])
  @@map("milestone_kpi_targets")
}

model WealthRmUser {
  id                String              @id @default(uuid())
  name              String
  email             String?             @unique
  team              String?
  performance_score Float               @default(0)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  actions           WealthAction[]
  clients           WealthClient[]
  interactions      WealthInteraction[]

  @@index([team])
  @@map("wealth_rm_users")
}

model WealthClient {
  id                String                     @id @default(uuid())
  name              String
  email             String?
  phone             String?
  rm_id             String?
  segment           WealthClientSegment
  risk_profile      WealthRiskProfile
  engagement_score  Float                      @default(0)
  churn_probability Float                      @default(0)
  last_contact_at   DateTime?
  metadata          Json?
  created_at        DateTime                   @default(now())
  updated_at        DateTime                   @updatedAt
  actions           WealthAction[]
  model_mappings    WealthClientModelMapping[]
  rm                WealthRmUser?              @relation(fields: [rm_id], references: [id])
  feature_store     WealthFeatureStore[]
  interactions      WealthInteraction[]
  portfolio         WealthPortfolio?
  suggestions       WealthSuggestion[]

  @@index([rm_id])
  @@index([segment])
  @@index([churn_probability])
  @@index([last_contact_at])
  @@map("wealth_clients")
}

model WealthPortfolio {
  id                  String       @id @default(uuid())
  client_id           String       @unique
  total_value         Float        @default(0)
  risk_score          Float        @default(0)
  last_rebalance_date DateTime?
  holdings            Json?
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt
  client              WealthClient @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
  @@map("wealth_portfolios")
}

model WealthInteraction {
  id         String                @id @default(uuid())
  client_id  String
  rm_id      String?
  type       WealthInteractionType
  summary    String?
  sentiment  String?
  timestamp  DateTime              @default(now())
  metadata   Json?
  created_at DateTime              @default(now())
  client     WealthClient          @relation(fields: [client_id], references: [id], onDelete: Cascade)
  rm         WealthRmUser?         @relation(fields: [rm_id], references: [id])

  @@index([client_id])
  @@index([rm_id])
  @@index([timestamp])
  @@map("wealth_interactions")
}

model WealthSuggestion {
  id               String                   @id @default(uuid())
  client_id        String
  priority         WealthSuggestionPriority @default(MEDIUM)
  reason           String?
  suggested_action String?
  message          String?
  talking_points   Json?
  status           WealthSuggestionStatus   @default(pending)
  score            Float                    @default(0)
  job_id           String?
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt
  actions          WealthAction[]
  client           WealthClient             @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id])
  @@index([status])
  @@index([priority])
  @@index([score])
  @@map("wealth_suggestions")
}

model WealthAction {
  id            String            @id @default(uuid())
  suggestion_id String?
  client_id     String
  rm_id         String?
  action_type   String
  content       String?
  outcome       String?
  created_at    DateTime          @default(now())
  client        WealthClient      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  rm            WealthRmUser?     @relation(fields: [rm_id], references: [id])
  suggestion    WealthSuggestion? @relation(fields: [suggestion_id], references: [id])

  @@index([client_id])
  @@index([rm_id])
  @@index([suggestion_id])
  @@map("wealth_actions")
}

model WealthApprovedModel {
  id              String                     @id @default(uuid())
  name            String
  description     String?
  model_type      WealthModelType
  data            Json?
  created_at      DateTime                   @default(now())
  updated_at      DateTime                   @updatedAt
  client_mappings WealthClientModelMapping[]

  @@index([model_type])
  @@map("wealth_approved_models")
}

model WealthClientModelMapping {
  id          String              @id @default(uuid())
  client_id   String
  model_id    String
  assigned_at DateTime            @default(now())
  client      WealthClient        @relation(fields: [client_id], references: [id], onDelete: Cascade)
  model       WealthApprovedModel @relation(fields: [model_id], references: [id], onDelete: Cascade)

  @@unique([client_id, model_id])
  @@index([client_id])
  @@index([model_id])
  @@map("wealth_client_model_mappings")
}

model WealthAuditLog {
  id           String   @id @default(uuid())
  entity_type  String
  entity_id    String
  action       String
  performed_by String?
  timestamp    DateTime @default(now())
  payload      Json?

  @@index([entity_type, entity_id])
  @@index([performed_by])
  @@index([timestamp])
  @@map("wealth_audit_logs")
}

model WealthFeatureStore {
  id           String       @id @default(uuid())
  client_id    String
  feature_name String
  value        Float
  updated_at   DateTime     @updatedAt
  client       WealthClient @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([client_id, feature_name])
  @@index([client_id])
  @@index([feature_name])
  @@map("wealth_feature_store")
}

model annual_reports {
  id                BigInt    @id @default(autoincrement())
  company           String?
  document_type     String?
  fiscal_year       String?
  call_date         String?
  annual_report_url String?
  created_at        DateTime? @db.Timestamp(6)

