  nse_quantity          Float?        @map("nse_quantity") // positions.nse.quantity
  nse_avg_price         Float?        @map("nse_avg_price") // positions.nse.averagePrice
  bse_quantity          Float?        @map("bse_quantity") // positions.bse.quantity
  bse_avg_price         Float?        @map("bse_avg_price") // positions.bse.averagePrice
  suspended_nse         Boolean?      @map("suspended_nse") // isSuspendedOrDelistedOnNSE
