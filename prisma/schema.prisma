model AiInsight {
  id               String   @id @default(uuid())
  ticker           String
  type             String
  insight          Json
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  lens_scores_hash String?  @map("lens_scores_hash")
  prompt_v         String?  @map("prompt_v")

  @@unique([ticker, type])
  @@index([ticker])
  @@index([type])
  @@map("ai_insights")
}

model Watchlist {
  id           String           @id @default(uuid())
  user_id      String
  name         String
  total_assets Int              @default(0) @map("total_assets")
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  assets       WatchlistAsset[]

  @@index([user_id])
  @@map("watchlists")
}

model WatchlistAsset {
  id           String    @id @default(uuid())
  watchlist_id String
  symbol       String
  added_on     DateTime  @default(now())
  notes        String?
  watchlist    Watchlist @relation(fields: [watchlist_id], references: [id], onDelete: Cascade)

  @@unique([watchlist_id, symbol])
  @@index([watchlist_id])
  @@index([symbol])
  @@map("watchlist_assets")
}

model User {
  id                String           @id @default(uuid())
  email             String?          @unique
  mobile            String?          @unique
  password_hash     String?          @map("password_hash")
  google_id         String?          @unique @map("google_id")
  display_name      String?          @map("display_name")
  display_picture   String?          @map("display_picture")
  account_type      AccountType      @map("account_type")
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  shadow_portfolios ShadowPortfolio?
  team_memberships  TeamMember[]
  user_portfolios   UserPortfolio?

  @@index([email])
  @@index([mobile])
  @@index([google_id])
  @@map("qc_users")
}

model Team {
  id         String       @id @default(uuid())
  name       String
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  members    TeamMember[]

  @@map("qc_teams")
}

model TeamMember {
  id         String   @id @default(uuid())
  team_id    String
  user_id    String
  created_at DateTime @default(now())
  team       Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@index([team_id])
  @@index([user_id])
  @@map("qc_team_members")
}

model UserPortfolio {
  id         String    @id @default(uuid())
  user_id    String    @unique @map("user_id")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  holdings   Holding[]
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("qc_user_portfolios")
}

model ShadowPortfolio {
  id         String    @id @default(uuid())
  user_id    String    @unique @map("user_id")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  holdings   Holding[]
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("qc_shadow_portfolios")
}

model Holding {
  id                  String           @id @default(uuid())
  ticker              String
  amount_invested     Float            @map("amount_invested")
  invested_at         DateTime         @map("invested_at")
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  user_portfolio_id   String?          @map("user_portfolio_id")
  shadow_portfolio_id String?          @map("shadow_portfolio_id")
  notes               HoldingNote[]
  shadow_portfolio    ShadowPortfolio? @relation(fields: [shadow_portfolio_id], references: [id], onDelete: Cascade)
  user_portfolio      UserPortfolio?   @relation(fields: [user_portfolio_id], references: [id], onDelete: Cascade)

  @@index([user_portfolio_id])
  @@index([shadow_portfolio_id])
  @@index([ticker])
  @@map("qc_holdings")
}

model HoldingNote {
  id         String   @id @default(uuid())
  holding_id String   @map("holding_id")
  note_text  String   @map("note_text")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  holding    Holding  @relation(fields: [holding_id], references: [id], onDelete: Cascade)

  @@index([holding_id])
  @@map("qc_holding_notes")
}

model MutualFundScheme {
  amfi_code      String   @id
  name           String
  isin           String?
  plan_type      String?
  option_type    String?
  nav            Float?
  nav_date       String?
  day_change     Float?
  day_change_pct Float?
  morningstar    Int?
  risk_label     String?
  expense_ratio  Float?
  aum            Float?
  family_name    String?
  family_id      Int?
  amc_name       String?
  amc_slug       String?
  category       String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  returns_1y     Float?
  returns_3y     Float?
  returns_5y     Float?

  @@index([amc_slug])
  @@index([category])
  @@index([family_id])
  @@map("mutual_fund_schemes")
}

model Skill {
  id                  String        @id @default(uuid())
  name                String        @unique
  description         String?
  promptKey           String        @map("prompt_key")
  model               String        @default("anthropic/claude-haiku-4.5")
  maxTokens           Int           @default(16000) @map("max_tokens")
  outputSchema        Json?         @map("output_schema")
  isActive            Boolean       @default(true) @map("is_active")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  defaultInstructions String?       @map("default_instructions")
  promptTemplate      String?       @map("prompt_template")
  slug                String?       @unique
  pluginSkills        PluginSkill[]

  @@index([name])
  @@map("skills")
}

model Plugin {
  id           String         @id @default(uuid())
  name         String         @unique
  description  String?
  category     PluginCategory
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  slug         String?        @unique
  pluginSkills PluginSkill[]

  @@index([category])
  @@map("plugins")
}

model PluginSkill {
  id       String @id @default(uuid())
  pluginId String @map("plugin_id")
  skillId  String @map("skill_id")
  order    Int
  plugin   Plugin @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([pluginId, skillId])
  @@unique([pluginId, order])
  @@index([pluginId])
  @@index([skillId])
  @@map("plugin_skills")
}

model ExtractedSignal {
  id              String           @id @default(uuid())
  call_id         String
  ticker          String
  company         String
  fiscal_year     String?
  quarter         String?
  call_date       String?
  source_type     SignalSourceType
  signal_type     String
  metric          String
  value           Float?
  raw_value       String?
  unit            String?
  multiplier      Float            @default(1)
  w               Float            @default(1.0)
  b               Float            @default(0.0)
  confidence      Float?
  time_horizon    String?
  esg_tag         String?
  risk_tag        String?
  sector          String?
  metric_family   String?
  source_hash     String
  prompt_v        String
  schema_v        String           @default("2.0.0")
  extractor_model String
  lineage_id      String
  statement       String?
  start_date      String?
  end_date        String?
  period_type     String?
  is_invalidated  Boolean          @default(false)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  impact          String?
  severity        String?

  @@unique([call_id, signal_type, metric, source_hash, prompt_v, start_date])
  @@index([ticker])
  @@index([call_id])
  @@index([ticker, metric_family])
  @@index([source_hash])
  @@map("extracted_signals")
}

model TranscriptSignalV2 {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  call_id         String
  ticker          String
  company         String
  fiscal_year     String?
  quarter         String?
  call_date       String?
  signal_type     String
  source_context  String?
  source_stmt_id  String?
  signal_seq_id   String?
  metric          String?
  impact          String?
  severity        String?
  statement       String?
  data            Json
  source_hash     String
  prompt_v        String
  extractor_model String
  lineage_id      String
  is_invalidated  Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  source_doc_type String?

  @@index([source_doc_type])
  @@index([call_id], map: "tsv2_call_id")
  @@index([call_id, signal_type], map: "tsv2_call_type")
  @@index([lineage_id], map: "tsv2_lineage")
  @@index([source_hash], map: "tsv2_src_hash")
  @@index([ticker, signal_type], map: "tsv2_tick_type")
  @@index([ticker], map: "tsv2_ticker")
  @@map("transcript_signals_v2")
}

model LensConfig {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  is_active   Boolean  @default(true)
  version     String   @default("1.0.0")
  config      Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  category    String?

  @@index([slug])
  @@index([category])
  @@map("lens_configs")
}

model LensScore {
  id               String   @id @default(uuid())
  call_id          String
  ticker           String
  lens_slug        String
  z_score          Float
  confidence_lo    Float?
  confidence_hi    Float?
  signal_count     Int
  lens_config_v    String
  signals_snapshot Json
  is_stale         Boolean  @default(false)
  computed_at      DateTime @default(now())
  updated_at       DateTime @updatedAt
  lens_data        Json?
  signals_hash     String?

  @@unique([call_id, lens_slug])
  @@index([ticker, lens_slug])
  @@index([call_id])
  @@map("lens_scores")
}

