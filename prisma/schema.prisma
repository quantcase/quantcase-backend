  updatedAt    DateTime          @updatedAt @map("updated_at")
  industry     String[]          @default([])
  source       KpiSource
  kpi_type     KpiTypeCategory?
  prowessValues ProwessValueNew[]

  @@index([abbr])
  @@index([source])
  @@map("kpis")
}


model SubstituteKpi {
