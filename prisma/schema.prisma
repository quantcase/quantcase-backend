model nse_equity_new {
  symbol        String    @db.VarChar
  company_name  String    @db.VarChar
  datetime      DateTime  @db.Date
  open          Float?
  high          Float?
  low           Float?
  close         Float?
  volume        Int?
  pe            Float?
  // Two new Prowess-computed PE variants (2026-07-25), from a custom
  // QueryOnStockPricesAndRatios expression: close / ((PAT * 1e7) / shares) —
  // consolidated-financials-based and standalone-financials-based
  // respectively. Deliberately separate from `pe` (Prowess's own plain P/E
  // column, left untouched) -- admin wants these as additional columns, not
  // a replacement.
  pe_consolidated Float?
  pe_standalone   Float?
  eps           Float?
  market_cap_cr Float?
  // Daily return as Prowess reports it, already in percentage points
  // (e.g. 0.060604 = 0.06%, verified against real Sensex close on 2026-07-13 —
  // do not multiply by 100) — populated for index rows today ("Daily Index
  // Returns"), null for stocks (no equivalent source column).
  pct_change    Float?
  // Nullable, no @default/@updatedAt-driven NOT NULL — this table has ~1.2M
  // pre-existing rows and neither column should force a backfill to add.
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  @@id([symbol, datetime])
  @@map("nse_equity_new")
}

