}

// Jobs table for API
model Job {
  id           String   @id @default(uuid())
  callId       String   @map("call_id")
  type         String
  status       String   @default("pending")
  bullmqId     String?  @unique @map("bullmq_id")
  result       Json?
  error        String?
  prompt       String?                       // full prompt sent to LLM
  llm_response String?  @map("llm_response") // raw text response from LLM before parsing
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("jobs")
  @@index([callId])
  @@index([status])
}

// Summaries table for storing extracted call data (legacy — do not modify)
model Summary {
  id                String   @id @default(uuid())
  callId            String   @unique @map("call_id")
  kpis              Json?                              // from QE worker: [{kpi_abbr, value}]
  entities          Json?                              // from transcript worker
  milestones        Json?                              // from transcript worker
  riskDisclosures   Json?    @map("risk_disclosures")  // from transcript worker
  governanceSignals Json?    @map("governance_signals") // from transcript worker
  industryAnalysis  Json?    @map("industry_analysis")  // from transcript worker
  tone              String?                            // from transcript worker
  confidence        String?                            // from transcript worker
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  @@map("summaries")
  @@index([callId])
}

// New summaries table with financial_strength and client_traction
model SummaryNew {
  id                String   @id @default(uuid())
  callId            String   @unique @map("call_id")
  kpis              Json?                              // from QE worker: [{kpi_abbr, value}]
  entities          Json?                              // from transcript worker
  milestones        Json?                              // from transcript worker
  riskDisclosures   Json?    @map("risk_disclosures")  // from transcript worker
  governanceSignals Json?    @map("governance_signals") // from transcript worker
  industryAnalysis  Json?    @map("industry_analysis")  // from transcript worker
  financialStrength Json?    @map("financial_strength") // from transcript worker
  clientTraction    Json?    @map("client_traction")    // from transcript worker
  tone              String?                            // from transcript worker
  confidence        String?                            // from transcript worker
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  @@map("summary_new")
  @@index([callId])
}
model Kpi {
  id           String           @id @default(uuid())
  abbr         String           @unique
  full_form    String
  kpi_type     KpiTypeCategory?
  denomination DenominationType?
  industry     String[]         @default([])
  source       KpiSource
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt      @map("updated_at")

  @@map("kpis")
  @@index([abbr])
  @@index([source])
}

enum DenominationType {
  rupee
  percentage
  ratio
  other
}

enum KpiSource {
  transcript
  QE
}

enum KpiTypeCategory {
  // QE source types
  assets
  liabilities
  equity
  revenue
  cogs
  operating_expenses
  profit_lines
  cashflow
  // transcript source types
  customer_kpis
  industry_specific
}

model market_cap {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at                DateTime  @default(now()) @db.Timestamptz(6)
  market_cap                BigInt?
  date                      DateTime? @db.Date
  market_cap_cr             Float?    @map("market_cap(Cr)")
  symbol                    String?
}

model pe_data {
  id         BigInt    @id @default(autoincrement())
  company    String
  date       DateTime  @db.Date
  pe         Decimal?  @db.Decimal
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([company, date], map: "pe_data_company_date_key")
  @@index([company])
}

model SubstituteKpi {
  id             String   @id @default(uuid())
  primaryKpiAbbr String   @unique @map("primary_kpi_abbr")
  substitutes    String[]                                   // ordered list, index 0 = highest priority
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("substitute_kpis")
  @@index([primaryKpiAbbr])
}

model OFactorResult {
  id             String   @id @default(uuid())
  callId         String   @unique @map("call_id")
  subjectTicker  String   @map("subject_ticker")
  peerTickers    String[] @map("peer_tickers")
  result         Json                              // full parsed Claude output (OFactorResponseSchema shape)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  @@map("ofactor_results")
  @@index([callId])
  @@index([subjectTicker])
}

model DealResult {
  id        String   @id @default(uuid())
  callId    String   @unique @map("call_id")
  ticker    String
  result    Json                              // full parsed Claude output (DealResponseSchema shape)
  inputs    Json                              // EPS/PE CAGR inputs used to generate the result
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("deal_results")
  @@index([callId])
  @@index([ticker])
}

// Flattened KPI values for fast time-series DB lookups — sourced from summary_new.
//
// source_path values:
//   QE KPIs         : ""
//   Transcript KPIs : "industry_analysis.demand" | "industry_analysis.supply"
//                     "industry_analysis.operating_margins"
//                     "client_traction.customer_growth" | "client_traction.revenue_streams"
//   Milestone KPIs  : "milestones.future_goals" | "milestones.success_disclosures"
//                     "milestones.failure_disclosures"
//                     (only added when kpi_abbr is absent from QE + transcript rows for that call)
//
// statement is populated for transcript/milestone KPIs for auditing.
model KpiValue {
  id          String    @id @default(uuid())
  callId      String    @map("call_id")       // → earnings_calls.id / summary_new.call_id
  company     String                          // denormalized from earnings_calls.company
  fiscal_year String?
  quarter     String?
  call_date   String?
  kpi_abbr    String                          // → kpis.abbr
  value       Float?                          // normalized: llm_value * multiplier (absolute units)
  raw_value   String?   @map("raw_value")     // llm-reported value before normalization (audit)
  unit        String?                         // from kpis.denomination: "Cr" | "%" | "x" | ""
  multiplier  Int       @default(1)           // LLM scale factor (1 | 100000 | 10000000); applied to value at ingestion
  start_date  String?   @map("start_date")    // period start; null for snapshots (balance sheet)
  end_date    String?   @map("end_date")      // period end or snapshot date
  period_type String?   @map("period_type")   // derived at ingestion: snapshot|quarterly|half_yearly|annual|multi_year
  source      KpiSource                       // "QE" | "transcript"
  source_path String    @default("")          // which column/path in summary_new
  statement   String?                         // supporting quote for transcript/milestone KPIs (audit)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt      @map("updated_at")

  @@map("kpi_values")
  @@unique([callId, kpi_abbr], map: "kpi_values_call_kpi_unique")
  @@index([callId])
  @@index([company, fiscal_year, quarter])
  @@index([company, kpi_abbr])
  @@index([kpi_abbr])
  @@index([kpi_abbr, period_type])
}

// Full milestone financial targets — separate from kpi_values.
// Stores all three categories with both current and targeted values.
// No deduplication logic applied here — source of truth for promise tracking.
model MilestoneKpiTarget {
  id              String   @id @default(uuid())
  callId          String   @map("call_id")
  company         String
  fiscal_year     String?
  quarter         String?
  call_date       String?
  category        String                      // "future_goals" | "success_disclosures" | "failure_disclosures"
  kpi_abbr        String
  statement       String?                     // natural language description from transcript
  current_value   Float?   @map("current_value")
  targeted_value  Float?   @map("targeted_value")
  multiplier      Int      @default(1)        // scale factor (1 | 100000 | 10000000); applied to values at ingestion
  initial_time    String?  @map("initial_time")   // YYYY-MM-DD when target was announced
  target_time     String?  @map("target_time")    // YYYY-MM-DD when target is due
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  @@map("milestone_kpi_targets")
  @@index([callId])
  @@index([company, kpi_abbr])
  @@index([kpi_abbr])
}