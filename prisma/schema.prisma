model Watchlist {
  id           String           @id @default(uuid())
  user_id      String
  name         String
  total_assets Int              @default(0) @map("total_assets")
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  assets       WatchlistAsset[]

  @@index([user_id])
  @@map("watchlists")
}

model WatchlistAsset {
  id           String    @id @default(uuid())
  watchlist_id String
  symbol       String
  added_on     DateTime  @default(now())
  notes        String?
  watchlist    Watchlist @relation(fields: [watchlist_id], references: [id], onDelete: Cascade)

  @@unique([watchlist_id, symbol])
  @@index([watchlist_id])
  @@index([symbol])
  @@map("watchlist_assets")
}

// Reusable, named ticker sets selectable across L1/L2/L3 admin dispatch flows.
// filter_type 'manual' → filter_config: { tickers: string[] }.
// filter_type 'dynamic' → filter_config combines any of: coverage, pendingExtraction,
// marketCap, industries — resolved fresh every time the group is used (see
// services/companyGroups/resolver.js).
model CompanyGroup {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  filter_type   String
  filter_config Json     @default("{}")
  // Which HtmlIncrementalSkillConfig.key (e.g. "t1"/"t2"/"t3") every ticker in
  // this group should run with — a plain string, not an FK, since configs are
  // saved per-skill but this pairing is skill-agnostic (the same key
  // convention is expected across skills). Resolved automatically at run time
  // for any ticker whose configKey wasn't passed explicitly — see
  // resolveConfigKeyForTicker in services/companyGroups/resolver.js. A ticker
  // that resolves to no config_key at all (not covered by any config-mapped
  // group, and no explicit configKey given) blocks the run with a 400 rather
  // than silently falling back to the skill's own top-level fields.
  config_key    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("company_groups")
}
