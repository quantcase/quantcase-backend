model SmallcaseHolding {
  id                    String        @id @default(uuid())
  smallcase_user_id     String        @map("smallcase_user_id")
  ticker                String
  quantity              Float // holdings.quantity — total shares held
  avg_price             Float         @map("avg_price") // holdings.averagePrice — avg BUY price (cost basis, not LTP)
  current_price         Float?        @map("current_price") // not in payload; filled by later market-data enrichment
  current_value         Float?        @map("current_value")
  invested_value        Float         @map("invested_value")
  pnl                   Float?
  pnl_pct               Float?        @map("pnl_pct")
  exchange              String?
  isin                  String?
  // ─── Full smallcase v2 security fields ────────────────────────────────────
