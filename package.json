{
  "name": "quantcase-backend",
  "version": "1.0.0",
  "description": "Backend API server for QuantCase",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node --max-old-space-size=8192 worker.js",
    "worker:dev": "nodemon --exec 'node --max-old-space-size=8192' worker.js",
    "admin": "node lib/admin.js",
    "scheduler": "node scheduler.js",
    "scheduler:dev": "nodemon scheduler.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed:billing": "node prisma/seedBilling.js",
    "db:seed:scheduler": "node scripts/seedSchedulerJobs.js",
    "db:seed:post-html-analysis": "node scripts/seedPostHtmlAnalysisConfigs.js",
    "db:create:bse": "node scripts/createBseDiscoveredUrls.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@bull-board/api": "^6.20.3",
    "@bull-board/express": "^6.20.3",
    "@prisma/client": "^5.7.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.67.3",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.9.2",
    "jsonrepair": "^3.14.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "openai": "^6.19.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "razorpay": "^2.9.6",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "xlsx": "^0.18.5",
    "yahoo-finance2": "^3.13.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^5.7.0"
  }
